edition 7;
import std.result;

fn int_max() -> [] int {
    return 9223372036854775807;
}

fn int_min() -> [] int {
    return -9223372036854775807 - 1;
}

fn arith_ok(op: int, a: int, b: int) -> [] bool {
    if op == 0 {
        if b > 0 { return a <= int_max() - b; }
        return a >= int_min() - b;
    }
    if op == 1 {
        if b > 0 { return a >= int_min() + b; }
        return a <= int_max() + b;
    }
    if op == 2 {
        if a == 0 || b == 0 { return true; }
        if a == -1 { return b != int_min(); }
        if b == -1 { return a != int_min(); }
        let p = wrapping_mul(a, b);
        return p / b == a;
    }
    if op == 3 {
        if b == 0 { return false; }
        return !(a == int_min() && b == -1);
    }
    return b != 0;
}

fn arith_apply(op: int, a: int, b: int) -> [] int {
    if op == 0 { return a + b; }
    if op == 1 { return a - b; }
    if op == 2 { return a * b; }
    if op == 3 { return a / b; }
    return a % b;
}

fn skip_spaces[&r](s: &r [byte], pos: int) -> [] int {
    var i = pos;
    while i < len(s) && int_of(s[i]) == 32 {
        i = i + 1;
    }
    return i;
}

fn read_number[&r, &q](s: &r [byte], st: &!q [int]) -> [] int {
    var i = st[0];
    var v = 0;
    var digits = 0;
    while i < len(s) && int_of(s[i]) >= 48 && int_of(s[i]) <= 57 && st[1] == 0 {
        let d = int_of(s[i]) - 48;
        if v > (int_max() - d) / 10 {
            st[1] = 1;
        } else {
            v = v * 10 + d;
        }
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 { st[1] = 1; }
    st[0] = i;
    return v;
}

fn parse_level[&r, &q](s: &r [byte], st: &!q [int], level: int) -> [] int {
    if level == 2 {
        let i = skip_spaces(s, st[0]);
        st[0] = i;
        if i >= len(s) {
            st[1] = 1;
            return 0;
        }
        let c = int_of(s[i]);
        if c == 45 {
            st[0] = i + 1;
            let v = parse_level(s, st, 2);
            if st[1] == 0 && arith_ok(1, 0, v) { return 0 - v; }
            st[1] = 1;
            return 0;
        }
        if c == 40 {
            st[0] = i + 1;
            let v = parse_level(s, st, 0);
            let j = skip_spaces(s, st[0]);
            if st[1] == 0 && j < len(s) && int_of(s[j]) == 41 {
                st[0] = j + 1;
            } else {
                st[1] = 1;
            }
            return v;
        }
        return read_number(s, st);
    }
    var acc = parse_level(s, st, level + 1);
    var more = true;
    while more && st[1] == 0 {
        let i = skip_spaces(s, st[0]);
        var op = -1;
        if i < len(s) {
            let c = int_of(s[i]);
            if level == 0 {
                if c == 43 { op = 0; }
                if c == 45 { op = 1; }
            } else {
                if c == 42 { op = 2; }
                if c == 47 { op = 3; }
                if c == 37 { op = 4; }
            }
        }
        if op < 0 {
            more = false;
        } else {
            st[0] = i + 1;
            let rhs = parse_level(s, st, level + 1);
            if st[1] == 0 && arith_ok(op, acc, rhs) {
                acc = arith_apply(op, acc, rhs);
            } else {
                st[1] = 1;
            }
        }
    }
    return acc;
}

pub fn expr_eval[&r](s: &r [byte]) -> [] result.Result[int, &static [byte]] {
    var value = 0;
    var failed = true;
    region a {
        let st = alloc_slice[a](2, 0);
        value = parse_level(s, st, 0);
        let end = skip_spaces(s, st[0]);
        failed = st[1] != 0 || end != len(s);
    }
    if failed { return result.Result::Err("invalid expression"); }
    return result.Result::Ok(value);
}
