edition 7;
import std.option;
import std.result;
import std.buffer;
import std.bytes;

// iniconf port. Representation (pinned in the plan): a list of "name=value" settings is ONE heap-owned
// buffer.Buffer holding the entries each terminated by "\n" (values never contain a line feed); Err carries
// the 1-based number of the first malformed line.

fn find_byte[&t](s: &t [byte], b: int) -> [] int {
    var i = 0;
    while i < len(s) {
        if int_of(s[i]) == b { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ini_key_ok[&r](key: &r [byte]) -> [] bool {
    if len(key) == 0 { return false; }
    var i = 0;
    while i < len(key) {
        let c = int_of(key[i]);
        if !(bytes.is_alpha(c) || bytes.is_digit(c) || c == '_' || c == '.' || c == '-') { return false; }
        i = i + 1;
    }
    return true;
}

fn ini_section_name_ok[&r](name: &r [byte]) -> [] bool {
    if len(name) == 0 { return false; }
    var i = 0;
    while i < len(name) {
        let c = int_of(name[i]);
        if c == '[' || c == ']' || c == '=' { return false; }
        i = i + 1;
    }
    return true;
}

fn ini_unquote[&r](value: &r [byte]) -> [] &r [byte] {
    if len(value) >= 2 && int_of(value[0]) == '"' && int_of(value[len(value) - 1]) == '"' {
        return value[1..len(value) - 1];
    }
    return value;
}

fn ini_line_kind[&r](line: &r [byte]) -> [] int {
    let t = bytes.trim(line);
    if len(t) == 0 { return 0; }
    let c0 = int_of(t[0]);
    if c0 == ';' || c0 == '#' { return 0; }
    if c0 == '[' {
        if len(t) < 2 || int_of(t[len(t) - 1]) != ']' { return 3; }
        if ini_section_name_ok(bytes.trim(t[1..len(t) - 1])) { return 1; }
        return 3;
    }
    let eq = find_byte(t, '=');
    if eq < 0 { return 3; }
    if ini_key_ok(bytes.trim(t[0..eq])) { return 2; }
    return 3;
}

fn ini_raw[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] result.Result[buffer.Buffer, int] {
    var raw = buffer.empty(heap, 16);
    var section = text[0..0];
    var pos = 0;
    var lineno = 0;
    var bad = 0;
    while bad == 0 && pos <= len(text) {
        var nl = find_byte(text[pos..len(text)], 10);
        var stop = len(text);
        if nl >= 0 { stop = pos + nl; }
        let line = bytes.trim(text[pos..stop]);
        pos = stop + 1;
        lineno = lineno + 1;
        let kind = ini_line_kind(line);
        if kind == 3 {
            bad = lineno;
        } else if kind == 1 {
            section = bytes.trim(line[1..len(line) - 1]);
        } else if kind == 2 {
            let eq = find_byte(line, '=');
            let k = bytes.trim(line[0..eq]);
            let v = ini_unquote(bytes.trim(line[eq + 1..len(line)]));
            if len(section) > 0 {
                raw = buffer.append(heap, raw, section);
                raw = buffer.push(heap, raw, byte_of('.'));
            }
            raw = buffer.append(heap, raw, k);
            raw = buffer.push(heap, raw, byte_of('='));
            raw = buffer.append(heap, raw, v);
            raw = buffer.push(heap, raw, byte_of('\n'));
        }
    }
    if bad != 0 {
        buffer.drop(heap, raw);
        return result.Result::Err(bad);
    }
    return result.Result::Ok(raw);
}

fn rec_end[&t](r: &t [byte], i: int) -> [] int {
    return i + find_byte(r[i..len(r)], 10);
}

fn ini_dedupe[&h, &r](heap: &!h Heap, raw: &r [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    var i = 0;
    while i < len(raw) {
        let e = rec_end(raw, i);
        let nlen = find_byte(raw[i..e], '=');
        let name = raw[i..i + nlen];
        var seen = false;
        var k = 0;
        while k < i {
            let ke = rec_end(raw, k);
            let kn = find_byte(raw[k..ke], '=');
            if bytes.equal(raw[k..k + kn], name) { seen = true; }
            k = ke + 1;
        }
        if seen == false {
            var vs = i + nlen + 1;
            var ve = e;
            var j = e + 1;
            while j < len(raw) {
                let je = rec_end(raw, j);
                let jn = find_byte(raw[j..je], '=');
                if bytes.equal(raw[j..j + jn], name) {
                    vs = j + jn + 1;
                    ve = je;
                }
                j = je + 1;
            }
            out = buffer.append(heap, out, name);
            out = buffer.push(heap, out, byte_of('='));
            out = buffer.append(heap, out, raw[vs..ve]);
            out = buffer.push(heap, out, byte_of('\n'));
        }
        i = e + 1;
    }
    return out;
}

pub fn ini_parse[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] result.Result[buffer.Buffer, int] {
    match ini_raw(heap, text) {
        result.Result::Err(n) => { return result.Result::Err(n); }
        result.Result::Ok(raw) => {
            var out = buffer.empty(heap, 1);
            buffer.drop(heap, out);
            borrow raw as &r in { out = ini_dedupe(heap, buffer.bytes(r)); }
            buffer.drop(heap, raw);
            return result.Result::Ok(out);
        }
    }
}

fn ini_find[&r, &k](entries: &r [byte], full: &k [byte]) -> [] int {
    var i = 0;
    while i < len(entries) {
        let e = rec_end(entries, i);
        let nlen = find_byte(entries[i..e], '=');
        if bytes.equal(entries[i..i + nlen], full) { return i + nlen + 1; }
        i = e + 1;
    }
    return 0 - 1;
}

pub fn ini_get[&h, &t, &s, &k](heap: &!h Heap, text: &t [byte], section: &s [byte], key: &k [byte]) -> [heap] result.Result[option.Option[buffer.Buffer], int] {
    match ini_parse(heap, text) {
        result.Result::Err(n) => { return result.Result::Err(n); }
        result.Result::Ok(entries) => {
            var full = buffer.empty(heap, 16);
            if len(section) > 0 {
                full = buffer.append(heap, full, section);
                full = buffer.push(heap, full, byte_of('.'));
            }
            full = buffer.append(heap, full, key);
            var vs = 0 - 1;
            var ve = 0;
            borrow entries as &r in {
                let b = buffer.bytes(r);
                borrow full as &f in { vs = ini_find(b, buffer.bytes(f)); }
                if vs >= 0 { ve = rec_end(b, vs); }
            }
            buffer.drop(heap, full);
            if vs < 0 {
                buffer.drop(heap, entries);
                return result.Result::Ok(option.Option::None);
            }
            var v = buffer.empty(heap, 1);
            borrow entries as &r in { v = buffer.append(heap, v, buffer.bytes(r)[vs..ve]); }
            buffer.drop(heap, entries);
            return result.Result::Ok(option.Option::Some(v));
        }
    }
}
