edition 7;

module tokens;

// Token kinds: 1 number, 2 plus, 3 minus, 4 star, 5 open parenthesis, 6 close parenthesis.

pub fn tk_kind[&t](toks: &t [int], i: int) -> [] int {
    return toks[2 * i];
}

pub fn tk_value[&t](toks: &t [int], i: int) -> [] int {
    return toks[2 * i + 1];
}

fn tk_punct(c: int) -> [] int {
    if c == 43 {
        return 2;
    }
    if c == 45 {
        return 3;
    }
    if c == 42 {
        return 4;
    }
    if c == 40 {
        return 5;
    }
    if c == 41 {
        return 6;
    }
    return 0;
}

pub fn tk_scan[&s, &o](text: &s [byte], toks: &!o [int]) -> [] int {
    let cap = len(toks) / 2;
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == 32 || c == 9 {
            i = i + 1;
        } else if c >= 48 && c <= 57 {
            var v = 0;
            var digits = 0;
            while i < len(text) && int_of(text[i]) >= 48 && int_of(text[i]) <= 57 {
                if digits >= 18 {
                    return 0 - 2;
                }
                v = v * 10 + (int_of(text[i]) - 48);
                digits = digits + 1;
                i = i + 1;
            }
            if n >= cap {
                return 0 - 3;
            }
            toks[2 * n] = 1;
            toks[2 * n + 1] = v;
            n = n + 1;
        } else {
            let k = tk_punct(c);
            if k == 0 {
                return 0 - 1;
            }
            if n >= cap {
                return 0 - 3;
            }
            toks[2 * n] = k;
            toks[2 * n + 1] = 0;
            n = n + 1;
            i = i + 1;
        }
    }
    return n;
}
