edition 7;
module semver_tests;
import std.result;
import std.test;
import semver;

fn is_ok_int(r: result.Result[int, &static [byte]], x: int) -> [] bool {
    match r {
        result.Result::Ok(v) => { return v == x; }
        result.Result::Err(_) => { return false; }
    }
}
fn is_ok_bool(r: result.Result[bool, &static [byte]], x: bool) -> [] bool {
    match r {
        result.Result::Ok(v) => { return v == x; }
        result.Result::Err(_) => { return false; }
    }
}
fn is_err_int(r: result.Result[int, &static [byte]]) -> [] bool {
    match r {
        result.Result::Ok(_) => { return false; }
        result.Result::Err(_) => { return true; }
    }
}
fn is_err_bool(r: result.Result[bool, &static [byte]]) -> [] bool {
    match r {
        result.Result::Ok(_) => { return false; }
        result.Result::Err(_) => { return true; }
    }
}
