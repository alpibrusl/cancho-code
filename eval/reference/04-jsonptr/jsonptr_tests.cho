edition 7;
module jsonptr_tests;
import std.list;
import std.result;
import std.test;
import std.bytes;
import jsonptr;

fn mk[&h, &r](heap: &!h Heap, s: &r [byte]) -> [heap] Box[[byte]] {
    let b = box_slice(heap, len(s), byte_of(0));
    borrow mut b as &!w in { copy_into(contents(w), s); }
    return b;
}

fn drop_list[&h](heap: &!h Heap, l: list.List[Box[jsonptr.Token]]) -> [heap] int {
    match l {
        list.List::Empty => { return 0; }
        list.List::Cons(t, rest) => {
            let jsonptr.Token { held } = unbox(heap, t);
            unbox_slice(heap, held);
            let tail = unbox(heap, rest);
            return 1 + drop_list(heap, tail);
        }
    }
}

fn list_eq[&a, &b](x: &a list.List[Box[jsonptr.Token]], y: &b list.List[Box[jsonptr.Token]]) -> [] bool {
    match x {
        list.List::Empty => {
            match y {
                list.List::Empty => { return true; }
                list.List::Cons(_, _) => { return false; }
            }
        }
        list.List::Cons(t, rest) => {
            match y {
                list.List::Empty => { return false; }
                list.List::Cons(u, rest2) => {
                    if bytes.equal(contents(contents(t).held), contents(contents(u).held)) == false { return false; }
                    return list_eq(contents(rest), contents(rest2));
                }
            }
        }
    }
}

fn parse_ok[&h, &r](heap: &!h Heap, p: &r [byte], exp: list.List[Box[jsonptr.Token]]) -> [heap] bool {
    match jsonptr.ptr_parse(heap, p) {
        result.Result::Ok(got) => {
            var same = false;
            borrow got as &g in { borrow exp as &e in { same = list_eq(g, e); } }
            drop_list(heap, got);
            drop_list(heap, exp);
            return same;
        }
        result.Result::Err(_) => {
            drop_list(heap, exp);
            return false;
        }
    }
}

fn parse_err[&h, &r](heap: &!h Heap, p: &r [byte]) -> [heap] bool {
    match jsonptr.ptr_parse(heap, p) {
        result.Result::Ok(got) => { drop_list(heap, got); return false; }
        result.Result::Err(_) => { return true; }
    }
}

fn format_is[&h, &r](heap: &!h Heap, toks: list.List[Box[jsonptr.Token]], exp: &r [byte]) -> [heap] bool {
    var same = false;
    borrow toks as &t in {
        let out = jsonptr.ptr_format(heap, t);
        borrow out as &o in { same = bytes.equal(contents(o), exp); }
        unbox_slice(heap, out);
    }
    drop_list(heap, toks);
    return same;
}

fn append_ok[&h, &r, &t, &e](heap: &!h Heap, p: &r [byte], tok: &t [byte], exp: &e [byte]) -> [heap] bool {
    match jsonptr.ptr_append(heap, p, tok) {
        result.Result::Ok(b) => {
            var same = false;
            borrow b as &o in { same = bytes.equal(contents(o), exp); }
            unbox_slice(heap, b);
            return same;
        }
        result.Result::Err(_) => { return false; }
    }
}

fn append_err[&h, &r, &t](heap: &!h Heap, p: &r [byte], tok: &t [byte]) -> [heap] bool {
    match jsonptr.ptr_append(heap, p, tok) {
        result.Result::Ok(b) => { unbox_slice(heap, b); return false; }
        result.Result::Err(_) => { return true; }
    }
}

fn parent_ok[&r, &e](p: &r [byte], exp: &e [byte]) -> [] bool {
    match jsonptr.ptr_parent(p) {
        result.Result::Ok(s) => { return bytes.equal(s, exp); }
        result.Result::Err(_) => { return false; }
    }
}

fn parent_err[&r](p: &r [byte]) -> [] bool {
    match jsonptr.ptr_parent(p) {
        result.Result::Ok(_) => { return false; }
        result.Result::Err(_) => { return true; }
    }
}

pub fn test_000_ptr_parse[&h](heap: &!h Heap) -> [heap] int {
    var e: list.List[Box[jsonptr.Token]] = list.List::Empty;
    test.assert(parse_ok(heap, "", e));
    return 0;
}

pub fn test_001_ptr_parse[&h](heap: &!h Heap) -> [heap] int {
    var e: list.List[Box[jsonptr.Token]] = list.List::Empty;
    e = list.push(heap, e, box(heap, jsonptr.Token { held: mk(heap, "") }));
    test.assert(parse_ok(heap, "/", e));
    return 0;
}

pub fn test_002_ptr_parse[&h](heap: &!h Heap) -> [heap] int {
    var e: list.List[Box[jsonptr.Token]] = list.List::Empty;
    e = list.push(heap, e, box(heap, jsonptr.Token { held: mk(heap, "") }));
    e = list.push(heap, e, box(heap, jsonptr.Token { held: mk(heap, "") }));
    test.assert(parse_ok(heap, "//", e));
    return 0;
}

