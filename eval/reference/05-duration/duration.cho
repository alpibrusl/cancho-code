edition 7;
module duration;
import std.result;
import std.buffer;

fn unit_rank(c: int) -> [] int {
    if c == 119 { return 5; }
    if c == 100 { return 4; }
    if c == 104 { return 3; }
    if c == 109 { return 2; }
    if c == 115 { return 1; }
    return 0;
}

fn unit_secs(rank: int) -> [] int {
    if rank == 5 { return 604800; }
    if rank == 4 { return 86400; }
    if rank == 3 { return 3600; }
    if rank == 2 { return 60; }
    return 1;
}

pub fn duration_parse[&r](s: &r [byte]) -> [] result.Result[int, &static [byte]] {
    let n = len(s);
    if n == 0 { return result.Result::Err("empty duration"); }
    var i = 0;
    var total = 0;
    var last = 6;
    while i < n {
        var num = 0;
        var digits = 0;
        var more = true;
        while more {
            if i >= n {
                more = false;
            } else {
                let c = int_of(s[i]);
                if c >= 48 && c <= 57 {
                    if digits >= 9 { return result.Result::Err("number has more than 9 digits"); }
                    num = num * 10 + (c - 48);
                    digits = digits + 1;
                    i = i + 1;
                } else {
                    more = false;
                }
            }
        }
        if digits == 0 { return result.Result::Err("expected a digit"); }
        if i >= n { return result.Result::Err("number without a unit"); }
        let rank = unit_rank(int_of(s[i]));
        if rank == 0 { return result.Result::Err("unknown unit"); }
        if rank >= last { return result.Result::Err("units out of order or repeated"); }
        last = rank;
        total = total + num * unit_secs(rank);
        i = i + 1;
    }
    return result.Result::Ok(total);
}

fn put_part[&h](heap: &!h Heap, b: buffer.Buffer, n: int, unit: int) -> [heap] buffer.Buffer {
    if n == 0 { return b; }
    let b2 = buffer.push_nat(heap, b, n);
    return buffer.push(heap, b2, byte_of(unit));
}

pub fn duration_format[&h](heap: &!h Heap, seconds: int) -> [heap] result.Result[buffer.Buffer, &static [byte]] {
    if seconds < 0 { return result.Result::Err("negative duration"); }
    var b = buffer.empty(heap, 32);
    if seconds == 0 {
        b = buffer.push_nat(heap, b, 0);
        b = buffer.push(heap, b, byte_of(115));
        return result.Result::Ok(b);
    }
    var rest = seconds;
    b = put_part(heap, b, rest / 604800, 119);
    rest = rest % 604800;
    b = put_part(heap, b, rest / 86400, 100);
    rest = rest % 86400;
    b = put_part(heap, b, rest / 3600, 104);
    rest = rest % 3600;
    b = put_part(heap, b, rest / 60, 109);
    rest = rest % 60;
    b = put_part(heap, b, rest, 115);
    return result.Result::Ok(b);
}
