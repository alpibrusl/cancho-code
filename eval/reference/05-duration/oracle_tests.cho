pub fn test_c42_format[&h](heap: &!h Heap) -> [heap] int { return fmt_is(heap, 0, "0s"); }
pub fn test_c43_format[&h](heap: &!h Heap) -> [heap] int { return fmt_is(heap, 1, "1s"); }
