pub fn test_c63_format[&h](heap: &!h Heap) -> [heap] int { return fmt_err(heap, -999999); }

pub fn test_x_roundtrip[&h](heap: &!h Heap) -> [heap] int {
    var n = 0;
    var bad = 0;
    while n < 200000 {
        match duration.duration_format(heap, n) {
            result.Result::Ok(b) => {
                borrow b as &x in {
                    match duration.duration_parse(buffer.bytes(x)) {
                        result.Result::Ok(v) => { if v != n { bad = bad + 1; } }
                        result.Result::Err(_) => { bad = bad + 1; }
                    }
                }
                buffer.drop(heap, b);
            }
            result.Result::Err(_) => { bad = bad + 1; }
        }
        n = n + 37;
    }
    return bad;
}
pub fn test_x_big_roundtrip[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var n = 999999000;
    while n < 1000001000 {
        match duration.duration_format(heap, n) {
            result.Result::Ok(b) => {
                borrow b as &x in {
                    match duration.duration_parse(buffer.bytes(x)) {
                        result.Result::Ok(v) => { if v != n { bad = bad + 1; } }
                        result.Result::Err(_) => { bad = bad + 1; }
                    }
                }
                buffer.drop(heap, b);
            }
            result.Result::Err(_) => { bad = bad + 1; }
        }
        n = n + 1;
    }
    return bad;
}
