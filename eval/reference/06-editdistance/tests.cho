pub fn test_41_closest[&h](heap: &!h Heap) -> [heap] int {
    var l = vec.empty(heap, 5, "");
    l = vec.push(heap, l, "sitting");
    l = vec.push(heap, l, "mitten");
    l = vec.push(heap, l, "bitten");
    l = vec.push(heap, l, "kitchen");
    var code = 9;
    borrow l as &lb in {
        let r = editdistance.closest("kitten", lb);
        match r { option.Option::None => { code = 1; } option.Option::Some(s) => { if bytes_eq(s, "mitten") { code = 0; } else { code = 2; } } }
    }
    vec.drop(heap, l);
    return code;
}

pub fn test_42_closest[&h](heap: &!h Heap) -> [heap] int {
    var l = vec.empty(heap, 1, "");
    var code = 9;
    borrow l as &lb in {
        let r = editdistance.closest("abc", lb);
        match r { option.Option::None => { code = 0; } option.Option::Some(_) => { code = 1; } }
    }
    vec.drop(heap, l);
    return code;
}

