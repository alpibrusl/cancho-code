edition 7;
module tests;
import std.option;
import std.vec;
import std.test;
import editdistance;

fn bytes_eq[&r, &s](a: &r [byte], b: &s [byte]) -> [] bool {
    if len(a) != len(b) { return false; }
    var i = 0;
    while i < len(a) { if a[i] != b[i] { return false; } i = i + 1; }
    return true;
}

pub fn test_01_edit_distance() -> [] int {
    test.assert_eq(editdistance.edit_distance("", ""), 0);
    return 0;
}

pub fn test_02_similarity_pct() -> [] int {
    test.assert_eq(editdistance.similarity_pct("", ""), 100);
    return 0;
}

