edition 7;
import std.option;

struct Allow { allowed: bool, tokens_milli: int, retry_ms: int }

fn bucket_refill(tokens_milli: int, last_ms: int, now_ms: int, capacity: int, per_sec: int) -> [] int {
    var t = tokens_milli;
    if now_ms > last_ms { t = tokens_milli + (now_ms - last_ms) * per_sec; }
    if t > capacity * 1000 { t = capacity * 1000; }
    return t;
}

fn bucket_take(tokens_milli: int, cost: int) -> [] option.Option[int] {
    if cost < 1 { return option.Option::None; }
    if tokens_milli < cost * 1000 { return option.Option::None; }
    return option.Option::Some(tokens_milli - cost * 1000);
}

fn retry_after_ms(tokens_milli: int, cost: int, per_sec: int, capacity: int) -> [] int {
    if cost < 1 { return -1; }
    if cost > capacity { return -1; }
    if tokens_milli >= cost * 1000 { return 0; }
    if per_sec <= 0 { return -1; }
    let missing = cost * 1000 - tokens_milli;
    return (missing + per_sec - 1) / per_sec;
}

fn bucket_allow(tokens_milli: int, last_ms: int, now_ms: int, capacity: int, per_sec: int, cost: int) -> [] Allow {
    let r = bucket_refill(tokens_milli, last_ms, now_ms, capacity, per_sec);
    if cost < 1 { return Allow { allowed: false, tokens_milli: r, retry_ms: -1 }; }
    if cost > capacity { return Allow { allowed: false, tokens_milli: r, retry_ms: -1 }; }
    match bucket_take(r, cost) {
        option.Option::Some(rem) => { return Allow { allowed: true, tokens_milli: rem, retry_ms: 0 }; }
        option.Option::None => { return Allow { allowed: false, tokens_milli: r, retry_ms: retry_after_ms(r, cost, per_sec, capacity) }; }
    }
}
