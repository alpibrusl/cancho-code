edition 7;

module build;

// `build` -- one command from a brief to a verified build (docs/build.md): the plan the agent writes (`--mode plan`, with its own
// retry rounds and the optional blind review), the plan check, the project driver (src/project.cho) over that plan, a report.
// It ends with one `[BUILD_VERDICT]` line and an exit code, and keeps `build.json` (the dashboard's file) current after each stage.
//
// Nothing here is new machinery: the plan agent is run the way the acceptance command is (`acceptance.run`: a shell command with
// the file appended, a deadline, bounded output), the plan is checked by `plan.check`, the build is `project.run_logged`. A killed
// run resumes because both steps leave their result in the work directory: a valid `plan.json` is not asked for again (but for a plan whose
// own test was the dead end of the run before, asked again once: dead_plan_test), `state.txt` keeps the units that verified.

import acceptance;
import plan;
import project;
import trail;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

// ---- small helpers --------------------------------------------------------

// The file `path` read whole (at most `cap` bytes), and whether it could be read.
fn slurp[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read("")] (buffer.Buffer, bool) {
    let store = box_slice(heap, cap, byte_of(0));
    var out = buffer.empty(heap, 16);
    var ok = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= 0 && n < cap {
            ok = true;
            out = buffer.append(heap, out, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    return (out, ok);
}

// How the plan in `src` stands: -1 when the plan check refuses it, else the number of units. With `show`, the check's report
// (its `[PLAN_ERROR]` lines and `[PLAN]` line) goes to the console and the log.
fn judge[&h, &i, &z, &l, &s, &b, &k](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], src: &s [byte], brief: &b [byte], show: bool, tool: &k [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    let (out, code) = plan.check_as(heap, src, project.tool_components(tool));
    if show {
        borrow out as &o in {
            project.tell(heap, io, fs, log, buffer.bytes(o));
        }
    }
    buffer.drop(heap, out);
    if code != 0 {
        return 0 - 1;
    }
    // A plan with `files` is cancho's module system (docs/multi-file.md): under a profile other than the default it is refused (docs/profile.md).
    if project.tool_profiled(tool) {
        var declared = 0;
        let pb = box_slice(heap, json.tape_len(src), 0);
        borrow mut pb as &!pw in {
            let ptape = contents(pw);
            json.parse(src, ptape);
            declared = plan.files_declared(src, ptape);
        }
        unbox_slice(heap, pb);
        if declared > 0 {
            if show {
                project.tell(heap, io, fs, log, "[PLAN_ERROR]\tprofile-files\tfiles\ta plan with `files` is built only under the default profile (docs/profile.md): write every unit into the one entry file\n");
            }
            return 0 - 1;
        }
    }
    // The names the brief states must be the plan's: a plan that renames them builds a different API than the one asked for. The plan agent runs the
    // same check in each of its rounds (src/cancho_agent.cho); this one is the backstop for a plan.json that was not written by this run.
    // The brief's names are functions (`- name(...) : ...` bullets, declared `fn name`): a plan of components declares none, and is not held to them.
    var brief_len = len(brief);
    if project.tool_components(tool) {
        brief_len = 0;
    }
    let (brep, missing_count) = plan.brief_report(heap, brief[0..brief_len], src);
    if missing_count > 0 && show {
        borrow brep as &bq in {
            project.tell(heap, io, fs, log, buffer.bytes(bq));
        }
    }
    buffer.drop(heap, brep);
    if missing_count > 0 {
        return 0 - 1;
    }
    var units = 0;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        units = json.count(tape, json.get(src, tape, 0, "units"));
    }
    unbox_slice(heap, tb);
    return units;
}

// The scaffold of project.cho: `edition 7;` and the standard modules the plan's signatures name (the same rule as eval/run_item.py).
fn scaffold[&h, &s](heap: &!h Heap, src: &s [byte]) -> [heap] buffer.Buffer {
    var has_result = false;
    var has_buffer = false;
    var has_option = false;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        let units = json.get(src, tape, 0, "units");
        var j = units + 1;
        var left = json.count(tape, units);
        while left > 0 {
            let sig = json.string_view(src, tape, json.get(src, tape, j, "signature"));
            if bytes.find(sig, "result.") >= 0 {
                has_result = true;
            }
            if bytes.find(sig, "buffer.") >= 0 {
                has_buffer = true;
            }
            if bytes.find(sig, "option.") >= 0 {
                has_option = true;
            }
            j = json.skip(tape, j);
            left = left - 1;
        }
    }
    unbox_slice(heap, tb);
    var b = buffer.append(heap, buffer.empty(heap, 128), "edition 7;\n");
    // a plan with files declares the imports of each file, and the project driver writes them (docs/multi-file.md)
    var declared = 0;
    let fb = box_slice(heap, json.tape_len(src), 0);
    borrow mut fb as &!fw in {
        let ftape = contents(fw);
        json.parse(src, ftape);
        declared = plan.files_declared(src, ftape);
    }
    unbox_slice(heap, fb);
    if declared > 0 {
        return b;
    }
    if has_result {
        b = buffer.append(heap, b, "import std.result;\n");
    }
    if has_buffer {
        b = buffer.append(heap, b, "import std.buffer;\n");
    }
    if has_option {
        b = buffer.append(heap, b, "import std.option;\n");
    }
    return b;
}

// Create project.cho (the profile's entry) from the scaffold when there is none (a resumed run keeps the one it has). The scaffold is cancho's:
// a profile whose units are components (another language, docs/profile.md) starts from an empty entry.
fn make_project[&h, &z, &w, &s, &k](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], src: &s [byte], tool: &k [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let path = project.in_wd(heap, wd, project.tool_entry(tool), "", "");
    var r = 0;
    borrow path as &pb in {
        let (old, ok) = slurp(heap, fs, buffer.bytes(pb), 16777216);
        buffer.drop(heap, old);
        if ok == false && project.tool_components(tool) {
            r = project.put(heap, fs, buffer.bytes(pb), buffer.empty(heap, 8));
        } else if ok == false {
            r = project.put(heap, fs, buffer.bytes(pb), scaffold(heap, src));
        }
    }
    buffer.drop(heap, path);
    return r;
}

// The units `state.txt` says verified: its `verified <id>` lines.
fn count_verified[&h, &z, &w](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte]) -> [heap, fs_read("")] int {
    let path = project.in_wd(heap, wd, "state.txt", "", "");
    var n = 0;
    borrow path as &pb in {
        let (text, ok) = slurp(heap, fs, buffer.bytes(pb), 1048576);
        borrow text as &tb in {
            let all = buffer.bytes(tb);
            var i = 0;
            while i < len(all) {
                if bytes.starts_with(all[i..len(all)], "verified ") {
                    n = n + 1;
                }
                while i < len(all) && int_of(all[i]) != 10 {
                    i = i + 1;
                }
                i = i + 1;
            }
        }
        buffer.drop(heap, text);
    }
    buffer.drop(heap, path);
    return n;
}

// What the plan's review came to, read from the plan agent's output in `plan.log`: "unreviewed" (the review gave no usable answer, so the plan's
// cases were kept without a second reader), "reviewed" (a review ran and its report is there), "none" (no review, or no plan.log).
fn review_state[&h, &z, &w](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte]) -> [heap, fs_read("")] &static [byte] {
    let lp = project.in_wd(heap, wd, "plan.log", "", "");
    var state = "none";
    borrow lp as &lb in {
        let (text, ok) = slurp(heap, fs, buffer.bytes(lb), 1048576);
        if ok {
            borrow text as &tb in {
                if bytes.find(buffer.bytes(tb), "the plan stands unreviewed") >= 0 {
                    state = "unreviewed";
                } else if bytes.find(buffer.bytes(tb), "[REVIEW]\tkept ") >= 0 {
                    state = "reviewed";
                }
            }
        }
        buffer.drop(heap, text);
    }
    buffer.drop(heap, lp);
    return state;
}

// `build.json`: the one file the dashboard reads for the run as a whole. Written whole, after each stage.
fn write_state[&h, &z, &w, &b, &p, &m, &v, &rt, &pt](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], brief: &b [byte], stage: &static [byte], valid: bool, total: int, verified: int, verdict: &v [byte], started_ms: int, now_ms: int, provider: &p [byte], model: &m [byte], retry: &rt [byte], patch: &pt [byte]) -> [heap, fs_read(""), fs_write("")] int {
    var j = json.writer(heap, 512);
    j = json.begin_object(heap, j);
    j = json.put_key(heap, j, "brief");
    j = json.put_string(heap, j, brief);
    j = json.put_key(heap, j, "stage");
    j = json.put_string(heap, j, stage);
    j = json.put_key(heap, j, "plan_valid");
    j = json.put_bool(heap, j, valid);
    j = json.put_key(heap, j, "units_total");
    j = json.put_int(heap, j, total);
    j = json.put_key(heap, j, "units_verified");
    j = json.put_int(heap, j, verified);
    j = json.put_key(heap, j, "verdict");
    j = json.put_string(heap, j, verdict);
    j = json.put_key(heap, j, "started_unix");
    j = json.put_int(heap, j, started_ms / 1000);
    j = json.put_key(heap, j, "seconds");
    j = json.put_int(heap, j, (now_ms - started_ms) / 1000);
    j = json.put_key(heap, j, "provider");
    j = json.put_string(heap, j, provider);
    j = json.put_key(heap, j, "model");
    j = json.put_string(heap, j, model);
    j = json.put_key(heap, j, "review");
    j = json.put_string(heap, j, review_state(heap, fs, wd));
    // the unit the person re-opened in this invocation (docs/build.md `--retry`, `--patch`), when they did
    if len(retry) > 0 {
        j = json.put_key(heap, j, "retry");
        j = json.put_string(heap, j, retry);
    }
    if len(patch) > 0 {
        j = json.put_key(heap, j, "patch");
        j = json.put_string(heap, j, patch);
    }
    j = json.end_object(heap, j);
    var text = json.finish(j);
    text = buffer.push(heap, text, byte_of(10));
    let path = project.in_wd(heap, wd, "build.json", "", "");
    var r = -1;
    borrow path as &pb in {
        r = project.put(heap, fs, buffer.bytes(pb), text);
    }
    buffer.drop(heap, path);
    return r;
}

// The plan agent's command: the caller's agent command, the provider and model (the agent has no default for either), then
// `--mode plan` with the guide and the brief; the file appended by `acceptance.run` is the plan's path.
fn plan_command[&h, &a, &p, &m, &g, &r, &c, &w, &k](heap: &!h Heap, agent: &a [byte], provider: &p [byte], model: &m [byte], guide: &g [byte], brief: &k [byte], review_guide: &r [byte], contract: &c [byte], rounds: int, review: bool, wd: &w [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 512), agent);
    b = buffer.append(heap, b, " --provider ");
    b = buffer.append(heap, b, provider);
    b = buffer.append(heap, b, " --model ");
    b = buffer.append(heap, b, model);
    b = buffer.append(heap, b, " --mode plan --guide ");
    b = buffer.append(heap, b, guide);
    b = buffer.append(heap, b, " --brief ");
    b = buffer.append(heap, b, brief);
    if len(contract) > 0 {
        b = buffer.append(heap, b, " --contract ");
        b = buffer.append(heap, b, contract);
    }
    b = buffer.append(heap, b, " --rounds ");
    b = buffer.push_nat(heap, b, rounds);
    if review {
        b = buffer.append(heap, b, " --review on --review-guide ");
        b = buffer.append(heap, b, review_guide);
    }
    b = buffer.append(heap, b, " --usage-log ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/usage.jsonl --journal ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/journal");
    return b;
}

// The agent for the units: the caller's agent command, the provider, the model and the usage log (the project driver appends the file).
fn unit_command[&h, &a, &p, &m, &w](heap: &!h Heap, agent: &a [byte], provider: &p [byte], model: &m [byte], wd: &w [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 512), agent);
    b = buffer.append(heap, b, " --provider ");
    b = buffer.append(heap, b, provider);
    b = buffer.append(heap, b, " --model ");
    b = buffer.append(heap, b, model);
    b = buffer.append(heap, b, " --usage-log ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/usage.jsonl");
    return b;
}

// ---- the plan stage -------------------------------------------------------

// Ask the agent for a plan: 0 a plan was written (the caller judges it), 1 the agent gave up on the plan (rounds used up, or the
// model needs a decision), 2 the agent could not be reached (or did not answer in time). The agent's output is kept in plan.log.
fn ask_plan[&h, &x, &c, &z, &w, &k, &y](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &z Fs(""), wd: &w [byte], command: &k [byte], plan_path: &y [byte], plan_ms: int) -> [heap, exec(""), clock, poll, fs_write("")] int {
    let r = acceptance.run(heap, exec, clock, command, plan_path, 1048576, plan_ms);
    let acceptance.Result { held, why, said } = r;
    var status = 0;
    if held == 2 {
        status = 2;
    } else if held == 1 {
        status = 1;
        borrow said as &sb in {
            if bytes.find(buffer.bytes(sb), "cannot reach the API") >= 0 || bytes.find(buffer.bytes(sb), "HTTP error from the API") >= 0 {
                status = 2;
            }
        }
    }
    let lp = project.in_wd(heap, wd, "plan.log", "", "");
    borrow lp as &lb in {
        borrow said as &sb in {
            fs_write(fs, buffer.bytes(lb), buffer.bytes(sb));
        }
    }
    buffer.drop(heap, lp);
    buffer.drop(heap, why);
    buffer.drop(heap, said);
    return status;
}

// ---- the language profile (docs/profile.md) -------------------------------
//
// `--profile <file>` is read here, before anything else, and turned into the project driver's toolchain (`src/project.cho` `tool_get`): the
// checker's path, then one `key<TAB>value` line per field that differs from the default. A profile that states the default is the default:
// its toolchain is the checker's path alone.

// One `[PROFILE_ERROR]<TAB><tag><TAB><where><TAB><message>` line appended to `b`.
fn perr[&h, &w](heap: &!h Heap, b: buffer.Buffer, tag: &static [byte], at: &w [byte], msg: &static [byte]) -> [heap] buffer.Buffer {
    var r = buffer.append(heap, b, "[PROFILE_ERROR]\t");
    r = buffer.append(heap, r, tag);
    r = buffer.push(heap, r, byte_of(9));
    r = buffer.append(heap, r, at);
    r = buffer.push(heap, r, byte_of(9));
    r = buffer.append(heap, r, msg);
    return buffer.push(heap, r, byte_of(10));
}

// A byte of a word that goes into a shell command line: letters, digits and . _ + : = @ % , - (and `/` when `slash`).
fn word_byte(c: int, slash: bool) -> [] bool {
    return bytes.is_alpha(c) || bytes.is_digit(c) || c == 46 || c == 95 || c == 43 || c == 58 || c == 61 || c == 64 || c == 37 || c == 44 || c == 45 || (slash && c == 47);
}

fn word_ok[&a](text: &a [byte], slash: bool) -> [] bool {
    if len(text) == 0 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        if word_byte(int_of(text[i]), slash) == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Is `name` one of the space-separated words of `list`?
fn listed[&n](list: &static [byte], name: &n [byte]) -> [] bool {
    var a = 0;
    while a < len(list) {
        var e = a;
        while e < len(list) && int_of(list[e]) != 32 {
            e = e + 1;
        }
        if bytes.equal(list[a..e], name) {
            return true;
        }
        a = e + 1;
    }
    return false;
}

// The closed shape of the object at `obj`: a key `allowed` does not list is `profile-unknown-key`, a key it lists that is absent is
// `profile-missing-key`.
fn closed[&h, &s, &t](heap: &!h Heap, errs: buffer.Buffer, src: &s [byte], tape: &t [int], obj: int, allowed: &static [byte]) -> [heap] buffer.Buffer {
    var b = errs;
    var j = obj + 1;
    var left = json.count(tape, obj);
    while left > 0 {
        let k = json.string_view(src, tape, j);
        if listed(allowed, k) == false {
            b = perr(heap, b, "profile-unknown-key", k, "the schema has no such key (docs/profile.md)");
        }
        j = json.skip(tape, j + 1);
        left = left - 1;
    }
    var a = 0;
    while a < len(allowed) {
        var e = a;
        while e < len(allowed) && int_of(allowed[e]) != 32 {
            e = e + 1;
        }
        if json.get(src, tape, obj, allowed[a..e]) < 0 {
            b = perr(heap, b, "profile-missing-key", allowed[a..e], "every key of the schema is required (docs/profile.md)");
        }
        a = e + 1;
    }
    return b;
}

// The string under `key` of `obj` as written (an escaped string is not plain and never a word), and whether it is a string at all. A key that is
// absent is already `profile-missing-key`; one that is not a string is `profile-type` here.
fn text_of[&h, &s, &t](heap: &!h Heap, errs: buffer.Buffer, src: &s [byte], tape: &t [int], obj: int, key: &static [byte]) -> [heap] (buffer.Buffer, &s [byte], bool) {
    let n = json.get(src, tape, obj, key);
    if n < 0 {
        return (errs, src[0..0], false);
    }
    if json.is_string(tape, n) == false {
        return (perr(heap, errs, "profile-type", key, "a string is wanted"), src[0..0], false);
    }
    return (errs, json.string_view(src, tape, n), true);
}

// The words of the list under `key` of `obj`, joined by spaces, appended to `out` (empty when the list is not a list of words; the refusal is in `errs`).
fn words_of[&h, &s, &t](heap: &!h Heap, errs: buffer.Buffer, out: buffer.Buffer, src: &s [byte], tape: &t [int], obj: int, key: &static [byte]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var b = errs;
    var o = out;
    let n = json.get(src, tape, obj, key);
    if n < 0 {
        return (b, o);
    }
    if json.is_array(tape, n) == false || json.count(tape, n) == 0 {
        return (perr(heap, b, "profile-type", key, "a list of one or more words is wanted"), o);
    }
    var j = n + 1;
    var left = json.count(tape, n);
    var first = true;
    while left > 0 {
        if json.is_string(tape, j) == false {
            b = perr(heap, b, "profile-type", key, "every element is a string");
        } else if json.string_plain(tape, j) == false || word_ok(json.string_view(src, tape, j), false) == false {
            b = perr(heap, b, "profile-word", key, "a word holds only letters, digits and . _ + : = @ % , -");
        } else {
            if first == false {
                o = buffer.push(heap, o, byte_of(32));
            }
            o = buffer.append(heap, o, json.string_view(src, tape, j));
            first = false;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return (b, o);
}

// A file name of the profile: plain, no `/`, no `..`.
fn name_ok[&a](name: &a [byte]) -> [] bool {
    return word_ok(name, false) && bytes.find(name, "..") < 0;
}

// `key<TAB>value` on a line of its own after `tool`, when `value` is not the default `dflt`.
fn put_field[&h, &v](heap: &!h Heap, tool: buffer.Buffer, key: &static [byte], value: &v [byte], dflt: &static [byte]) -> [heap] buffer.Buffer {
    if bytes.equal(value, dflt) {
        return tool;
    }
    var r = buffer.push(heap, tool, byte_of(10));
    r = buffer.append(heap, r, key);
    r = buffer.push(heap, r, byte_of(9));
    return buffer.append(heap, r, value);
}

// Check the profile in `src` (docs/profile.md) and build the toolchain for `checker` from it: (toolchain, refusals). The refusals are empty
// exactly when the profile is good.
fn profile_parse[&h, &z, &s, &k](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], checker: &k [byte]) -> [heap, fs_read("")] (buffer.Buffer, buffer.Buffer) {
    var errs = buffer.empty(heap, 256);
    var tool = buffer.append(heap, buffer.empty(heap, 256), checker);
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        if json.parse(src, tape) < 0 || json.is_object(tape, 0) == false {
            errs = perr(heap, errs, "profile-json", "-", "a profile is one JSON object");
        } else {
            errs = closed(heap, errs, src, tape, 0, "profile name ext files commands units unit_tests findings primer");
            let (e1, version, v_ok) = text_of(heap, errs, src, tape, 0, "profile");
            errs = e1;
            if v_ok && bytes.equal(version, "cancho-build-profile/1") == false {
                errs = perr(heap, errs, "profile-version", "profile", "this build reads \"cancho-build-profile/1\"");
            }
            let (e2, pname, n_ok) = text_of(heap, errs, src, tape, 0, "name");
            errs = e2;
            if n_ok && word_ok(pname, false) == false {
                errs = perr(heap, errs, "profile-value", "name", "a non-empty word of letters, digits and . _ + : = @ % , -");
            } else if n_ok {
                // the language the task and the prompt name (src/project.cho `write_task`)
                tool = put_field(heap, tool, "name", pname, "cancho");
            }
            // units and unit_tests: words of the schema. This build runs two pairs: functions with examples (cancho's) and components with
            // traces (with no main file, below); the two mixed pairs are refused as not built yet.
            let (e3, units, u_ok) = text_of(heap, errs, src, tape, 0, "units");
            errs = e3;
            var comps = false;
            if u_ok && bytes.equal(units, "components") {
                comps = true;
                tool = put_field(heap, tool, "units", units, "functions");
            } else if u_ok && bytes.equal(units, "functions") == false {
                errs = perr(heap, errs, "profile-value", "units", "\"functions\" or \"components\"");
            }
            let (e4, ut, ut_ok) = text_of(heap, errs, src, tape, 0, "unit_tests");
            errs = e4;
            var trace = false;
            if ut_ok && bytes.equal(ut, "trace") {
                trace = true;
                tool = put_field(heap, tool, "unit_tests", ut, "examples");
            } else if ut_ok && bytes.equal(ut, "examples") == false {
                errs = perr(heap, errs, "profile-value", "unit_tests", "\"examples\" or \"trace\"");
            }
            if comps && ut_ok && trace == false && bytes.equal(ut, "examples") {
                errs = perr(heap, errs, "profile-not-implemented", "unit_tests", "\"components\" is built with \"trace\" only: a component has no examples (docs/profile.md, the next slices)");
            }
            if trace && u_ok && comps == false && bytes.equal(units, "functions") {
                errs = perr(heap, errs, "profile-not-implemented", "units", "\"trace\" is built with \"components\" only: a function unit has no trace (docs/profile.md, the next slices)");
            }
            // ext
            let (e5, ext, x_ok) = text_of(heap, errs, src, tape, 0, "ext");
            errs = e5;
            var ext_good = false;
            if x_ok {
                ext_good = len(ext) >= 2 && len(ext) <= 9 && int_of(ext[0]) == 46;
                var xi = 1;
                while ext_good && xi < len(ext) {
                    if bytes.is_alpha(int_of(ext[xi])) == false && bytes.is_digit(int_of(ext[xi])) == false {
                        ext_good = false;
                    }
                    xi = xi + 1;
                }
                if ext_good == false {
                    errs = perr(heap, errs, "profile-name", "ext", "`.` and 1 to 8 letters or digits");
                }
            }
            // files
            let fo = json.get(src, tape, 0, "files");
            if fo >= 0 && json.is_object(tape, fo) == false {
                errs = perr(heap, errs, "profile-type", "files", "an object is wanted");
            } else if fo >= 0 {
                errs = closed(heap, errs, src, tape, fo, "entry main tests");
                let (e6, entry, en_ok) = text_of(heap, errs, src, tape, fo, "entry");
                errs = e6;
                let (e7, mainf, m_ok) = text_of(heap, errs, src, tape, fo, "main");
                errs = e7;
                let (e8, tests, t_ok) = text_of(heap, errs, src, tape, fo, "tests");
                errs = e8;
                if en_ok {
                    if name_ok(entry) == false {
                        errs = perr(heap, errs, "profile-word", "entry", "a file name of letters, digits and . _ + : = @ % , -, no `/`, no `..`");
                    } else if ext_good && bytes.ends_with(entry, ext) == false {
                        errs = perr(heap, errs, "profile-name", "entry", "the entry ends in `ext`");
                    }
                }
                if m_ok && len(mainf) == 0 && comps == false {
                    errs = perr(heap, errs, "profile-not-implemented", "main", "\"\" (no main file) is built with \"components\" only: a cancho program is checked beside its fixed main (docs/profile.md, the next slices)");
                } else if m_ok && comps && len(mainf) > 0 {
                    errs = perr(heap, errs, "profile-not-implemented", "main", "\"components\" is built with no main file (\"\") only: the fixed main the build writes is cancho's (docs/profile.md, the next slices)");
                } else if m_ok && len(mainf) > 0 {
                    if name_ok(mainf) == false {
                        errs = perr(heap, errs, "profile-word", "main", "a file name of letters, digits and . _ + : = @ % , -, no `/`, no `..` (or \"\": none)");
                    } else if ext_good && bytes.ends_with(mainf, ext) == false {
                        errs = perr(heap, errs, "profile-name", "main", "the main file ends in `ext`");
                    } else if en_ok && bytes.equal(mainf, entry) {
                        errs = perr(heap, errs, "profile-name", "main", "the main file and the entry are two files");
                    }
                }
                if t_ok {
                    let at = bytes.find(tests, "{id}");
                    if at < 0 || bytes.find(tests[at + 4..len(tests)], "{id}") >= 0 {
                        errs = perr(heap, errs, "profile-name", "tests", "`{id}` exactly once: it is the unit's id");
                    } else if (at > 0 && name_ok(tests[0..at]) == false) || (at + 4 < len(tests) && name_ok(tests[at + 4..len(tests)]) == false) {
                        errs = perr(heap, errs, "profile-word", "tests", "a file name of letters, digits and . _ + : = @ % , -, no `/`, no `..`, and `{id}`");
                    } else if trace && bytes.ends_with(tests, ".json") == false {
                        errs = perr(heap, errs, "profile-name", "tests", "a trace ends in `.json`");
                    } else if trace == false && ext_good && bytes.ends_with(tests, ext) == false {
                        errs = perr(heap, errs, "profile-name", "tests", "the tests file ends in `ext`");
                    } else {
                        tool = put_field(heap, tool, "tests_pre", tests[0..at], "tests-");
                        tool = put_field(heap, tool, "tests_suf", tests[at + 4..len(tests)], ".cho");
                    }
                }
                if en_ok {
                    tool = put_field(heap, tool, "entry", entry, "project.cho");
                }
                if m_ok {
                    tool = put_field(heap, tool, "main", mainf, "main.cho");
                }
            }
            // commands
            let co = json.get(src, tape, 0, "commands");
            if co >= 0 && json.is_object(tape, co) == false {
                errs = perr(heap, errs, "profile-type", "commands", "an object is wanted");
            } else if co >= 0 {
                errs = closed(heap, errs, src, tape, co, "check compile test");
                let (e9, wc) = words_of(heap, errs, buffer.empty(heap, 64), src, tape, co, "check");
                errs = e9;
                borrow wc as &wcq in {
                    if len(buffer.bytes(wcq)) > 0 {
                        tool = put_field(heap, tool, "check", buffer.bytes(wcq), "check --std --output json --backend cranelift");
                    }
                }
                buffer.drop(heap, wc);
                let (e10, wp) = words_of(heap, errs, buffer.empty(heap, 64), src, tape, co, "compile");
                errs = e10;
                borrow wp as &wpq in {
                    if len(buffer.bytes(wpq)) > 0 {
                        tool = put_field(heap, tool, "compile", buffer.bytes(wpq), "check --std --backend cranelift");
                    }
                }
                buffer.drop(heap, wp);
                let (e11, wt) = words_of(heap, errs, buffer.empty(heap, 64), src, tape, co, "test");
                errs = e11;
                borrow wt as &wtq in {
                    if len(buffer.bytes(wtq)) > 0 {
                        tool = put_field(heap, tool, "test", buffer.bytes(wtq), "test --std --backend cranelift");
                    }
                }
                buffer.drop(heap, wt);
            }
            // findings
            let ko = json.get(src, tape, 0, "findings");
            if ko >= 0 && json.is_object(tape, ko) == false {
                errs = perr(heap, errs, "profile-type", "findings", "an object is wanted");
            } else if ko >= 0 {
                errs = closed(heap, errs, src, tape, ko, "key clean");
                let (e12, fkey, k_ok) = text_of(heap, errs, src, tape, ko, "key");
                errs = e12;
                if k_ok {
                    var kg = len(fkey) >= 1 && len(fkey) <= 32;
                    var ki = 0;
                    while kg && ki < len(fkey) {
                        if bytes.is_lower(int_of(fkey[ki])) == false && int_of(fkey[ki]) != 95 {
                            kg = false;
                        }
                        ki = ki + 1;
                    }
                    if kg {
                        tool = put_field(heap, tool, "key", fkey, "rule");
                    } else {
                        errs = perr(heap, errs, "profile-value", "findings.key", "1 to 32 of a-z and _");
                    }
                }
                let cn = json.get(src, tape, ko, "clean");
                if cn >= 0 && json.is_string(tape, cn) == false {
                    errs = perr(heap, errs, "profile-type", "clean", "a string is wanted");
                } else if cn >= 0 {
                    let cl = json.string_length(src, tape, cn);
                    if cl <= 0 || cl > 256 {
                        errs = perr(heap, errs, "profile-value", "findings.clean", "1 to 256 bytes, no tab, no newline");
                    } else {
                        let cb = box_slice(heap, cl, byte_of(0));
                        borrow mut cb as &!cw in {
                            json.string_into(src, tape, cn, contents(cw));
                            let ct = contents(cw);
                            if bytes.find(ct, "\t") >= 0 || bytes.find(ct, "\n") >= 0 || bytes.find(ct, "\r") >= 0 {
                                errs = perr(heap, errs, "profile-value", "findings.clean", "1 to 256 bytes, no tab, no newline");
                            } else {
                                tool = put_field(heap, tool, "clean", ct, "\"refused\": []");
                            }
                        }
                        unbox_slice(heap, cb);
                    }
                }
            }
            // primer
            let (e13, primer, p_ok) = text_of(heap, errs, src, tape, 0, "primer");
            errs = e13;
            if p_ok && len(primer) > 0 {
                if int_of(primer[0]) != 47 || word_ok(primer, true) == false || bytes.find(primer, "..") >= 0 {
                    errs = perr(heap, errs, "profile-value", "primer", "\"\" or an absolute path of letters, digits and . _ / + : = @ % , -, no `..`");
                } else {
                    let (pt, pread) = slurp(heap, fs, primer, 16777216);
                    buffer.drop(heap, pt);
                    if pread == false {
                        errs = perr(heap, errs, "profile-primer", "primer", "the primer cannot be read");
                    } else {
                        tool = put_field(heap, tool, "primer", primer, "");
                    }
                }
            }
        }
    }
    unbox_slice(heap, tb);
    return (tool, errs);
}

// The toolchain for `checker` under the profile in the file `path`: (toolchain, 0); or (the checker's path, 2) when the profile is refused, its
// `[PROFILE_ERROR]` lines on standard error. Nothing is written.
pub fn profile_tool[&h, &i, &z, &p, &k](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), path: &p [byte], checker: &k [byte]) -> [heap, fs_read(""), err_write] (buffer.Buffer, int) {
    let (text, ok) = slurp(heap, fs, path, 65537);
    var tool = buffer.empty(heap, 8);
    var errs = buffer.empty(heap, 64);
    var size = 0;
    borrow text as &tq in {
        size = len(buffer.bytes(tq));
        if ok && size > 0 && size <= 65536 {
            let (t2, e2) = profile_parse(heap, fs, buffer.bytes(tq), checker);
            buffer.drop(heap, tool);
            buffer.drop(heap, errs);
            tool = t2;
            errs = e2;
        }
    }
    buffer.drop(heap, text);
    if ok == false || size == 0 || size > 65536 {
        errs = perr(heap, errs, "profile-unreadable", path, "the profile cannot be read, is empty, or is larger than 64 KiB");
    }
    var status = 0;
    borrow errs as &eq in {
        if len(buffer.bytes(eq)) > 0 {
            io.error_all(io, buffer.bytes(eq));
            status = 2;
        }
    }
    buffer.drop(heap, errs);
    if status != 0 {
        buffer.drop(heap, tool);
        return (buffer.append(heap, buffer.empty(heap, 64), checker), 2);
    }
    return (tool, 0);
}

// ---- a plan whose own test was the dead end ---------------------------------

// Whether `name` is a test the plan `src` gives unit `unit`: one of the unit's own `tests` (`pub fn <name>(` or `pub fn <name>[`), or, for a unit
// without them, the test the project driver writes for its k-th example (`test_<id>_<k>`, src/project.cho `write_tests`).
fn plan_has_test[&h, &s, &u, &n](heap: &!h Heap, src: &s [byte], unit: &u [byte], name: &n [byte]) -> [heap] bool {
    var found = false;
    var paren = buffer.append(heap, buffer.empty(heap, 64), "pub fn ");
    paren = buffer.append(heap, paren, name);
    var bracket = buffer.append(heap, buffer.empty(heap, 64), "pub fn ");
    bracket = buffer.append(heap, bracket, name);
    paren = buffer.append(heap, paren, "(");
    bracket = buffer.append(heap, bracket, "[");
    // the example tests' prefix: `test_`, the id with every byte but a letter, a digit or `_` made `_`, and `_`
    var prefix = buffer.append(heap, buffer.empty(heap, 32), "test_");
    var q = 0;
    while q < len(unit) {
        let c = int_of(unit[q]);
        if bytes.is_alpha(c) || bytes.is_digit(c) || c == 95 {
            prefix = buffer.push(heap, prefix, unit[q]);
        } else {
            prefix = buffer.push(heap, prefix, byte_of(95));
        }
        q = q + 1;
    }
    prefix = buffer.append(heap, prefix, "_");
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        if json.parse(src, tape) > 0 {
            let us = json.get(src, tape, 0, "units");
            var j = us + 1;
            var left = json.count(tape, us);
            while left > 0 {
                if json.string_equals(src, tape, json.get(src, tape, j, "id"), unit) {
                    let rt = json.get(src, tape, j, "tests");
                    var raw = 0;
                    if rt >= 0 {
                        raw = json.count(tape, rt);
                    }
                    if raw > 0 {
                        var k = rt + 1;
                        var rl = raw;
                        while rl > 0 {
                            let t = trail.add_string(heap, buffer.empty(heap, 128), src, tape, k);
                            borrow t as &tq in {
                                borrow paren as &pq in {
                                    borrow bracket as &bq in {
                                        if bytes.find(buffer.bytes(tq), buffer.bytes(pq)) >= 0 || bytes.find(buffer.bytes(tq), buffer.bytes(bq)) >= 0 {
                                            found = true;
                                        }
                                    }
                                }
                            }
                            buffer.drop(heap, t);
                            k = json.skip(tape, k);
                            rl = rl - 1;
                        }
                    } else {
                        let examples = json.count(tape, json.get(src, tape, j, "examples"));
                        borrow prefix as &xq in {
                            let px = buffer.bytes(xq);
                            if len(name) > len(px) && bytes.starts_with(name, px) {
                                var n = 0;
                                var digits = true;
                                var p = len(px);
                                while p < len(name) {
                                    let d = bytes.digit_of(int_of(name[p]));
                                    if d < 0 || n > 100000 {
                                        digits = false;
                                    } else {
                                        n = n * 10 + d;
                                    }
                                    p = p + 1;
                                }
                                if digits && n >= 1 && n <= examples {
                                    found = true;
                                }
                            }
                        }
                    }
                }
                j = json.skip(tape, j);
                left = left - 1;
            }
        }
    }
    unbox_slice(heap, tb);
    buffer.drop(heap, paren);
    buffer.drop(heap, bracket);
    buffer.drop(heap, prefix);
    return found;
}

// `<unit><TAB><test>` when the plan about to be reused (`plan_src`) was the dead end of the run before, else empty. All of, for the last run the
// journal (`jdir`) holds before this one (its `run_start` .. this run's `run_start`): it ended `stuck`; a unit's last attempt failed a test of
// this plan (signature `acceptance:test <name> ... FAILED`, not a test file that did not compile) on code that compiled (`acceptance_failed`),
// the same way twice (decision `signature`); that run built exactly this plan (its `plan_final` blob is these bytes: a plan the person edited
// since is theirs); and no plan of this work directory was replaced before (`plan_replaced`: one re-plan per work directory).
fn dead_plan_test[&h, &z, &d, &s](heap: &!h Heap, fs: &z Fs(""), jdir: &d [byte], plan_src: &s [byte]) -> [heap, fs_read("")] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    var stuck = false;
    var cand_unit = buffer.empty(heap, 32);
    var cand_test = buffer.empty(heap, 32);
    var plan_blob = buffer.empty(heap, 32);
    let ep = trail.path_under(heap, jdir, "events.jsonl", "");
    borrow ep as &eq in {
        // the journal stops growing at 2 MiB (trail.journal_emit); a run may add one line past it
        let (evs, evs_ok) = slurp(heap, fs, buffer.bytes(eq), 4194304);
        borrow evs as &evb in {
            let all = buffer.bytes(evb);
            // where the last two runs began: the one before this, and this one (its run_start was just written)
            var prev_rs = 0 - 1;
            var cur_rs = 0 - 1;
            var i = 0;
            while evs_ok && i < len(all) {
                var e = i;
                while e < len(all) && int_of(all[e]) != 10 {
                    e = e + 1;
                }
                if bytes.find(all[i..e], "\"kind\":\"run_start\"") >= 0 {
                    prev_rs = cur_rs;
                    cur_rs = i;
                }
                i = e + 1;
            }
            if evs_ok && prev_rs >= 0 && bytes.find(all, "\"kind\":\"plan_replaced\"") < 0 {
                i = prev_rs;
                while i < cur_rs {
                    var e = i;
                    while e < cur_rs && int_of(all[e]) != 10 {
                        e = e + 1;
                    }
                    let line = all[i..e];
                    let is_end = bytes.find(line, "\"kind\":\"run_end\"") >= 0;
                    let is_plan = bytes.find(line, "\"kind\":\"plan_final\"") >= 0;
                    let is_attempt = bytes.find(line, "\"kind\":\"attempt\"") >= 0;
                    if is_end || is_plan || is_attempt {
                        let tb = box_slice(heap, json.tape_len(line), 0);
                        borrow mut tb as &!tw in {
                            let tape = contents(tw);
                            if json.parse(line, tape) > 0 {
                                if is_end {
                                    stuck = json.string_equals(line, tape, json.get(line, tape, 0, "verdict"), "stuck");
                                } else if is_plan {
                                    buffer.drop(heap, plan_blob);
                                    plan_blob = trail.add_string(heap, buffer.empty(heap, 32), line, tape, json.get(line, tape, 0, "plan"));
                                } else {
                                    let un = json.get(line, tape, 0, "unit");
                                    // a later attempt of the candidate's unit is its last one now
                                    var same = false;
                                    borrow cand_unit as &cu in {
                                        same = len(buffer.bytes(cu)) > 0 && json.string_equals(line, tape, un, buffer.bytes(cu));
                                    }
                                    if same {
                                        buffer.drop(heap, cand_unit);
                                        buffer.drop(heap, cand_test);
                                        cand_unit = buffer.empty(heap, 32);
                                        cand_test = buffer.empty(heap, 32);
                                    }
                                    let sig = trail.add_string(heap, buffer.empty(heap, 64), line, tape, json.get(line, tape, 0, "signature"));
                                    var name_at = 0 - 1;
                                    var name_end = 0 - 1;
                                    borrow sig as &sq in {
                                        let s = buffer.bytes(sq);
                                        let head = "acceptance:test ";
                                        if json.string_equals(line, tape, json.get(line, tape, 0, "outcome"), "acceptance_failed")
                                            && json.string_equals(line, tape, json.get(line, tape, 0, "decision"), "signature")
                                            && bytes.starts_with(s, head) && bytes.ends_with(s, " FAILED") {
                                            name_at = len(head);
                                            name_end = name_at;
                                            while name_end < len(s) && int_of(s[name_end]) != 32 {
                                                name_end = name_end + 1;
                                            }
                                        }
                                    }
                                    if name_end > name_at && name_at > 0 {
                                        buffer.drop(heap, cand_unit);
                                        buffer.drop(heap, cand_test);
                                        cand_unit = trail.add_string(heap, buffer.empty(heap, 32), line, tape, un);
                                        borrow sig as &sq2 in {
                                            cand_test = buffer.append(heap, buffer.empty(heap, 32), buffer.bytes(sq2)[name_at..name_end]);
                                        }
                                    }
                                    buffer.drop(heap, sig);
                                }
                            }
                        }
                        unbox_slice(heap, tb);
                    }
                    i = e + 1;
                }
            }
        }
        buffer.drop(heap, evs);
    }
    buffer.drop(heap, ep);
    // the rule's last two parts: the unit's test is one of this plan's, and that run's plan is this one, byte for byte
    var holds = false;
    borrow cand_unit as &cu in {
        borrow cand_test as &ct in {
            borrow plan_blob as &pb in {
                let u = buffer.bytes(cu);
                let t = buffer.bytes(ct);
                if stuck && len(u) > 0 && len(t) > 0 && len(buffer.bytes(pb)) > 0 && plan_has_test(heap, plan_src, u, t) {
                    let bp = trail.blob_path(heap, jdir, buffer.bytes(pb));
                    borrow bp as &bpq in {
                        let (was, was_ok) = slurp(heap, fs, buffer.bytes(bpq), 1048576);
                        borrow was as &wq in {
                            holds = was_ok && bytes.equal(buffer.bytes(wq), plan_src);
                        }
                        buffer.drop(heap, was);
                    }
                    buffer.drop(heap, bp);
                }
                if holds {
                    out = buffer.append(heap, out, u);
                    out = buffer.push(heap, out, byte_of(9));
                    out = buffer.append(heap, out, t);
                }
            }
        }
    }
    buffer.drop(heap, cand_unit);
    buffer.drop(heap, cand_test);
    buffer.drop(heap, plan_blob);
    return out;
}

// ---- the run --------------------------------------------------------------

// What a verdict word is as an exit code.
fn code_of(word: &static [byte]) -> [] int {
    if bytes.equal(word, "done") {
        return 0;
    }
    if bytes.equal(word, "plan_failed") {
        return 3;
    }
    if bytes.equal(word, "provider_error") {
        return 4;
    }
    return 1;
}

// End the run: `build.json` with the verdict (stage `done`), then the `[BUILD_VERDICT]` line.
fn finish[&h, &i, &z, &l, &w, &b, &p, &m, &rt, &pt](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], wd: &w [byte], brief: &b [byte], valid: bool, total: int, verdict: &static [byte], started_ms: int, now_ms: int, provider: &p [byte], model: &m [byte], retry: &rt [byte], patch: &pt [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    write_state(heap, fs, wd, brief, "done", valid, total, count_verified(heap, fs, wd), verdict, started_ms, now_ms, provider, model, retry, patch);
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        trail.run_end(heap, now_ms, fs, buffer.bytes(jq), verdict, code_of(verdict), (now_ms - started_ms) / 1000);
    }
    buffer.drop(heap, jd);
    var line = buffer.append(heap, buffer.empty(heap, 64), "[BUILD_VERDICT]\t");
    line = buffer.append(heap, line, verdict);
    line = buffer.append(heap, line, "\n");
    borrow line as &lb in {
        project.tell(heap, io, fs, log, buffer.bytes(lb));
    }
    buffer.drop(heap, line);
    return code_of(verdict);
}

// Build `brief` in `wd`: 0 done, 1 stuck or the final gate failed, 2 usage, 3 plan_failed, 4 provider_error. `guide` and `review_guide`
// are the plan agent's (empty: none); an empty `contract` is none. With a valid plan.json already in `wd` the plan agent is not asked, unless
// that plan's own test was the dead end of the run before (dead_plan_test; once per work directory).
pub fn run[&h, &x, &c, &i, &z, &k, &b, &w, &a, &p, &m, &g, &r, &q, &rt, &ht, &pt, &pf, &av](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), checker: &k [byte], brief: &b [byte], wd: &w [byte], agent: &a [byte], provider: &p [byte], model: &m [byte], guide: &g [byte], review_guide: &r [byte], contract: &q [byte], review: bool, rounds: int, attempts: int, agent_ms: int, plan_ms: int, retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte], jobs: int, argv0: &av [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, err_write, pipe_read, child_signal] int {
    let started = clock_unix_ms(clock);
    let logp = project.in_wd(heap, wd, "run.log", "", "");
    let planp = project.in_wd(heap, wd, "plan.json", "", "");
    var status = 2;
    borrow logp as &lgb in {
        borrow planp as &ppb in {
            let lg = buffer.bytes(lgb);
            let pp = buffer.bytes(ppb);
            // The brief's text: the names it requires are checked against every plan (judge).
            let (brief_text, brief_read) = slurp(heap, fs, brief, 1048576);
            borrow brief_text as &btb in {
            let bt = buffer.bytes(btb);
            // A unit the person re-opens (`--retry`, `--patch`) must be in the plan the earlier run left; this is settled before anything is written.
            var redo_bad = false;
            if len(retry) > 0 || len(patch) > 0 {
                let (prior, prior_ok) = slurp(heap, fs, pp, 1048576);
                var prior_units = 0 - 1;
                if prior_ok {
                    borrow prior as &prb in {
                        prior_units = judge(heap, io, fs, lg, buffer.bytes(prb), bt, false, checker);
                        if prior_units >= 0 && project.redo_check(heap, io, fs, buffer.bytes(prb), retry, patch, pfile) != 0 {
                            redo_bad = true;
                        }
                    }
                }
                buffer.drop(heap, prior);
                if prior_units < 0 {
                    io.error_all(io, "build: --retry and --patch continue an earlier run: there is no valid plan.json in the work directory\n");
                    redo_bad = true;
                }
            }
            // The work directory must exist: the log is the first thing written.
            if redo_bad {
                status = 2;
            } else if project.append_file(heap, fs, lg, "") < 0 {
                io.error_all(io, "build: the work directory cannot be written\n");
            } else {
                let jd = trail.journal_dir(heap, wd);
                borrow jd as &jq in {
                    trail.journal_dirs(heap, exec, clock, buffer.bytes(jq));
                    trail.run_start(heap, clock, fs, buffer.bytes(jq), brief, provider, model, review, rounds, attempts, agent_ms, plan_ms);
                }
                buffer.drop(heap, jd);
                // A plan.json from an earlier run that the check accepts is kept, unless its own test was the dead end of the run before:
                // then, once per work directory, the plan agent is asked again (dead_plan_test). Not when the person continues a unit
                // (`--retry`, `--patch`), and not without a guide to ask with.
                let (old, readable) = slurp(heap, fs, pp, 1048576);
                var units = 0 - 1;
                if readable {
                    borrow old as &ob in {
                        units = judge(heap, io, fs, lg, buffer.bytes(ob), bt, false, checker);
                        if units >= 0 && len(retry) == 0 && len(patch) == 0 && len(guide) > 0 {
                            let jd3 = trail.journal_dir(heap, wd);
                            borrow jd3 as &jq3 in {
                                let dead = dead_plan_test(heap, fs, buffer.bytes(jq3), buffer.bytes(ob));
                                borrow dead as &dq in {
                                    let dt = buffer.bytes(dq);
                                    if len(dt) > 0 {
                                        var said = buffer.append(heap, buffer.empty(heap, 96), "[BUILD_STAGE]\tplan\treplaced\t");
                                        said = buffer.append(heap, said, dt);
                                        said = buffer.append(heap, said, "\n");
                                        borrow said as &sq in {
                                            project.tell(heap, io, fs, lg, buffer.bytes(sq));
                                        }
                                        buffer.drop(heap, said);
                                        trail.plan_replaced(heap, clock, fs, buffer.bytes(jq3), bytes.field(dt, 9, 1), bytes.field(dt, 9, 2));
                                        units = 0 - 1;
                                    }
                                }
                                buffer.drop(heap, dead);
                            }
                            buffer.drop(heap, jd3);
                        }
                    }
                }
                buffer.drop(heap, old);
                var provider_away = false;
                var asked = false;
                if units >= 0 {
                    project.tell(heap, io, fs, lg, "[BUILD_STAGE]\tplan\treused\n");
                } else if len(guide) == 0 {
                    io.error_all(io, "build: there is no valid plan.json in the work directory, and no --guide to ask for one\n");
                    status = 2;
                } else {
                    asked = true;
                    write_state(heap, fs, wd, brief, "plan", false, 0, count_verified(heap, fs, wd), "", started, clock_unix_ms(clock), provider, model, retry, patch);
                    project.tell(heap, io, fs, lg, "[BUILD_STAGE]\tplan\n");
                    // A plan.json that is not valid is emptied first, so that what is there afterwards is what this agent wrote.
                    fs_write(fs, pp, "");
                    let command = plan_command(heap, agent, provider, model, guide, brief, review_guide, contract, rounds, review, wd);
                    var asked_status = 1;
                    borrow command as &cb in {
                        asked_status = ask_plan(heap, exec, clock, fs, wd, buffer.bytes(cb), pp, plan_ms);
                    }
                    buffer.drop(heap, command);
                    // the review's outcome is part of the run's record, whichever it was: a plan kept without a second reader says so
                    let rv = review_state(heap, fs, wd);
                    if bytes.equal(rv, "unreviewed") {
                        project.tell(heap, io, fs, lg, "[PLAN_REVIEW]\tunreviewed\n");
                    } else if bytes.equal(rv, "reviewed") {
                        project.tell(heap, io, fs, lg, "[PLAN_REVIEW]\treviewed\n");
                    }
                    if asked_status == 2 {
                        provider_away = true;
                    } else {
                        let (fresh, readable2) = slurp(heap, fs, pp, 1048576);
                        if readable2 && asked_status == 0 {
                            borrow fresh as &fb in {
                                units = judge(heap, io, fs, lg, buffer.bytes(fb), bt, true, checker);
                            }
                        }
                        buffer.drop(heap, fresh);
                    }
                }
                // The plan agent's plan, valid: a unit that thinks long and has no `effort` gets `medium` (plan.tier_efforts, docs/plan.md "Effort tiers").
                // Only a plan asked for just now: a plan.json that was already there is the operator's (or an earlier run's, already tiered), and is kept.
                if asked && units >= 0 {
                    let (cur, cur_ok) = slurp(heap, fs, pp, 1048576);
                    borrow cur as &cb2 in {
                        if cur_ok {
                            let (tiered, tier_n) = plan.tier_efforts(heap, buffer.bytes(cb2));
                            if tier_n > 0 {
                                borrow tiered as &tdq in {
                                    fs_write(fs, pp, buffer.bytes(tdq));
                                }
                                var tsaid = buffer.append(heap, buffer.empty(heap, 64), "[BUILD_STAGE]\tplan\ttiered\t");
                                tsaid = buffer.push_nat(heap, tsaid, tier_n);
                                tsaid = buffer.append(heap, tsaid, "\n");
                                borrow tsaid as &tsq in {
                                    project.tell(heap, io, fs, lg, buffer.bytes(tsq));
                                }
                                buffer.drop(heap, tsaid);
                            }
                            buffer.drop(heap, tiered);
                        }
                    }
                    buffer.drop(heap, cur);
                }
                if provider_away == false && (asked || units >= 0) {
                    let jd2 = trail.journal_dir(heap, wd);
                    var counted = units;
                    if counted < 0 {
                        counted = 0;
                    }
                    borrow jd2 as &jq2 in {
                        trail.plan_final(heap, clock, fs, buffer.bytes(jq2), units >= 0, counted, pp);
                    }
                    buffer.drop(heap, jd2);
                }
                if provider_away {
                    status = finish(heap, io, fs, lg, wd, brief, false, 0, "provider_error", started, clock_unix_ms(clock), provider, model, retry, patch);
                } else if units < 0 && asked {
                    status = finish(heap, io, fs, lg, wd, brief, false, 0, "plan_failed", started, clock_unix_ms(clock), provider, model, retry, patch);
                } else if units >= 0 {
                    // The plan is valid: the build stage.
                    let (text, readable3) = slurp(heap, fs, pp, 1048576);
                    borrow text as &tb in {
                        let src = buffer.bytes(tb);
                        if make_project(heap, fs, wd, src, checker) < 0 {
                            io.error_all(io, "build: the work directory cannot be written\n");
                        } else {
                            write_state(heap, fs, wd, brief, "build", true, units, count_verified(heap, fs, wd), "", started, clock_unix_ms(clock), provider, model, retry, patch);
                            project.tell(heap, io, fs, lg, "[BUILD_STAGE]\tbuild\n");
                            let unit_agent = unit_command(heap, agent, provider, model, wd);
                            var code = 2;
                            borrow unit_agent as &ua in {
                                code = project.run_logged(heap, exec, clock, io, fs, src, checker, wd, buffer.bytes(ua), attempts, agent_ms, lg, "", "", retry, hint, patch, pfile, project.Par { jobs: jobs, settle: 300, warm: asked }, argv0);
                            }
                            buffer.drop(heap, unit_agent);
                            if code == 0 {
                                status = finish(heap, io, fs, lg, wd, brief, true, units, "done", started, clock_unix_ms(clock), provider, model, retry, patch);
                            } else if code == 4 {
                                status = finish(heap, io, fs, lg, wd, brief, true, units, "provider_error", started, clock_unix_ms(clock), provider, model, retry, patch);
                            } else if code == 5 {
                                status = finish(heap, io, fs, lg, wd, brief, true, units, "gate_failed", started, clock_unix_ms(clock), provider, model, retry, patch);
                            } else if code == 1 {
                                status = finish(heap, io, fs, lg, wd, brief, true, units, "stuck", started, clock_unix_ms(clock), provider, model, retry, patch);
                            } else if code == 3 {
                                status = finish(heap, io, fs, lg, wd, brief, false, 0, "plan_failed", started, clock_unix_ms(clock), provider, model, retry, patch);
                            }
                        }
                    }
                    buffer.drop(heap, text);
                }
            }
            }
            buffer.drop(heap, brief_text);
        }
    }
    buffer.drop(heap, logp);
    buffer.drop(heap, planp);
    return status;
}
