edition 7;

// `cancho-agent` — the agent the driver runs, written in cancho.
//
//     cancho-agent --provider anthropic --model <model> --key-file <path> \
//                  --host <name> --ip <a.b.c.d> --roots <pem> <project.cho>
//
// An agent is a command the driver runs with the project file as its last
// argument; it replaces that file with a better one, or exits non-zero and
// leaves it as it was. This one asks a model through `provider.exchange`
// (native TLS, no spawned `curl`, no Python), builds what it asks with
// `prompt`, reads the answer with `reply`, and writes only a program.
//
// **No provider and no model is ever assumed**: `--provider` and `--model`
// are required, and so is every name that decides where the key goes
// (`--host`, `--ip`, `--roots`). Resolving the name is the caller's
// (`provider.exchange`'s rule: a resolver is a policy); `scripts/cancho-agent.sh`
// is the thin wrapper that does it.
//
// Options (each `--name value`):
//   --provider      anthropic | ollama                           required
//   --model         the model, as the API spells it              required
//   --key-file      a file holding the API key                   required (anthropic)
//   --host          the API's name (certificate and Host:)       required
//   --ip            where that name resolves, as text            required
//   --roots         a PEM bundle of the CAs to trust             required (anthropic, or ollama with --tls on)
//   --port          the TCP port                                 (443; ollama 11434)
//   --tls           on | off                                     (on; ollama off)
//   --num-ctx       ollama's context window in tokens            (8192)
//   --num-predict   ollama's bound on one answer (= --max-tokens) (8192)
//   --max-tokens    the bound on one answer                      (8192); a reply cut off by it is asked again with the bound doubled (at most 32000)
//   --primer        a file with the language page, cached        (none)
//   --thinking      adaptive | disabled                          (the model's own)
//   --effort        low | medium | high | xhigh | max            (the model's own)
//   --workspace     a workspace id, for a key not scoped to one  (none)
//   --save-raw      a file every raw reply is appended to        (none)
//   --mode          edit (default): rewrite the project file; plan: ask for a PLAN (docs/plan.md) instead. In plan mode the last
//                   argument is where the plan is written, and --guide <file> (how to write a plan) and --brief <file> (the task)
//                   are required; --contract <file> (exact signatures) and --rounds N (3) are optional. The plan check
//                   (src/plan.cho, in process) decides: a rejected plan is fed back with its report; {"status": "unclear" |
//                   "too_big"} exits 3 and is saved as <out>.questions.json; nothing is written unless the check passes.
//   --output        file (default): the model returns the complete project file; patch: it returns only the code to ADD or CHANGE (a unit)
//                   and src/splice.cho splices it into the file (an item with the same name is replaced in place, a new one appended)
//   --review        off | on (off): after a plan passes the check, a SECOND call re-derives every case's expected value blind (from the
//                   description only) and a case survives only if the reviewer agrees (src/review.cho); needs --review-guide <file>
//   --usage-log     a file that gets one JSON line per API call: tokens in, out,
//                   cache write, cache read, stop reason, outcome, sizes, ms (none)
//
// Exit 0: the project file is the model's program. Exit 1: it was not
// changed (the model was unreachable, refused, or never produced a program).
// Exit 2: the command line was wrong; nothing was read or sent.

import anthropic;
import cases;
import ollama;
import plan;
import planprompt;
import prompt;
import provider;
import review;
import splice;
import reply;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

// ---- the command line ----------------------------------------------------

// The value after `--name`, or "" when the option is absent.
fn opt[&g](g: &g Args, name: &static [byte]) -> [args] &static [byte] {
    var found = "";
    var i = 1;
    while i + 1 < arg_count(g) {
        if bytes.equal(arg(g, i), name) {
            found = arg(g, i + 1);
        }
        i = i + 1;
    }
    return found;
}

fn number[&t](text: &t [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        n = n * 10 + int_of(text[i]) - 48;
        i = i + 1;
    }
    return n;
}

fn say[&i, &m](io: &!i Io, message: &m [byte]) -> [err_write] int {
    io.error_all(io, "cancho-agent: ");
    io.error_all(io, message);
    io.error_all(io, "\n");
    return 0;
}

// ---- files ---------------------------------------------------------------

// A file's bytes, on the heap; false when it cannot be read.
fn slurp[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read("")] (buffer.Buffer, bool) {
    let store = box_slice(heap, cap, byte_of(0));
    var out = buffer.empty(heap, 16);
    var ok = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= 0 {
            ok = true;
            out = buffer.append(heap, out, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    return (out, ok);
}

// `path` with `suffix` after it, on the heap.
fn with_suffix[&h, &p, &s](heap: &!h Heap, path: &p [byte], suffix: &s [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 256);
    b = buffer.append(heap, b, path);
    b = buffer.append(heap, b, suffix);
    return b;
}

fn trimmed_key[&t](text: &t [byte]) -> [] &t [byte] {
    var a = 0;
    var b = len(text);
    while a < b && (int_of(text[a]) == 32 || (int_of(text[a]) >= 9 && int_of(text[a]) <= 13)) {
        a = a + 1;
    }
    while b > a && (int_of(text[b - 1]) == 32 || (int_of(text[b - 1]) >= 9 && int_of(text[b - 1]) <= 13)) {
        b = b - 1;
    }
    return text[a..b];
}

// Every raw reply is kept whole, before anything is cut out of it: the trail
// records only the verdict on it. Appended by reading what is there and
// writing it back with the new reply.
fn save_raw[&h, &f, &p, &t, &s](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], text: &t [byte], why: &s [byte]) -> [heap, fs_read(""), fs_write("")] int {
    if len(path) == 0 {
        return 0;
    }
    let (old, ok) = slurp(heap, fs, path, 16777216);
    var all = old;
    all = buffer.append(heap, all, "=== reply (stopped because: ");
    all = buffer.append(heap, all, why);
    all = buffer.append(heap, all, ")\n");
    all = buffer.append(heap, all, text);
    all = buffer.append(heap, all, "\n");
    borrow all as &ar in {
        fs_write(fs, path, buffer.bytes(ar));
    }
    buffer.drop(heap, all);
    return 0;
}

// One JSON line per API call, whatever came of it: what the call cost in
// tokens, how it ended, and how big the reply and the program in it were.
// `thinking` is the part of `out` the model spent thinking, as the API reports it (0 when it does not).
// `outcome` is written | cut_off | no_program | api_error | unreachable (plans: also rejected, needs_input, no_plan; reviews: reviewed, review_failed, review_rejected).
// Appended by reading what is there and writing it back, as `save_raw` does.
fn log_call[&h, &f, &p, &m, &t](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], provider: &static [byte], model: &m [byte], task: &t [byte], sample: int, tin: int, tout: int, tthink: int, cw: int, cr: int, stop: &static [byte], outcome: &static [byte], status: int, reply_chars: int, program_chars: int, ms: int) -> [heap, fs_read(""), fs_write("")] int {
    if len(path) == 0 {
        return 0;
    }
    var w = json.writer(heap, 512);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "provider");
    w = json.put_string(heap, w, provider);
    w = json.put_key(heap, w, "model");
    w = json.put_string(heap, w, model);
    w = json.put_key(heap, w, "task");
    w = json.put_string(heap, w, task);
    w = json.put_key(heap, w, "sample");
    w = json.put_int(heap, w, sample);
    w = json.put_key(heap, w, "in");
    w = json.put_int(heap, w, tin);
    w = json.put_key(heap, w, "out");
    w = json.put_int(heap, w, tout);
    w = json.put_key(heap, w, "thinking");
    w = json.put_int(heap, w, tthink);
    w = json.put_key(heap, w, "cache_write");
    w = json.put_int(heap, w, cw);
    w = json.put_key(heap, w, "cache_read");
    w = json.put_int(heap, w, cr);
    w = json.put_key(heap, w, "stop");
    w = json.put_string(heap, w, stop);
    w = json.put_key(heap, w, "outcome");
    w = json.put_string(heap, w, outcome);
    w = json.put_key(heap, w, "status");
    w = json.put_int(heap, w, status);
    w = json.put_key(heap, w, "reply_chars");
    w = json.put_int(heap, w, reply_chars);
    w = json.put_key(heap, w, "program_chars");
    w = json.put_int(heap, w, program_chars);
    w = json.put_key(heap, w, "ms");
    w = json.put_int(heap, w, ms);
    w = json.end_object(heap, w);
    let line = json.finish(w);
    let (old, ok) = slurp(heap, fs, path, 67108864);
    var all = old;
    borrow line as &lr in {
        all = buffer.append(heap, all, buffer.bytes(lr));
    }
    all = buffer.append(heap, all, "\n");
    buffer.drop(heap, line);
    borrow all as &ar in {
        fs_write(fs, path, buffer.bytes(ar));
    }
    buffer.drop(heap, all);
    return 0;
}

// The effort the task asks for: the text after `EFFORT: ` on its own line (a unit's `effort` in the plan, written by the driver), trimmed; empty when
// there is none. It beats `--effort`: the unit knows how hard it is, the flag is the default.
fn task_effort[&t](task: &t [byte]) -> [] &t [byte] {
    var i = 0;
    var found = task[0..0];
    while i < len(task) {
        var e = i;
        while e < len(task) && int_of(task[e]) != 10 {
            e = e + 1;
        }
        if e - i > 8 && int_of(task[i]) == 69 && int_of(task[i + 1]) == 70 && int_of(task[i + 2]) == 70 && int_of(task[i + 3]) == 79 && int_of(task[i + 4]) == 82 && int_of(task[i + 5]) == 84 && int_of(task[i + 6]) == 58 && int_of(task[i + 7]) == 32 {
            var a = i + 8;
            var z = e;
            while z > a && (int_of(task[z - 1]) == 32 || int_of(task[z - 1]) == 13) {
                z = z - 1;
            }
            found = task[a..z];
        }
        i = e + 1;
    }
    return found;
}

fn effort_valid[&t](e: &t [byte]) -> [] bool {
    return bytes.equal(e, "low") || bytes.equal(e, "medium") || bytes.equal(e, "high") || bytes.equal(e, "xhigh") || bytes.equal(e, "max");
}

// The first line of the task, which names the unit (`UNIT: refill`), at most 100 bytes.
fn task_head[&t](task: &t [byte]) -> [] &t [byte] {
    var a = 0;
    while a < len(task) && (int_of(task[a]) == 32 || (int_of(task[a]) >= 9 && int_of(task[a]) <= 13)) {
        a = a + 1;
    }
    var b = a;
    while b < len(task) && int_of(task[b]) != 10 && b - a < 100 {
        b = b + 1;
    }
    return task[a..b];
}

fn cap_len(n: int, most: int) -> [] int {
    if n > most {
        return most;
    }
    return n;
}

// The `[REVIEW_ERROR]` lines of a review report, one per line (empty: none).
fn error_lines[&h, &r](heap: &!h Heap, rep: &r [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    var pos = 0;
    while pos < len(rep) {
        var e = pos;
        while e < len(rep) && int_of(rep[e]) != 10 {
            e = e + 1;
        }
        if bytes.starts_with(rep[pos..e], "[REVIEW_ERROR]") {
            out = buffer.append(heap, out, rep[pos..e]);
            out = buffer.push(heap, out, byte_of(10));
        }
        pos = e + 1;
    }
    return out;
}

// Is every `[REVIEW_ERROR]` of the report the verdict "the reviewer agreed with none of a unit's cases" (a judgement on the plan: the planner is
// told), and not a malformed answer (a wrong number of answers, a missing unit, an answer of another shape: the reviewer's slip, not the plan's)?
fn only_disagreement[&r](rep: &r [byte]) -> [] bool {
    var pos = 0;
    var any = false;
    while pos < len(rep) {
        var e = pos;
        while e < len(rep) && int_of(rep[e]) != 10 {
            e = e + 1;
        }
        let line = rep[pos..e];
        if bytes.starts_with(line, "[REVIEW_ERROR]") {
            any = true;
            if bytes.find(line, "agreed with none of the") < 0 {
                return false;
            }
        }
        pos = e + 1;
    }
    return any;
}

// The blind review of a plan that has passed the check (docs/review-guide.md): the reviewer is shown the questions (signatures, descriptions, the
// arguments of each case, never an expected value) and re-derives the results; `review.apply` keeps the cases it agrees with. Up to two tries to get a
// usable answer. Answers (0, the plan as expanded again after the drops), (1, the report: the review refused the plan: a unit lost all its cases) or
// (2, empty: no usable review, the plan stands unreviewed).
fn review_phase[&h, &f, &n, &c, &i, &r1, &r2, &r3, &r4, &r5, &r6, &e, &r7, &r8, &r9, &r10, &r11, &r12, &r13](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), clock: &c Clock, io: &!i Io, host: &r1 [byte], ip: &r2 [byte], port: int, secure: bool, path: &r3 [byte], headers: &r4 [byte], roots: &r5 [byte], entropy: &!e [byte], local: bool, model: &r7 [byte], num_ctx: int, max_tokens: int, thinking: &r8 [byte], effort: &r9 [byte], obj: &r10 [byte], rguide: &r11 [byte], usage_path: &r6 [byte], provider_label: &static [byte], task: &r12 [byte], attempt: int) -> [heap, fs_read(""), fs_write(""), net_out(""), conn_read, conn_write, poll, clock, err_write] (int, buffer.Buffer) {
    let questions = review.blind(heap, obj);
    var verdict = 2;
    var result = buffer.empty(heap, 16);
    var has_cases = false;
    borrow questions as &qr in {
        has_cases = bytes.find(buffer.bytes(qr), "\"cases\"") >= 0;
    }
    if has_cases == false {
        buffer.drop(heap, questions);
        return (2, result);
    }
    var prompt_text = buffer.append(heap, buffer.empty(heap, 4096), rguide);
    prompt_text = buffer.append(heap, prompt_text, "\n\n=== THE PLAN TO VERIFY ===\n");
    borrow questions as &qr2 in {
        prompt_text = buffer.append(heap, prompt_text, buffer.bytes(qr2));
    }
    prompt_text = buffer.append(heap, prompt_text, "\n\nReply with the JSON object only.\n");
    buffer.drop(heap, questions);
    // what the last try got wrong (a malformed answer), told to the next try
    var slip = buffer.empty(heap, 16);
    var tries = 0;
    var settled = false;
    while tries < 2 && settled == false {
        tries = tries + 1;
        var body = buffer.empty(heap, 16);
        buffer.drop(heap, body);
        var asked = buffer.empty(heap, 4096);
        borrow prompt_text as &pt in {
            asked = buffer.append(heap, asked, buffer.bytes(pt));
        }
        borrow slip as &sl in {
            if len(buffer.bytes(sl)) > 0 {
                asked = buffer.append(heap, asked, "\n=== YOUR PREVIOUS ANSWER WAS UNUSABLE ===\n");
                asked = buffer.append(heap, asked, buffer.bytes(sl)[0..cap_len(len(buffer.bytes(sl)), 1500)]);
                asked = buffer.append(heap, asked, "\nAnswer again: one entry per unit given, with exactly as many answers as that unit has cases, in the same order; each answer is {\"expect\": ...} or {\"skip\": true}. Reply with the JSON object only.\n");
            }
        }
        borrow asked as &pr in {
            if local {
                body = ollama.request_body(heap, model, num_ctx, max_tokens, "", buffer.bytes(pr));
            } else {
                body = anthropic.request_body(heap, model, max_tokens, "", buffer.bytes(pr), thinking, effort);
            }
        }
        buffer.drop(heap, asked);
        let t0 = clock_ms(clock);
        var text = buffer.empty(heap, 16);
        var cut = false;
        var tin = 0;
        var tout = 0;
        var tthink = 0;
        var tcw = 0;
        var tcr = 0;
        var status = 0;
        borrow body as &br in {
            match provider.exchange(heap, net, clock, io, host, port, secure, path, headers, buffer.bytes(br), roots, ip, entropy, 33554432, 1800000) {
                provider.Answered::Failed(tag) => {
                    status = 0;
                }
                provider.Answered::Ok(st, out) => {
                    status = st;
                    borrow out as &or in {
                        if st == 200 {
                            buffer.drop(heap, text);
                            if local {
                                text = reply.generated_text(heap, buffer.bytes(or));
                                cut = reply.done_reason_is(heap, buffer.bytes(or), "length");
                                tin = reply.top_count(heap, buffer.bytes(or), "prompt_eval_count");
                                tout = reply.top_count(heap, buffer.bytes(or), "eval_count");
                            } else {
                                text = reply.text(heap, buffer.bytes(or));
                                cut = reply.stop_reason_is(heap, buffer.bytes(or), "max_tokens");
                                tin = reply.usage_count(heap, buffer.bytes(or), "input_tokens");
                                tout = reply.usage_count(heap, buffer.bytes(or), "output_tokens");
                                tthink = reply.usage_thinking(heap, buffer.bytes(or));
                                tcw = reply.usage_count(heap, buffer.bytes(or), "cache_creation_input_tokens");
                                tcr = reply.usage_count(heap, buffer.bytes(or), "cache_read_input_tokens");
                            }
                        }
                    }
                    buffer.drop(heap, out);
                }
            }
        }
        var outcome = "review_failed";
        borrow text as &xr in {
            let (ja, jz) = reply.json_span(heap, buffer.bytes(xr));
            if status == 200 && cut == false && ja >= 0 {
                let answers = buffer.bytes(xr)[ja..jz];
                let (filtered, rrep, rcode) = review.apply(heap, obj, answers);
                var judged = false;
                if rcode != 0 {
                    borrow rrep as &rq in {
                        judged = only_disagreement(buffer.bytes(rq));
                    }
                }
                if rcode != 0 && judged == false {
                    // a malformed answer (the wrong number of answers, a unit missing, an answer of another shape): the reviewer's slip, not
                    // the plan's. The plan is not rejected for it: the review is tried once more, told what was wrong; if it fails again the
                    // plan stands unreviewed, and says so (below, on stderr, in plan.log).
                    var errs = buffer.empty(heap, 16);
                    borrow rrep as &rq3 in {
                        buffer.drop(heap, errs);
                        errs = error_lines(heap, buffer.bytes(rq3));
                    }
                    io.error_all(io, "cancho-agent: the review answer was unusable:\n");
                    borrow errs as &eq in {
                        io.error_all(io, buffer.bytes(eq));
                    }
                    buffer.drop(heap, slip);
                    slip = errs;
                    buffer.drop(heap, rrep);
                    buffer.drop(heap, filtered);
                } else if rcode != 0 {
                    // the reviewer agreed with none of a unit's cases: a judgement on the plan, the planner is told
                    buffer.drop(heap, result);
                    result = rrep;
                    buffer.drop(heap, filtered);
                    verdict = 1;
                    outcome = "review_rejected";
                    settled = true;
                } else {
                    borrow rrep as &rp in {
                        if len(buffer.bytes(rp)) > 0 {
                            io.error_all(io, "cancho-agent: review:\n");
                            io.error_all(io, buffer.bytes(rp));
                        }
                    }
                    buffer.drop(heap, rrep);
                    borrow filtered as &fr in {
                        let (expanded, creport, ccode) = cases.expand(heap, buffer.bytes(fr));
                        if ccode == 0 {
                            borrow expanded as &er in {
                                let (prep, pcode) = plan.check(heap, buffer.bytes(er));
                                if pcode == 0 {
                                    buffer.drop(heap, result);
                                    result = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(er)) + 2), buffer.bytes(er));
                                    verdict = 0;
                                    outcome = "reviewed";
                                    settled = true;
                                } else {
                                    buffer.drop(heap, result);
                                    borrow prep as &pq in {
                                        result = buffer.append(heap, buffer.empty(heap, 256), buffer.bytes(pq));
                                    }
                                    verdict = 1;
                                    outcome = "review_rejected";
                                    settled = true;
                                }
                                buffer.drop(heap, prep);
                            }
                        } else {
                            buffer.drop(heap, result);
                            borrow creport as &cq in {
                                result = buffer.append(heap, buffer.empty(heap, 256), buffer.bytes(cq));
                            }
                            verdict = 1;
                            outcome = "review_rejected";
                            settled = true;
                        }
                        buffer.drop(heap, expanded);
                        buffer.drop(heap, creport);
                    }
                    buffer.drop(heap, filtered);
                }
            }
        }
        var tlen = 0;
        borrow text as &tq in {
            tlen = len(buffer.bytes(tq));
        }
        log_call(heap, fs, usage_path, provider_label, model, task, attempt, tin, tout, tthink, tcw, tcr, "", outcome, status, tlen, 0, clock_ms(clock) - t0);
        buffer.drop(heap, text);
        buffer.drop(heap, body);
    }
    buffer.drop(heap, prompt_text);
    buffer.drop(heap, slip);
    if settled == false {
        // never silent: the plan is kept, its cases are NOT confirmed by a second reader, and the build records it (docs/build.md)
        io.error_all(io, "cancho-agent: the review gave no usable answer; the plan stands unreviewed\n");
    }
    return (verdict, result);
}

// The bound for the round after one that was cut off by it: doubled, at most 32000 (never lowered). A model that thinks first can use the whole bound
// before its first byte of answer (a plan, a patch); asking again with the same bound only repeats that.
fn grown_bound(bound: int) -> [] int {
    if bound >= 32000 {
        return bound;
    }
    if bound * 2 > 32000 {
        return 32000;
    }
    return bound * 2;
}

// ---- the work ------------------------------------------------------------

fn go[&h, &f, &n, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [heap, fs_read(""), fs_write(""), net_out(""), conn_read, conn_write, poll, clock, err_write, args] int {
    let provider_name = opt(args, "--provider");
    let model = opt(args, "--model");
    let key_file = opt(args, "--key-file");
    let host = opt(args, "--host");
    let ip = opt(args, "--ip");
    let roots_file = opt(args, "--roots");
    if len(provider_name) == 0 {
        say(io, "--provider is required (there is no default provider)");
        return 2;
    }
    let local = bytes.equal(provider_name, "ollama");
    if local == false && bytes.equal(provider_name, "anthropic") == false {
        say(io, "--provider must be anthropic or ollama");
        return 2;
    }
    if len(model) == 0 {
        say(io, "--model is required (there is no default model)");
        return 2;
    }
    if len(host) == 0 || len(ip) == 0 {
        say(io, "--host and --ip are required");
        return 2;
    }
    if local == false && (len(key_file) == 0 || len(roots_file) == 0) {
        say(io, "--key-file and --roots are required");
        return 2;
    }
    let mode = opt(args, "--mode");
    if len(mode) > 0 && bytes.equal(mode, "edit") == false && bytes.equal(mode, "plan") == false {
        say(io, "--mode must be edit or plan");
        return 2;
    }
    let plan_mode = bytes.equal(mode, "plan");
    let out_mode = opt(args, "--output");
    if len(out_mode) > 0 && bytes.equal(out_mode, "file") == false && bytes.equal(out_mode, "patch") == false {
        say(io, "--output must be file or patch");
        return 2;
    }
    if plan_mode && (len(opt(args, "--guide")) == 0 || len(opt(args, "--brief")) == 0) {
        say(io, "--mode plan needs --guide (how to write a plan) and --brief (the task)");
        return 2;
    }
    let thinking = opt(args, "--thinking");
    let effort = opt(args, "--effort");
    if len(thinking) > 0 && bytes.equal(thinking, "adaptive") == false && bytes.equal(thinking, "disabled") == false {
        say(io, "--thinking must be disabled or adaptive");
        return 2;
    }
    if len(effort) > 0 && bytes.equal(effort, "low") == false && bytes.equal(effort, "medium") == false && bytes.equal(effort, "high") == false && bytes.equal(effort, "xhigh") == false && bytes.equal(effort, "max") == false {
        say(io, "--effort must be one of low, medium, high, xhigh, max");
        return 2;
    }
    var port = 443;
    if local {
        port = 11434;
    }
    if len(opt(args, "--port")) > 0 {
        port = number(opt(args, "--port"));
    }
    // anthropic is TLS unless told otherwise; a local ollama is plain unless told otherwise
    var secure = local == false;
    if bytes.equal(opt(args, "--tls"), "off") {
        secure = false;
    }
    if bytes.equal(opt(args, "--tls"), "on") {
        secure = true;
    }
    var max_tokens = 8192;
    if len(opt(args, "--max-tokens")) > 0 {
        max_tokens = number(opt(args, "--max-tokens"));
    }
    if len(opt(args, "--num-predict")) > 0 {
        max_tokens = number(opt(args, "--num-predict"));
    }
    var num_ctx = 8192;
    if len(opt(args, "--num-ctx")) > 0 {
        num_ctx = number(opt(args, "--num-ctx"));
    }
    if arg_count(args) < 2 {
        say(io, "the project file is the last argument");
        return 2;
    }
    let project = arg(args, arg_count(args) - 1);

    // the key, the roots, the primer and the project's three files
    var key_raw = buffer.empty(heap, 16);
    var key_ok = true;
    var roots = buffer.empty(heap, 16);
    var roots_ok = true;
    if local == false {
        buffer.drop(heap, key_raw);
        buffer.drop(heap, roots);
        let (k, kok) = slurp(heap, fs, key_file, 4096);
        key_raw = k;
        key_ok = kok;
        let (r, rok) = slurp(heap, fs, roots_file, 4194304);
        roots = r;
        roots_ok = rok;
    } else if secure {
        buffer.drop(heap, roots);
        let (r, rok) = slurp(heap, fs, roots_file, 4194304);
        roots = r;
        roots_ok = rok;
    }
    var primer = buffer.empty(heap, 16);
    var primer_ok = true;
    if len(opt(args, "--primer")) > 0 {
        buffer.drop(heap, primer);
        let (p, ok) = slurp(heap, fs, opt(args, "--primer"), 1048576);
        primer = p;
        primer_ok = ok;
    }
    var source = buffer.empty(heap, 16);
    var source_ok = true;
    var task = buffer.empty(heap, 16);
    var feedback = buffer.empty(heap, 16);
    var guide = buffer.empty(heap, 16);
    var guide_ok = true;
    if plan_mode {
        // the brief is the "source", the contract the "task"; nothing is read from the output path
        buffer.drop(heap, source);
        let (b, bok) = slurp(heap, fs, opt(args, "--brief"), 1048576);
        source = b;
        source_ok = bok;
        buffer.drop(heap, guide);
        let (gd, gok) = slurp(heap, fs, opt(args, "--guide"), 1048576);
        guide = gd;
        guide_ok = gok;
        if len(opt(args, "--contract")) > 0 {
            buffer.drop(heap, task);
            let (t, tok) = slurp(heap, fs, opt(args, "--contract"), 262144);
            task = t;
            if tok == false {
                source_ok = false;
            }
        }
    } else {
        buffer.drop(heap, source);
        let (src, sok) = slurp(heap, fs, project, 1048576);
        source = src;
        source_ok = sok;
        let task_path = with_suffix(heap, project, ".task");
        let feedback_path = with_suffix(heap, project, ".feedback");
        borrow task_path as &tp in {
            buffer.drop(heap, task);
            let (t, ok) = slurp(heap, fs, buffer.bytes(tp), 65536);
            task = t;
        }
        borrow feedback_path as &fp in {
            buffer.drop(heap, feedback);
            let (t, ok) = slurp(heap, fs, buffer.bytes(fp), 262144);
            feedback = t;
        }
        buffer.drop(heap, task_path);
        buffer.drop(heap, feedback_path);
    }
    let patch_out = bytes.equal(out_mode, "patch") && plan_mode == false;
    let review_on = bytes.equal(opt(args, "--review"), "on");
    var rguide = buffer.empty(heap, 16);
    var rguide_ok = true;
    if review_on {
        if plan_mode == false || len(opt(args, "--review-guide")) == 0 {
            say(io, "--review on needs --mode plan and --review-guide (how to verify cases)");
            buffer.drop(heap, rguide);
            buffer.drop(heap, guide);
            buffer.drop(heap, key_raw);
            buffer.drop(heap, roots);
            buffer.drop(heap, primer);
            buffer.drop(heap, source);
            buffer.drop(heap, task);
            buffer.drop(heap, feedback);
            return 2;
        }
        buffer.drop(heap, rguide);
        let (rg, rgok) = slurp(heap, fs, opt(args, "--review-guide"), 1048576);
        rguide = rg;
        rguide_ok = rgok;
    }
    var rounds = 3;
    if len(opt(args, "--rounds")) > 0 {
        rounds = number(opt(args, "--rounds"));
    }

    var rc = 1;
    var key_present = local;
    borrow key_raw as &kq in {
        if local == false {
            key_present = len(trimmed_key(buffer.bytes(kq))) > 0;
        }
    }
    var task_ok = true;
    borrow task as &tq0 in {
        let te0 = task_effort(buffer.bytes(tq0));
        task_ok = len(te0) == 0 || effort_valid(te0);
    }
    if key_ok && key_present && roots_ok && primer_ok && source_ok && guide_ok && rguide_ok && task_ok {
        // consumed: it drops all six
        return ask_and_write(heap, fs, net, clock, io, args, project, model, host, ip, port, secure, local, num_ctx, max_tokens, thinking, effort, plan_mode, rounds, review_on, patch_out, key_raw, roots, primer, guide, rguide, source, task, feedback);
    }
    if key_ok == false {
        say(io, "cannot read --key-file");
    } else if key_present == false {
        say(io, "--key-file is empty");
    } else if roots_ok == false {
        say(io, "cannot read --roots");
    } else if primer_ok == false {
        say(io, "cannot read --primer");
    } else if guide_ok == false {
        say(io, "cannot read --guide");
    } else if task_ok == false {
        say(io, "EFFORT in the task must be one of low, medium, high, xhigh, max");
        rc = 2;
    } else if plan_mode {
        say(io, "cannot read --brief or --contract");
    } else {
        say(io, "cannot read the project file");
    }
    buffer.drop(heap, guide);
    buffer.drop(heap, rguide);
    buffer.drop(heap, key_raw);
    buffer.drop(heap, roots);
    buffer.drop(heap, primer);
    buffer.drop(heap, source);
    buffer.drop(heap, task);
    buffer.drop(heap, feedback);
    return rc;
}

// The request body for this round: the prompt (to fix a program, or to write a plan) in the provider's wire form.
fn make_body[&h, &m, &y, &s, &p, &g, &r, &k, &f](heap: &!h Heap, local: bool, plan_mode: bool, patch_out: bool, model: &m [byte], num_ctx: int, max_tokens: int, thinking: &y [byte], effort: &s [byte], primer: &p [byte], guide: &g [byte], source: &r [byte], task: &k [byte], feedback: &f [byte]) -> [heap] buffer.Buffer {
    var asked = buffer.empty(heap, 16);
    buffer.drop(heap, asked);
    if plan_mode {
        asked = planprompt.build(heap, guide, source, task, feedback);
    } else if patch_out {
        asked = prompt.build_patch(heap, source, task, feedback);
    } else {
        asked = prompt.build(heap, source, task, feedback);
    }
    var body = buffer.empty(heap, 16);
    borrow asked as &ar in {
        buffer.drop(heap, body);
        if local {
            body = ollama.request_body(heap, model, num_ctx, max_tokens, primer, buffer.bytes(ar));
        } else {
            body = anthropic.request_body(heap, model, max_tokens, primer, buffer.bytes(ar), thinking, effort);
        }
    }
    buffer.drop(heap, asked);
    return body;
}

// Up to `rounds` samples: a reply without a program, or cut off, is retried and
// never written over the project.
fn ask_and_write[&h, &f, &n, &c, &i, &g, &p, &m, &o, &q, &y, &s](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), clock: &c Clock, io: &!i Io, args: &g Args, project: &p [byte], model: &m [byte], host: &o [byte], ip: &q [byte], port: int, secure: bool, local: bool, num_ctx: int, max_tokens: int, thinking: &y [byte], effort: &s [byte], plan_mode: bool, rounds: int, review_on: bool, patch_out: bool, key_raw: buffer.Buffer, roots: buffer.Buffer, primer: buffer.Buffer, guide: buffer.Buffer, rguide: buffer.Buffer, source: buffer.Buffer, task: buffer.Buffer, feedback0: buffer.Buffer) -> [heap, fs_read(""), fs_write(""), net_out(""), conn_read, conn_write, poll, clock, err_write, args] int {
    var feedback = feedback0;
    // The bound on one answer. A reply (a plan, a patch) cut off by it is asked again with the bound doubled (at most 32000): a model that thinks first can spend the
    // whole bound before the first byte of the plan (the `semver` plan failed three rounds of three with 16000 tokens of thinking and no JSON).
    var bound = max_tokens;
    let workspace = opt(args, "--workspace");
    let raw_path = opt(args, "--save-raw");
    var body = buffer.empty(heap, 16);
    var headers = buffer.empty(heap, 16);
    borrow key_raw as &kr in {
        buffer.drop(heap, headers);
        if local {
            headers = ollama.headers(heap);
        } else {
            headers = anthropic.headers(heap, trimmed_key(buffer.bytes(kr)), workspace);
        }
    }
    var entropy = box_slice(heap, 32, byte_of(0));
    borrow mut entropy as &!ew in {
        fs_read(fs, "/dev/urandom", contents(ew));
    }
    let usage_path = opt(args, "--usage-log");
    var provider_label = "anthropic";
    if local {
        provider_label = "ollama";
    }
    var path = "/v1/messages";
    if local {
        path = "/api/generate";
    }
    var rc = 1;
    var attempt = 0;
    var finished = false;
    while attempt < rounds && finished == false {
        attempt = attempt + 1;
        // the request is built each round: after a rejected plan the prompt carries the report
        borrow primer as &pr in {
            borrow guide as &gdr in {
                borrow source as &sr in {
                    borrow task as &tr in {
                        borrow feedback as &fr in {
                            buffer.drop(heap, body);
                            let te = task_effort(buffer.bytes(tr));
                            if len(te) > 0 {
                                body = make_body(heap, local, plan_mode, patch_out, model, num_ctx, bound, thinking, te, buffer.bytes(pr), buffer.bytes(gdr), buffer.bytes(sr), buffer.bytes(tr), buffer.bytes(fr));
                            } else {
                                body = make_body(heap, local, plan_mode, patch_out, model, num_ctx, bound, thinking, effort, buffer.bytes(pr), buffer.bytes(gdr), buffer.bytes(sr), buffer.bytes(tr), buffer.bytes(fr));
                            }
                        }
                    }
                }
            }
        }
        borrow headers as &hr in {
            borrow body as &br in {
              borrow roots as &rr in {
                borrow mut entropy as &!ew in {
                    let t0 = clock_ms(clock);
                    match provider.exchange(heap, net, clock, io, host, port, secure, path, buffer.bytes(hr), buffer.bytes(br), buffer.bytes(rr), ip, contents(ew), 33554432, 1800000) {
                        provider.Answered::Failed(tag) => {
                            borrow task as &lt in {
                                log_call(heap, fs, usage_path, provider_label, model, task_head(buffer.bytes(lt)), attempt, 0, 0, 0, 0, 0, "", "unreachable", 0, 0, 0, clock_ms(clock) - t0);
                            }
                            io.error_all(io, "cancho-agent: cannot reach the API: ");
                            io.error_all(io, provider.tag_of(tag));
                            io.error_all(io, "\n");
                            finished = true;
                        }
                        provider.Answered::Ok(status, out) => {
                            borrow out as &or in {
                                let answer = buffer.bytes(or);
                                if status != 200 {
                                    borrow task as &lt in {
                                        log_call(heap, fs, usage_path, provider_label, model, task_head(buffer.bytes(lt)), attempt, 0, 0, 0, 0, 0, "", "api_error", status, len(answer), 0, clock_ms(clock) - t0);
                                    }
                                    var why = buffer.empty(heap, 16);
                                    buffer.drop(heap, why);
                                    if local {
                                        why = reply.generate_error(heap, answer);
                                    } else {
                                        why = reply.error_message(heap, answer);
                                    }
                                    borrow why as &wr in {
                                        io.error_all(io, "cancho-agent: HTTP error from the API (");
                                        io.error_all(io, buffer.bytes(wr));
                                        io.error_all(io, ")\n");
                                    }
                                    buffer.drop(heap, why);
                                    finished = true;
                                } else {
                                    var text = buffer.empty(heap, 16);
                                    var usage = buffer.empty(heap, 16);
                                    var cut = false;
                                    buffer.drop(heap, text);
                                    buffer.drop(heap, usage);
                                    if local {
                                        text = reply.generated_text(heap, answer);
                                        usage = buffer.empty(heap, 16);
                                        cut = reply.done_reason_is(heap, answer, "length");
                                    } else {
                                        text = reply.text(heap, answer);
                                        usage = reply.usage_line(heap, answer);
                                        cut = reply.stop_reason_is(heap, answer, "max_tokens");
                                    }
                                    borrow text as &xr in {
                                        borrow usage as &ur in {
                                            var why = buffer.empty(heap, 64);
                                            if local {
                                                if cut {
                                                    why = buffer.append(heap, why, "length");
                                                } else {
                                                    why = buffer.append(heap, why, "stop");
                                                }
                                            } else {
                                                if cut {
                                                    why = buffer.append(heap, why, "max_tokens; usage ");
                                                } else {
                                                    why = buffer.append(heap, why, "end; usage ");
                                                }
                                                why = buffer.append(heap, why, buffer.bytes(ur));
                                            }
                                            borrow why as &yr in {
                                                save_raw(heap, fs, raw_path, buffer.bytes(xr), buffer.bytes(yr));
                                            }
                                            buffer.drop(heap, why);
                                        }
                                        if plan_mode {
                                            // A PLAN: the first parseable JSON object in the reply, then the plan check (in process, no model).
                                            // Nothing is written unless the check passes.
                                            let (ja, jz) = reply.json_span(heap, buffer.bytes(xr));
                                            var po = "no_plan";
                                            var report = buffer.empty(heap, 16);
                                            var asks = false;
                                            var accepted = false;
                                            var final_plan = buffer.empty(heap, 16);
                                            if cut {
                                                po = "cut_off";
                                            } else if ja >= 0 {
                                                let obj = buffer.bytes(xr)[ja..jz];
                                                if reply.field_is(heap, obj, "status", "unclear") || reply.field_is(heap, obj, "status", "too_big") {
                                                    po = "needs_input";
                                                    asks = true;
                                                } else {
                                                    // The model wrote DATA (`cases`); the tests are made from it by a program, from the signature.
                                                    let (expanded, creport, ccode) = cases.expand(heap, obj);
                                                    if ccode != 0 {
                                                        buffer.drop(heap, report);
                                                        report = creport;
                                                        po = "rejected";
                                                        buffer.drop(heap, expanded);
                                                    } else {
                                                        buffer.drop(heap, creport);
                                                        borrow expanded as &er in {
                                                            let (rep, code) = plan.check(heap, buffer.bytes(er));
                                                            buffer.drop(heap, report);
                                                            report = rep;
                                                            if code == 0 {
                                                                po = "written";
                                                                accepted = true;
                                                                buffer.drop(heap, final_plan);
                                                                final_plan = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(er)) + 2), buffer.bytes(er));
                                                            } else {
                                                                po = "rejected";
                                                            }
                                                        }
                                                        buffer.drop(heap, expanded);
                                                    }
                                                }
                                            }
                                            var tin = 0;
                                            var tout = 0;
                                            var tthink = 0;
                                            var tcw = 0;
                                            var tcr = 0;
                                            if local {
                                                tin = reply.top_count(heap, answer, "prompt_eval_count");
                                                tout = reply.top_count(heap, answer, "eval_count");
                                            } else {
                                                tin = reply.usage_count(heap, answer, "input_tokens");
                                                tout = reply.usage_count(heap, answer, "output_tokens");
                                                tthink = reply.usage_thinking(heap, answer);
                                                tcw = reply.usage_count(heap, answer, "cache_creation_input_tokens");
                                                tcr = reply.usage_count(heap, answer, "cache_read_input_tokens");
                                            }
                                            var pstop = "end_turn";
                                            if local {
                                                pstop = "stop";
                                            }
                                            if cut {
                                                pstop = "max_tokens";
                                                if local {
                                                    pstop = "length";
                                                }
                                            }
                                            var jlen = 0;
                                            if ja >= 0 {
                                                jlen = jz - ja;
                                            }
                                            borrow task as &lt in {
                                                log_call(heap, fs, usage_path, provider_label, model, task_head(buffer.bytes(lt)), attempt, tin, tout, tthink, tcw, tcr, pstop, po, status, len(buffer.bytes(xr)), jlen, clock_ms(clock) - t0);
                                            }
                                            if accepted && review_on {
                                                // the blind second pass: the cases the reviewer cannot re-derive are dropped
                                                borrow rguide as &rgr in {
                                                    borrow task as &lt2 in {
                                                        let (rv, rres) = review_phase(heap, fs, net, clock, io, host, ip, port, secure, path, buffer.bytes(hr), buffer.bytes(rr), contents(ew), local, model, num_ctx, max_tokens, thinking, effort, buffer.bytes(xr)[ja..jz], buffer.bytes(rgr), usage_path, provider_label, task_head(buffer.bytes(lt2)), attempt);
                                                        if rv == 0 {
                                                            buffer.drop(heap, final_plan);
                                                            final_plan = rres;
                                                        } else if rv == 1 {
                                                            accepted = false;
                                                            buffer.drop(heap, report);
                                                            report = rres;
                                                        } else {
                                                            buffer.drop(heap, rres);
                                                        }
                                                    }
                                                }
                                            }
                                            if cut {
                                                io.error_all(io, "cancho-agent: a sample was cut off by the bound (--max-tokens / --num-predict)\n");
                                                if grown_bound(bound) > bound {
                                                    bound = grown_bound(bound);
                                                    var said = buffer.append(heap, buffer.empty(heap, 96), "cancho-agent: the bound for the next round is ");
                                                    said = buffer.push_nat(heap, said, bound);
                                                    said = buffer.push(heap, said, byte_of(10));
                                                    borrow said as &sdq in {
                                                        io.error_all(io, buffer.bytes(sdq));
                                                    }
                                                    buffer.drop(heap, said);
                                                }
                                                buffer.drop(heap, feedback);
                                                if len(buffer.bytes(xr)) == 0 {
                                                    feedback = buffer.append(heap, buffer.empty(heap, 256), "Your reply was cut off by the output limit before any text of it: your thinking used all of it. Think less and write the plan now: decide the units quickly, keep the descriptions short.");
                                                } else {
                                                    feedback = buffer.append(heap, buffer.empty(heap, 256), "Your reply was cut off before the JSON object ended. Reply with a SHORTER plan: fewer units or shorter descriptions.");
                                                }
                                            } else if ja < 0 {
                                                io.error_all(io, "cancho-agent: a sample has no JSON object in it\n");
                                                buffer.drop(heap, feedback);
                                                feedback = buffer.append(heap, buffer.empty(heap, 256), "Your reply contained no JSON object. Reply with the JSON object only.");
                                            } else if asks {
                                                var qpath = with_suffix(heap, project, ".questions.json");
                                                var qfile = buffer.empty(heap, jz - ja + 2);
                                                qfile = buffer.append(heap, qfile, buffer.bytes(xr)[ja..jz]);
                                                qfile = buffer.push(heap, qfile, byte_of(10));
                                                borrow qpath as &qp in {
                                                    borrow qfile as &qf in {
                                                        fs_write(fs, buffer.bytes(qp), buffer.bytes(qf));
                                                    }
                                                }
                                                buffer.drop(heap, qpath);
                                                buffer.drop(heap, qfile);
                                                io.error_all(io, "cancho-agent: the model needs a decision, not a plan: see the .questions.json beside the output\n");
                                                rc = 3;
                                                finished = true;
                                            } else if accepted {
                                                // the plan as expanded (its tests made from its cases), and one newline
                                                var file = buffer.empty(heap, 16);
                                                buffer.drop(heap, file);
                                                file = buffer.empty(heap, 16);
                                                borrow final_plan as &fpr in {
                                                    buffer.drop(heap, file);
                                                    file = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(fpr)) + 2), buffer.bytes(fpr));
                                                }
                                                file = buffer.push(heap, file, byte_of(10));
                                                borrow file as &fr in {
                                                    fs_write(fs, project, buffer.bytes(fr));
                                                }
                                                buffer.drop(heap, file);
                                                rc = 0;
                                                finished = true;
                                            } else {
                                                borrow report as &rr in {
                                                    io.error_all(io, "cancho-agent: the plan was rejected:\n");
                                                    io.error_all(io, buffer.bytes(rr));
                                                }
                                                var nf = buffer.empty(heap, 1024);
                                                nf = buffer.append(heap, nf, "Your previous plan:\n");
                                                nf = buffer.append(heap, nf, buffer.bytes(xr)[ja..jz]);
                                                nf = buffer.append(heap, nf, "\n\nThe plan check (a program, not a person) says:\n");
                                                borrow report as &rr2 in {
                                                    nf = buffer.append(heap, nf, buffer.bytes(rr2));
                                                }
                                                buffer.drop(heap, feedback);
                                                feedback = nf;
                                            }
                                            buffer.drop(heap, report);
                                            buffer.drop(heap, final_plan);
                                        } else {
                                        var pa = 0 - 1;
                                        var pz = 0 - 1;
                                        if cut == false {
                                            if patch_out {
                                                let (a, z) = splice.patch_span(buffer.bytes(xr));
                                                pa = a;
                                                pz = z;
                                            } else {
                                                let (a, z) = reply.program_span(buffer.bytes(xr));
                                                pa = a;
                                                pz = z;
                                            }
                                        }
                                        // a patch is spliced into the file as it was read; the new file, the notes and the code
                                        var newfile = buffer.empty(heap, 16);
                                        var srep = buffer.empty(heap, 16);
                                        var scode = 0;
                                        if patch_out && pa >= 0 {
                                            borrow source as &sb in {
                                                let (nf, sr, sc) = splice.splice(heap, buffer.bytes(sb), buffer.bytes(xr)[pa..pz]);
                                                buffer.drop(heap, newfile);
                                                buffer.drop(heap, srep);
                                                newfile = nf;
                                                srep = sr;
                                                scode = sc;
                                            }
                                        }
                                        var outcome = "written";
                                        if cut {
                                            outcome = "cut_off";
                                        } else if pa < 0 {
                                            outcome = "no_program";
                                        } else if scode != 0 {
                                            outcome = "splice_error";
                                        }
                                        var stop = "end_turn";
                                        if local {
                                            stop = "stop";
                                        }
                                        if cut {
                                            stop = "max_tokens";
                                            if local {
                                                stop = "length";
                                            }
                                        }
                                        var tin = 0;
                                        var tout = 0;
                                        var tthink = 0;
                                        var tcw = 0;
                                        var tcr = 0;
                                        if local {
                                            tin = reply.top_count(heap, answer, "prompt_eval_count");
                                            tout = reply.top_count(heap, answer, "eval_count");
                                        } else {
                                            tin = reply.usage_count(heap, answer, "input_tokens");
                                            tout = reply.usage_count(heap, answer, "output_tokens");
                                                tthink = reply.usage_thinking(heap, answer);
                                            tcw = reply.usage_count(heap, answer, "cache_creation_input_tokens");
                                            tcr = reply.usage_count(heap, answer, "cache_read_input_tokens");
                                        }
                                        var plen = 0;
                                        if pa >= 0 {
                                            plen = pz - pa;
                                        }
                                        borrow task as &lt in {
                                            log_call(heap, fs, usage_path, provider_label, model, task_head(buffer.bytes(lt)), attempt, tin, tout, tthink, tcw, tcr, stop, outcome, status, len(buffer.bytes(xr)), plen, clock_ms(clock) - t0);
                                        }
                                        if cut {
                                            io.error_all(io, "cancho-agent: a sample was cut off by the bound (--max-tokens / --num-predict)\n");
                                            if grown_bound(bound) > bound {
                                                bound = grown_bound(bound);
                                                var said = buffer.append(heap, buffer.empty(heap, 96), "cancho-agent: the bound for the next round is ");
                                                said = buffer.push_nat(heap, said, bound);
                                                said = buffer.push(heap, said, byte_of(10));
                                                borrow said as &sdq in {
                                                    io.error_all(io, buffer.bytes(sdq));
                                                }
                                                buffer.drop(heap, said);
                                            }
                                        } else if patch_out {
                                            if pa < 0 {
                                                io.error_all(io, "cancho-agent: a sample has no code in it to add or change (reasoning, not a patch)\n");
                                            } else if scode != 0 {
                                                io.error_all(io, "cancho-agent: the patch could not be spliced into the file:\n");
                                                borrow srep as &sq in {
                                                    io.error_all(io, buffer.bytes(sq));
                                                }
                                            } else {
                                                borrow newfile as &nq in {
                                                    fs_write(fs, project, buffer.bytes(nq));
                                                }
                                                rc = 0;
                                                finished = true;
                                            }
                                        } else {
                                            let (a, z) = reply.program_span(buffer.bytes(xr));
                                            if a < 0 {
                                                io.error_all(io, "cancho-agent: a sample has no program in it (reasoning, not a file)\n");
                                            } else {
                                                // the program and one final newline, as the Python agent writes it
                                                var file = buffer.empty(heap, z - a + 2);
                                                file = buffer.append(heap, file, buffer.bytes(xr)[a..z]);
                                                file = buffer.push(heap, file, byte_of(10));
                                                borrow file as &fr in {
                                                    fs_write(fs, project, buffer.bytes(fr));
                                                }
                                                buffer.drop(heap, file);
                                                rc = 0;
                                                finished = true;
                                            }
                                        }
                                        buffer.drop(heap, newfile);
                                        buffer.drop(heap, srep);
                                        }
                                    }
                                    buffer.drop(heap, text);
                                    buffer.drop(heap, usage);
                                }
                            }
                            buffer.drop(heap, out);
                        }
                    }
                }
              }
            }
        }
    }
    unbox_slice(heap, entropy);
    buffer.drop(heap, headers);
    buffer.drop(heap, body);
    buffer.drop(heap, key_raw);
    buffer.drop(heap, roots);
    buffer.drop(heap, primer);
    buffer.drop(heap, guide);
    buffer.drop(heap, rguide);
    buffer.drop(heap, source);
    buffer.drop(heap, task);
    buffer.drop(heap, feedback);
    return rc;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(signals);
    release(exec);
    var console = io;
    var h = heap;
    var rc = 1;
    borrow args as &g in {
        borrow net as &n in {
            borrow clock as &c in {
                borrow fs as &f in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            rc = go(hh, f, n, c, i, g);
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(clock);
    release(fs);
    release(console);
    release(h);
    release(args);
    return rc;
}
