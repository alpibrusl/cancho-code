edition 7;

module cases;

// The cases expander. A model that writes a plan also had to write each unit's tests, and the tests it wrote did not compile against the
// unit's own signature (the wrong argument count, the wrong type, a test form that is not one). So the model writes test DATA instead:
//
//     "cases": [ {"args": [1, "ab"], "expect": {"ok": 5}}, ... ]
//
// and this module writes the test CODE from the signature, once, deterministically (docs/plan.md). The gate is scripts/test-cases.sh; the
// Python oracle it holds this to is tests/reference/cases_ref.py, and the two are written against the same spec.
//
// `expand(heap, plan)` answers the plan with every unit's `cases` replaced by `tests` (and `examples` filled when it had none), a report
// with one `[CASES_ERROR]<TAB>unit<TAB>case or -<TAB>message` line per problem, and 0 when there was none, else 1. A unit with a problem
// is copied as it was, `cases` and all; every unit without `cases` is copied as it is. Pure: the effect row is [heap].
//
// `sg` is the signature of the unit being expanded, as ints (a layout, not a type):
//     0 1   the function name (byte range in the signature)
//     2 3   the return type (byte range, trimmed)
//     4     how many parameters there are (all of them, heap included)
//     5     how many of them are args (not the heap)
//     6     return kind: 0 int, 1 bool, 2 buffer, 3 text, 4 option, 5 result
//     7     the option / result payload: 0 int, 1 bool, 2 buffer, 3 text
//     8     1 when a result's error type is a buffer
//     9 10  the byte range of the type that cannot be expressed
//     11    1 when the signature has a heap
//     12..  parameter i: its type's byte range at 12 + 2i; its kind at 76 + i (0 int, 1 bool, 2 text, 3 heap)

import std.buffer;
import std.bytes;
import std.json;

fn max_params() -> [] int { return 32; }
fn sg_len() -> [] int { return 144; }

fn byte_at[&t](t: &t [byte], i: int) -> [] int {
    if i < 0 || i >= len(t) {
        return 0 - 1;
    }
    return int_of(t[i]);
}

fn is_start(c: int) -> [] bool {
    return bytes.is_alpha(c) || c == 95;
}

fn is_part(c: int) -> [] bool {
    return bytes.is_alpha(c) || bytes.is_digit(c) || c == 95;
}

fn is_ws(c: int) -> [] bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn skip_sp[&t](t: &t [byte], p: int) -> [] int {
    var i = p;
    while byte_at(t, i) == 32 {
        i = i + 1;
    }
    return i;
}

fn ident_end[&t](t: &t [byte], p: int) -> [] int {
    if !is_start(byte_at(t, p)) {
        return p;
    }
    var i = p + 1;
    while is_part(byte_at(t, i)) {
        i = i + 1;
    }
    return i;
}

// The range a..b of `t` without leading and trailing whitespace.
fn trim_range[&t](t: &t [byte], a: int, b: int) -> [] (int, int) {
    var x = a;
    var y = b;
    while x < y && is_ws(byte_at(t, x)) {
        x = x + 1;
    }
    while y > x && is_ws(byte_at(t, y - 1)) {
        y = y - 1;
    }
    return (x, y);
}

// ---- the signature --------------------------------------------------------------

// `&r X` (or `&!r X` when `bang`): where X starts, or -1.
fn amp_rest[&t](t: &t [byte], bang: bool) -> [] int {
    if byte_at(t, 0) != 38 {
        return 0 - 1;
    }
    var p = 1;
    if bang {
        if byte_at(t, 1) != 33 {
            return 0 - 1;
        }
        p = 2;
    }
    let e = ident_end(t, p);
    if e == p {
        return 0 - 1;
    }
    return skip_sp(t, e);
}

fn is_text_type[&t](t: &t [byte]) -> [] bool {
    let r = amp_rest(t, false);
    return r >= 0 && bytes.equal(t[r..len(t)], "[byte]");
}

// The list type the plan uses for a list of text (cancho#461: a Box of a Box).
fn list_type() -> [] &static [byte] { return "list.List[Box[Box[[byte]]]]"; }

// 0 int, 1 bool, 2 text, 3 heap, 4 list of text, 5 vec of text slices; plus 16 when the text parameter is `&static`. -1 for anything else.
fn classify_param[&t](t: &t [byte]) -> [] int {
    if bytes.equal(t, "int") {
        return 0;
    }
    if bytes.equal(t, "bool") {
        return 1;
    }
    let r = amp_rest(t, false);
    if r >= 0 {
        let rest = t[r..len(t)];
        if bytes.equal(rest, "[byte]") {
            let e = ident_end(t, 1);
            if bytes.equal(t[1..e], "static") {
                return 18;
            }
            return 2;
        }
        if bytes.equal(rest, list_type()) {
            return 4;
        }
        if len(rest) > 9 && bytes.starts_with(rest, "vec.Vec[") && byte_at(rest, len(rest) - 1) == 93 {
            let (a, b) = trim_range(rest, 8, len(rest) - 1);
            if is_text_type(rest[a..b]) {
                return 5;
            }
        }
    }
    let h = amp_rest(t, true);
    if h >= 0 && bytes.equal(t[h..len(t)], "Heap") {
        return 3;
    }
    return 0 - 1;
}

// The value kind of a plain type: 0 int, 1 bool, 2 buffer, 3 text slice, 4 list of text, 5 owned box; -1 for another.
fn plain_v[&t](t: &t [byte]) -> [] int {
    if bytes.equal(t, "int") {
        return 0;
    }
    if bytes.equal(t, "bool") {
        return 1;
    }
    if bytes.equal(t, "buffer.Buffer") {
        return 2;
    }
    if is_text_type(t) {
        return 3;
    }
    if bytes.equal(t, list_type()) {
        return 4;
    }
    if bytes.equal(t, "Box[[byte]]") {
        return 5;
    }
    return 0 - 1;
}

// `option.Option[X]` (X an int, a bool, a buffer or a text slice): the value kind of X; -2 when `t` is not an option, -1 when it is an
// option of something else.
fn opt_inner[&t](t: &t [byte]) -> [] int {
    let last = len(t) - 1;
    if len(t) >= 15 && bytes.starts_with(t, "option.Option[") && byte_at(t, last) == 93 {
        let (a, b) = trim_range(t, 14, last);
        let v = plain_v(t[a..b]);
        if v < 0 || v >= 4 {
            return 0 - 1;
        }
        return v;
    }
    return 0 - 2;
}

// The return type `t` (trimmed; `base` is where it starts in the signature). 0 when it can be expressed, else 2 with the offending
// type's range in sg[9], sg[10]. Writes sg[6] outer (0 plain, 1 option, 2 result), sg[7] the value kind, sg[8] the error type (0 other,
// 1 int, 2 buffer), sg[140] 1 when a result holds an option.
fn classify_ret[&t, &g](t: &t [byte], base: int, sg: &!g [int]) -> [] int {
    sg[9] = base;
    sg[10] = base + len(t);
    let v = plain_v(t);
    if v >= 0 {
        sg[6] = 0;
        sg[7] = v;
        return 0;
    }
    let o = opt_inner(t);
    if o == 0 - 1 {
        return 2;
    }
    if o >= 0 {
        sg[6] = 1;
        sg[7] = o;
        return 0;
    }
    let last = len(t) - 1;
    if len(t) >= 15 && bytes.starts_with(t, "result.Result[") && byte_at(t, last) == 93 {
        var depth = 0;
        var comma = 0 - 1;
        var i = 14;
        while i < last && comma < 0 {
            let ch = byte_at(t, i);
            if ch == 40 || ch == 91 {
                depth = depth + 1;
            } else if ch == 41 || ch == 93 {
                depth = depth - 1;
            } else if ch == 44 && depth == 0 {
                comma = i;
            }
            i = i + 1;
        }
        if comma < 0 {
            return 2;
        }
        let (a, b) = trim_range(t, 14, comma);
        let (c, d) = trim_range(t, comma + 1, last);
        let tt = t[a..b];
        var e = 0;
        if bytes.equal(t[c..d], "int") {
            e = 1;
        } else if bytes.equal(t[c..d], "buffer.Buffer") {
            e = 2;
        }
        let o2 = opt_inner(tt);
        if o2 == 0 - 1 {
            sg[9] = base + a;
            sg[10] = base + b;
            return 2;
        }
        if o2 >= 0 {
            sg[6] = 2;
            sg[7] = o2;
            sg[8] = e;
            sg[140] = 1;
            return 0;
        }
        let v2 = plain_v(tt);
        if v2 < 0 {
            sg[9] = base + a;
            sg[10] = base + b;
            return 2;
        }
        sg[6] = 2;
        sg[7] = v2;
        sg[8] = e;
        return 0;
    }
    return 2;
}

// Read `fn NAME[regions](params) -> [row] TYPE` into `sg`. 0 ok; 1 the signature cannot be read; 2 a type cannot be expressed; 3 too many
// parameters.
fn parse_sig[&t, &g](t: &t [byte], sg: &!g [int]) -> [] int {
    if !bytes.starts_with(t, "fn ") {
        return 1;
    }
    let a = skip_sp(t, 3);
    let b = ident_end(t, a);
    if b == a {
        return 1;
    }
    sg[0] = a;
    sg[1] = b;
    var c = skip_sp(t, b);
    if byte_at(t, c) == 91 {
        var q = c;
        while q < len(t) && byte_at(t, q) != 93 {
            q = q + 1;
        }
        if q >= len(t) {
            return 1;
        }
        c = skip_sp(t, q + 1);
    }
    if byte_at(t, c) != 40 {
        return 1;
    }
    var depth = 0;
    var i = c;
    var close = 0 - 1;
    while i < len(t) && close < 0 {
        let ch = byte_at(t, i);
        if ch == 40 || ch == 91 {
            depth = depth + 1;
        } else if ch == 41 || ch == 93 {
            depth = depth - 1;
            if depth == 0 {
                close = i;
            }
        }
        i = i + 1;
    }
    if close < 0 || byte_at(t, close) != 41 {
        return 1;
    }
    let d = skip_sp(t, close + 1);
    if byte_at(t, d) != 45 || byte_at(t, d + 1) != 62 {
        return 1;
    }
    let e = skip_sp(t, d + 2);
    if byte_at(t, e) != 91 {
        return 1;
    }
    var f = e;
    while f < len(t) && byte_at(t, f) != 93 {
        f = f + 1;
    }
    if f >= len(t) {
        return 1;
    }
    let (rs, re) = trim_range(t, f + 1, len(t));
    if rs == re {
        return 1;
    }
    sg[2] = rs;
    sg[3] = re;
    // the parameters: c + 1 .. close, split at the commas that are not inside brackets
    var n = 0;
    let (ia, ib) = trim_range(t, c + 1, close);
    if ia < ib {
        var start = c + 1;
        var level = 0;
        var p = c + 1;
        var fine = true;
        while p <= close && fine {
            var cut = false;
            if p == close {
                cut = true;
            } else {
                let ch = byte_at(t, p);
                if ch == 40 || ch == 91 {
                    level = level + 1;
                } else if ch == 41 || ch == 93 {
                    level = level - 1;
                } else if ch == 44 && level == 0 {
                    cut = true;
                }
            }
            if cut {
                let (pa, pb) = trim_range(t, start, p);
                if pa == pb {
                    fine = false;
                } else {
                    var colon = pa;
                    while colon < pb && byte_at(t, colon) != 58 {
                        colon = colon + 1;
                    }
                    if colon >= pb {
                        fine = false;
                    } else {
                        let (na, nb) = trim_range(t, pa, colon);
                        if na == nb || ident_end(t, na) != nb {
                            fine = false;
                        } else {
                            let (ta, tb) = trim_range(t, colon + 1, pb);
                            if n < max_params() {
                                sg[12 + 2 * n] = ta;
                                sg[13 + 2 * n] = tb;
                            }
                            n = n + 1;
                        }
                    }
                }
                start = p + 1;
            }
            p = p + 1;
        }
        if !fine {
            return 1;
        }
    }
    if n > max_params() {
        return 3;
    }
    sg[4] = n;
    var heaps = 0;
    var args = 0;
    var k = 0;
    while k < n {
        let ta = sg[12 + 2 * k];
        let tb = sg[13 + 2 * k];
        let code = classify_param(t[ta..tb]);
        var kind = code;
        if code >= 16 {
            kind = code - 16;
            sg[108 + k] = 1;
        }
        if kind == 3 {
            heaps = heaps + 1;
            if heaps > 1 {
                kind = 0 - 1;
            }
        }
        if kind < 0 {
            sg[9] = ta;
            sg[10] = tb;
            return 2;
        }
        if kind != 3 {
            args = args + 1;
        }
        sg[76 + k] = kind;
        k = k + 1;
    }
    sg[5] = args;
    sg[11] = heaps;
    return classify_ret(t[rs..re], rs, sg);
}

// ---- the report -----------------------------------------------------------------

// `[CASES_ERROR]<TAB>who<TAB>case or -<TAB>`: the message follows, then `end_line`.
fn line_head[&h, &w](heap: &!h Heap, rep: buffer.Buffer, who: &w [byte], k: int) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, rep, "[CASES_ERROR]\t");
    b = buffer.append(heap, b, who);
    b = buffer.append(heap, b, "\t");
    if k > 0 {
        b = buffer.push_nat(heap, b, k);
    } else {
        b = buffer.append(heap, b, "-");
    }
    return buffer.append(heap, b, "\t");
}

fn emit[&h, &w, &m](heap: &!h Heap, rep: buffer.Buffer, who: &w [byte], k: int, msg: &m [byte]) -> [heap] buffer.Buffer {
    var b = line_head(heap, rep, who, k);
    b = buffer.append(heap, b, msg);
    return buffer.push(heap, b, byte_of(10));
}

fn kind_desc[&t](tape: &t [int], i: int) -> [] &static [byte] {
    let k = json.kind(tape, i);
    if k == 0 {
        return "null";
    }
    if k == 1 || k == 2 {
        return "a boolean";
    }
    if k == 3 {
        return "an integer";
    }
    if k == 4 {
        return "a number that is not an integer";
    }
    if k == 5 {
        return "a string";
    }
    if k == 6 {
        return "a list";
    }
    return "an object";
}

// A value problem: `st` 1 wrong kind, 2 out of range, 4 a "bytes" list that is not one, 5 text a &static parameter cannot take, 6 text a
// vec cannot hold. `vk` is what was wanted (0 int, 1 bool, 2 text, 3 list of text); `wk` names the value: 0 "argument N", 1 "expect",
// 2 `expect "ok"`, 3 `expect "err"`; `item` is the 1-based element of a list (0 for the value itself).
fn emit_value[&h, &w, &t](heap: &!h Heap, rep: buffer.Buffer, who: &w [byte], k: int, st: int, vk: int, wk: int, argno: int, item: int, tape: &t [int], node: int) -> [heap] buffer.Buffer {
    var b = line_head(heap, rep, who, k);
    if wk == 0 {
        b = buffer.append(heap, b, "argument ");
        b = buffer.push_nat(heap, b, argno);
    } else if wk == 1 {
        b = buffer.append(heap, b, "expect");
    } else if wk == 2 {
        b = buffer.append(heap, b, "expect \"ok\"");
    } else {
        b = buffer.append(heap, b, "expect \"err\"");
    }
    if item > 0 {
        b = buffer.append(heap, b, " item ");
        b = buffer.push_nat(heap, b, item);
    }
    if st == 1 {
        b = buffer.append(heap, b, " must be ");
        if vk == 0 {
            b = buffer.append(heap, b, "a JSON integer");
        } else if vk == 1 {
            b = buffer.append(heap, b, "true or false");
        } else if vk == 2 || item > 0 {
            b = buffer.append(heap, b, "a JSON string");
        } else {
            b = buffer.append(heap, b, "a JSON list of strings");
        }
        b = buffer.append(heap, b, ", got ");
        b = buffer.append(heap, b, kind_desc(tape, node));
    } else if st == 2 {
        b = buffer.append(heap, b, " is out of the range of int");
    } else if st == 4 {
        b = buffer.append(heap, b, " has a \"bytes\" list that is not a list of integers 0 to 255");
    } else if st == 5 {
        b = buffer.append(heap, b, " cannot be written in a cancho string literal and the parameter is &static; use another input");
    } else {
        b = buffer.append(heap, b, " cannot be written in a cancho string literal (a vec holds literals); use another input");
    }
    return buffer.push(heap, b, byte_of(10));
}

// ---- literals -------------------------------------------------------------------

fn put_int_lit[&h](heap: &!h Heap, out: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    if n >= 0 {
        return buffer.push_nat(heap, out, n);
    }
    if n == 0 - 9223372036854775807 - 1 {
        // no literal for it: the language reads the magnitude first
        return buffer.append(heap, out, "0 - 9223372036854775807 - 1");
    }
    let b = buffer.push(heap, out, byte_of(45));
    return buffer.push_nat(heap, b, 0 - n);
}

// An int (vk 0) or a bool (vk 1) as a literal appended to `out`; status 0, 1 wrong kind, 2 out of range.
fn put_scalar[&h, &s, &t](heap: &!h Heap, out: buffer.Buffer, vk: int, src: &s [byte], tape: &t [int], node: int) -> [heap] (buffer.Buffer, int) {
    if vk == 0 {
        if !json.is_int(tape, node) {
            return (out, 1);
        }
        if !json.fits_int(src, tape, node) {
            return (out, 2);
        }
        return (put_int_lit(heap, out, json.to_int(src, tape, node)), 0);
    }
    if !json.is_bool(tape, node) {
        return (out, 1);
    }
    if json.to_bool(tape, node) {
        return (buffer.append(heap, out, "true"), 0);
    }
    return (buffer.append(heap, out, "false"), 0);
}

fn cont_ok[&t](t: &t [byte], i: int, k: int, lo: int, hi: int) -> [] bool {
    let c = byte_at(t, i + k);
    return c >= lo && c <= hi;
}

// The valid UTF-8 sequence at `i`: its length and code point, or (0, 0).
fn utf8_seq[&t](t: &t [byte], i: int) -> [] (int, int) {
    let c = byte_at(t, i);
    if c >= 194 && c <= 223 && cont_ok(t, i, 1, 128, 191) {
        return (2, ((c & 31) << 6) | (byte_at(t, i + 1) & 63));
    }
    if c >= 224 && c <= 239 {
        var lo = 128;
        var hi = 191;
        if c == 224 {
            lo = 160;
        }
        if c == 237 {
            hi = 159;
        }
        if cont_ok(t, i, 1, lo, hi) && cont_ok(t, i, 2, 128, 191) {
            return (3, ((c & 15) << 12) | ((byte_at(t, i + 1) & 63) << 6) | (byte_at(t, i + 2) & 63));
        }
    }
    if c >= 240 && c <= 244 {
        var lo = 128;
        var hi = 191;
        if c == 240 {
            lo = 144;
        }
        if c == 244 {
            hi = 143;
        }
        if cont_ok(t, i, 1, lo, hi) && cont_ok(t, i, 2, 128, 191) && cont_ok(t, i, 3, 128, 191) {
            return (4, ((c & 7) << 18) | ((byte_at(t, i + 1) & 63) << 12) | ((byte_at(t, i + 2) & 63) << 6) | (byte_at(t, i + 3) & 63));
        }
    }
    return (0, 0);
}

fn is_escaped(c: int) -> [] bool {
    return c == 34 || c == 92 || c == 10 || c == 9 || c == 13 || c == 0;
}

// Can every byte of `t` be written in a cancho string literal? The lexer takes printable ASCII, the escapes \" \\ \n \t \r \0 and UTF-8
// text; the other control bytes, DEL, the C1 controls, U+2028, U+2029, U+FEFF and bytes that are not UTF-8 are built from hex instead.
fn lit_ok[&t](t: &t [byte]) -> [] bool {
    var i = 0;
    while i < len(t) {
        let c = int_of(t[i]);
        if is_escaped(c) || (c >= 32 && c <= 126) {
            i = i + 1;
        } else {
            let (n, cp) = utf8_seq(t, i);
            if n == 0 || cp < 160 || cp == 8232 || cp == 8233 || cp == 65279 {
                return false;
            }
            i = i + n;
        }
    }
    return true;
}

// `t` as a string literal (only when `lit_ok`).
fn put_lit_text[&h, &t](heap: &!h Heap, out: buffer.Buffer, t: &t [byte]) -> [heap] buffer.Buffer {
    var o = buffer.push(heap, out, byte_of(34));
    var i = 0;
    while i < len(t) {
        let c = int_of(t[i]);
        if c == 34 {
            o = buffer.append(heap, o, "\\\"");
            i = i + 1;
        } else if c == 92 {
            o = buffer.append(heap, o, "\\\\");
            i = i + 1;
        } else if c == 10 {
            o = buffer.append(heap, o, "\\n");
            i = i + 1;
        } else if c == 9 {
            o = buffer.append(heap, o, "\\t");
            i = i + 1;
        } else if c == 13 {
            o = buffer.append(heap, o, "\\r");
            i = i + 1;
        } else if c == 0 {
            o = buffer.append(heap, o, "\\0");
            i = i + 1;
        } else if c >= 32 && c <= 126 {
            o = buffer.push(heap, o, t[i]);
            i = i + 1;
        } else {
            let (n, cp) = utf8_seq(t, i);
            o = buffer.append(heap, o, t[i..i + n]);
            i = i + n;
        }
    }
    return buffer.push(heap, o, byte_of(34));
}

fn hex_digit(n: int) -> [] byte {
    if n < 10 {
        return byte_of(48 + n);
    }
    return byte_of(87 + n);
}

fn put_hex[&h, &t](heap: &!h Heap, out: buffer.Buffer, t: &t [byte]) -> [heap] buffer.Buffer {
    var o = out;
    var i = 0;
    while i < len(t) {
        let c = int_of(t[i]);
        o = buffer.push(heap, o, hex_digit(c / 16));
        o = buffer.push(heap, o, hex_digit(c % 16));
        i = i + 1;
    }
    return o;
}

// A text value of the plan as bytes: a JSON string (its UTF-8) or {"bytes": [0..255, ...]}. The bytes in a box of n + 1, the count n and a
// status: 0, 1 not a text, 4 a "bytes" list that is not a list of integers 0 to 255.
fn fetch_text[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int) -> [heap] (Box[[byte]], int, int) {
    if json.is_string(tape, node) {
        let n = json.string_length(src, tape, node);
        let b = box_slice(heap, n + 1, byte_of(0));
        borrow mut b as &!w in {
            json.string_into(src, tape, node, contents(w));
        }
        return (b, n, 0);
    }
    if json.is_object(tape, node) && json.count(tape, node) == 1 && json.get(src, tape, node, "bytes") >= 0 {
        let bn = json.get(src, tape, node, "bytes");
        if !json.is_array(tape, bn) {
            return (box_slice(heap, 1, byte_of(0)), 0, 4);
        }
        let cnt = json.count(tape, bn);
        let b = box_slice(heap, cnt + 1, byte_of(0));
        var st = 0;
        borrow mut b as &!w in {
            let text = contents(w);
            var j = bn + 1;
            var i = 0;
            while i < cnt {
                if json.is_int(tape, j) && json.fits_int(src, tape, j) && json.to_int(src, tape, j) >= 0 && json.to_int(src, tape, j) <= 255 {
                    text[i] = byte_of(json.to_int(src, tape, j));
                } else {
                    st = 4;
                }
                j = json.skip(tape, j);
                i = i + 1;
            }
        }
        return (b, cnt, st);
    }
    return (box_slice(heap, 1, byte_of(0)), 0, 1);
}

// ---- the generated code ---------------------------------------------------------

// The accumulator of one unit.
res struct Gen {
    rep: buffer.Buffer,
    // the test items (NUL after each)
    items: buffer.Buffer,
    // the example lines (NUL after each)
    exs: buffer.Buffer,
    nex: int,
    // bit h: helper h is used (1 is, 2 some, 3 none, 4 ok, 5 err, 6 errn, 7 oksome, 8 oknone); bit 9 mk, 10 unhex, 11 ldrop
    used: int,
    errs: int,
}

// A text-like value as the generated code uses it: the expression, how it is documented, the statements that build it and free it, and
// the name of the local (empty when the value is a literal).
res struct Val {
    vexpr: buffer.Buffer,
    vdoc: buffer.Buffer,
    vlocs: buffer.Buffer,
    vdrops: buffer.Buffer,
    vnm: buffer.Buffer,
    vnodoc: int,
    vfeats: int,
    vst: int,
    vitem: int,
    venode: int,
}

// One case, in pieces.
res struct Parts {
    call: buffer.Buffer,
    calld: buffer.Buffer,
    want: buffer.Buffer,
    wantd: buffer.Buffer,
    locs: buffer.Buffer,
    opens: buffer.Buffer,
    drops: buffer.Buffer,
    rep: buffer.Buffer,
    nopen: int,
    nodoc: int,
    feats: int,
}

fn val_new[&h](heap: &!h Heap) -> [heap] Val {
    return Val { vexpr: buffer.empty(heap, 32), vdoc: buffer.empty(heap, 32), vlocs: buffer.empty(heap, 16), vdrops: buffer.empty(heap, 16), vnm: buffer.empty(heap, 8), vnodoc: 0, vfeats: 0, vst: 0, vitem: 0, venode: 0 - 1 };
}

fn parts_new[&h](heap: &!h Heap, rep: buffer.Buffer) -> [heap] Parts {
    return Parts { call: buffer.empty(heap, 64), calld: buffer.empty(heap, 64), want: buffer.empty(heap, 32), wantd: buffer.empty(heap, 32), locs: buffer.empty(heap, 16), opens: buffer.empty(heap, 16), drops: buffer.empty(heap, 16), rep: rep, nopen: 0, nodoc: 0, feats: 0 };
}

fn parts_drop[&h](heap: &!h Heap, p: Parts) -> [heap] buffer.Buffer {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    buffer.drop(heap, call);
    buffer.drop(heap, calld);
    buffer.drop(heap, want);
    buffer.drop(heap, wantd);
    buffer.drop(heap, locs);
    buffer.drop(heap, opens);
    buffer.drop(heap, drops);
    return rep;
}

fn helper_name(h: int) -> [] &static [byte] {
    if h == 1 {
        return "is";
    }
    if h == 2 {
        return "some";
    }
    if h == 3 {
        return "none";
    }
    if h == 4 {
        return "ok";
    }
    if h == 5 {
        return "err";
    }
    if h == 6 {
        return "errn";
    }
    if h == 7 {
        return "oksome";
    }
    return "oknone";
}

fn put_name[&h](heap: &!h Heap, b: buffer.Buffer, isw: bool, argno: int) -> [heap] buffer.Buffer {
    if isw {
        return buffer.append(heap, b, "w");
    }
    return buffer.push_nat(heap, buffer.append(heap, b, "a"), argno);
}

// A text for an argument or a want: a literal when it can be one, else a local built from its hex (`isw`: the want, else argument `argno`).
fn text_val[&h, &s, &t, &d](heap: &!h Heap, v: Val, src: &s [byte], tape: &t [int], node: int, sid: &d [byte], isw: bool, argno: int, static: bool) -> [heap] Val {
    let Val { vexpr, vdoc, vlocs, vdrops, vnm, vnodoc, vfeats, vst, vitem, venode } = v;
    var e = vexpr;
    var dc = vdoc;
    var lc = vlocs;
    var dr = vdrops;
    var nmv = vnm;
    var nd = vnodoc;
    var ft = vfeats;
    let (b, n, st0) = fetch_text(heap, src, tape, node);
    var stn = st0;
    borrow mut b as &!bw in {
        let text = contents(bw)[0..n];
        if st0 == 0 {
            if lit_ok(text) {
                e = put_lit_text(heap, e, text);
                dc = put_lit_text(heap, dc, text);
            } else if static {
                stn = 5;
            } else {
                nd = 1;
                ft = ft | 2;
                nmv = put_name(heap, nmv, isw, argno);
                borrow nmv as &nr in {
                    let name = buffer.bytes(nr);
                    lc = buffer.append(heap, lc, "let ");
                    lc = buffer.append(heap, lc, name);
                    lc = buffer.append(heap, lc, " = cases_");
                    lc = buffer.append(heap, lc, sid);
                    lc = buffer.append(heap, lc, "_unhex(heap, \"");
                    lc = put_hex(heap, lc, text);
                    lc = buffer.append(heap, lc, "\");");
                    dr = buffer.append(heap, dr, "unbox_slice(heap, ");
                    dr = buffer.append(heap, dr, name);
                    dr = buffer.append(heap, dr, ");");
                    e = buffer.append(heap, e, "contents(r");
                    e = buffer.append(heap, e, name);
                    e = buffer.append(heap, e, ")");
                }
            }
        }
    }
    unbox_slice(heap, b);
    return Val { vexpr: e, vdoc: dc, vlocs: lc, vdrops: dr, vnm: nmv, vnodoc: nd, vfeats: ft, vst: stn, vitem: 0, venode: node };
}

// A list of text (a vec of literals when `isvec`) for an argument or a want.
fn list_val[&h, &s, &t, &d](heap: &!h Heap, v: Val, src: &s [byte], tape: &t [int], node: int, sid: &d [byte], isw: bool, argno: int, isvec: bool) -> [heap] Val {
    let Val { vexpr, vdoc, vlocs, vdrops, vnm, vnodoc, vfeats, vst, vitem, venode } = v;
    var e = vexpr;
    var dc = vdoc;
    var lc = vlocs;
    var dr = vdrops;
    var nmv = vnm;
    var nd = vnodoc;
    var ft = vfeats;
    var stn = 0;
    var it = 0;
    var en = node;
    if !json.is_array(tape, node) {
        stn = 1;
    } else {
        let cnt = json.count(tape, node);
        dc = buffer.append(heap, dc, "[");
        var j = node + 1;
        var i = 1;
        while i <= cnt && stn == 0 {
            let (b, n, st0) = fetch_text(heap, src, tape, j);
            borrow mut b as &!bw in {
                let text = contents(bw)[0..n];
                if st0 != 0 {
                    stn = st0;
                    it = i;
                    en = j;
                } else if lit_ok(text) {
                    if i > 1 {
                        dc = buffer.append(heap, dc, ", ");
                    }
                    dc = put_lit_text(heap, dc, text);
                } else if isvec {
                    stn = 6;
                    it = i;
                    en = j;
                } else {
                    nd = 1;
                }
            }
            unbox_slice(heap, b);
            j = json.skip(tape, j);
            i = i + 1;
        }
        dc = buffer.append(heap, dc, "]");
        if stn == 0 {
            nmv = put_name(heap, nmv, isw, argno);
            borrow nmv as &nr in {
                let name = buffer.bytes(nr);
                if isvec {
                    lc = buffer.append(heap, lc, "var ");
                    lc = buffer.append(heap, lc, name);
                    lc = buffer.append(heap, lc, " = vec.empty(heap, ");
                    lc = buffer.push_nat(heap, lc, cnt + 1);
                    lc = buffer.append(heap, lc, ", \"\");");
                    var k = 0;
                    while k < cnt {
                        let (b, n, st0) = fetch_text(heap, src, tape, json.at(tape, node, k));
                        borrow mut b as &!bw in {
                            lc = buffer.append(heap, lc, " ");
                            lc = buffer.append(heap, lc, name);
                            lc = buffer.append(heap, lc, " = vec.push(heap, ");
                            lc = buffer.append(heap, lc, name);
                            lc = buffer.append(heap, lc, ", ");
                            lc = put_lit_text(heap, lc, contents(bw)[0..n]);
                            lc = buffer.append(heap, lc, ");");
                        }
                        unbox_slice(heap, b);
                        k = k + 1;
                    }
                    dr = buffer.append(heap, dr, "vec.drop(heap, ");
                    dr = buffer.append(heap, dr, name);
                    dr = buffer.append(heap, dr, ");");
                } else {
                    ft = ft | 4;
                    lc = buffer.append(heap, lc, "var ");
                    lc = buffer.append(heap, lc, name);
                    lc = buffer.append(heap, lc, ": list.List[Box[Box[[byte]]]] = list.List::Empty;");
                    var k = cnt;
                    while k > 0 {
                        let (b, n, st0) = fetch_text(heap, src, tape, json.at(tape, node, k - 1));
                        borrow mut b as &!bw in {
                            let text = contents(bw)[0..n];
                            lc = buffer.append(heap, lc, " ");
                            lc = buffer.append(heap, lc, name);
                            lc = buffer.append(heap, lc, " = list.push(heap, ");
                            lc = buffer.append(heap, lc, name);
                            lc = buffer.append(heap, lc, ", box(heap, cases_");
                            lc = buffer.append(heap, lc, sid);
                            if lit_ok(text) {
                                ft = ft | 1;
                                lc = buffer.append(heap, lc, "_mk(heap, ");
                                lc = put_lit_text(heap, lc, text);
                                lc = buffer.append(heap, lc, ")");
                            } else {
                                ft = ft | 2;
                                lc = buffer.append(heap, lc, "_unhex(heap, \"");
                                lc = put_hex(heap, lc, text);
                                lc = buffer.append(heap, lc, "\")");
                            }
                            lc = buffer.append(heap, lc, "));");
                        }
                        unbox_slice(heap, b);
                        k = k - 1;
                    }
                    dr = buffer.append(heap, dr, "cases_");
                    dr = buffer.append(heap, dr, sid);
                    dr = buffer.append(heap, dr, "_ldrop(heap, ");
                    dr = buffer.append(heap, dr, name);
                    dr = buffer.append(heap, dr, ");");
                }
                e = buffer.append(heap, e, "r");
                e = buffer.append(heap, e, name);
            }
        }
    }
    return Val { vexpr: e, vdoc: dc, vlocs: lc, vdrops: dr, vnm: nmv, vnodoc: nd, vfeats: ft, vst: stn, vitem: it, venode: en };
}

// An int or a bool.
fn scalar_val[&h, &s, &t](heap: &!h Heap, v: Val, vk: int, src: &s [byte], tape: &t [int], node: int) -> [heap] Val {
    let Val { vexpr, vdoc, vlocs, vdrops, vnm, vnodoc, vfeats, vst, vitem, venode } = v;
    let (e, s1) = put_scalar(heap, vexpr, vk, src, tape, node);
    var dc = vdoc;
    if s1 == 0 {
        borrow e as &er in {
            dc = buffer.append(heap, dc, buffer.bytes(er));
        }
    }
    return Val { vexpr: e, vdoc: dc, vlocs: vlocs, vdrops: vdrops, vnm: vnm, vnodoc: vnodoc, vfeats: vfeats, vst: s1, vitem: 0, venode: node };
}

fn buf_text[&h, &b](heap: &!h Heap, out: buffer.Buffer, b: &b buffer.Buffer) -> [heap] buffer.Buffer {
    return buffer.append(heap, out, buffer.bytes(b));
}

// Take a value into the case: `sep` puts ", " first; the want (`to_want`) or an argument; `pre` and `post` wrap the doc of a want.
fn absorb[&h, &a, &b](heap: &!h Heap, p: Parts, v: Val, to_want: bool, sep: bool, pre: &a [byte], post: &b [byte]) -> [heap] Parts {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    let Val { vexpr, vdoc, vlocs, vdrops, vnm, vnodoc, vfeats, vst, vitem, venode } = v;
    var c = call;
    var cd = calld;
    var w = want;
    var wd = wantd;
    var lc = locs;
    var op = opens;
    var dr = drops;
    var nn = nopen;
    var vsize = 0;
    borrow vlocs as &lr in {
        vsize = buffer.size(lr);
    }
    if to_want {
        borrow vexpr as &er in {
            w = buffer.append(heap, w, buffer.bytes(er));
        }
        wd = buffer.append(heap, wd, pre);
        borrow vdoc as &dr2 in {
            wd = buffer.append(heap, wd, buffer.bytes(dr2));
        }
        wd = buffer.append(heap, wd, post);
    } else {
        if sep {
            c = buffer.append(heap, c, ", ");
            cd = buffer.append(heap, cd, ", ");
        }
        borrow vexpr as &er in {
            c = buffer.append(heap, c, buffer.bytes(er));
        }
        borrow vdoc as &dr2 in {
            cd = buffer.append(heap, cd, buffer.bytes(dr2));
        }
    }
    if vsize > 0 {
        borrow vlocs as &lr in {
            lc = buffer.append(heap, lc, buffer.bytes(lr));
        }
        lc = buffer.append(heap, lc, " ");
        borrow vnm as &nr in {
            op = buffer.append(heap, op, "borrow ");
            op = buffer.append(heap, op, buffer.bytes(nr));
            op = buffer.append(heap, op, " as &r");
            op = buffer.append(heap, op, buffer.bytes(nr));
            op = buffer.append(heap, op, " in { ");
        }
        nn = nn + 1;
        borrow vdrops as &xr in {
            dr = buffer.append(heap, dr, buffer.bytes(xr));
        }
        dr = buffer.append(heap, dr, " ");
    }
    buffer.drop(heap, vexpr);
    buffer.drop(heap, vdoc);
    buffer.drop(heap, vlocs);
    buffer.drop(heap, vdrops);
    buffer.drop(heap, vnm);
    return Parts { call: c, calld: cd, want: w, wantd: wd, locs: lc, opens: op, drops: dr, rep: rep, nopen: nn, nodoc: nodoc | vnodoc, feats: feats | vfeats };
}

fn parts_msg[&h, &w, &m](heap: &!h Heap, p: Parts, who: &w [byte], k: int, msg: &m [byte]) -> [heap] Parts {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    return Parts { call: call, calld: calld, want: want, wantd: wantd, locs: locs, opens: opens, drops: drops, rep: emit(heap, rep, who, k, msg), nopen: nopen, nodoc: nodoc, feats: feats };
}

fn parts_wantdoc[&h, &m](heap: &!h Heap, p: Parts, text: &m [byte]) -> [heap] Parts {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    return Parts { call: call, calld: calld, want: want, wantd: buffer.append(heap, wantd, text), locs: locs, opens: opens, drops: drops, rep: rep, nopen: nopen, nodoc: nodoc, feats: feats };
}

fn parts_raw[&h, &m, &n](heap: &!h Heap, p: Parts, sep: bool, expr: &m [byte], doc: &n [byte]) -> [heap] Parts {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    var c = call;
    var cd = calld;
    if sep {
        c = buffer.append(heap, c, ", ");
        cd = buffer.append(heap, cd, ", ");
    }
    return Parts { call: buffer.append(heap, c, expr), calld: buffer.append(heap, cd, doc), want: want, wantd: wantd, locs: locs, opens: opens, drops: drops, rep: rep, nopen: nopen, nodoc: nodoc, feats: feats };
}

// The value's status, its list item and the node to describe, read before it is taken.
fn val_status[&v](v: &v Val) -> [] (int, int, int) {
    return (v.vst, v.vitem, v.venode);
}

// A value problem of the case, into the report.
fn parts_vale[&h, &w, &t](heap: &!h Heap, p: Parts, who: &w [byte], k: int, st: int, vk: int, wk: int, argno: int, item: int, tape: &t [int], node: int) -> [heap] Parts {
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = p;
    return Parts { call: call, calld: calld, want: want, wantd: wantd, locs: locs, opens: opens, drops: drops, rep: emit_value(heap, rep, who, k, st, vk, wk, argno, item, tape, node), nopen: nopen, nodoc: nodoc, feats: feats };
}

// The want of the case (value kind `v`: 0 int, 1 bool, 2 buffer, 3 text, 4 list, 5 box) into the parts; `pre` and `post` wrap its doc. The
// second answer is true when the value was fine.
fn want_value[&h, &s, &t, &w, &d, &a, &b](heap: &!h Heap, p: Parts, src: &s [byte], tape: &t [int], node: int, v: int, wk: int, sid: &d [byte], who: &w [byte], k: int, pre: &a [byte], post: &b [byte]) -> [heap] (Parts, bool) {
    var vv = val_new(heap);
    var vk = 2;
    if v == 0 || v == 1 {
        vv = scalar_val(heap, vv, v, src, tape, node);
        vk = v;
    } else if v == 4 {
        vv = list_val(heap, vv, src, tape, node, sid, true, 0, false);
        vk = 3;
    } else {
        vv = text_val(heap, vv, src, tape, node, sid, true, 0, false);
    }
    var vs = 0;
    var vit = 0;
    var ven = 0;
    borrow vv as &vr in {
        let (x, y, z) = val_status(vr);
        vs = x;
        vit = y;
        ven = z;
    }
    var pp = p;
    if vs != 0 {
        pp = parts_vale(heap, pp, who, k, vs, vk, wk, 0, vit, tape, ven);
    }
    pp = absorb(heap, pp, vv, true, false, pre, post);
    return (pp, vs == 0);
}

// Validate one case and write its pieces. The second answer is the helper (0 a direct comparison, 1 is, 2 some, 3 none, 4 ok, 5 err,
// 6 errn, 7 oksome, 8 oknone), or -1 when the case was reported.
fn case_parts[&h, &s, &t, &w, &d, &g](heap: &!h Heap, p: Parts, src: &s [byte], tape: &t [int], cn: int, k: int, who: &w [byte], sid: &d [byte], sg: &!g [int]) -> [heap] (Parts, int) {
    var pp = p;
    var hh = 0 - 1;
    let a = json.get(src, tape, cn, "args");
    let ex = json.get(src, tape, cn, "expect");
    if !json.is_object(tape, cn) || !json.is_array(tape, a) || ex < 0 {
        pp = parts_msg(heap, pp, who, k, "a case must be an object with \"args\" (a list) and \"expect\"");
        return (pp, 0 - 1);
    }
    if json.count(tape, a) != sg[5] {
        var m = buffer.append(heap, buffer.empty(heap, 96), "args has ");
        m = buffer.push_nat(heap, m, json.count(tape, a));
        m = buffer.append(heap, m, " value(s) but the function takes ");
        m = buffer.push_nat(heap, m, sg[5]);
        m = buffer.append(heap, m, " (the heap is not given in args)");
        borrow m as &mr in {
            pp = parts_msg(heap, pp, who, k, buffer.bytes(mr));
        }
        buffer.drop(heap, m);
        return (pp, 0 - 1);
    }
    var i = 0;
    var ai = 0;
    var bad = false;
    while i < sg[4] && !bad {
        let pk = sg[76 + i];
        if pk == 3 {
            pp = parts_raw(heap, pp, i > 0, "heap", "heap");
        } else {
            let node = json.at(tape, a, ai);
            ai = ai + 1;
            var vv = val_new(heap);
            var vk = pk;
            if pk == 0 || pk == 1 {
                vv = scalar_val(heap, vv, pk, src, tape, node);
            } else if pk == 2 {
                vv = text_val(heap, vv, src, tape, node, sid, false, ai, sg[108 + i] == 1);
            } else {
                vv = list_val(heap, vv, src, tape, node, sid, false, ai, pk == 5);
                vk = 3;
            }
            if pk == 2 {
                vk = 2;
            }
            var vs = 0;
            var vit = 0;
            var ven = 0;
            borrow vv as &vr in {
                let (x, y, z) = val_status(vr);
                vs = x;
                vit = y;
                ven = z;
            }
            if vs != 0 {
                pp = parts_vale(heap, pp, who, k, vs, vk, 0, ai, vit, tape, ven);
                bad = true;
            }
            pp = absorb(heap, pp, vv, false, i > 0, "", "");
        }
        i = i + 1;
    }
    if bad {
        return (pp, 0 - 1);
    }
    let outer = sg[6];
    let v = sg[7];
    let e = sg[8];
    let topt = sg[140];
    if outer == 0 {
        let (p2, fine) = want_value(heap, pp, src, tape, ex, v, 1, sid, who, k, "", "");
        pp = p2;
        if fine {
            hh = 1;
            if v == 0 || v == 1 {
                hh = 0;
            }
        }
    } else if outer == 1 {
        if json.is_null(tape, ex) {
            pp = parts_wantdoc(heap, pp, "option.Option::None");
            hh = 3;
        } else {
            let (p2, fine) = want_value(heap, pp, src, tape, ex, v, 1, sid, who, k, "option.Option::Some(", ")");
            pp = p2;
            if fine {
                hh = 2;
            }
        }
    } else if !(json.is_object(tape, ex) && json.count(tape, ex) == 1 && (json.get(src, tape, ex, "ok") >= 0 || json.get(src, tape, ex, "err") >= 0)) {
        pp = parts_msg(heap, pp, who, k, "expect for a Result must be {\"ok\": value} or {\"err\": anything}");
    } else if json.get(src, tape, ex, "err") >= 0 {
        let x = json.get(src, tape, ex, "err");
        if e == 1 && json.is_int(tape, x) {
            let (p2, fine) = want_value(heap, pp, src, tape, x, 0, 3, sid, who, k, "result.Result::Err(", ")");
            pp = p2;
            if fine {
                hh = 6;
            }
        } else {
            pp = parts_wantdoc(heap, pp, "result.Result::Err");
            hh = 5;
        }
    } else {
        let x = json.get(src, tape, ex, "ok");
        if topt == 1 {
            if json.is_null(tape, x) {
                pp = parts_wantdoc(heap, pp, "result.Result::Ok(option.Option::None)");
                hh = 8;
            } else {
                let (p2, fine) = want_value(heap, pp, src, tape, x, v, 2, sid, who, k, "result.Result::Ok(option.Option::Some(", "))");
                pp = p2;
                if fine {
                    hh = 7;
                }
            }
        } else {
            let (p2, fine) = want_value(heap, pp, src, tape, x, v, 2, sid, who, k, "result.Result::Ok(", ")");
            pp = p2;
            if fine {
                hh = 4;
            }
        }
    }
    return (pp, hh);
}

fn do_case[&h, &s, &t, &w, &d, &n, &g](heap: &!h Heap, gen: Gen, src: &s [byte], tape: &t [int], cn: int, k: int, who: &w [byte], sid: &d [byte], name: &n [byte], sg: &!g [int]) -> [heap] Gen {
    let Gen { rep, items, exs, nex, used, errs } = gen;
    let p = parts_new(heap, rep);
    let (done, helper) = case_parts(heap, p, src, tape, cn, k, who, sid, sg);
    let Parts { call, calld, want, wantd, locs, opens, drops, rep, nopen, nodoc, feats } = done;
    var items_b = items;
    var exs_b = exs;
    var nex_n = nex;
    var used_n = used;
    var errs_n = errs;
    if helper < 0 {
        errs_n = errs_n + 1;
    } else {
        used_n = used_n | (feats << 9);
        var wantsize = 0;
        borrow want as &x in {
            wantsize = buffer.size(x);
        }
        var callsize = 0;
        borrow call as &x in {
            callsize = buffer.size(x);
        }
        // what is compared or called: `NAME(CALL) == WANT`, or `cases_SID_HELPER(CALL, WANT)`
        var core = buffer.empty(heap, 96);
        if helper == 0 {
            core = buffer.append(heap, core, name);
            core = buffer.append(heap, core, "(");
            borrow call as &x in {
                core = buffer.append(heap, core, buffer.bytes(x));
            }
            core = buffer.append(heap, core, ") == ");
            borrow want as &x in {
                core = buffer.append(heap, core, buffer.bytes(x));
            }
        } else {
            used_n = used_n | (1 << helper);
            core = buffer.append(heap, core, "cases_");
            core = buffer.append(heap, core, sid);
            core = buffer.append(heap, core, "_");
            core = buffer.append(heap, core, helper_name(helper));
            core = buffer.append(heap, core, "(");
            borrow call as &x in {
                core = buffer.append(heap, core, buffer.bytes(x));
            }
            if wantsize > 0 {
                if callsize > 0 {
                    core = buffer.append(heap, core, ", ");
                }
                borrow want as &x in {
                    core = buffer.append(heap, core, buffer.bytes(x));
                }
            }
            core = buffer.append(heap, core, ")");
        }
        if nopen > 0 {
            items_b = buffer.append(heap, items_b, "fn cases_");
            items_b = buffer.append(heap, items_b, sid);
            items_b = buffer.append(heap, items_b, "_c");
            items_b = buffer.push_nat(heap, items_b, k);
            items_b = buffer.append(heap, items_b, "[&h](heap: &!h Heap) -> [heap] int { ");
            borrow locs as &x in {
                items_b = buffer.append(heap, items_b, buffer.bytes(x));
            }
            items_b = buffer.append(heap, items_b, "var code = 1; ");
            borrow opens as &x in {
                items_b = buffer.append(heap, items_b, buffer.bytes(x));
            }
            if helper == 0 {
                items_b = buffer.append(heap, items_b, "if ");
            } else {
                items_b = buffer.append(heap, items_b, "code = ");
            }
            borrow core as &x in {
                items_b = buffer.append(heap, items_b, buffer.bytes(x));
            }
            if helper == 0 {
                items_b = buffer.append(heap, items_b, " { code = 0; } ");
            } else {
                items_b = buffer.append(heap, items_b, "; ");
            }
            var c = 0;
            while c < nopen {
                items_b = buffer.append(heap, items_b, "} ");
                c = c + 1;
            }
            borrow drops as &x in {
                items_b = buffer.append(heap, items_b, buffer.bytes(x));
            }
            items_b = buffer.append(heap, items_b, "return code; }");
            items_b = buffer.push(heap, items_b, byte_of(0));
            items_b = buffer.append(heap, items_b, "pub fn test_");
            items_b = buffer.append(heap, items_b, sid);
            items_b = buffer.append(heap, items_b, "_");
            items_b = buffer.push_nat(heap, items_b, k);
            items_b = buffer.append(heap, items_b, "[&h](heap: &!h Heap) -> [heap] int { test.assert_eq(cases_");
            items_b = buffer.append(heap, items_b, sid);
            items_b = buffer.append(heap, items_b, "_c");
            items_b = buffer.push_nat(heap, items_b, k);
            items_b = buffer.append(heap, items_b, "(heap), 0); return 0; }");
        } else {
            items_b = buffer.append(heap, items_b, "pub fn test_");
            items_b = buffer.append(heap, items_b, sid);
            items_b = buffer.append(heap, items_b, "_");
            items_b = buffer.push_nat(heap, items_b, k);
            if sg[11] == 1 {
                items_b = buffer.append(heap, items_b, "[&h](heap: &!h Heap) -> [heap] int { ");
            } else {
                items_b = buffer.append(heap, items_b, "() -> [] int { ");
            }
            if helper == 0 {
                items_b = buffer.append(heap, items_b, "test.assert(");
            } else {
                items_b = buffer.append(heap, items_b, "test.assert_eq(");
            }
            borrow core as &x in {
                items_b = buffer.append(heap, items_b, buffer.bytes(x));
            }
            if helper == 0 {
                items_b = buffer.append(heap, items_b, "); return 0; }");
            } else {
                items_b = buffer.append(heap, items_b, ", 0); return 0; }");
            }
        }
        items_b = buffer.push(heap, items_b, byte_of(0));
        buffer.drop(heap, core);
        // the example: NAME(CALL) == EXPECTED, when every part can be shown
        if nodoc == 0 {
            var ln = buffer.append(heap, buffer.empty(heap, 96), name);
            ln = buffer.append(heap, ln, "(");
            var usable = true;
            borrow calld as &x in {
                ln = buffer.append(heap, ln, buffer.bytes(x));
                if bytes.find(buffer.bytes(x), " == ") >= 0 {
                    usable = false;
                }
            }
            ln = buffer.append(heap, ln, ") == ");
            borrow wantd as &x in {
                ln = buffer.append(heap, ln, buffer.bytes(x));
            }
            borrow ln as &l in {
                if bytes.find(buffer.bytes(l), "|| true") >= 0 || bytes.find(buffer.bytes(l), "or true") >= 0 {
                    usable = false;
                }
            }
            if usable && nex_n < 3 {
                borrow ln as &l in {
                    exs_b = buffer.append(heap, exs_b, buffer.bytes(l));
                }
                exs_b = buffer.push(heap, exs_b, byte_of(0));
                nex_n = nex_n + 1;
            }
            buffer.drop(heap, ln);
        }
    }
    buffer.drop(heap, call);
    buffer.drop(heap, calld);
    buffer.drop(heap, want);
    buffer.drop(heap, wantd);
    buffer.drop(heap, locs);
    buffer.drop(heap, opens);
    buffer.drop(heap, drops);
    return Gen { rep: rep, items: items_b, exs: exs_b, nex: nex_n, used: used_n, errs: errs_n };
}

// `tpl` with every `{s}` replaced by the unit's id.
fn put_tpl[&h, &a, &d](heap: &!h Heap, out: buffer.Buffer, tpl: &a [byte], sid: &d [byte]) -> [heap] buffer.Buffer {
    var o = out;
    var from = 0;
    var i = 0;
    while i < len(tpl) {
        if int_of(tpl[i]) == 123 && byte_at(tpl, i + 1) == 115 && byte_at(tpl, i + 2) == 125 {
            o = buffer.append(heap, o, tpl[from..i]);
            o = buffer.append(heap, o, sid);
            i = i + 3;
            from = i;
        } else {
            i = i + 1;
        }
    }
    return buffer.append(heap, o, tpl[from..len(tpl)]);
}

// `NAME(heap, a1, a2)`.
fn put_call[&h, &n, &g](heap: &!h Heap, out: buffer.Buffer, name: &n [byte], sg: &!g [int]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, out, name);
    b = buffer.append(heap, b, "(");
    var i = 0;
    var n = 0;
    while i < sg[4] {
        if i > 0 {
            b = buffer.append(heap, b, ", ");
        }
        if sg[76 + i] == 3 {
            b = buffer.append(heap, b, "heap");
        } else {
            n = n + 1;
            b = buffer.append(heap, b, "a");
            b = buffer.push_nat(heap, b, n);
        }
        i = i + 1;
    }
    return buffer.append(heap, b, ")");
}

// The region list of a helper, without the brackets: `&h, &t1, &l2, &v3, &e3, &w`.
fn put_regions[&h, &g](heap: &!h Heap, out: buffer.Buffer, sg: &!g [int], wt: int) -> [heap] buffer.Buffer {
    var b = out;
    var count = 0;
    if sg[11] == 1 {
        b = buffer.append(heap, b, "&h");
        count = 1;
    }
    var i = 0;
    var n = 0;
    while i < sg[4] {
        let pk = sg[76 + i];
        if pk != 3 {
            n = n + 1;
        }
        if pk >= 2 && pk != 3 && !(pk == 2 && sg[108 + i] == 1) {
            if count > 0 {
                b = buffer.append(heap, b, ", ");
            }
            count = count + 1;
            if pk == 2 {
                b = buffer.push_nat(heap, buffer.append(heap, b, "&t"), n);
            } else if pk == 4 {
                b = buffer.push_nat(heap, buffer.append(heap, b, "&l"), n);
            } else {
                b = buffer.push_nat(heap, buffer.append(heap, b, "&v"), n);
                b = buffer.push_nat(heap, buffer.append(heap, b, ", &e"), n);
            }
        }
        i = i + 1;
    }
    if wt >= 3 {
        if count > 0 {
            b = buffer.append(heap, b, ", ");
        }
        b = buffer.append(heap, b, "&w");
    }
    return b;
}

// The parameter list of a helper: `heap: &!h Heap, a1: int, a2: &t2 [byte]`, then `want`.
fn put_plist[&h, &g](heap: &!h Heap, out: buffer.Buffer, sg: &!g [int], wt: int) -> [heap] buffer.Buffer {
    var b = out;
    var i = 0;
    var n = 0;
    while i < sg[4] {
        if i > 0 {
            b = buffer.append(heap, b, ", ");
        }
        let pk = sg[76 + i];
        if pk == 3 {
            b = buffer.append(heap, b, "heap: &!h Heap");
        } else {
            n = n + 1;
            b = buffer.push_nat(heap, buffer.append(heap, b, "a"), n);
            if pk == 0 {
                b = buffer.append(heap, b, ": int");
            } else if pk == 1 {
                b = buffer.append(heap, b, ": bool");
            } else if pk == 2 && sg[108 + i] == 1 {
                b = buffer.append(heap, b, ": &static [byte]");
            } else if pk == 2 {
                b = buffer.push_nat(heap, buffer.append(heap, b, ": &t"), n);
                b = buffer.append(heap, b, " [byte]");
            } else if pk == 4 {
                b = buffer.push_nat(heap, buffer.append(heap, b, ": &l"), n);
                b = buffer.append(heap, b, " list.List[Box[Box[[byte]]]]");
            } else {
                b = buffer.push_nat(heap, buffer.append(heap, b, ": &v"), n);
                b = buffer.append(heap, b, " vec.Vec[&e");
                b = buffer.push_nat(heap, b, n);
                b = buffer.append(heap, b, " [byte]]");
            }
        }
        i = i + 1;
    }
    if wt > 0 {
        if sg[4] > 0 {
            b = buffer.append(heap, b, ", ");
        }
        if wt == 1 {
            b = buffer.append(heap, b, "want: int");
        } else if wt == 2 {
            b = buffer.append(heap, b, "want: bool");
        } else if wt == 3 {
            b = buffer.append(heap, b, "want: &w [byte]");
        } else {
            b = buffer.append(heap, b, "want: &w list.List[Box[Box[[byte]]]]");
        }
    }
    return b;
}

// `fn cases_SID_NAME[regions](params) -> row int`; `wt` is the type of `want`: 0 none, 1 int, 2 bool, 3 text, 4 list.
fn put_head[&h, &d, &g](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], hname: &static [byte], sg: &!g [int], wt: int) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, out, "fn cases_");
    b = buffer.append(heap, b, sid);
    b = buffer.append(heap, b, "_");
    b = buffer.append(heap, b, hname);
    let regs = put_regions(heap, buffer.empty(heap, 32), sg, wt);
    var nreg = 0;
    borrow regs as &rr in {
        nreg = buffer.size(rr);
        if nreg > 0 {
            b = buffer.append(heap, b, "[");
            b = buffer.append(heap, b, buffer.bytes(rr));
            b = buffer.append(heap, b, "]");
        }
    }
    buffer.drop(heap, regs);
    b = buffer.append(heap, b, "(");
    b = put_plist(heap, b, sg, wt);
    if sg[11] == 1 {
        return buffer.append(heap, b, ") -> [heap] int");
    }
    return buffer.append(heap, b, ") -> [] int");
}

// The statements that compare `var` (of value kind `v`) with `want`, free it, and answer 0 or 1.
fn put_cmp[&h, &d](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], var_name: &static [byte], v: int) -> [heap] buffer.Buffer {
    var b = out;
    if v == 0 || v == 1 {
        b = buffer.append(heap, b, "if ");
        b = buffer.append(heap, b, var_name);
        return buffer.append(heap, b, " == want { return 0; } return 1;");
    }
    if v == 3 {
        b = buffer.append(heap, b, "if cases_");
        b = buffer.append(heap, b, sid);
        b = buffer.append(heap, b, "_same(");
        b = buffer.append(heap, b, var_name);
        return buffer.append(heap, b, ", want) { return 0; } return 1;");
    }
    b = buffer.append(heap, b, "var same = false; borrow ");
    b = buffer.append(heap, b, var_name);
    b = buffer.append(heap, b, " as &x in { same = cases_");
    b = buffer.append(heap, b, sid);
    if v == 2 {
        b = buffer.append(heap, b, "_same(buffer.bytes(x), want); } buffer.drop(heap, ");
    } else if v == 5 {
        b = buffer.append(heap, b, "_same(contents(x), want); } unbox_slice(heap, ");
    } else {
        b = buffer.append(heap, b, "_leq(x, want); } cases_");
        b = buffer.append(heap, b, sid);
        b = buffer.append(heap, b, "_ldrop(heap, ");
    }
    b = buffer.append(heap, b, var_name);
    return buffer.append(heap, b, "); if same { return 0; } return 1;");
}

fn has_drop(v: int) -> [] bool {
    return v == 2 || v == 4 || v == 5;
}

// The statement that frees `var` (of value kind `v`, which has something to free).
fn put_drop[&h, &d](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], var_name: &static [byte], v: int) -> [heap] buffer.Buffer {
    var b = out;
    if v == 2 {
        b = buffer.append(heap, b, "buffer.drop(heap, ");
    } else if v == 5 {
        b = buffer.append(heap, b, "unbox_slice(heap, ");
    } else {
        b = buffer.append(heap, b, "cases_");
        b = buffer.append(heap, b, sid);
        b = buffer.append(heap, b, "_ldrop(heap, ");
    }
    b = buffer.append(heap, b, var_name);
    return buffer.append(heap, b, ");");
}

// `option.Option::Some(v) => { DROP return CODE; }` (or `Some(_)` when there is nothing to free).
fn put_some_arm[&h, &d](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], v: int, code: int) -> [heap] buffer.Buffer {
    var b = out;
    if has_drop(v) {
        b = buffer.append(heap, b, "option.Option::Some(v) => { ");
        b = put_drop(heap, b, sid, "v", v);
        b = buffer.append(heap, b, " return ");
    } else {
        b = buffer.append(heap, b, "option.Option::Some(_) => { return ");
    }
    b = buffer.push_nat(heap, b, code);
    return buffer.append(heap, b, "; }");
}

fn put_err_arm[&h](heap: &!h Heap, out: buffer.Buffer, e: int, code: int) -> [heap] buffer.Buffer {
    var b = out;
    if e == 2 {
        b = buffer.append(heap, b, "result.Result::Err(e) => { buffer.drop(heap, e); return ");
    } else {
        b = buffer.append(heap, b, "result.Result::Err(_) => { return ");
    }
    b = buffer.push_nat(heap, b, code);
    return buffer.append(heap, b, "; }");
}

// The `Ok` arm that frees what it holds and answers `code`.
fn put_ok_drop_arm[&h, &d](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], v: int, topt: int, code: int) -> [heap] buffer.Buffer {
    var b = out;
    if topt == 1 {
        b = buffer.append(heap, b, "result.Result::Ok(o) => { match o { ");
        b = put_some_arm(heap, b, sid, v, code);
        b = buffer.append(heap, b, " option.Option::None => { return ");
        b = buffer.push_nat(heap, b, code);
        return buffer.append(heap, b, "; } } }");
    }
    if has_drop(v) {
        b = buffer.append(heap, b, "result.Result::Ok(v) => { ");
        b = put_drop(heap, b, sid, "v", v);
        b = buffer.append(heap, b, " return ");
    } else {
        b = buffer.append(heap, b, "result.Result::Ok(_) => { return ");
    }
    b = buffer.push_nat(heap, b, code);
    return buffer.append(heap, b, "; }");
}

// The type of `want` for helper `which`.
fn want_kind(which: int, v: int) -> [] int {
    if which == 3 || which == 5 || which == 8 {
        return 0;
    }
    if which == 6 || v == 0 {
        return 1;
    }
    if v == 1 {
        return 2;
    }
    if v == 4 {
        return 4;
    }
    return 3;
}

// One helper, ended with a NUL.
fn put_helper[&h, &d, &n, &g](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], name: &n [byte], sg: &!g [int], which: int) -> [heap] buffer.Buffer {
    let v = sg[7];
    let e = sg[8];
    let topt = sg[140];
    var b = put_head(heap, out, sid, helper_name(which), sg, want_kind(which, v));
    b = buffer.append(heap, b, " { ");
    if which == 1 {
        b = buffer.append(heap, b, "let got = ");
        b = put_call(heap, b, name, sg);
        b = buffer.append(heap, b, "; ");
        b = put_cmp(heap, b, sid, "got", v);
    } else {
        b = buffer.append(heap, b, "match ");
        b = put_call(heap, b, name, sg);
        b = buffer.append(heap, b, " { ");
        if which == 2 {
            b = buffer.append(heap, b, "option.Option::Some(v) => { ");
            b = put_cmp(heap, b, sid, "v", v);
            b = buffer.append(heap, b, " } option.Option::None => { return 2; }");
        } else if which == 3 {
            b = put_some_arm(heap, b, sid, v, 2);
            b = buffer.append(heap, b, " option.Option::None => { return 0; }");
        } else if which == 4 {
            b = buffer.append(heap, b, "result.Result::Ok(v) => { ");
            b = put_cmp(heap, b, sid, "v", v);
            b = buffer.append(heap, b, " } ");
            b = put_err_arm(heap, b, e, 2);
        } else if which == 5 {
            b = put_ok_drop_arm(heap, b, sid, v, topt, 2);
            b = buffer.append(heap, b, " ");
            b = put_err_arm(heap, b, e, 0);
        } else if which == 6 {
            b = put_ok_drop_arm(heap, b, sid, v, topt, 2);
            b = buffer.append(heap, b, " result.Result::Err(n) => { if n == want { return 0; } return 3; }");
        } else if which == 7 {
            b = buffer.append(heap, b, "result.Result::Ok(o) => { match o { option.Option::Some(v) => { ");
            b = put_cmp(heap, b, sid, "v", v);
            b = buffer.append(heap, b, " } option.Option::None => { return 3; } } } ");
            b = put_err_arm(heap, b, e, 2);
        } else {
            b = buffer.append(heap, b, "result.Result::Ok(o) => { match o { ");
            b = put_some_arm(heap, b, sid, v, 1);
            b = buffer.append(heap, b, " option.Option::None => { return 0; } } } ");
            b = put_err_arm(heap, b, e, 2);
        }
        b = buffer.append(heap, b, " }");
    }
    b = buffer.append(heap, b, " }");
    return buffer.push(heap, b, byte_of(0));
}

// The helper functions the cases need, then the cases' tests: all of the unit's `tests`, each item ended with a NUL.
fn put_helpers[&h, &d, &n, &g](heap: &!h Heap, out: buffer.Buffer, sid: &d [byte], name: &n [byte], sg: &!g [int], used: int) -> [heap] buffer.Buffer {
    var b = out;
    let v = sg[7];
    if v >= 2 {
        b = put_tpl(heap, b, "fn cases_{s}_same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool { if len(x) != len(y) { return false; } var i = 0; while i < len(x) { if int_of(x[i]) != int_of(y[i]) { return false; } i = i + 1; } return true; }", sid);
        b = buffer.push(heap, b, byte_of(0));
    }
    if (used >> 9) & 1 == 1 {
        b = put_tpl(heap, b, "fn cases_{s}_mk[&h, &r](heap: &!h Heap, s: &r [byte]) -> [heap] Box[[byte]] { let b = box_slice(heap, len(s), byte_of(0)); borrow mut b as &!w in { copy_into(contents(w), s); } return b; }", sid);
        b = buffer.push(heap, b, byte_of(0));
    }
    if (used >> 10) & 1 == 1 {
        b = put_tpl(heap, b, "fn cases_{s}_hexv(c: int) -> [] int { if c >= 97 { return c - 87; } return c - 48; }", sid);
        b = buffer.push(heap, b, byte_of(0));
        b = put_tpl(heap, b, "fn cases_{s}_unhex[&h, &r](heap: &!h Heap, hex: &r [byte]) -> [heap] Box[[byte]] { let n = len(hex) / 2; let b = box_slice(heap, n, byte_of(0)); borrow mut b as &!w in { let s = contents(w); var i = 0; while i < n { s[i] = byte_of(cases_{s}_hexv(int_of(hex[2 * i])) * 16 + cases_{s}_hexv(int_of(hex[2 * i + 1]))); i = i + 1; } } return b; }", sid);
        b = buffer.push(heap, b, byte_of(0));
    }
    if (used >> 11) & 1 == 1 || v == 4 {
        b = put_tpl(heap, b, "fn cases_{s}_ldrop[&h](heap: &!h Heap, l: list.List[Box[Box[[byte]]]]) -> [heap] int { match l { list.List::Empty => { return 0; } list.List::Cons(f, rest) => { unbox_slice(heap, unbox(heap, f)); let tail = unbox(heap, rest); return 1 + cases_{s}_ldrop(heap, tail); } } }", sid);
        b = buffer.push(heap, b, byte_of(0));
    }
    if v == 4 {
        b = put_tpl(heap, b, "fn cases_{s}_nth[&l](l: &l list.List[Box[Box[[byte]]]], i: int) -> [] &l [byte] { match l { list.List::Empty => { return \"\"; } list.List::Cons(f, rest) => { if i == 0 { return contents(contents(f)); } return cases_{s}_nth(contents(rest), i - 1); } } }", sid);
        b = buffer.push(heap, b, byte_of(0));
        b = put_tpl(heap, b, "fn cases_{s}_leq[&a, &b](x: &a list.List[Box[Box[[byte]]]], y: &b list.List[Box[Box[[byte]]]]) -> [] bool { if list.length(x) != list.length(y) { return false; } var i = 0; while i < list.length(x) { if !cases_{s}_same(cases_{s}_nth(x, i), cases_{s}_nth(y, i)) { return false; } i = i + 1; } return true; }", sid);
        b = buffer.push(heap, b, byte_of(0));
    }
    var which = 1;
    while which <= 8 {
        if (used >> which) & 1 == 1 {
            b = put_helper(heap, b, sid, name, sg, which);
        }
        which = which + 1;
    }
    return b;
}

// ---- one unit -------------------------------------------------------------------

// The cases of the unit at `un`, with the signature `sig` read. Fills `gen`; `errs` says whether the unit was fine.
fn unit_cases[&h, &s, &t, &w, &d, &x, &g](heap: &!h Heap, gen: Gen, src: &s [byte], tape: &t [int], un: int, who: &w [byte], sid: &d [byte], sig: &x [byte], sg: &!g [int]) -> [heap] Gen {
    var g2 = gen;
    let status = parse_sig(sig, sg);
    if status == 1 {
        let Gen { rep, items, exs, nex, used, errs } = g2;
        g2 = Gen { rep: emit(heap, rep, who, 0, "cannot read the signature; it must be `fn NAME(params) -> [row] TYPE`"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
        return g2;
    }
    if status == 3 {
        let Gen { rep, items, exs, nex, used, errs } = g2;
        g2 = Gen { rep: emit(heap, rep, who, 0, "the signature has more than 32 parameters; give tests instead"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
        return g2;
    }
    if status == 2 {
        let Gen { rep, items, exs, nex, used, errs } = g2;
        var r = line_head(heap, rep, who, 0);
        r = buffer.append(heap, r, "signature uses a type that cases cannot express (");
        r = buffer.append(heap, r, sig[sg[9]..sg[10]]);
        r = buffer.append(heap, r, "); give tests instead\n");
        g2 = Gen { rep: r, items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
        return g2;
    }
    if (sg[7] == 2 || sg[7] == 4 || sg[7] == 5 || sg[8] == 2) && sg[11] == 0 {
        let Gen { rep, items, exs, nex, used, errs } = g2;
        g2 = Gen { rep: emit(heap, rep, who, 0, "the function returns a buffer.Buffer but takes no heap parameter; give tests instead"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
        return g2;
    }
    let name = sig[sg[0]..sg[1]];
    let cases = json.get(src, tape, un, "cases");
    var c = cases + 1;
    var k = 1;
    let total = json.count(tape, cases);
    while k <= total {
        g2 = do_case(heap, g2, src, tape, c, k, who, sid, name, sg);
        c = json.skip(tape, c);
        k = k + 1;
    }
    let Gen { rep, items, exs, nex, used, errs } = g2;
    var items_b = items;
    if errs == 0 {
        var hb = buffer.empty(heap, 256);
        hb = put_helpers(heap, hb, sid, name, sg, used);
        borrow items_b as &i in {
            hb = buffer.append(heap, hb, buffer.bytes(i));
        }
        buffer.drop(heap, items_b);
        items_b = hb;
    }
    return Gen { rep: rep, items: items_b, exs: exs, nex: nex, used: used, errs: errs };
}

// ---- writing JSON -----------------------------------------------------------------

fn put_key_of[&h, &s, &t](heap: &!h Heap, w: json.Writer, src: &s [byte], tape: &t [int], i: int) -> [heap] json.Writer {
    let n = json.string_length(src, tape, i);
    let sb = box_slice(heap, n + 1, byte_of(0));
    var out = w;
    borrow mut sb as &!kw in {
        let text = contents(kw);
        json.string_into(src, tape, i, text);
        out = json.put_key(heap, out, text[0..n]);
    }
    unbox_slice(heap, sb);
    return out;
}

fn put_string_of[&h, &s, &t](heap: &!h Heap, w: json.Writer, src: &s [byte], tape: &t [int], i: int) -> [heap] json.Writer {
    let n = json.string_length(src, tape, i);
    let sb = box_slice(heap, n + 1, byte_of(0));
    var out = w;
    borrow mut sb as &!kw in {
        let text = contents(kw);
        json.string_into(src, tape, i, text);
        out = json.put_string(heap, out, text[0..n]);
    }
    unbox_slice(heap, sb);
    return out;
}

// The value at node `i`, as it was.
fn copy_value[&h, &s, &t](heap: &!h Heap, w: json.Writer, src: &s [byte], tape: &t [int], i: int) -> [heap] json.Writer {
    var out = w;
    if json.is_null(tape, i) {
        return json.put_null(heap, out);
    }
    if json.is_bool(tape, i) {
        return json.put_bool(heap, out, json.to_bool(tape, i));
    }
    if json.is_number(tape, i) {
        return json.put_fragment(heap, out, src[tape[3 * i + 1]..tape[3 * i + 2]]);
    }
    if json.is_string(tape, i) {
        return put_string_of(heap, out, src, tape, i);
    }
    if json.is_array(tape, i) {
        out = json.begin_array(heap, out);
        var j = i + 1;
        var left = json.count(tape, i);
        while left > 0 {
            out = copy_value(heap, out, src, tape, j);
            j = json.skip(tape, j);
            left = left - 1;
        }
        return json.end_array(heap, out);
    }
    out = json.begin_object(heap, out);
    var j = i + 1;
    var left = json.count(tape, i);
    while left > 0 {
        out = put_key_of(heap, out, src, tape, j);
        out = copy_value(heap, out, src, tape, j + 1);
        j = json.skip(tape, j + 1);
        left = left - 1;
    }
    return json.end_object(heap, out);
}

// An array of strings from NUL-ended items.
fn put_items[&h, &b](heap: &!h Heap, w: json.Writer, items: &b [byte]) -> [heap] json.Writer {
    var out = json.begin_array(heap, w);
    var from = 0;
    var i = 0;
    while i < len(items) {
        if int_of(items[i]) == 0 {
            out = json.put_string(heap, out, items[from..i]);
            from = i + 1;
        }
        i = i + 1;
    }
    return json.end_array(heap, out);
}

// Write the unit at `un` with its cases turned into tests (and examples).
fn write_unit[&h, &s, &t, &i, &e](heap: &!h Heap, w: json.Writer, src: &s [byte], tape: &t [int], un: int, items: &i [byte], exs: &e [byte], fill: bool) -> [heap] json.Writer {
    var out = json.begin_object(heap, w);
    let has_examples = json.get(src, tape, un, "examples") >= 0;
    let has_tests = json.get(src, tape, un, "tests") >= 0;
    var j = un + 1;
    var left = json.count(tape, un);
    while left > 0 {
        if json.string_equals(src, tape, j, "cases") {
            if !has_examples {
                out = json.put_key(heap, out, "examples");
                out = put_items(heap, out, exs);
            }
            if !has_tests {
                out = json.put_key(heap, out, "tests");
                out = put_items(heap, out, items);
            }
        } else if json.string_equals(src, tape, j, "examples") && fill {
            out = json.put_key(heap, out, "examples");
            out = put_items(heap, out, exs);
        } else if json.string_equals(src, tape, j, "tests") {
            out = json.put_key(heap, out, "tests");
            out = put_items(heap, out, items);
        } else {
            out = put_key_of(heap, out, src, tape, j);
            out = copy_value(heap, out, src, tape, j + 1);
        }
        j = json.skip(tape, j + 1);
        left = left - 1;
    }
    return json.end_object(heap, out);
}

// The unit at `un`: expanded when it has cases and no problem, else as it was.
fn unit_expand[&h, &s, &t](heap: &!h Heap, w: json.Writer, rep: buffer.Buffer, src: &s [byte], tape: &t [int], un: int) -> [heap] (json.Writer, buffer.Buffer) {
    if !json.is_object(tape, un) || json.get(src, tape, un, "cases") < 0 {
        return (copy_value(heap, w, src, tape, un), rep);
    }
    let idn = json.get(src, tape, un, "id");
    var n = 1;
    if json.is_string(tape, idn) {
        n = json.string_length(src, tape, idn);
    }
    let whob = box_slice(heap, n + 2, byte_of(0));
    let sidb = box_slice(heap, n + 2, byte_of(0));
    let sgb = box_slice(heap, sg_len(), 0);
    var gen = Gen { rep: rep, items: buffer.empty(heap, 256), exs: buffer.empty(heap, 64), nex: 0, used: 0, errs: 0 };
    var fill = false;
    borrow mut whob as &!ww in {
        borrow mut sidb as &!sw in {
            borrow mut sgb as &!gw in {
                let who = contents(ww);
                let sidt = contents(sw);
                let sgs = contents(gw);
                var wl = 1;
                if json.is_string(tape, idn) {
                    wl = json.string_into(src, tape, idn, who);
                } else {
                    who[0] = byte_of(45);
                }
                var q = 0;
                while q < wl {
                    let c = int_of(who[q]);
                    if bytes.is_alpha(c) || bytes.is_digit(c) || c == 95 {
                        sidt[q] = who[q];
                    } else {
                        sidt[q] = byte_of(95);
                    }
                    q = q + 1;
                }
                let whot = who[0..wl];
                let sidv = sidt[0..wl];
                let cases = json.get(src, tape, un, "cases");
                let tn = json.get(src, tape, un, "tests");
                let sn = json.get(src, tape, un, "signature");
                let en = json.get(src, tape, un, "examples");
                fill = en < 0 || (json.is_array(tape, en) && json.count(tape, en) == 0);
                if !json.is_array(tape, cases) || json.count(tape, cases) == 0 {
                    let Gen { rep, items, exs, nex, used, errs } = gen;
                    gen = Gen { rep: emit(heap, rep, whot, 0, "cases must be a non-empty list of {\"args\": [...], \"expect\": value} objects"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
                } else if tn >= 0 && !(json.is_array(tape, tn) && json.count(tape, tn) == 0) {
                    let Gen { rep, items, exs, nex, used, errs } = gen;
                    gen = Gen { rep: emit(heap, rep, whot, 0, "this unit has both cases and tests; give cases OR tests, not both"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
                } else if !json.is_string(tape, sn) {
                    let Gen { rep, items, exs, nex, used, errs } = gen;
                    gen = Gen { rep: emit(heap, rep, whot, 0, "a unit with cases needs a string signature"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
                } else {
                    let sl = json.string_length(src, tape, sn);
                    let sigb = box_slice(heap, sl + 1, byte_of(0));
                    borrow mut sigb as &!xw in {
                        let sigt = contents(xw);
                        json.string_into(src, tape, sn, sigt);
                        gen = unit_cases(heap, gen, src, tape, un, whot, sidv, sigt[0..sl], sgs);
                    }
                    unbox_slice(heap, sigb);
                    let Gen { rep, items, exs, nex, used, errs } = gen;
                    if errs == 0 && fill && nex == 0 {
                        gen = Gen { rep: emit(heap, rep, whot, 0, "no case can be shown as an example (its call text contains \" == \" or a byte string); add a case without it, or give examples"), items: items, exs: exs, nex: nex, used: used, errs: errs + 1 };
                    } else {
                        gen = Gen { rep: rep, items: items, exs: exs, nex: nex, used: used, errs: errs };
                    }
                }
            }
        }
    }
    unbox_slice(heap, sgb);
    unbox_slice(heap, sidb);
    unbox_slice(heap, whob);
    let Gen { rep, items, exs, nex, used, errs } = gen;
    var out = w;
    if errs == 0 {
        borrow items as &ib in {
            borrow exs as &eb in {
                out = write_unit(heap, out, src, tape, un, buffer.bytes(ib), buffer.bytes(eb), fill);
            }
        }
    } else {
        out = copy_value(heap, out, src, tape, un);
    }
    buffer.drop(heap, items);
    buffer.drop(heap, exs);
    return (out, rep);
}

// ---- the plan ---------------------------------------------------------------------

// The deepest nesting of arrays and objects in the document (the writer takes 60).
fn tape_depth[&h, &t](heap: &!h Heap, tape: &t [int], nodes: int) -> [heap] int {
    let sb = box_slice(heap, 200, 0);
    var deepest = 0;
    borrow mut sb as &!sw in {
        let stack = contents(sw);
        var sp = 0;
        var i = 0;
        while i < nodes {
            while sp > 0 && stack[sp - 1] <= i {
                sp = sp - 1;
            }
            if json.is_array(tape, i) || json.is_object(tape, i) {
                if sp + 1 > deepest {
                    deepest = sp + 1;
                }
                stack[sp] = tape[3 * i + 2];
                sp = sp + 1;
            }
            i = i + 1;
        }
    }
    unbox_slice(heap, sb);
    return deepest;
}

fn plan_out[&h, &s, &t](heap: &!h Heap, rep: buffer.Buffer, src: &s [byte], tape: &t [int], units: int) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var r = rep;
    var w = json.writer(heap, len(src) + 256);
    w = json.begin_object(heap, w);
    var j = 1;
    var left = json.count(tape, 0);
    while left > 0 {
        w = put_key_of(heap, w, src, tape, j);
        if j + 1 == units {
            w = json.begin_array(heap, w);
            var u = units + 1;
            var m = json.count(tape, units);
            while m > 0 {
                let (nw, nr) = unit_expand(heap, w, r, src, tape, u);
                w = nw;
                r = nr;
                u = json.skip(tape, u);
                m = m - 1;
            }
            w = json.end_array(heap, w);
        } else {
            w = copy_value(heap, w, src, tape, j + 1);
        }
        j = json.skip(tape, j + 1);
        left = left - 1;
    }
    w = json.end_object(heap, w);
    return (json.finish(w), r);
}

// Expand the cases of the plan in `plan`: the new plan, the report (one `[CASES_ERROR]` line per problem), and 0 when there was no
// problem, else 1. A plan that is not JSON, or has no `units` list, comes back as it was.
pub fn expand[&h, &s](heap: &!h Heap, plan: &s [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 256);
    var out = buffer.empty(heap, 16);
    let tb = box_slice(heap, json.tape_len(plan) + 3, 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        let nodes = json.parse(plan, tape);
        if nodes < 0 {
            rep = emit(heap, rep, "-", 0, "the plan is not valid JSON");
            out = buffer.append(heap, out, plan);
        } else {
            let units = json.get(plan, tape, 0, "units");
            if !json.is_object(tape, 0) || !json.is_array(tape, units) {
                rep = emit(heap, rep, "-", 0, "the plan must be a JSON object with a \"units\" array");
                out = buffer.append(heap, out, plan);
            } else if tape_depth(heap, tape, nodes) > 55 {
                rep = emit(heap, rep, "-", 0, "the plan is nested more than 55 levels deep");
                out = buffer.append(heap, out, plan);
            } else {
                let (fin, r2) = plan_out(heap, rep, plan, tape, units);
                rep = r2;
                buffer.drop(heap, out);
                out = fin;
            }
        }
    }
    unbox_slice(heap, tb);
    var code = 0;
    borrow rep as &rr in {
        if buffer.size(rr) > 0 {
            code = 1;
        }
    }
    return (out, rep, code);
}
