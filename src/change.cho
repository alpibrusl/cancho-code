edition 7;

module change;

// `change` -- the pure half of `repo.patch` (docs/repo-patch.md): a change request answered for an EXISTING repository checkout. The model's reply is an
// ENVELOPE, one section per file it touches:
//
//     === FILE src/diff.cho
//     remove fn edit_count
//     fn edit_distance(...) -> [] int { ... }
//     === FILE tests/diff_test.cho
//     fn test_edit_distance() -> [] int { ... }
//
// `section_at` finds a section, `path_tag` refuses a path that may not be written, `apply` puts one section into a file (the items to add or replace
// through `splice.splice`, the `remove` lines through `splice.remove_items`, a path the checkout does not have as a whole new file). Everything is a
// function of its bytes: the files, the processes and the gate are `repochange`'s. A refusal is a `[CHANGE_ERROR]<TAB>tag<TAB>path<TAB>detail` line, or
// the `[SPLICE_ERROR]` lines of `splice`.

import splice;
import std.buffer;
import std.bytes;

fn is_space(c: int) -> [] bool {
    return c == 32 || c >= 9 && c <= 13;
}

fn line_end[&t](t: &t [byte], from: int) -> [] int {
    var e = from;
    while e < len(t) && int_of(t[e]) != 10 {
        e = e + 1;
    }
    return e;
}

// ---- what a change request is allowed to be --------------------------------------------------------------------------------------------

// The kinds of change (docs/repo-patch.md): a bug or a feature must come with a test, a refactor or a rename need not.
pub fn kind_ok[&k](kind: &k [byte]) -> [] bool {
    return bytes.equal(kind, "bug") || bytes.equal(kind, "feature") || bytes.equal(kind, "refactor") || bytes.equal(kind, "rename");
}

pub fn needs_test[&k](kind: &k [byte]) -> [] bool {
    return bytes.equal(kind, "bug") || bytes.equal(kind, "feature");
}

fn path_byte(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 45 || c == 46 || c == 47;
}

// Why a path may not be written, as a tag, or "" when it may. A path is relative to the checkout, made of letters, digits and `_ - . /`, has no
// empty, `.`, `..` or hidden (`.git`) component, lies under `src/` or `tests/` and names a `.cho` file. Whether a link is in the way is for the
// file system to say (`repochange`).
pub fn path_tag[&p](path: &p [byte]) -> [] &static [byte] {
    if len(path) == 0 || len(path) > 200 {
        return "path-length";
    }
    if int_of(path[0]) == 47 {
        return "path-absolute";
    }
    var i = 0;
    while i < len(path) {
        if path_byte(int_of(path[i])) == false {
            return "path-chars";
        }
        i = i + 1;
    }
    var start = 0;
    var k = 0;
    while k <= len(path) {
        if k == len(path) || int_of(path[k]) == 47 {
            let part = path[start..k];
            if len(part) == 0 {
                return "path-component";
            }
            if bytes.equal(part, "..") {
                return "path-dotdot";
            }
            if int_of(part[0]) == 46 {
                if bytes.equal(part, ".git") {
                    return "path-git";
                }
                return "path-component";
            }
            start = k + 1;
        }
        k = k + 1;
    }
    if bytes.starts_with(path, "src/") == false && bytes.starts_with(path, "tests/") == false {
        return "path-outside";
    }
    if len(path) < 5 || bytes.equal(path[len(path) - 4..len(path)], ".cho") == false {
        return "path-outside";
    }
    return "";
}

// ---- the envelope --------------------------------------------------------------------------------------------------------------------

// Section `k` (0-based) of the envelope `env`: the offsets of its path and of its body, or (-1, -1, -1, -1) when there is no such section. The path is
// the rest of the header line, trimmed, without a closing `===`; the body runs to the next header line or the end.
pub fn section_at[&e](env: &e [byte], k: int) -> [] (int, int, int, int) {
    var seen = 0 - 1;
    var i = 0;
    var ps = 0 - 1;
    var pz = 0 - 1;
    var bs = 0 - 1;
    var bz = 0 - 1;
    while i < len(env) && bz < 0 {
        let eol = line_end(env, i);
        if splice.is_header(env, i) {
            if seen == k {
                bz = i;
            } else {
                seen = seen + 1;
                if seen == k {
                    var a = i + 9;
                    var z = eol;
                    while z > a && is_space(int_of(env[z - 1])) {
                        z = z - 1;
                    }
                    if z - 3 >= a && bytes.equal(env[z - 3..z], "===") {
                        z = z - 3;
                        while z > a && is_space(int_of(env[z - 1])) {
                            z = z - 1;
                        }
                    }
                    while a < z && is_space(int_of(env[a])) {
                        a = a + 1;
                    }
                    ps = a;
                    pz = z;
                    bs = eol + 1;
                    if bs > len(env) {
                        bs = len(env);
                    }
                }
            }
        }
        i = eol + 1;
    }
    if seen < k {
        return (0 - 1, 0 - 1, 0 - 1, 0 - 1);
    }
    if bz < 0 {
        bz = len(env);
    }
    return (ps, pz, bs, bz);
}

pub fn section_count[&e](env: &e [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(env) {
        if splice.is_header(env, i) {
            n = n + 1;
        }
        i = line_end(env, i) + 1;
    }
    return n;
}

// ---- one section into one file -------------------------------------------------------------------------------------------------------------

pub fn error_line[&h, &p, &d](heap: &!h Heap, rep: buffer.Buffer, tag: &static [byte], path: &p [byte], detail: &d [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, rep, "[CHANGE_ERROR]\t");
    b = buffer.append(heap, b, tag);
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, path);
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, detail);
    return buffer.push(heap, b, byte_of(10));
}

// The body of a section cut in two: the `remove` lines, as the lines `fn NAME` / `type NAME` that `splice.remove_items` reads (a struct or an enum is
// a `type`), and the rest. The answer: (the removals, the rest, 0 or the line number of a `remove` line that is not `remove fn|struct|enum|type NAME`).
fn split_removes[&h, &b](heap: &!h Heap, body: &b [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var removes = buffer.empty(heap, 64);
    var rest = buffer.empty(heap, len(body) + 8);
    var bad = 0;
    var lineno = 0;
    var p = 0;
    while p < len(body) {
        let e = line_end(body, p);
        lineno = lineno + 1;
        let ln = body[p..e];
        if bytes.starts_with(ln, "remove ") {
            let words = bytes.trim(ln[7..len(ln)]);
            var kind_len = 0;
            var word = "";
            if bytes.starts_with(words, "fn ") {
                kind_len = 3;
                word = "fn ";
            } else if bytes.starts_with(words, "struct ") {
                kind_len = 7;
                word = "type ";
            } else if bytes.starts_with(words, "enum ") {
                kind_len = 5;
                word = "type ";
            } else if bytes.starts_with(words, "type ") {
                kind_len = 5;
                word = "type ";
            }
            let name = bytes.trim(words[kind_len..len(words)]);
            var good = kind_len > 0 && len(name) > 0;
            var j = 0;
            while j < len(name) {
                let c = int_of(name[j]);
                if (c >= 48 && c <= 57) == false && (c >= 65 && c <= 90) == false && (c >= 97 && c <= 122) == false && c != 95 {
                    good = false;
                }
                j = j + 1;
            }
            if good {
                removes = buffer.append(heap, removes, word);
                removes = buffer.append(heap, removes, name);
                removes = buffer.push(heap, removes, byte_of(10));
            } else if bad == 0 {
                bad = lineno;
            }
        } else {
            rest = buffer.append(heap, rest, ln);
            rest = buffer.push(heap, rest, byte_of(10));
        }
        p = e + 1;
    }
    return (removes, rest, bad);
}

// Put the body of one section into the file `path`. `existing` is the file as the checkout has it, `exists` false when the checkout has no such file
// (then the body is the whole new file and starts with its `edition` line). The answer: the new file, the report, 0 or 1 (1: the report says why and
// the file is returned as it was).
pub fn apply[&h, &e, &b, &p](heap: &!h Heap, existing: &e [byte], exists: bool, body: &b [byte], path: &p [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 128);
    var out = buffer.append(heap, buffer.empty(heap, len(existing) + len(body) + 16), existing);
    var code = 0;
    let (removes, rest, bad) = split_removes(heap, body);
    if bad > 0 {
        var d = buffer.append(heap, buffer.empty(heap, 64), "line ");
        d = buffer.push_nat(heap, d, bad);
        d = buffer.append(heap, d, " of the section: a removal is `remove fn NAME`, `remove struct NAME`, `remove enum NAME` or `remove type NAME`");
        borrow d as &dr in {
            rep = error_line(heap, rep, "remove-syntax", path, buffer.bytes(dr));
        }
        buffer.drop(heap, d);
        code = 1;
    } else {
        borrow rest as &rq in {
            borrow removes as &mq in {
                let (pa, pz) = splice.patch_span(buffer.bytes(rq));
                let have_removes = len(buffer.bytes(mq)) > 0;
                if exists == false {
                    if have_removes {
                        rep = error_line(heap, rep, "remove-in-new-file", path, "the file does not exist: there is nothing to remove from it");
                        code = 1;
                    } else if pa < 0 {
                        rep = error_line(heap, rep, "section-empty", path, "a new file needs its whole text, starting with the `edition` line");
                        code = 1;
                    } else if bytes.starts_with(buffer.bytes(rq)[pa..pz], "edition ") == false {
                        rep = error_line(heap, rep, "new-file-no-edition", path, "the file does not exist, so the section is the whole new file, which starts with `edition N;`");
                        code = 1;
                    } else {
                        buffer.drop(heap, out);
                        out = buffer.append(heap, buffer.empty(heap, pz - pa + 2), buffer.bytes(rq)[pa..pz]);
                        out = buffer.push(heap, out, byte_of(10));
                    }
                } else if have_removes == false && pa < 0 {
                    rep = error_line(heap, rep, "section-empty", path, "the section has no item to add or change and no `remove` line");
                    code = 1;
                } else {
                    var cur = buffer.append(heap, buffer.empty(heap, len(existing) + 16), existing);
                    if have_removes {
                        let (f, r, c) = splice.remove_items(heap, existing, buffer.bytes(mq));
                        buffer.drop(heap, cur);
                        cur = f;
                        if c != 0 {
                            borrow r as &rr in {
                                rep = buffer.append(heap, rep, buffer.bytes(rr));
                            }
                            code = 1;
                        }
                        buffer.drop(heap, r);
                    }
                    if code == 0 && pa >= 0 {
                        borrow cur as &cr in {
                            let (g, r2, c2) = splice.splice(heap, buffer.bytes(cr), buffer.bytes(rq)[pa..pz]);
                            if c2 != 0 {
                                borrow r2 as &rr2 in {
                                    rep = buffer.append(heap, rep, buffer.bytes(rr2));
                                }
                                code = 1;
                                buffer.drop(heap, g);
                            } else {
                                buffer.drop(heap, out);
                                out = g;
                            }
                            buffer.drop(heap, r2);
                        }
                    } else if code == 0 {
                        buffer.drop(heap, out);
                        out = cur;
                        cur = buffer.empty(heap, 1);
                    }
                    buffer.drop(heap, cur);
                }
            }
        }
    }
    buffer.drop(heap, removes);
    buffer.drop(heap, rest);
    if code != 0 {
        buffer.drop(heap, out);
        out = buffer.append(heap, buffer.empty(heap, len(existing) + 16), existing);
    }
    return (out, rep, code);
}
