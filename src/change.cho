edition 7;

module change;

// `change` -- the pure half of `repo.patch` (docs/repo-patch.md): a change request answered for an EXISTING repository checkout. The model's reply is an
// ENVELOPE, one section per file it touches:
//
//     === FILE src/diff.cho
//     remove fn edit_count
//     fn edit_distance(...) -> [] int { ... }
//     === FILE tests/diff_test.cho
//     fn test_edit_distance() -> [] int { ... }
//
// `section_at` finds a section, `path_tag` refuses a path that may not be written, `apply` puts one section into a file (the items to add or replace
// through `splice.splice`, the `remove` lines through `splice.remove_items`, a path the checkout does not have as a whole new file). Everything is a
// function of its bytes: the files, the processes and the gate are `repochange`'s. A refusal is a `[CHANGE_ERROR]<TAB>tag<TAB>path<TAB>detail` line, or
// the `[SPLICE_ERROR]` lines of `splice`.

import splice;
import std.buffer;
import std.bytes;

fn is_space(c: int) -> [] bool {
    return c == 32 || c >= 9 && c <= 13;
}

fn line_end[&t](t: &t [byte], from: int) -> [] int {
    var e = from;
    while e < len(t) && int_of(t[e]) != 10 {
        e = e + 1;
    }
    return e;
}

// ---- what a change request is allowed to be --------------------------------------------------------------------------------------------

// The kinds of change (docs/repo-patch.md): a bug or a feature must come with a test, a refactor or a rename need not.
pub fn kind_ok[&k](kind: &k [byte]) -> [] bool {
    return bytes.equal(kind, "bug") || bytes.equal(kind, "feature") || bytes.equal(kind, "refactor") || bytes.equal(kind, "rename");
}

pub fn needs_test[&k](kind: &k [byte]) -> [] bool {
    return bytes.equal(kind, "bug") || bytes.equal(kind, "feature");
}

fn path_byte(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 45 || c == 46 || c == 47;
}

// Why a path may not be written, as a tag, or "" when it may. A path is relative to the checkout, made of letters, digits and `_ - . /`, has no
// empty, `.`, `..` or hidden (`.git`) component, lies under `src/` or `tests/` and names a `.cho` file. Whether a link is in the way is for the
// file system to say (`repochange`).
pub fn path_tag[&p](path: &p [byte]) -> [] &static [byte] {
    if len(path) == 0 || len(path) > 200 {
        return "path-length";
    }
    if int_of(path[0]) == 47 {
        return "path-absolute";
    }
    var i = 0;
    while i < len(path) {
        if path_byte(int_of(path[i])) == false {
            return "path-chars";
        }
        i = i + 1;
    }
    var start = 0;
    var k = 0;
    while k <= len(path) {
        if k == len(path) || int_of(path[k]) == 47 {
            let part = path[start..k];
            if len(part) == 0 {
                return "path-component";
            }
            if bytes.equal(part, "..") {
                return "path-dotdot";
            }
            if int_of(part[0]) == 46 {
                if bytes.equal(part, ".git") {
                    return "path-git";
                }
                return "path-component";
            }
            start = k + 1;
        }
        k = k + 1;
    }
    if bytes.starts_with(path, "src/") == false && bytes.starts_with(path, "tests/") == false {
        return "path-outside";
    }
    if len(path) < 5 || bytes.equal(path[len(path) - 4..len(path)], ".cho") == false {
        return "path-outside";
    }
    return "";
}

// ---- the envelope --------------------------------------------------------------------------------------------------------------------

// Section `k` (0-based) of the envelope `env`: the offsets of its path and of its body, or (-1, -1, -1, -1) when there is no such section. The path is
// the rest of the header line, trimmed, without a closing `===`; the body runs to the next header line or the end.
pub fn section_at[&e](env: &e [byte], k: int) -> [] (int, int, int, int) {
    var seen = 0 - 1;
    var i = 0;
    var ps = 0 - 1;
    var pz = 0 - 1;
    var bs = 0 - 1;
    var bz = 0 - 1;
    while i < len(env) && bz < 0 {
        let eol = line_end(env, i);
        if splice.is_header(env, i) {
            if seen == k {
                bz = i;
            } else {
                seen = seen + 1;
                if seen == k {
                    var a = i + 9;
                    var z = eol;
                    while z > a && is_space(int_of(env[z - 1])) {
                        z = z - 1;
                    }
                    if z - 3 >= a && bytes.equal(env[z - 3..z], "===") {
                        z = z - 3;
                        while z > a && is_space(int_of(env[z - 1])) {
                            z = z - 1;
                        }
                    }
                    while a < z && is_space(int_of(env[a])) {
                        a = a + 1;
                    }
                    ps = a;
                    pz = z;
                    bs = eol + 1;
                    if bs > len(env) {
                        bs = len(env);
                    }
                }
            }
        }
        i = eol + 1;
    }
    if seen < k {
        return (0 - 1, 0 - 1, 0 - 1, 0 - 1);
    }
    if bz < 0 {
        bz = len(env);
    }
    return (ps, pz, bs, bz);
}

pub fn section_count[&e](env: &e [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(env) {
        if splice.is_header(env, i) {
            n = n + 1;
        }
        i = line_end(env, i) + 1;
    }
    return n;
}

// ---- one section into one file -------------------------------------------------------------------------------------------------------------

pub fn error_line[&h, &p, &d](heap: &!h Heap, rep: buffer.Buffer, tag: &static [byte], path: &p [byte], detail: &d [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, rep, "[CHANGE_ERROR]\t");
    b = buffer.append(heap, b, tag);
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, path);
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, detail);
    return buffer.push(heap, b, byte_of(10));
}

// The body of a section cut in two: the `remove` lines, as the lines `fn NAME` / `type NAME` that `splice.remove_items` reads (a struct or an enum is
// a `type`), and the rest. The answer: (the removals, the rest, 0 or the line number of a `remove` line that is not `remove fn|struct|enum|type NAME`).
fn split_removes[&h, &b](heap: &!h Heap, body: &b [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var removes = buffer.empty(heap, 64);
    var rest = buffer.empty(heap, len(body) + 8);
    var bad = 0;
    var lineno = 0;
    var p = 0;
    while p < len(body) {
        let e = line_end(body, p);
        lineno = lineno + 1;
        let ln = body[p..e];
        if bytes.starts_with(ln, "remove ") {
            let words = bytes.trim(ln[7..len(ln)]);
            var kind_len = 0;
            var word = "";
            if bytes.starts_with(words, "fn ") {
                kind_len = 3;
                word = "fn ";
            } else if bytes.starts_with(words, "struct ") {
                kind_len = 7;
                word = "type ";
            } else if bytes.starts_with(words, "enum ") {
                kind_len = 5;
                word = "type ";
            } else if bytes.starts_with(words, "type ") {
                kind_len = 5;
                word = "type ";
            }
            let name = bytes.trim(words[kind_len..len(words)]);
            var good = kind_len > 0 && len(name) > 0;
            var j = 0;
            while j < len(name) {
                let c = int_of(name[j]);
                if (c >= 48 && c <= 57) == false && (c >= 65 && c <= 90) == false && (c >= 97 && c <= 122) == false && c != 95 {
                    good = false;
                }
                j = j + 1;
            }
            if good {
                removes = buffer.append(heap, removes, word);
                removes = buffer.append(heap, removes, name);
                removes = buffer.push(heap, removes, byte_of(10));
            } else if bad == 0 {
                bad = lineno;
            }
        } else {
            rest = buffer.append(heap, rest, ln);
            rest = buffer.push(heap, rest, byte_of(10));
        }
        p = e + 1;
    }
    return (removes, rest, bad);
}

// Put the body of one section into the file `path`. `existing` is the file as the checkout has it, `exists` false when the checkout has no such file
// (then the body is the whole new file and starts with its `edition` line). The answer: the new file, the report, 0 or 1 (1: the report says why and
// the file is returned as it was).
pub fn apply[&h, &e, &b, &p](heap: &!h Heap, existing: &e [byte], exists: bool, body: &b [byte], path: &p [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 128);
    var out = buffer.append(heap, buffer.empty(heap, len(existing) + len(body) + 16), existing);
    var code = 0;
    let (removes, rest, bad) = split_removes(heap, body);
    if bad > 0 {
        var d = buffer.append(heap, buffer.empty(heap, 64), "line ");
        d = buffer.push_nat(heap, d, bad);
        d = buffer.append(heap, d, " of the section: a removal is `remove fn NAME`, `remove struct NAME`, `remove enum NAME` or `remove type NAME`");
        borrow d as &dr in {
            rep = error_line(heap, rep, "remove-syntax", path, buffer.bytes(dr));
        }
        buffer.drop(heap, d);
        code = 1;
    } else {
        borrow rest as &rq in {
            borrow removes as &mq in {
                let (pa, pz) = splice.patch_span(buffer.bytes(rq));
                let have_removes = len(buffer.bytes(mq)) > 0;
                if exists == false {
                    if have_removes {
                        rep = error_line(heap, rep, "remove-in-new-file", path, "the file does not exist: there is nothing to remove from it");
                        code = 1;
                    } else if pa < 0 {
                        rep = error_line(heap, rep, "section-empty", path, "a new file needs its whole text, starting with the `edition` line");
                        code = 1;
                    } else if bytes.starts_with(buffer.bytes(rq)[pa..pz], "edition ") == false {
                        rep = error_line(heap, rep, "new-file-no-edition", path, "the file does not exist, so the section is the whole new file, which starts with `edition N;`");
                        code = 1;
                    } else {
                        buffer.drop(heap, out);
                        out = buffer.append(heap, buffer.empty(heap, pz - pa + 2), buffer.bytes(rq)[pa..pz]);
                        out = buffer.push(heap, out, byte_of(10));
                    }
                } else if have_removes == false && pa < 0 {
                    rep = error_line(heap, rep, "section-empty", path, "the section has no item to add or change and no `remove` line");
                    code = 1;
                } else {
                    var cur = buffer.append(heap, buffer.empty(heap, len(existing) + 16), existing);
                    if have_removes {
                        let (f, r, c) = splice.remove_items(heap, existing, buffer.bytes(mq));
                        buffer.drop(heap, cur);
                        cur = f;
                        if c != 0 {
                            borrow r as &rr in {
                                rep = buffer.append(heap, rep, buffer.bytes(rr));
                            }
                            code = 1;
                        }
                        buffer.drop(heap, r);
                    }
                    if code == 0 && pa >= 0 {
                        borrow cur as &cr in {
                            let (g, r2, c2) = splice.splice(heap, buffer.bytes(cr), buffer.bytes(rq)[pa..pz]);
                            if c2 != 0 {
                                borrow r2 as &rr2 in {
                                    rep = buffer.append(heap, rep, buffer.bytes(rr2));
                                }
                                code = 1;
                                buffer.drop(heap, g);
                            } else {
                                buffer.drop(heap, out);
                                out = g;
                            }
                            buffer.drop(heap, r2);
                        }
                    } else if code == 0 {
                        buffer.drop(heap, out);
                        out = cur;
                        cur = buffer.empty(heap, 1);
                    }
                    buffer.drop(heap, cur);
                }
            }
        }
    }
    buffer.drop(heap, removes);
    buffer.drop(heap, rest);
    if code != 0 {
        buffer.drop(heap, out);
        out = buffer.append(heap, buffer.empty(heap, len(existing) + 16), existing);
    }
    return (out, rep, code);
}

// ---- tests that prove something (docs/repo-patch.md) -----------------------------------------------------------------------------------------

fn ident_byte(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
}

// Is `name` called in `text`: it stands as a whole word (no identifier byte before it) and a `(` follows, spaces aside?
fn calls[&t, &n](text: &t [byte], name: &n [byte]) -> [] bool {
    if len(name) == 0 {
        return false;
    }
    var i = 0;
    while i + len(name) <= len(text) {
        if bytes.equal(text[i..i + len(name)], name) && (i == 0 || ident_byte(int_of(text[i - 1])) == false) {
            var j = i + len(name);
            while j < len(text) && int_of(text[j]) == 32 {
                j = j + 1;
            }
            if j < len(text) && int_of(text[j]) == 40 {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Does `text` (the text of the tests a change adds or changes) call any of the `names` (one per line)? True when `names` is empty: a change that
// adds no public function has nothing a test could be asked to call.
pub fn exercised[&t, &n](text: &t [byte], names: &n [byte]) -> [] bool {
    var any = false;
    var hit = false;
    var p = 0;
    while p < len(names) {
        let e = line_end(names, p);
        if e > p {
            any = true;
            if calls(text, names[p..e]) {
                hit = true;
            }
        }
        p = e + 1;
    }
    return any == false || hit;
}

// The field `k` (0-based, tab separated) of `line`, as (start, end).
fn field_of[&l](line: &l [byte], k: int) -> [] (int, int) {
    var start = 0;
    var seen = 0;
    var i = 0;
    while i <= len(line) {
        if i == len(line) || int_of(line[i]) == 9 {
            if seen == k {
                return (start, i);
            }
            seen = seen + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return (0, 0);
}

// The public functions a change added or replaced in `src/`, from `splice.item_delta` lines, one name per line.
pub fn public_fns[&h, &r](heap: &!h Heap, records: &r [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    var p = 0;
    while p < len(records) {
        let e = line_end(records, p);
        let ln = records[p..e];
        let (a0, a1) = field_of(ln, 0);
        let (b0, b1) = field_of(ln, 1);
        let (c0, c1) = field_of(ln, 2);
        let (d0, d1) = field_of(ln, 3);
        let (f0, f1) = field_of(ln, 4);
        if bytes.starts_with(ln[a0..a1], "src/") && (bytes.equal(ln[b0..b1], "A") || bytes.equal(ln[b0..b1], "C")) && bytes.equal(ln[c0..c1], "fn") && bytes.equal(ln[f0..f1], "1") {
            out = buffer.append(heap, out, ln[d0..d1]);
            out = buffer.push(heap, out, byte_of(10));
        }
        p = e + 1;
    }
    return out;
}

// Of the `names` (one per line) the ones the `cancho test` output shows as passed (`test MODULE.NAME ... ok`).
pub fn passed_in[&h, &o, &n](heap: &!h Heap, output: &o [byte], names: &n [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    var p = 0;
    while p < len(names) {
        let e = line_end(names, p);
        if e > p {
            let name = names[p..e];
            var found = false;
            var i = 0;
            while i + len(name) + 7 <= len(output) {
                if int_of(output[i]) == 46 && bytes.equal(output[i + 1..i + 1 + len(name)], name) && bytes.equal(output[i + 1 + len(name)..i + 8 + len(name)], " ... ok") {
                    found = true;
                }
                i = i + 1;
            }
            if found {
                out = buffer.append(heap, out, name);
                out = buffer.push(heap, out, byte_of(10));
            }
        }
        p = e + 1;
    }
    return out;
}

// ---- constraints on the shape of a change ---------------------------------------------------------------------------------------------------
//
// `--constraints FILE`: lines `keep-names GLOB`, `max-added-items N`, `max-added-lines N`, `only-items a,b,c`; blank lines and `#` comments are
// skipped. A GLOB is a path under `src/` or `tests/`, with a `*` only at its end.

fn digits_value[&a](t: &a [byte]) -> [] int {
    if len(t) == 0 || len(t) > 8 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(t) {
        let c = int_of(t[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + c - 48;
        i = i + 1;
    }
    return n;
}

fn glob_ok[&a](g: &a [byte]) -> [] bool {
    if bytes.starts_with(g, "src/") == false && bytes.starts_with(g, "tests/") == false {
        return false;
    }
    var i = 0;
    while i < len(g) {
        let c = int_of(g[i]);
        if path_byte(c) == false && (c != 42 || i != len(g) - 1) {
            return false;
        }
        i = i + 1;
    }
    return bytes.find(g, "..") < 0;
}

fn names_ok[&a](list: &a [byte]) -> [] bool {
    var start = 0;
    var i = 0;
    while i <= len(list) {
        if i == len(list) || int_of(list[i]) == 44 {
            if i == start {
                return false;
            }
            var j = start;
            while j < i {
                if ident_byte(int_of(list[j])) == false {
                    return false;
                }
                j = j + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// The key and the value of a constraint line (trimmed), or two empty slices for a blank line or a comment.
fn constraint_parts[&l](ln: &l [byte]) -> [] (int, int, int, int) {
    if len(ln) == 0 || int_of(ln[0]) == 35 {
        return (0, 0, 0, 0);
    }
    var s = 0;
    while s < len(ln) && int_of(ln[s]) > 32 {
        s = s + 1;
    }
    var v = s;
    while v < len(ln) && int_of(ln[v]) <= 32 {
        v = v + 1;
    }
    return (0, s, v, len(ln));
}

// The first line of the constraints that is not one: (its number, why), or (0, "") when all are good.
pub fn constraint_problem[&c](text: &c [byte]) -> [] (int, &static [byte]) {
    var items = 0;
    var lines = 0;
    var only = 0;
    var lineno = 0;
    var p = 0;
    while p < len(text) {
        let e = line_end(text, p);
        lineno = lineno + 1;
        let ln = bytes.trim(text[p..e]);
        let (k0, k1, v0, v1) = constraint_parts(ln);
        if k1 > 0 {
            let key = ln[k0..k1];
            let operand = ln[v0..v1];
            if bytes.equal(key, "keep-names") {
                if glob_ok(operand) == false {
                    return (lineno, "keep-names takes a path under src/ or tests/, with a * only at its end");
                }
            } else if bytes.equal(key, "max-added-items") {
                if digits_value(operand) < 0 {
                    return (lineno, "max-added-items takes a number");
                }
                if items > 0 {
                    return (lineno, "max-added-items is given twice");
                }
                items = 1;
            } else if bytes.equal(key, "max-added-lines") {
                if digits_value(operand) < 0 {
                    return (lineno, "max-added-lines takes a number");
                }
                if lines > 0 {
                    return (lineno, "max-added-lines is given twice");
                }
                lines = 1;
            } else if bytes.equal(key, "only-items") {
                if names_ok(operand) == false {
                    return (lineno, "only-items takes item names separated by commas");
                }
                if only > 0 {
                    return (lineno, "only-items is given twice");
                }
                only = 1;
            } else {
                return (lineno, "unknown constraint (keep-names, max-added-items, max-added-lines, only-items)");
            }
        }
        p = e + 1;
    }
    return (0, "");
}

// The values of every line with the key `key`, one per line.
fn values_of[&h, &c](heap: &!h Heap, text: &c [byte], key: &static [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    var p = 0;
    while p < len(text) {
        let e = line_end(text, p);
        let ln = bytes.trim(text[p..e]);
        let (k0, k1, v0, v1) = constraint_parts(ln);
        if k1 > 0 && bytes.equal(ln[k0..k1], key) {
            out = buffer.append(heap, out, ln[v0..v1]);
            out = buffer.push(heap, out, byte_of(10));
        }
        p = e + 1;
    }
    return out;
}

fn limit_of[&h, &c](heap: &!h Heap, text: &c [byte], key: &static [byte]) -> [heap] int {
    let v = values_of(heap, text, key);
    var n = 0 - 1;
    borrow v as &vr in {
        let b = buffer.bytes(vr);
        if len(b) > 0 {
            n = digits_value(b[0..line_end(b, 0)]);
        }
    }
    buffer.drop(heap, v);
    return n;
}

// Does the glob (a path, or a path with a `*` at its end) match `path`?
pub fn glob_match[&g, &p](glob: &g [byte], path: &p [byte]) -> [] bool {
    if len(glob) > 0 && int_of(glob[len(glob) - 1]) == 42 {
        return bytes.starts_with(path, glob[0..len(glob) - 1]);
    }
    return bytes.equal(glob, path);
}

fn in_list[&l, &n](list: &l [byte], name: &n [byte]) -> [] bool {
    var start = 0;
    var i = 0;
    while i <= len(list) {
        if i == len(list) || int_of(list[i]) == 44 {
            if bytes.equal(list[start..i], name) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// `item` added to a list of at most 8 names for a message.
fn note[&h, &i](heap: &!h Heap, out: buffer.Buffer, count: int, item: &i [byte]) -> [heap] buffer.Buffer {
    if count < 8 {
        var b = out;
        if count > 0 {
            b = buffer.append(heap, b, ", ");
        }
        return buffer.append(heap, b, item);
    }
    return out;
}

fn more[&h](heap: &!h Heap, out: buffer.Buffer, count: int) -> [heap] buffer.Buffer {
    if count > 8 {
        var b = buffer.append(heap, out, " and ");
        b = buffer.push_nat(heap, b, count - 8);
        return buffer.append(heap, b, " more");
    }
    return out;
}

// The constraints `ctext` against what a change did: `records` are the `splice.item_delta` lines of every file written, `added_lines` the lines added
// to files of `src/`. The answer is `[CHANGE_ERROR]` lines, one per constraint broken (empty: all hold).
pub fn violations[&h, &c, &r](heap: &!h Heap, ctext: &c [byte], records: &r [byte], added_lines: int) -> [heap] buffer.Buffer {
    var rep = buffer.empty(heap, 64);
    let globs = values_of(heap, ctext, "keep-names");
    let onlyv = values_of(heap, ctext, "only-items");
    let max_items = limit_of(heap, ctext, "max-added-items");
    let max_lines = limit_of(heap, ctext, "max-added-lines");
    var gone = buffer.empty(heap, 32);
    var n_gone = 0;
    var added = buffer.empty(heap, 32);
    var n_added = 0;
    var off = buffer.empty(heap, 32);
    var n_off = 0;
    borrow globs as &gr in {
        borrow onlyv as &ovr in {
            let gl = buffer.bytes(gr);
            let ov = buffer.bytes(ovr);
            var only = ov;
            if len(ov) > 0 {
                only = ov[0..line_end(ov, 0)];
            }
            var p = 0;
            while p < len(records) {
                let e = line_end(records, p);
                let ln = records[p..e];
                let (a0, a1) = field_of(ln, 0);
                let (b0, b1) = field_of(ln, 1);
                let (c0, c1) = field_of(ln, 2);
                let (d0, d1) = field_of(ln, 3);
                let path = ln[a0..a1];
                let status = ln[b0..b1];
                let name = ln[d0..d1];
                if bytes.equal(status, "R") && bytes.equal(ln[c0..c1], "fn") {
                    var q = 0;
                    var hit = false;
                    while q < len(gl) {
                        let ge = line_end(gl, q);
                        if glob_match(gl[q..ge], path) {
                            hit = true;
                        }
                        q = ge + 1;
                    }
                    if hit {
                        gone = note(heap, gone, n_gone, name);
                        n_gone = n_gone + 1;
                    }
                }
                if bytes.starts_with(path, "src/") {
                    if bytes.equal(status, "A") {
                        added = note(heap, added, n_added, name);
                        n_added = n_added + 1;
                    }
                    if len(ov) > 0 && in_list(only, name) == false {
                        off = note(heap, off, n_off, name);
                        n_off = n_off + 1;
                    }
                }
                p = e + 1;
            }
        }
    }
    if n_gone > 0 {
        var d = buffer.append(heap, buffer.empty(heap, 64), "these functions were removed or renamed, and the request keeps their names: ");
        borrow gone as &goner in {
            d = buffer.append(heap, d, buffer.bytes(goner));
        }
        d = more(heap, d, n_gone);
        borrow d as &dr in {
            rep = error_line(heap, rep, "constraint-keep-names", "-", buffer.bytes(dr));
        }
        buffer.drop(heap, d);
    }
    if max_items >= 0 && n_added > max_items {
        var d = buffer.append(heap, buffer.empty(heap, 64), "the change adds ");
        d = buffer.push_nat(heap, d, n_added);
        d = buffer.append(heap, d, " items to src/ (");
        borrow added as &addedr in {
            d = buffer.append(heap, d, buffer.bytes(addedr));
        }
        d = more(heap, d, n_added);
        d = buffer.append(heap, d, "); at most ");
        d = buffer.push_nat(heap, d, max_items);
        borrow d as &dr in {
            rep = error_line(heap, rep, "constraint-max-added-items", "-", buffer.bytes(dr));
        }
        buffer.drop(heap, d);
    }
    if max_lines >= 0 && added_lines > max_lines {
        var d = buffer.append(heap, buffer.empty(heap, 64), "the change adds ");
        d = buffer.push_nat(heap, d, added_lines);
        d = buffer.append(heap, d, " lines to src/; at most ");
        d = buffer.push_nat(heap, d, max_lines);
        borrow d as &dr in {
            rep = error_line(heap, rep, "constraint-max-added-lines", "-", buffer.bytes(dr));
        }
        buffer.drop(heap, d);
    }
    if n_off > 0 {
        var d = buffer.append(heap, buffer.empty(heap, 64), "the change touches items of src/ the request does not allow: ");
        borrow off as &offr in {
            d = buffer.append(heap, d, buffer.bytes(offr));
        }
        d = more(heap, d, n_off);
        borrow d as &dr in {
            rep = error_line(heap, rep, "constraint-only-items", "-", buffer.bytes(dr));
        }
        buffer.drop(heap, d);
    }
    buffer.drop(heap, globs);
    buffer.drop(heap, onlyv);
    buffer.drop(heap, gone);
    buffer.drop(heap, added);
    buffer.drop(heap, off);
    return rep;
}

// How many lines of `constraints` limit lines added (-1: none): the driver counts them only then.
pub fn wants_line_count[&h, &c](heap: &!h Heap, ctext: &c [byte]) -> [heap] bool {
    return limit_of(heap, ctext, "max-added-lines") >= 0;
}
