edition 7;

module driver;

// `driver` — the loop the harness has been bounding slice by slice, now
// composed: run the agent, check the file, decide, and after a verified
// unit re-verify (design §3: an edit that silently drops a verified
// issue's function puts it back on the board — nothing else would notice).
//
// This is also where the verdict lines arrive (design §6): every way the
// loop can end prints one machine-readable line, and there is no state in
// which it runs silently without either making progress or naming its
// stop.
//
//     [ISSUE_VERDICT]\t<verified|failed|unavailable>\t<reason>
//
//   verified     — the unit checked clean and the re-verify held
//   failed       — the budgets named the stop: `signature` (the
//                  same-signature rule), `ceiling` (attempts), `defect`
//   unavailable  — the checker or the agent is away: a wait, not a
//                  failure; the caller preserves the attempts and stops
//                  the run with the provider named (design §4)
//
// What is deliberately single-issue here: the board (which issue is next,
// what regressed) is the typed-issue model's job, issue #2. This module
// drives ONE issue against ONE file with the real checker, and the
// re-verify pass is the regression catch in miniature: after the check
// says verified, it checks again before believing it.

import checker;
import snapshot;
import acceptance;
import trail;
import loop_check;
import std.buffer;
import std.bytes;
import std.io;
import std.process;

// How the run ended, as data for the caller (the printed line is for the
// person; this is for the run's verdict).
pub enum Ended {
    Verified,
    FailedSignaure,
    FailedCeiling,
    PlanDefect,
    Unavailable,
}

fn outcome_name(o: loop_check.Outcome) -> [] &static [byte] {
    match o {
        loop_check.Outcome::Verified => { return "verified"; }
        loop_check.Outcome::Retryable => { return "refused"; }
        loop_check.Outcome::PlanDefect => { return "defect"; }
        loop_check.Outcome::ProviderOutage => { return "outage"; }
    }
}

// One record of the trail (parity P0), on the file the run drives.
fn note[&h, &z, &t, &o, &s, &d](heap: &!h Heap, fs: &z Fs(""), tpath: &t buffer.Buffer, attempt: int, ms: int, outcome: &o [byte], sig: &s [byte], decision: &d [byte]) -> [heap, fs_read(""), fs_write("")] int {
    return trail.record(heap, fs, buffer.bytes(tpath), attempt, ms, outcome, sig, decision, 65536);
}

// Drive one issue: `agent` runs before every check (it is the editor —
// an LLM in production, a shell stand-in in the gate), `check_cmd` is the
// checker command for `file`, and the budgets are the design's §4.
//
// `agent_timeout_ms` caps one agent turn (a local 27B model with the
// compiler's refusals in its prompt took longer than the 30 s that used to be
// fixed here, and the run ended `unavailable agent` before the model had a
// fair attempt: issue #11). The checker keeps its own 30 s.
//
// `accept` is the acceptance command (empty: none): after the checker verifies the
// file it runs on it, and a file that does not satisfy it is a retryable failure
// with an `acceptance:` signature (src/acceptance.cho, docs/parity.md P4a).
//
// `snap_prefix` names the snapshot store; the loop snapshots after every
// verified unit (the §4 contract), so a later regression has a clean
// copy to restore from.
pub fn run_issue[&h, &x, &c, &i, &z, &f, &a, &k, &p, &q](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), file: &f [byte], agent: &a [byte], check_cmd: &k [byte], snap_prefix: &p [byte], max_attempts: int, k_signature: int, agent_timeout_ms: int, accept: &q [byte], accept_timeout_ms: int) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] Ended {
    var tpath = buffer.append(heap, buffer.empty(heap, 256), file);
    tpath = buffer.append(heap, tpath, ".trail.jsonl");
    borrow tpath as &tq0 in {
        trail.begin(fs, buffer.bytes(tq0));
    }
    // The checker's current answer for the file goes to `<file>.feedback`
    // before every agent turn (docs/parity.md P1): the agent has no way to ask
    // the checker itself, and a model that never sees the refusal repeats it
    // (issue #12). The command is the checker's own, redirected.
    var fbcmd = buffer.empty(heap, len(check_cmd) + len(file) * 4 + 96);
    var ci = 0;
    while ci + 1 < len(check_cmd) {
        fbcmd = buffer.push(heap, fbcmd, check_cmd[ci]);
        ci = ci + 1;
    }
    fbcmd = buffer.append(heap, fbcmd, " > ");
    fbcmd = buffer.append(heap, fbcmd, file);
    fbcmd = buffer.append(heap, fbcmd, ".feedback 2>&1; if [ -s ");
    fbcmd = buffer.append(heap, fbcmd, file);
    fbcmd = buffer.append(heap, fbcmd, ".acceptance ]; then cat ");
    fbcmd = buffer.append(heap, fbcmd, file);
    fbcmd = buffer.append(heap, fbcmd, ".acceptance >> ");
    fbcmd = buffer.append(heap, fbcmd, file);
    fbcmd = buffer.append(heap, fbcmd, ".feedback; fi\0");
    var accpath = buffer.append(heap, buffer.empty(heap, 256), file);
    accpath = buffer.append(heap, accpath, ".acceptance");
    borrow accpath as &aq0 in {
        acceptance.note(heap, fs, buffer.bytes(aq0), "");
    }
    var attempts = 0;
    var consecutive = 0;
    var last = buffer.empty(heap, 64);
    var snap_next = 0;
    var ended = Ended::Unavailable;
    var going = true;
    while going {
        borrow fbcmd as &fq in {
            let fb = checker.run(heap, exec, clock, file, buffer.bytes(fq), 4096, 30000);
            checker.drop(heap, fb);
        }
        // The agent's turn. Its output is not ours to parse: the check
        // below is the only oracle (design §2 — done is what the gate
        // says, never what the model claims). A provider outage here is
        // the same wait-not-burn stop as the checker's.
        match process.channels() {
            process.Channels::Failed(e) => {
                ended = Ended::Unavailable;
                going = false;
            }
            process.Channels::Ok(to_child, child_in, from_child, child_out) => {
                match exec_spawn(exec, "/bin/sh", agent, "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null) {
                    Spawned::Failed(e) => {
                        process.close(to_child, from_child);
                        ended = Ended::Unavailable;
                        going = false;
                    }
                    Spawned::Ok(child) => {
                        let t0 = clock_ms(clock);
                        let (agent_out, agent_ran) = process.capture(heap, clock, child, to_child, from_child, "", 4096, agent_timeout_ms);
                        buffer.drop(heap, agent_out);
                        let agent_ms = clock_ms(clock) - t0;
                        match agent_ran {
                            process.Ran::Code(n) => {
                                if n != 0 {
                                    // The agent itself failed (a script that could not run
                                    // its model, a missing tool): named in its own verdict
                                    // and in the trail, not read as a looping model.
                                    borrow tpath as &tq in {
                                        note(heap, fs, tq, attempts, agent_ms, "none", "", "agent_exit");
                                    }
                                    io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tagent\n");
                                    ended = Ended::Unavailable;
                                    going = false;
                                } else {
                                // The agent answered; the check is the oracle.
                                let answer = checker.run(heap, exec, clock, file, check_cmd, 4096, 30000);
                                let checker.Answer { outcome, sig } = answer;
                                var oc = outcome;
                                var sg = sig;
                                var checked = false;
                                match oc {
                                    loop_check.Outcome::Verified => { checked = true; }
                                    loop_check.Outcome::Retryable => { }
                                    loop_check.Outcome::PlanDefect => { }
                                    loop_check.Outcome::ProviderOutage => { }
                                }
                                if checked && len(accept) > 0 {
                                    let ar = acceptance.run(heap, exec, clock, accept, file, 4096, accept_timeout_ms);
                                    let acceptance.Result { held, why, said } = ar;
                                    if held == 0 {
                                        io.write_all(io, "[ACCEPTANCE]\tpass\n");
                                        borrow accpath as &aq in {
                                            acceptance.note(heap, fs, buffer.bytes(aq), "");
                                        }
                                        buffer.drop(heap, why);
                                    } else {
                                        io.write_all(io, "[ACCEPTANCE]\tfail\n");
                                        borrow accpath as &aq in {
                                            borrow said as &sd in {
                                                acceptance.note(heap, fs, buffer.bytes(aq), buffer.bytes(sd));
                                            }
                                        }
                                        buffer.drop(heap, sg);
                                        sg = why;
                                        oc = loop_check.Outcome::Retryable;
                                    }
                                    buffer.drop(heap, said);
                                }
                                if checked && len(accept) == 0 {
                                    io.write_all(io, "[ACCEPTANCE]\tnone\n");
                                }
                                var this_sig = sg;
                                let oname = outcome_name(oc);
                                // Compare against the last attempt's signature
                                // before it becomes the last.
                                var same = false;
                                borrow last as &lb in {
                                    borrow this_sig as &tb in {
                                        same = loop_check.same_signature(buffer.bytes(lb), buffer.bytes(tb));
                                    }
                                }
                                // `decide` compares the two signatures it is
                                // handed; hand them for real, via the regions
                                // the buffers allow.
                                var decision2 = loop_check.Decision::Retry;
                                borrow last as &lb in {
                                    borrow this_sig as &tb in {
                                        decision2 = loop_check.decide(attempts, consecutive, buffer.bytes(lb), buffer.bytes(tb), oc, max_attempts, k_signature);
                                    }
                                }
                                match decision2 {
                                    loop_check.Decision::StopIssueVerified => {
                                        buffer.drop(heap, this_sig);
                                        // The re-verify pass: check again
                                        // before believing it. A file that
                                        // stops checking between the two
                                        // runs is a regression the single
                                        // check would have certified.
                                        let again = checker.run(heap, exec, clock, file, check_cmd, 4096, 30000);
                                        let checker.Answer { outcome, sig } = again;
                                        buffer.drop(heap, sig);
                                        match outcome {
                                            loop_check.Outcome::Verified => {
                                                borrow tpath as &tq in {
                                                    note(heap, fs, tq, attempts, agent_ms, "verified", "", "verified");
                                                }
                                                // Snapshot the verified state
                                                // (§4): the newest copy that
                                                // checked.
                                                let idx = snapshot.take(heap, fs, file, snap_prefix, snap_next, 65536);
                                                if idx >= 0 {
                                                    snap_next = idx + 1;
                                                }
                                                io.write_all(io, "[ISSUE_VERDICT]\tverified\tattempts ");
                                                io.print_int(io, attempts + 1);
                                                io.newline(io);
                                                ended = Ended::Verified;
                                                going = false;
                                            }
                                            loop_check.Outcome::Retryable => {
                                                borrow tpath as &tq in {
                                                    note(heap, fs, tq, attempts, agent_ms, "refused", "", "regressed");
                                                }
                                                // Regressed between the two
                                                // runs: back on the board,
                                                // named.
                                                io.write_all(io, "[ISSUE_VERDICT]\tregressed\tre-verify refused\n");
                                                attempts = attempts + 1;
                                            }
                                            loop_check.Outcome::PlanDefect => {
                                                borrow tpath as &tq in {
                                                    note(heap, fs, tq, attempts, agent_ms, "defect", "", "defect");
                                                }
                                                io.write_all(io, "[ISSUE_VERDICT]\tfailed\tdefect\n");
                                                ended = Ended::PlanDefect;
                                                going = false;
                                            }
                                            loop_check.Outcome::ProviderOutage => {
                                                borrow tpath as &tq in {
                                                    note(heap, fs, tq, attempts, agent_ms, "outage", "", "provider");
                                                }
                                                io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tchecker\n");
                                                ended = Ended::Unavailable;
                                                going = false;
                                            }
                                        }
                                    }
                                    loop_check.Decision::StopIssueDefect => {
                                        borrow tpath as &tq in {
                                            borrow this_sig as &tb in {
                                                note(heap, fs, tq, attempts, agent_ms, oname, buffer.bytes(tb), "defect");
                                            }
                                        }
                                        buffer.drop(heap, this_sig);
                                        io.write_all(io, "[ISSUE_VERDICT]\tfailed\tdefect\n");
                                        ended = Ended::PlanDefect;
                                        going = false;
                                    }
                                    loop_check.Decision::StopIssueCeiling => {
                                        borrow tpath as &tq in {
                                            borrow this_sig as &tb in {
                                                note(heap, fs, tq, attempts, agent_ms, oname, buffer.bytes(tb), "ceiling");
                                            }
                                        }
                                        buffer.drop(heap, this_sig);
                                        io.write_all(io, "[ISSUE_VERDICT]\tfailed\tceiling\n");
                                        ended = Ended::FailedCeiling;
                                        going = false;
                                    }
                                    loop_check.Decision::StopIssueSignature => {
                                        borrow tpath as &tq in {
                                            borrow this_sig as &tb in {
                                                note(heap, fs, tq, attempts, agent_ms, oname, buffer.bytes(tb), "signature");
                                            }
                                        }
                                        buffer.drop(heap, this_sig);
                                        io.write_all(io, "[ISSUE_VERDICT]\tfailed\tsignature\n");
                                        ended = Ended::FailedSignaure;
                                        going = false;
                                    }
                                    loop_check.Decision::StopRunProvider => {
                                        borrow tpath as &tq in {
                                            borrow this_sig as &tb in {
                                                note(heap, fs, tq, attempts, agent_ms, oname, buffer.bytes(tb), "provider");
                                            }
                                        }
                                        buffer.drop(heap, this_sig);
                                        io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tchecker\n");
                                        ended = Ended::Unavailable;
                                        going = false;
                                    }
                                    loop_check.Decision::Retry => {
                                        borrow tpath as &tq in {
                                            borrow this_sig as &tb in {
                                                note(heap, fs, tq, attempts, agent_ms, oname, buffer.bytes(tb), "retry");
                                            }
                                        }
                                        // `consecutive` counts the attempts, this one
                                        // included, that ended in this signature: a
                                        // fresh signature starts a run of one, not
                                        // zero (found by the trail gate: with zero
                                        // the stop needed K+1 identical refusals).
                                        if same {
                                            consecutive = consecutive + 1;
                                        } else {
                                            consecutive = 1;
                                        }
                                        buffer.drop(heap, last);
                                        last = this_sig;
                                        attempts = attempts + 1;
                                    }
                                }
                                                            }
}
                            process.Ran::TimedOut => {
                                borrow tpath as &tq in {
                                    note(heap, fs, tq, attempts, agent_ms, "none", "", "agent_timeout");
                                }
                                io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tagent\n");
                                ended = Ended::Unavailable;
                                going = false;
                            }
                            process.Ran::TooMuch => {
                                borrow tpath as &tq in {
                                    note(heap, fs, tq, attempts, agent_ms, "none", "", "agent_output");
                                }
                                io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tagent\n");
                                ended = Ended::Unavailable;
                                going = false;
                            }
                            process.Ran::Signaled(s) => {
                                borrow tpath as &tq in {
                                    note(heap, fs, tq, attempts, agent_ms, "none", "", "agent_signal");
                                }
                                io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tagent\n");
                                ended = Ended::Unavailable;
                                going = false;
                            }
                            process.Ran::Failed(e) => {
                                borrow tpath as &tq in {
                                    note(heap, fs, tq, attempts, agent_ms, "none", "", "agent_failed");
                                }
                                io.write_all(io, "[ISSUE_VERDICT]\tunavailable\tagent\n");
                                ended = Ended::Unavailable;
                                going = false;
                            }
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, last);
    buffer.drop(heap, tpath);
    buffer.drop(heap, accpath);
    buffer.drop(heap, fbcmd);
    return ended;
}
