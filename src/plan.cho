edition 7;

module plan;

// The plan check (docs/plan.md): a JSON plan is parsed onto a tape and every
// rule is reported, one `[PLAN_ERROR]` line each, then the verdict. No model.
//
// `info` holds 12 ints per unit (see the field names below); it is filled in
// one pass, the cycles are marked in a second, and the third reports.

import std.buffer;
import std.bytes;
import std.json;

fn f_node() -> [] int { return 0; }
fn f_id() -> [] int { return 1; }
fn f_sig() -> [] int { return 2; }
fn f_ns() -> [] int { return 3; }
fn f_ne() -> [] int { return 4; }
fn f_ex() -> [] int { return 5; }
fn f_dep() -> [] int { return 6; }
fn f_ok() -> [] int { return 7; }
fn f_cur() -> [] int { return 8; }
fn f_col() -> [] int { return 9; }
fn f_cyc() -> [] int { return 10; }
fn f_file() -> [] int { return 11; }
fn stride() -> [] int { return 12; }

fn byte_at[&t](t: &t [byte], i: int) -> [] int {
    if i < 0 || i >= len(t) {
        return 0 - 1;
    }
    return int_of(t[i]);
}

fn is_start(c: int) -> [] bool {
    return bytes.is_alpha(c) || c == 95;
}

fn is_part(c: int) -> [] bool {
    return bytes.is_alpha(c) || bytes.is_digit(c) || c == 95;
}

fn skip_sp[&t](t: &t [byte], p: int) -> [] int {
    var i = p;
    while byte_at(t, i) == 32 {
        i = i + 1;
    }
    return i;
}

// The end of the identifier that starts at `p`, or `p` when there is none.
fn ident_end[&t](t: &t [byte], p: int) -> [] int {
    if !is_start(byte_at(t, p)) {
        return p;
    }
    var i = p + 1;
    while is_part(byte_at(t, i)) {
        i = i + 1;
    }
    return i;
}

// `fn NAME(...) -> [row] TYPE`: the name's byte range, or (-1, -1).
fn sig_name[&t](t: &t [byte]) -> [] (int, int) {
    if !bytes.starts_with(t, "fn ") {
        return (0 - 1, 0 - 1);
    }
    let a = skip_sp(t, 3);
    let b = ident_end(t, a);
    if b == a {
        return (0 - 1, 0 - 1);
    }
    var c = skip_sp(t, b);
    // region and type parameters after the name: `fn f[&r, &h](...)`
    if byte_at(t, c) == 91 {
        var q = c + 1;
        while q < len(t) && byte_at(t, q) != 93 {
            q = q + 1;
        }
        if q >= len(t) {
            return (0 - 1, 0 - 1);
        }
        c = skip_sp(t, q + 1);
    }
    if byte_at(t, c) != 40 {
        return (0 - 1, 0 - 1);
    }
    let arrow = bytes.find(t, "->");
    if arrow < c {
        return (0 - 1, 0 - 1);
    }
    var k = arrow - 1;
    while k > c && byte_at(t, k) == 32 {
        k = k - 1;
    }
    if byte_at(t, k) != 41 {
        return (0 - 1, 0 - 1);
    }
    let d = skip_sp(t, arrow + 2);
    if byte_at(t, d) != 91 {
        return (0 - 1, 0 - 1);
    }
    var e = d + 1;
    while e < len(t) && byte_at(t, e) != 93 {
        e = e + 1;
    }
    if e >= len(t) {
        return (0 - 1, 0 - 1);
    }
    let f = skip_sp(t, e + 1);
    if f >= len(t) {
        return (0 - 1, 0 - 1);
    }
    return (a, b);
}

fn node_text[&s, &t](src: &s [byte], tape: &t [int], i: int) -> [] &s [byte] {
    return src[tape[3 * i + 1]..tape[3 * i + 2]];
}

fn all_strings[&t](tape: &t [int], arr: int) -> [] bool {
    if !json.is_array(tape, arr) {
        return false;
    }
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        if !json.is_string(tape, j) {
            return false;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return true;
}

fn emit[&h, &r, &u, &m](heap: &!h Heap, out: buffer.Buffer, rule: &r [byte], unit: &u [byte], msg: &m [byte]) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "[PLAN_ERROR]\t");
    b = buffer.append(heap, b, rule);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, unit);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, msg);
    b = buffer.append(heap, b, "\n");
    return b;
}

fn get_f[&i](info: &!i [int], u: int, f: int) -> [] int {
    return info[u * stride() + f];
}

fn set_f[&i](info: &!i [int], u: int, f: int, v: int) -> [] int {
    info[u * stride() + f] = v;
    return 0;
}

// The id text of unit `u`, or "-" when it has none.
fn label[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], u: int) -> [] &s [byte] {
    let n = get_f(info, u, f_id());
    if n < 0 {
        return "-";
    }
    return node_text(src, tape, n);
}

fn fn_name[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], u: int) -> [] &s [byte] {
    let sig = node_text(src, tape, get_f(info, u, f_sig()));
    return sig[get_f(info, u, f_ns())..get_f(info, u, f_ne())];
}

fn has_name[&i](info: &!i [int], u: int) -> [] bool {
    return get_f(info, u, f_ok()) == 1 && get_f(info, u, f_ns()) >= 0;
}

// The first unit with this id, or -1.
fn find_id[&s, &t, &i, &x](src: &s [byte], tape: &t [int], info: &!i [int], n: int, text: &x [byte]) -> [] int {
    var u = 0;
    while u < n {
        if get_f(info, u, f_ok()) == 1 && bytes.equal(node_text(src, tape, get_f(info, u, f_id())), text) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// The first unit declaring a function of this name, or -1.
fn find_fn[&s, &t, &i, &x](src: &s [byte], tape: &t [int], info: &!i [int], n: int, text: &x [byte]) -> [] int {
    var u = 0;
    while u < n {
        if has_name(info, u) && bytes.equal(fn_name(src, tape, info, u), text) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// Is the node one of the five effort levels the API takes?
fn effort_level[&s, &t](src: &s [byte], tape: &t [int], n: int) -> [] bool {
    return json.is_string(tape, n) && (json.string_equals(src, tape, n, "low") || json.string_equals(src, tape, n, "medium") || json.string_equals(src, tape, n, "high") || json.string_equals(src, tape, n, "xhigh") || json.string_equals(src, tape, n, "max"));
}

fn collect[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], units: int, n: int) -> [] int {
    var u = 0;
    var j = units + 1;
    while u < n {
        set_f(info, u, f_node(), j);
        let isobj = json.is_object(tape, j);
        var idn = 0 - 1;
        var sg = 0 - 1;
        var ex = 0 - 1;
        var dp = 0 - 1;
        var ds = 0 - 1;
        var ts = 0 - 1;
        var ef = 0 - 1;
        var fl = 0 - 1;
        if isobj {
            idn = json.get(src, tape, j, "id");
            sg = json.get(src, tape, j, "signature");
            ex = json.get(src, tape, j, "examples");
            dp = json.get(src, tape, j, "deps");
            ds = json.get(src, tape, j, "description");
            ts = json.get(src, tape, j, "tests");
            ef = json.get(src, tape, j, "effort");
            fl = json.get(src, tape, j, "file");
        }
        if idn >= 0 && json.is_string(tape, idn) {
            set_f(info, u, f_id(), idn);
        }
        var ok = 0;
        if isobj && get_f(info, u, f_id()) >= 0 && sg >= 0 && json.is_string(tape, sg) && all_strings(tape, ex) && all_strings(tape, dp) && (ds < 0 || json.is_string(tape, ds)) && (ts < 0 || all_strings(tape, ts)) && (ef < 0 || effort_level(src, tape, ef)) && (fl < 0 || json.is_string(tape, fl)) {
            ok = 1;
        }
        set_f(info, u, f_ok(), ok);
        if ok == 1 {
            set_f(info, u, f_sig(), sg);
            set_f(info, u, f_ex(), ex);
            set_f(info, u, f_dep(), dp);
            let (a, b) = sig_name(node_text(src, tape, sg));
            set_f(info, u, f_ns(), a);
            set_f(info, u, f_ne(), b);
        }
        j = json.skip(tape, j);
        u = u + 1;
    }
    return 0;
}

// Depth-first search over the dependencies, with an explicit stack. A back
// edge to a node still on the stack closes a cycle; it is reported on the
// first unit of it in the file.
fn cycles[&s, &t, &i, &k](src: &s [byte], tape: &t [int], info: &!i [int], stack: &!k [int], n: int) -> [] int {
    var root = 0;
    while root < n {
        if get_f(info, root, f_ok()) == 1 && get_f(info, root, f_col()) == 0 {
            var sp = 0;
            stack[0] = root;
            sp = 1;
            set_f(info, root, f_col(), 1);
            while sp > 0 {
                let u = stack[sp - 1];
                let deps = get_f(info, u, f_dep());
                let cur = get_f(info, u, f_cur());
                if cur >= json.count(tape, deps) {
                    set_f(info, u, f_col(), 2);
                    sp = sp - 1;
                } else {
                    set_f(info, u, f_cur(), cur + 1);
                    let v = find_id(src, tape, info, n, node_text(src, tape, json.at(tape, deps, cur)));
                    if v >= 0 {
                        let color = get_f(info, v, f_col());
                        if color == 0 {
                            set_f(info, v, f_col(), 1);
                            stack[sp] = v;
                            sp = sp + 1;
                        } else if color == 1 {
                            var low = v;
                            var q = sp - 1;
                            while q >= 0 && stack[q] != v {
                                if stack[q] < low {
                                    low = stack[q];
                                }
                                q = q - 1;
                            }
                            set_f(info, low, f_cyc(), 1);
                        }
                    }
                }
            }
        }
        root = root + 1;
    }
    return 0;
}

// Where " == " splits an example, or -1.
fn split_at[&x](text: &x [byte]) -> [] int {
    return bytes.find(text, " == ");
}

// The length of the called identifier on the left side, or -1 when the left
// side is not `ident(`.
fn call_len[&x](left: &x [byte]) -> [] int {
    let e = ident_end(left, 0);
    if e == 0 || byte_at(left, e) != 40 {
        return 0 - 1;
    }
    return e;
}

// What is wrong with a unit that is not usable, field by field: one sentence naming each missing or mistyped field and the form it takes.
fn field_problems[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 256);
    if !json.is_object(tape, node) {
        return buffer.append(heap, b, "this unit is not a JSON object; a unit is {\"id\": \"...\", \"signature\": \"fn NAME(params) -> [row] TYPE\", \"description\": \"...\", \"examples\": [\"CALL == EXPECTED\"], \"deps\": []}");
    }
    let idn = json.get(src, tape, node, "id");
    if idn < 0 || !json.is_string(tape, idn) {
        b = buffer.append(heap, b, "`id` is missing or is not a string (letters, digits, underscore); ");
    }
    let sg = json.get(src, tape, node, "signature");
    if sg < 0 || !json.is_string(tape, sg) {
        b = buffer.append(heap, b, "`signature` is missing or is not a string (`fn NAME(params) -> [row] TYPE`); ");
    }
    let ex = json.get(src, tape, node, "examples");
    if !all_strings(tape, ex) {
        b = buffer.append(heap, b, "`examples` is missing or is not an array of strings (each `CALL == EXPECTED`, at least one); ");
    }
    let dp = json.get(src, tape, node, "deps");
    if !all_strings(tape, dp) {
        b = buffer.append(heap, b, "`deps` is missing or is not an array of strings (the ids of the units this one calls; `[]` for none); ");
    }
    let ds = json.get(src, tape, node, "description");
    if ds >= 0 && !json.is_string(tape, ds) {
        b = buffer.append(heap, b, "`description` is not a string; ");
    }
    let ts = json.get(src, tape, node, "tests");
    if ts >= 0 && !all_strings(tape, ts) {
        b = buffer.append(heap, b, "`tests` is not an array of strings (one cancho function each); ");
    }
    let ef = json.get(src, tape, node, "effort");
    if ef >= 0 && !effort_level(src, tape, ef) {
        b = buffer.append(heap, b, "`effort` is not one of low, medium, high, xhigh, max; ");
    }
    let fl = json.get(src, tape, node, "file");
    if fl >= 0 && !json.is_string(tape, fl) {
        b = buffer.append(heap, b, "`file` is not a string (the name of the module file this unit belongs to, such as \"store.cho\"; leave it out for project.cho); ");
    }
    return b;
}

// Does a test's cancho source have a line break INSIDE a string literal? A cancho string literal cannot span lines; a model that writes `\n` in the
// JSON text of a test gets a real line break in the source (the escape must be `\\n` in the JSON). Comments and character literals are skipped.
fn newline_in_string[&t](t: &t [byte]) -> [] bool {
    var i = 0;
    var in_str = false;
    while i < len(t) {
        let c = int_of(t[i]);
        if in_str {
            if c == 92 {
                i = i + 2;
            } else {
                if c == 34 {
                    in_str = false;
                } else if c == 10 {
                    return true;
                }
                i = i + 1;
            }
        } else if c == 34 {
            in_str = true;
            i = i + 1;
        } else if c == 47 && byte_at(t, i + 1) == 47 {
            while i < len(t) && int_of(t[i]) != 10 {
                i = i + 1;
            }
        } else if c == 39 {
            if byte_at(t, i + 1) == 92 {
                i = i + 4;
            } else {
                i = i + 3;
            }
        } else {
            i = i + 1;
        }
    }
    return false;
}

// Does `t` call `name`: the name, not part of a longer identifier, then `(`.
fn calls_name[&t, &n](t: &t [byte], name: &n [byte]) -> [] bool {
    var i = 0;
    while i + len(name) < len(t) {
        if bytes.equal(t[i..i + len(name)], name) && byte_at(t, i + len(name)) == 40 && (i == 0 || !is_part(byte_at(t, i - 1))) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Does the result type of a signature own memory (a buffer, a Box, a list, a vec: anything the compiler treats as linear)? The type is what follows the
// effort row; an error type that is `&static [byte]` or an `int` owns nothing.
fn owning_result[&t](sig: &t [byte]) -> [] bool {
    let arrow = bytes.find(sig, "->");
    if arrow < 0 {
        return false;
    }
    let close = bytes.find(sig[arrow..len(sig)], "]");
    if close < 0 {
        return false;
    }
    let ty = sig[arrow + close + 1..len(sig)];
    return bytes.find(ty, "buffer.") >= 0 || bytes.find(ty, "Box[") >= 0 || bytes.find(ty, "list.") >= 0 || bytes.find(ty, "vec.") >= 0;
}

// `integ` is the unit named by the plan's `integration` (-1: none): the application of a service, built against the service's acceptance
// scenarios, so it needs no example and no test (docs/plan.md).
fn report_unit[&h, &s, &t, &i](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], info: &!i [int], n: int, u: int, integ: int) -> [heap] buffer.Buffer {
    var b = out;
    let who = label(src, tape, info, u);
    if get_f(info, u, f_ok()) != 1 {
        let why = field_problems(heap, src, tape, get_f(info, u, f_node()));
        var msg = buffer.append(heap, buffer.empty(heap, 128), "the unit cannot be read: ");
        borrow why as &wr in {
            msg = buffer.append(heap, msg, buffer.bytes(wr));
        }
        buffer.drop(heap, why);
        borrow msg as &mr in {
            b = emit(heap, b, "unit-field", who, buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
        return b;
    }
    if find_id(src, tape, info, n, who) != u {
        b = emit(heap, b, "duplicate-id", who, "another unit already has this id");
    }
    let ns = get_f(info, u, f_ns());
    if ns < 0 {
        b = emit(heap, b, "bad-signature", who, "the signature must be `fn NAME(...) -> [effect row] TYPE`; a function's effect row is required, write `-> [] int` for the pure form");
    } else {
        let dv = find_fn(src, tape, info, n, fn_name(src, tape, info, u));
        if dv != u {
            if get_f(info, dv, f_file()) == get_f(info, u, f_file()) {
                b = emit(heap, b, "duplicate-function", who, "this function is already declared by an earlier unit; a function is declared by exactly one unit");
            } else {
                var msg = buffer.append(heap, buffer.empty(heap, 192), "this unit declares `");
                msg = buffer.append(heap, msg, fn_name(src, tape, info, u));
                msg = buffer.append(heap, msg, "`, which the unit `");
                msg = buffer.append(heap, msg, label(src, tape, info, dv));
                msg = buffer.append(heap, msg, "` already declares in `");
                msg = buffer.append(heap, msg, unit_file_text(src, tape, info, dv));
                msg = buffer.append(heap, msg, "`: a function is declared by exactly one unit, in one file (the same name in two files is refused); give this one another name");
                borrow msg as &mr in {
                    b = emit(heap, b, "file-duplicate", who, buffer.bytes(mr));
                }
                buffer.drop(heap, msg);
            }
        }
    }
    let ex = get_f(info, u, f_ex());
    let m = json.count(tape, ex);
    if m == 0 {
        if u != integ {
            var msg = buffer.append(heap, buffer.empty(heap, 192), "the unit has no example: give at least one `CALL == EXPECTED` that calls ");
            if ns >= 0 {
                msg = buffer.push(heap, msg, byte_of(96));
                msg = buffer.append(heap, msg, fn_name(src, tape, info, u));
                msg = buffer.push(heap, msg, byte_of(96));
            } else {
                msg = buffer.append(heap, msg, "the unit's function");
            }
            msg = buffer.append(heap, msg, " (its name exactly as in the signature, then the arguments, ` == `, the value). A unit with `tests` needs one too: it is documentation there, so it may pass a heap or text, e.g. `NAME(heap, \"a=1\", \"a\") == 1`");
            borrow msg as &mr in {
                b = emit(heap, b, "no-example", who, buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
    } else if ns >= 0 {
        var own = false;
        var shaped = 0;
        var q = 0;
        while q < m {
            let text = node_text(src, tape, json.at(tape, ex, q));
            let at = split_at(text);
            if at >= 0 {
                let left = bytes.trim(text[0..at]);
                let cl = call_len(left);
                if cl > 0 {
                    shaped = shaped + 1;
                }
                if cl > 0 && bytes.equal(left[0..cl], fn_name(src, tape, info, u)) {
                    own = true;
                }
            }
            q = q + 1;
        }
        if !own && shaped > 0 {
            var msg = buffer.append(heap, buffer.empty(heap, 192), "none of the examples calls this unit's own function `");
            msg = buffer.append(heap, msg, fn_name(src, tape, info, u));
            msg = buffer.append(heap, msg, "`: write at least one `");
            msg = buffer.append(heap, msg, fn_name(src, tape, info, u));
            msg = buffer.append(heap, msg, "(ARGS) == VALUE`, with the whole name from the signature (a helper's name keeps the task prefix, `hexnum_parse`, not `parse`)");
            borrow msg as &mr in {
                b = emit(heap, b, "example-own", who, buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
    }
    var q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var cl = 0 - 1;
        var left = text[0..0];
        if at >= 0 {
            left = bytes.trim(text[0..at]);
            cl = call_len(left);
        }
        if ns >= 0 && cl > 0 && find_fn(src, tape, info, n, left[0..cl]) < 0 {
            var msg = buffer.append(heap, buffer.empty(heap, 192), "an example calls `");
            msg = buffer.append(heap, msg, left[0..cl]);
            msg = buffer.append(heap, msg, "`, which no unit declares: use the name exactly as a signature of this plan spells it (a helper's name keeps the task prefix) or fix the signature");
            borrow msg as &mr in {
                b = emit(heap, b, "example-callee", who, buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
        q = q + 1;
    }
    q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var cl = 0 - 1;
        if at >= 0 {
            cl = call_len(bytes.trim(text[0..at]));
        }
        if cl < 0 {
            b = emit(heap, b, "example-shape", who, "an example must look like `CALL == EXPECTED`, with a call such as `f(1)` first");
        }
        q = q + 1;
    }
    q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var same = false;
        if at >= 0 {
            same = bytes.equal(bytes.trim(text[0..at]), bytes.trim(text[at + 4..len(text)]));
        }
        if same || bytes.find(text, "|| true") >= 0 || bytes.find(text, "or true") >= 0 {
            b = emit(heap, b, "tautology", who, "an example whose two sides are the same, or that contains `|| true`, checks nothing");
        }
        q = q + 1;
    }
    // A function that takes a heap, or whose result holds text, a buffer or a list (a Result with a text error, an Option of a slice), cannot
    // be called from `CALL == EXPECTED`: `==` compares scalars and a test has no heap in scope. Its examples are documentation; without `tests`
    // nothing can check the unit. (An Option or a Result of scalars compares fine and is not flagged.)
    if ns >= 0 {
        let sig = node_text(src, tape, get_f(info, u, f_sig()));
        let arrow = bytes.find(sig, "->");
        var heavy = false;
        if arrow >= 0 {
            if bytes.find(sig[0..arrow], "Heap") >= 0 {
                heavy = true;
            }
            let close = bytes.find(sig[arrow..len(sig)], "]");
            if close >= 0 {
                let ty = bytes.trim(sig[arrow + close + 1..len(sig)]);
                if bytes.find(ty, "buffer.") >= 0 || bytes.find(ty, "list.") >= 0 || bytes.find(ty, "vec.") >= 0 || bytes.find(ty, "[byte]") >= 0 {
                    heavy = true;
                }
            }
        }
        let tn = json.get(src, tape, get_f(info, u, f_node()), "tests");
        let cn = json.get(src, tape, get_f(info, u, f_node()), "cases");
        let has_tests = (tn >= 0 && json.is_array(tape, tn) && json.count(tape, tn) > 0) || (cn >= 0 && json.is_array(tape, cn) && json.count(tape, cn) > 0);
        if heavy && !has_tests && u != integ {
            b = emit(heap, b, "needs-tests", who, "this function takes a heap, or returns text, a buffer or a list (alone or inside a Result or Option): an example `CALL == EXPECTED` cannot run for it (`==` compares scalars, a test has no heap); give `cases` (inputs and expected values, the tests are made from them) or `tests`");
        }
    }
    // A test is `pub fn test_NAME[regions](caps) -> [row] int` whose parameters are unique `Heap` or `Io` references (docs/testing.md §3). The
    // form models reach for instead, `(world: World)` and a `split(world)` in the body, is not a test: the file then does not build, whatever the unit.
    if ns >= 0 {
        let tn2 = json.get(src, tape, get_f(info, u, f_node()), "tests");
        if tn2 >= 0 && json.is_array(tape, tn2) {
            var k = 0;
            var bad = false;
            var broken = false;
            var discards = false;
            let owns = owning_result(node_text(src, tape, get_f(info, u, f_sig())));
            while k < json.count(tape, tn2) {
                let tt = node_text(src, tape, json.at(tape, tn2, k));
                if bytes.starts_with(tt, "pub fn test_") && (bytes.find(tt, "World") >= 0 || bytes.find(tt, "split(") >= 0) {
                    bad = true;
                }
                // `Ok(_)` / `Some(_)` on the result of the unit's own function, whose payload owns memory: the compiler refuses to discard it
                if owns && calls_name(tt, fn_name(src, tape, info, u)) && (bytes.find(tt, "Ok(_)") >= 0 || bytes.find(tt, "Some(_)") >= 0) {
                    discards = true;
                }
                // the DECODED source (the JSON escapes resolved): that is what the test file will hold
                let dn = json.string_length(src, tape, json.at(tape, tn2, k));
                if dn > 0 {
                    let db = box_slice(heap, dn + 1, byte_of(0));
                    borrow mut db as &!dw in {
                        let got = json.string_into(src, tape, json.at(tape, tn2, k), contents(dw));
                        if got > 0 && newline_in_string(contents(dw)[0..got]) {
                            broken = true;
                        }
                    }
                    unbox_slice(heap, db);
                }
                k = k + 1;
            }
            if discards {
                b = emit(heap, b, "bad-test", who, "a test matches this function's result with `Ok(_)` or `Some(_)`, but the payload owns memory (a buffer, a Box, a list) and the compiler refuses to discard it: bind it and free it in that arm (`buffer.drop(heap, b)` for a buffer, `unbox_slice(heap, b)` for a Box), as the guide's tests example does");
            }
            if broken {
                b = emit(heap, b, "bad-test", who, "a string literal in one of the tests has a line break inside it, and a cancho string cannot span lines: the JSON text of the test has `\\n` (backslash, n) meaning a real line break. Write `\\\\n` in the JSON so that the cancho source holds `\\n` inside the quotes (and `\\\\\"` for a quote, `\\\\\\\\` for a backslash)");
            }
            if bad {
                b = emit(heap, b, "bad-test", who, "a test cannot take a `World` or call `split`: write `pub fn test_NAME[&h](heap: &!h Heap) -> [heap] int { ...; return 0; }` (and `io: &!i Io` the same way) and answer 0 to pass");
            }
        }
    }
    let deps = get_f(info, u, f_dep());
    q = 0;
    while q < json.count(tape, deps) {
        let d = node_text(src, tape, json.at(tape, deps, q));
        if find_id(src, tape, info, n, d) < 0 {
            b = emit(heap, b, "unknown-dep", who, "a dependency names no unit in this plan");
        }
        q = q + 1;
    }
    if get_f(info, u, f_cyc()) == 1 {
        b = emit(heap, b, "cycle", who, "the dependencies of this unit lead back to it");
    }
    return b;
}

// The unit the plan's `integration` names, or -1 (no field, not a string, or no such unit: `integration_rules` reports those).
fn integration_unit[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], n: int) -> [] int {
    let node = json.get(src, tape, 0, "integration");
    if node < 0 || !json.is_string(tape, node) {
        return 0 - 1;
    }
    return find_id(src, tape, info, n, node_text(src, tape, node));
}

// The plan-level rules of `integration`: it names a unit, and that unit depends, directly or through others, on every other unit (it is
// built last, with every function it wires together already verified).
fn integration_rules[&h, &s, &t, &i](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], info: &!i [int], n: int) -> [heap] buffer.Buffer {
    var b = out;
    let node = json.get(src, tape, 0, "integration");
    if node < 0 {
        return b;
    }
    let integ = integration_unit(src, tape, info, n);
    if integ < 0 {
        return emit(heap, b, "bad-integration", "-", "`integration` must be the id of a unit of this plan");
    }
    let rb = box_slice(heap, n + 1, 0);
    var missing = false;
    borrow mut rb as &!rw in {
        let reach = contents(rw);
        reach[integ] = 1;
        var round = 0;
        while round <= n {
            var u = 0;
            while u < n {
                if reach[u] == 1 && get_f(info, u, f_ok()) == 1 {
                    let deps = get_f(info, u, f_dep());
                    var q = 0;
                    while q < json.count(tape, deps) {
                        let v = find_id(src, tape, info, n, node_text(src, tape, json.at(tape, deps, q)));
                        if v >= 0 {
                            reach[v] = 1;
                        }
                        q = q + 1;
                    }
                }
                u = u + 1;
            }
            round = round + 1;
        }
        var w = 0;
        while w < n {
            if reach[w] == 0 && get_f(info, w, f_ok()) == 1 {
                missing = true;
            }
            w = w + 1;
        }
    }
    unbox_slice(heap, rb);
    if missing {
        b = emit(heap, b, "integration-order", label(src, tape, info, integ), "the integration unit must depend, directly or through other units, on every other unit: it is built last");
    }
    return b;
}

// ---- components (docs/profile.md, `units: "components"`) ---------------------------------------------------------------------------------
//
// Under a build profile whose units are components, a unit is `{"id", "component", "trace", "deps"}` (and an optional `description` and `effort`):
// `component` is the name of the one component the unit adds to the entry file, `trace` its trace (a JSON object, or a string that holds one),
// which the project driver writes as the unit's tests file and the profile's `test` command replays. `signature`, `examples`, `tests` and
// `cases` are not read; `bad-signature`, `needs-tests`, `bad-test` and the example rules do not apply. The info fields are the same: `f_sig` is
// the `component` node, `f_ns`..`f_ne` the name within it (-1 when it is not a name), so `find_fn` finds a component by name.

fn collect_components[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], units: int, n: int) -> [] int {
    var u = 0;
    var j = units + 1;
    while u < n {
        set_f(info, u, f_node(), j);
        set_f(info, u, f_file(), 0);
        let isobj = json.is_object(tape, j);
        var idn = 0 - 1;
        var cp = 0 - 1;
        var tr = 0 - 1;
        var dp = 0 - 1;
        var ds = 0 - 1;
        var ef = 0 - 1;
        var fl = 0 - 1;
        if isobj {
            idn = json.get(src, tape, j, "id");
            cp = json.get(src, tape, j, "component");
            tr = json.get(src, tape, j, "trace");
            dp = json.get(src, tape, j, "deps");
            ds = json.get(src, tape, j, "description");
            ef = json.get(src, tape, j, "effort");
            fl = json.get(src, tape, j, "file");
        }
        if idn >= 0 && json.is_string(tape, idn) {
            set_f(info, u, f_id(), idn);
        }
        var ok = 0;
        if isobj && get_f(info, u, f_id()) >= 0 && cp >= 0 && json.is_string(tape, cp) && tr >= 0 && all_strings(tape, dp) && (ds < 0 || json.is_string(tape, ds)) && (ef < 0 || effort_level(src, tape, ef)) && fl < 0 {
            ok = 1;
        }
        set_f(info, u, f_ok(), ok);
        if ok == 1 {
            set_f(info, u, f_sig(), cp);
            set_f(info, u, f_dep(), dp);
            let name = node_text(src, tape, cp);
            if len(name) > 0 && ident_end(name, 0) == len(name) {
                set_f(info, u, f_ns(), 0);
                set_f(info, u, f_ne(), len(name));
            } else {
                set_f(info, u, f_ns(), 0 - 1);
                set_f(info, u, f_ne(), 0 - 1);
            }
        }
        j = json.skip(tape, j);
        u = u + 1;
    }
    return 0;
}

// What is wrong with a component unit that is not usable, field by field.
fn component_problems[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 256);
    if !json.is_object(tape, node) {
        return buffer.append(heap, b, "this unit is not a JSON object; a unit is {\"id\": \"...\", \"component\": \"NAME\", \"description\": \"...\", \"trace\": {...}, \"deps\": []}");
    }
    let idn = json.get(src, tape, node, "id");
    if idn < 0 || !json.is_string(tape, idn) {
        b = buffer.append(heap, b, "`id` is missing or is not a string (letters, digits, underscore); ");
    }
    let cp = json.get(src, tape, node, "component");
    if cp < 0 || !json.is_string(tape, cp) {
        b = buffer.append(heap, b, "`component` is missing or is not a string (the name of the one component this unit adds); ");
    }
    if json.get(src, tape, node, "trace") < 0 {
        b = buffer.append(heap, b, "`trace` is missing (the component's trace: a JSON object whose `component` is the unit's component); ");
    }
    let dp = json.get(src, tape, node, "deps");
    if !all_strings(tape, dp) {
        b = buffer.append(heap, b, "`deps` is missing or is not an array of strings (the ids of the units this one uses; `[]` for none); ");
    }
    let ds = json.get(src, tape, node, "description");
    if ds >= 0 && !json.is_string(tape, ds) {
        b = buffer.append(heap, b, "`description` is not a string; ");
    }
    let ef = json.get(src, tape, node, "effort");
    if ef >= 0 && !effort_level(src, tape, ef) {
        b = buffer.append(heap, b, "`effort` is not one of low, medium, high, xhigh, max; ");
    }
    if json.get(src, tape, node, "file") >= 0 {
        b = buffer.append(heap, b, "`file` is not a field of a component unit (every component is written into the profile's one entry file); ");
    }
    return b;
}

// Does the trace at node `tr` (an object, or a string that parses as one) have a string `component` equal to `name`? 0 it does, 1 the trace is
// neither an object nor a string, 2 the string does not parse as a JSON object, 3 it names no component, 4 it names another one.
fn trace_names[&h, &s, &t, &n](heap: &!h Heap, src: &s [byte], tape: &t [int], tr: int, name: &n [byte]) -> [heap] int {
    if json.is_object(tape, tr) {
        let c = json.get(src, tape, tr, "component");
        if c < 0 || !json.is_string(tape, c) {
            return 3;
        }
        if json.string_equals(src, tape, c, name) {
            return 0;
        }
        return 4;
    }
    if !json.is_string(tape, tr) {
        return 1;
    }
    let dn = json.string_length(src, tape, tr);
    if dn <= 0 {
        return 2;
    }
    var r = 2;
    let db = box_slice(heap, dn + 1, byte_of(0));
    borrow mut db as &!dw in {
        let got = json.string_into(src, tape, tr, contents(dw));
        if got > 0 {
            let text = contents(dw)[0..got];
            let ib = box_slice(heap, json.tape_len(text), 0);
            borrow mut ib as &!iw in {
                let itape = contents(iw);
                if json.parse(text, itape) >= 0 && json.is_object(itape, 0) {
                    let c = json.get(text, itape, 0, "component");
                    if c < 0 || !json.is_string(itape, c) {
                        r = 3;
                    } else if json.string_equals(text, itape, c, name) {
                        r = 0;
                    } else {
                        r = 4;
                    }
                }
            }
            unbox_slice(heap, ib);
        }
    }
    unbox_slice(heap, db);
    return r;
}

fn report_component[&h, &s, &t, &i](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], info: &!i [int], n: int, u: int) -> [heap] buffer.Buffer {
    var b = out;
    let who = label(src, tape, info, u);
    if get_f(info, u, f_ok()) != 1 {
        let why = component_problems(heap, src, tape, get_f(info, u, f_node()));
        var msg = buffer.append(heap, buffer.empty(heap, 128), "the unit cannot be read: ");
        borrow why as &wr in {
            msg = buffer.append(heap, msg, buffer.bytes(wr));
        }
        buffer.drop(heap, why);
        borrow msg as &mr in {
            b = emit(heap, b, "unit-field", who, buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
        return b;
    }
    if find_id(src, tape, info, n, who) != u {
        b = emit(heap, b, "duplicate-id", who, "another unit already has this id");
    }
    if get_f(info, u, f_ns()) < 0 {
        b = emit(heap, b, "bad-component", who, "`component` must be the component's name: one identifier (letters, digits, underscore; not a digit first), such as `Counter`");
    } else {
        let name = fn_name(src, tape, info, u);
        if find_fn(src, tape, info, n, name) != u {
            var msg = buffer.append(heap, buffer.empty(heap, 160), "the component `");
            msg = buffer.append(heap, msg, name);
            msg = buffer.append(heap, msg, "` is already the component of an earlier unit: a component is added by exactly one unit");
            borrow msg as &mr in {
                b = emit(heap, b, "bad-component", who, buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
        let tn = trace_names(heap, src, tape, json.get(src, tape, get_f(info, u, f_node()), "trace"), name);
        if tn != 0 {
            var msg = buffer.empty(heap, 256);
            if tn == 1 {
                msg = buffer.append(heap, msg, "`trace` must be the component's trace: a JSON object (or a string that holds one)");
            } else if tn == 2 {
                msg = buffer.append(heap, msg, "`trace` is a string that is not a JSON object: write the trace as an object, or fix its JSON");
            } else if tn == 3 {
                msg = buffer.append(heap, msg, "the trace names no component: give it `\"component\": \"");
                msg = buffer.append(heap, msg, name);
                msg = buffer.append(heap, msg, "\"` (a trace without one replays some other component)");
            } else {
                msg = buffer.append(heap, msg, "the trace's `component` is not this unit's component: it must be `");
                msg = buffer.append(heap, msg, name);
                msg = buffer.append(heap, msg, "`");
            }
            borrow msg as &mr in {
                b = emit(heap, b, "bad-trace", who, buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
    }
    let deps = get_f(info, u, f_dep());
    var q = 0;
    while q < json.count(tape, deps) {
        let d = node_text(src, tape, json.at(tape, deps, q));
        if find_id(src, tape, info, n, d) < 0 {
            b = emit(heap, b, "unknown-dep", who, "a dependency names no unit in this plan");
        }
        q = q + 1;
    }
    if get_f(info, u, f_cyc()) == 1 {
        b = emit(heap, b, "cycle", who, "the dependencies of this unit lead back to it");
    }
    return b;
}

// ---- files (docs/plan.md, "Files") ------------------------------------------------------------------------------------------------------
//
// A unit may name the module file it belongs to (`file`), and the plan may declare the files (`files`: each with its `module` and the `imports` it
// needs). A file is a slot: 0..F-1 are the entries of `files`, F is `project.cho` when `files` does not list it (the root file, which has no module
// and cannot be imported). A unit without `file` is in the slot of `project.cho`. Slots of units that cannot be placed: -1 (the unit is not usable),
// -2 (its file is not declared), -3 (its file name is not a file name).

// A file name the driver can use: letters, digits, `_`, `.` and `-`, ending in `.cho`, no `..`, and none of the driver's own files.
fn file_name_ok[&t](t: &t [byte]) -> [] bool {
    let n = len(t);
    if n < 5 || n > 64 || !bytes.ends_with(t, ".cho") || bytes.find(t, "..") >= 0 {
        return false;
    }
    var i = 0;
    while i < n {
        let c = int_of(t[i]);
        if !(bytes.is_alpha(c) || bytes.is_digit(c) || c == 95 || c == 46 || c == 45) {
            return false;
        }
        i = i + 1;
    }
    if bytes.equal(t, "main.cho") || bytes.starts_with(t, "tests-") {
        return false;
    }
    return true;
}

// A module name: one identifier, and not one the driver's own files bind (`std`, `test`).
fn module_name_ok[&t](t: &t [byte]) -> [] bool {
    if len(t) == 0 || ident_end(t, 0) != len(t) {
        return false;
    }
    return !(bytes.equal(t, "std") || bytes.equal(t, "test"));
}

// `std.NAME` (more dotted segments allowed).
fn std_import_ok[&t](t: &t [byte]) -> [] bool {
    if !bytes.starts_with(t, "std.") || len(t) < 5 {
        return false;
    }
    var i = 4;
    while i < len(t) {
        let c = int_of(t[i]);
        if !(is_part(c) || c == 46) {
            return false;
        }
        i = i + 1;
    }
    return !bytes.equal(t, "std.test");
}

fn files_count[&s, &t](src: &s [byte], tape: &t [int]) -> [] int {
    let files = json.get(src, tape, 0, "files");
    if files < 0 || !json.is_array(tape, files) {
        return 0;
    }
    return json.count(tape, files);
}

// The text of entry `k`'s string field `key` of `files`, or "" (the entry is not an object, or the field is missing or not a string).
fn entry_text[&s, &t, &k](src: &s [byte], tape: &t [int], k: int, key: &k [byte]) -> [] &s [byte] {
    let files = json.get(src, tape, 0, "files");
    if files < 0 || !json.is_array(tape, files) || k < 0 || k >= json.count(tape, files) {
        return "";
    }
    let e = json.at(tape, files, k);
    if !json.is_object(tape, e) {
        return "";
    }
    let f = json.get(src, tape, e, key);
    if f < 0 || !json.is_string(tape, f) {
        return "";
    }
    return json.string_view(src, tape, f);
}

// The entry of `files` whose `file` is `name`, or -1.
fn find_entry[&s, &t, &x](src: &s [byte], tape: &t [int], name: &x [byte]) -> [] int {
    let fc = files_count(src, tape);
    var k = 0;
    while k < fc {
        let nm = entry_text(src, tape, k, "file");
        if len(nm) > 0 && bytes.equal(nm, name) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The slot of `project.cho`: its entry when `files` lists it, else the one after the last entry.
fn root_slot[&s, &t](src: &s [byte], tape: &t [int]) -> [] int {
    let k = find_entry(src, tape, "project.cho");
    if k >= 0 {
        return k;
    }
    return files_count(src, tape);
}

// The slot whose module is `name`, or -1.
fn slot_of_module[&s, &t, &x](src: &s [byte], tape: &t [int], name: &x [byte]) -> [] int {
    let fc = files_count(src, tape);
    var k = 0;
    while k < fc {
        let m = entry_text(src, tape, k, "module");
        if len(m) > 0 && bytes.equal(m, name) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The name of the file in slot `k`.
fn slot_name[&s, &t](src: &s [byte], tape: &t [int], k: int) -> [] &s [byte] {
    if k == files_count(src, tape) {
        return "project.cho";
    }
    return entry_text(src, tape, k, "file");
}

// Is `name` one of the imports of the entry `k`?
fn entry_imports[&s, &t, &x](src: &s [byte], tape: &t [int], k: int, name: &x [byte]) -> [] bool {
    let files = json.get(src, tape, 0, "files");
    if files < 0 || !json.is_array(tape, files) || k < 0 || k >= json.count(tape, files) {
        return false;
    }
    let e = json.at(tape, files, k);
    if !json.is_object(tape, e) {
        return false;
    }
    let im = json.get(src, tape, e, "imports");
    if im < 0 || !all_strings(tape, im) {
        return false;
    }
    var q = 0;
    while q < json.count(tape, im) {
        if json.string_equals(src, tape, json.at(tape, im, q), name) {
            return true;
        }
        q = q + 1;
    }
    return false;
}

// The file a unit names, as written, or `project.cho`.
fn unit_file_text[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], u: int) -> [] &s [byte] {
    let fl = json.get(src, tape, get_f(info, u, f_node()), "file");
    if fl < 0 || !json.is_string(tape, fl) {
        return "project.cho";
    }
    return json.string_view(src, tape, fl);
}

fn assign_files[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], n: int) -> [] int {
    let root = root_slot(src, tape);
    var u = 0;
    while u < n {
        var slot = 0 - 1;
        if get_f(info, u, f_ok()) == 1 {
            let fl = json.get(src, tape, get_f(info, u, f_node()), "file");
            if fl < 0 {
                slot = root;
            } else {
                let nm = json.string_view(src, tape, fl);
                if bytes.equal(nm, "project.cho") {
                    slot = root;
                } else if !file_name_ok(nm) {
                    slot = 0 - 3;
                } else {
                    let k = find_entry(src, tape, nm);
                    if k < 0 {
                        slot = 0 - 2;
                    } else {
                        slot = k;
                    }
                }
            }
        }
        set_f(info, u, f_file(), slot);
        u = u + 1;
    }
    return 0;
}

// The checks of one entry of `files`: its shape, its names, its imports.
fn entry_rules[&h, &s, &t](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], k: int) -> [heap] buffer.Buffer {
    var b = out;
    let files = json.get(src, tape, 0, "files");
    let e = json.at(tape, files, k);
    let shape = "an entry of `files` is {\"file\": \"store.cho\", \"module\": \"store\", \"imports\": [\"std.buffer\", \"tokens\"]}";
    if !json.is_object(tape, e) {
        return emit(heap, b, "files-field", "-", shape);
    }
    let fnode = json.get(src, tape, e, "file");
    if fnode < 0 || !json.is_string(tape, fnode) {
        return emit(heap, b, "files-field", "-", shape);
    }
    let nm = json.string_view(src, tape, fnode);
    if !file_name_ok(nm) && !bytes.equal(nm, "project.cho") {
        var msg = buffer.append(heap, buffer.empty(heap, 160), "`");
        msg = buffer.append(heap, msg, nm);
        msg = buffer.append(heap, msg, "` is not a file name: letters, digits, `_`, `.` and `-` only, no `/` and no `..`, ending in `.cho`, and not `main.cho` or `tests-...` (the driver's own)");
        borrow msg as &mr in {
            b = emit(heap, b, "file-name", "-", buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
        return b;
    }
    if find_entry(src, tape, nm) != k {
        var msg = buffer.append(heap, buffer.empty(heap, 96), "`");
        msg = buffer.append(heap, msg, nm);
        msg = buffer.append(heap, msg, "` is declared twice in `files`");
        borrow msg as &mr in {
            b = emit(heap, b, "files-field", "-", buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
    }
    let mnode = json.get(src, tape, e, "module");
    if bytes.equal(nm, "project.cho") {
        if mnode >= 0 {
            b = emit(heap, b, "files-field", "-", "`project.cho` is the root file: it has no `module` and no other file can import it");
        }
    } else if mnode < 0 || !json.is_string(tape, mnode) || !module_name_ok(json.string_view(src, tape, mnode)) {
        var msg = buffer.append(heap, buffer.empty(heap, 160), "`");
        msg = buffer.append(heap, msg, nm);
        msg = buffer.append(heap, msg, "` needs a `module`: one identifier (letters, digits, `_`), not `std` or `test`; it is the name the other files import");
        borrow msg as &mr in {
            b = emit(heap, b, "files-field", "-", buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
    } else if slot_of_module(src, tape, json.string_view(src, tape, mnode)) != k {
        var msg = buffer.append(heap, buffer.empty(heap, 96), "the module `");
        msg = buffer.append(heap, msg, json.string_view(src, tape, mnode));
        msg = buffer.append(heap, msg, "` is declared by two files");
        borrow msg as &mr in {
            b = emit(heap, b, "files-field", "-", buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
    }
    let im = json.get(src, tape, e, "imports");
    if im >= 0 && !all_strings(tape, im) {
        var msg = buffer.append(heap, buffer.empty(heap, 96), "`imports` of `");
        msg = buffer.append(heap, msg, nm);
        msg = buffer.append(heap, msg, "` is not an array of strings (`std.NAME` or the module of another file)");
        borrow msg as &mr in {
            b = emit(heap, b, "files-field", "-", buffer.bytes(mr));
        }
        buffer.drop(heap, msg);
    } else if im >= 0 {
        var q = 0;
        while q < json.count(tape, im) {
            let inode = json.at(tape, im, q);
            let it = json.string_view(src, tape, inode);
            var bad = false;
            var why = "";
            if q > 0 {
                var r = 0;
                while r < q {
                    if json.string_equals(src, tape, json.at(tape, im, r), it) {
                        bad = true;
                        why = "is listed twice (an import twice is refused by the compiler)";
                    }
                    r = r + 1;
                }
            }
            if !bad {
                if bytes.starts_with(it, "std.") {
                    if !std_import_ok(it) {
                        bad = true;
                        why = "is not a std module the driver allows (`std.test` is imported by the unit tests themselves)";
                    }
                } else {
                    let ms = slot_of_module(src, tape, it);
                    if ms < 0 {
                        bad = true;
                        why = "is neither a `std.` module nor the `module` of a file in `files`";
                    } else if ms == k {
                        bad = true;
                        why = "is the file's own module";
                    }
                }
            }
            if bad {
                var msg = buffer.append(heap, buffer.empty(heap, 160), "in `imports` of `");
                msg = buffer.append(heap, msg, nm);
                msg = buffer.append(heap, msg, "`: `");
                msg = buffer.append(heap, msg, it);
                msg = buffer.append(heap, msg, "` ");
                msg = buffer.append(heap, msg, why);
                borrow msg as &mr in {
                    b = emit(heap, b, "files-field", "-", buffer.bytes(mr));
                }
                buffer.drop(heap, msg);
            }
            q = q + 1;
        }
    }
    return b;
}

// The plan-level and the unit-level rules of files, after the rules of each unit: the entries of `files`, a unit whose file is not declared or not a file
// name, a unit that depends on a unit of another file that its file does not import, a cycle between files, a file without a unit.
fn file_rules[&h, &s, &t, &i](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], info: &!i [int], n: int) -> [heap] buffer.Buffer {
    var b = out;
    let files = json.get(src, tape, 0, "files");
    if files >= 0 && !json.is_array(tape, files) {
        return emit(heap, b, "files-field", "-", "`files` must be an array of entries {\"file\": \"store.cho\", \"module\": \"store\", \"imports\": [...]}");
    }
    let fc = files_count(src, tape);
    var k = 0;
    while k < fc {
        b = entry_rules(heap, b, src, tape, k);
        k = k + 1;
    }
    let slots = fc + 1;
    let root = root_slot(src, tape);
    let eb = box_slice(heap, slots * slots + 1, 0);
    let ab = box_slice(heap, slots + 1, 0);
    let ub = box_slice(heap, slots + 1, 0);
    borrow mut eb as &!ew in {
    borrow mut ab as &!aw in {
    borrow mut ub as &!uw in {
        let edge = contents(ew);
        let alive = contents(aw);
        let used = contents(uw);
        // the units: placed, and what they need
        var u = 0;
        while u < n {
            let su = get_f(info, u, f_file());
            if su == 0 - 1 && json.is_object(tape, get_f(info, u, f_node())) {
                // a unit that cannot be read still stands in its file (the file is not reported empty because of it)
                let rf = json.get(src, tape, get_f(info, u, f_node()), "file");
                if rf >= 0 && json.is_string(tape, rf) {
                    let rk = find_entry(src, tape, json.string_view(src, tape, rf));
                    if rk >= 0 {
                        used[rk] = used[rk] + 1;
                    }
                }
            }
            if su == 0 - 3 {
                var msg = buffer.append(heap, buffer.empty(heap, 192), "the file `");
                msg = buffer.append(heap, msg, unit_file_text(src, tape, info, u));
                msg = buffer.append(heap, msg, "` is not a file name: letters, digits, `_`, `.` and `-` only, no `/` and no `..`, ending in `.cho`, and not `main.cho` or `tests-...`");
                borrow msg as &mr in {
                    b = emit(heap, b, "file-name", label(src, tape, info, u), buffer.bytes(mr));
                }
                buffer.drop(heap, msg);
            } else if su == 0 - 2 {
                var msg = buffer.append(heap, buffer.empty(heap, 192), "the unit is in `");
                msg = buffer.append(heap, msg, unit_file_text(src, tape, info, u));
                msg = buffer.append(heap, msg, "`, which `files` does not declare: add {\"file\": \"");
                msg = buffer.append(heap, msg, unit_file_text(src, tape, info, u));
                msg = buffer.append(heap, msg, "\", \"module\": ..., \"imports\": [...]} to `files`, or put the unit in a declared file");
                borrow msg as &mr in {
                    b = emit(heap, b, "unknown-file", label(src, tape, info, u), buffer.bytes(mr));
                }
                buffer.drop(heap, msg);
            } else if su >= 0 {
                used[su] = used[su] + 1;
                let deps = get_f(info, u, f_dep());
                var q = 0;
                while q < json.count(tape, deps) {
                    let v = find_id(src, tape, info, n, node_text(src, tape, json.at(tape, deps, q)));
                    if v >= 0 {
                        let sv = get_f(info, v, f_file());
                        if sv >= 0 && sv != su {
                            if sv == root {
                                var msg = buffer.append(heap, buffer.empty(heap, 192), "this unit (in `");
                                msg = buffer.append(heap, msg, slot_name(src, tape, su));
                                msg = buffer.append(heap, msg, "`) depends on the unit `");
                                msg = buffer.append(heap, msg, label(src, tape, info, v));
                                msg = buffer.append(heap, msg, "`, which is in `project.cho`, the root file: no other file can import it; move that unit into a module file, or this one into `project.cho`");
                                borrow msg as &mr in {
                                    b = emit(heap, b, "file-import", label(src, tape, info, u), buffer.bytes(mr));
                                }
                                buffer.drop(heap, msg);
                            } else {
                                edge[su * slots + sv] = 1;
                                if !entry_imports(src, tape, su, entry_text(src, tape, sv, "module")) {
                                    var msg = buffer.append(heap, buffer.empty(heap, 192), "this unit (in `");
                                    msg = buffer.append(heap, msg, slot_name(src, tape, su));
                                    msg = buffer.append(heap, msg, "`) depends on the unit `");
                                    msg = buffer.append(heap, msg, label(src, tape, info, v));
                                    msg = buffer.append(heap, msg, "` of `");
                                    msg = buffer.append(heap, msg, slot_name(src, tape, sv));
                                    msg = buffer.append(heap, msg, "`: add \"");
                                    msg = buffer.append(heap, msg, entry_text(src, tape, sv, "module"));
                                    msg = buffer.append(heap, msg, "\" to the `imports` of `");
                                    msg = buffer.append(heap, msg, slot_name(src, tape, su));
                                    msg = buffer.append(heap, msg, "` in `files`");
                                    borrow msg as &mr in {
                                        b = emit(heap, b, "file-import", label(src, tape, info, u), buffer.bytes(mr));
                                    }
                                    buffer.drop(heap, msg);
                                }
                            }
                        }
                    }
                    q = q + 1;
                }
            }
            u = u + 1;
        }
        // a file without a unit
        k = 0;
        while k < fc {
            if k != root && used[k] == 0 && file_name_ok(entry_text(src, tape, k, "file")) {
                var msg = buffer.append(heap, buffer.empty(heap, 128), "`");
                msg = buffer.append(heap, msg, entry_text(src, tape, k, "file"));
                msg = buffer.append(heap, msg, "` has no unit: every file in `files` holds at least one unit (give a unit `\"file\": \"");
                msg = buffer.append(heap, msg, entry_text(src, tape, k, "file"));
                msg = buffer.append(heap, msg, "\"`, or take the entry out)");
                borrow msg as &mr in {
                    b = emit(heap, b, "empty-file", "-", buffer.bytes(mr));
                }
                buffer.drop(heap, msg);
            }
            k = k + 1;
        }
        // the graph of files: a declared import, or a unit that needs a unit of the other file
        k = 0;
        while k < fc {
            var m = 0;
            while m < fc {
                let mod_m = entry_text(src, tape, m, "module");
                if m != k && len(mod_m) > 0 && entry_imports(src, tape, k, mod_m) {
                    edge[k * slots + m] = 1;
                }
                m = m + 1;
            }
            k = k + 1;
        }
        var a = 0;
        while a < slots {
            alive[a] = 1;
            a = a + 1;
        }
        var round = 0;
        while round <= slots {
            a = 0;
            while a < slots {
                if alive[a] == 1 {
                    var out_edge = false;
                    var in_edge = false;
                    var c = 0;
                    while c < slots {
                        if alive[c] == 1 && c != a {
                            if edge[a * slots + c] == 1 {
                                out_edge = true;
                            }
                            if edge[c * slots + a] == 1 {
                                in_edge = true;
                            }
                        }
                        c = c + 1;
                    }
                    if !out_edge || !in_edge {
                        alive[a] = 0;
                    }
                }
                a = a + 1;
            }
            round = round + 1;
        }
        var listed = buffer.empty(heap, 64);
        var nlisted = 0;
        a = 0;
        while a < slots {
            if alive[a] == 1 {
                nlisted = nlisted + 1;
                if nlisted > 1 {
                    listed = buffer.append(heap, listed, ", ");
                }
                listed = buffer.push(heap, listed, byte_of(96));
                listed = buffer.append(heap, listed, slot_name(src, tape, a));
                listed = buffer.push(heap, listed, byte_of(96));
            }
            a = a + 1;
        }
        if nlisted > 0 {
            var msg = buffer.append(heap, buffer.empty(heap, 160), "these files need each other, directly or through others, in a cycle: ");
            borrow listed as &lq in {
                msg = buffer.append(heap, msg, buffer.bytes(lq));
            }
            msg = buffer.append(heap, msg, ". The edges are the declared `imports` and a unit depending on a unit of another file; make them all point one way (move a unit, or take an import out)");
            borrow msg as &mr in {
                b = emit(heap, b, "file-cycle", "-", buffer.bytes(mr));
            }
            buffer.drop(heap, msg);
        }
        buffer.drop(heap, listed);
    }
    }
    }
    unbox_slice(heap, ub);
    unbox_slice(heap, ab);
    unbox_slice(heap, eb);
    return b;
}

// ---- what the project driver reads of the files (docs/project.md) ------------------------------------------------------------------------

// The file the unit at `node` belongs to: its `file`, else `project.cho`.
pub fn unit_file[&s, &t](src: &s [byte], tape: &t [int], node: int) -> [] &s [byte] {
    let fl = json.get(src, tape, node, "file");
    if fl < 0 || !json.is_string(tape, fl) {
        return "project.cho";
    }
    return json.string_view(src, tape, fl);
}

// The module of the file the unit at `node` belongs to; empty for `project.cho` (the root file).
pub fn unit_module[&s, &t](src: &s [byte], tape: &t [int], node: int) -> [] &s [byte] {
    let nm = unit_file(src, tape, node);
    if bytes.equal(nm, "project.cho") {
        return "";
    }
    let k = find_entry(src, tape, nm);
    if k < 0 {
        return "";
    }
    return entry_text(src, tape, k, "module");
}

// How many entries `files` has (0: none, a single-file plan).
pub fn files_declared[&s, &t](src: &s [byte], tape: &t [int]) -> [] int {
    return files_count(src, tape);
}

pub fn declared_file[&s, &t](src: &s [byte], tape: &t [int], k: int) -> [] &s [byte] {
    return entry_text(src, tape, k, "file");
}

pub fn declared_module[&s, &t](src: &s [byte], tape: &t [int], k: int) -> [] &s [byte] {
    return entry_text(src, tape, k, "module");
}

// The entry for the file `name`, or -1 (`project.cho` when `files` does not list it).
pub fn declared_index[&s, &t, &x](src: &s [byte], tape: &t [int], name: &x [byte]) -> [] int {
    return find_entry(src, tape, name);
}

// How many imports entry `k` declares, and the `q`th.
pub fn import_count[&s, &t](src: &s [byte], tape: &t [int], k: int) -> [] int {
    let files = json.get(src, tape, 0, "files");
    if files < 0 || !json.is_array(tape, files) || k < 0 || k >= json.count(tape, files) {
        return 0;
    }
    let e = json.at(tape, files, k);
    if !json.is_object(tape, e) {
        return 0;
    }
    let im = json.get(src, tape, e, "imports");
    if im < 0 || !all_strings(tape, im) {
        return 0;
    }
    return json.count(tape, im);
}

pub fn import_at[&s, &t](src: &s [byte], tape: &t [int], k: int, q: int) -> [] &s [byte] {
    let files = json.get(src, tape, 0, "files");
    let e = json.at(tape, files, k);
    let im = json.get(src, tape, e, "imports");
    return json.string_view(src, tape, json.at(tape, im, q));
}

// The file whose module is `name`, or "".
pub fn file_of_module[&s, &t, &x](src: &s [byte], tape: &t [int], name: &x [byte]) -> [] &s [byte] {
    let k = slot_of_module(src, tape, name);
    if k < 0 {
        return "";
    }
    return entry_text(src, tape, k, "file");
}

// The names of the declared files other than `project.cho`, separated by a space (empty for a single-file plan).
pub fn extra_files[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 64);
    let fc = files_count(src, tape);
    var k = 0;
    var first = true;
    while k < fc {
        let nm = entry_text(src, tape, k, "file");
        if len(nm) > 0 && !bytes.equal(nm, "project.cho") {
            if !first {
                b = buffer.push(heap, b, byte_of(32));
            }
            first = false;
            b = buffer.append(heap, b, nm);
        }
        k = k + 1;
    }
    return b;
}

fn check_units[&h, &s, &t](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], units: int, components: bool) -> [heap] buffer.Buffer {
    var b = out;
    let n = json.count(tape, units);
    let ib = box_slice(heap, stride() * (n + 1), 0 - 1);
    let sb = box_slice(heap, n + 1, 0);
    borrow mut ib as &!iw in {
        borrow mut sb as &!sw in {
            let info = contents(iw);
            let stack = contents(sw);
            var u = 0;
            while u < n {
                set_f(info, u, f_cur(), 0);
                set_f(info, u, f_col(), 0);
                set_f(info, u, f_cyc(), 0);
                u = u + 1;
            }
            if components {
                // a plan of components (docs/profile.md `units`): one entry file, so no file rules
                collect_components(src, tape, info, units, n);
                cycles(src, tape, info, stack, n);
                b = integration_rules(heap, b, src, tape, info, n);
                u = 0;
                while u < n {
                    b = report_component(heap, b, src, tape, info, n, u);
                    u = u + 1;
                }
            } else {
                collect(src, tape, info, units, n);
                assign_files(src, tape, info, n);
                cycles(src, tape, info, stack, n);
                b = integration_rules(heap, b, src, tape, info, n);
                let integ = integration_unit(src, tape, info, n);
                u = 0;
                while u < n {
                    b = report_unit(heap, b, src, tape, info, n, u, integ);
                    u = u + 1;
                }
                b = file_rules(heap, b, src, tape, info, n);
            }
        }
    }
    unbox_slice(heap, sb);
    unbox_slice(heap, ib);
    return b;
}

// The JSON value at node `i`, written compactly as the source has it: strings with their escapes as written, numbers as their text.
fn add_json[&h, &s, &t](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], i: int) -> [heap] buffer.Buffer {
    var b = out;
    let k = json.kind(tape, i);
    if k == json.kind_object() || k == json.kind_array() {
        let obj = k == json.kind_object();
        if obj {
            b = buffer.push(heap, b, byte_of(123));
        } else {
            b = buffer.push(heap, b, byte_of(91));
        }
        var j = i + 1;
        var left = json.count(tape, i);
        var first = true;
        while left > 0 {
            if !first {
                b = buffer.push(heap, b, byte_of(44));
            }
            first = false;
            if obj {
                b = add_json(heap, b, src, tape, j);
                b = buffer.push(heap, b, byte_of(58));
                j = j + 1;
            }
            b = add_json(heap, b, src, tape, j);
            j = json.skip(tape, j);
            left = left - 1;
        }
        if obj {
            return buffer.push(heap, b, byte_of(125));
        }
        return buffer.push(heap, b, byte_of(93));
    }
    if k == json.kind_string() {
        b = buffer.push(heap, b, byte_of(34));
        b = buffer.append(heap, b, node_text(src, tape, i));
        return buffer.push(heap, b, byte_of(34));
    }
    if k == json.kind_int() || k == json.kind_float() {
        return buffer.append(heap, b, node_text(src, tape, i));
    }
    if k == json.kind_true() {
        return buffer.append(heap, b, "true");
    }
    if k == json.kind_false() {
        return buffer.append(heap, b, "false");
    }
    return buffer.append(heap, b, "null");
}

// The trace of the component unit at `node` (docs/profile.md, `unit_tests: "trace"`), as the unit's tests file holds it: a `trace` that is an
// object written compactly (add_json), one that is a string decoded as it stands; a newline at the end when the text has none.
pub fn trace_text[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int) -> [heap] buffer.Buffer {
    let tr = json.get(src, tape, node, "trace");
    var b = buffer.empty(heap, 512);
    if json.is_string(tape, tr) {
        let n = json.string_length(src, tape, tr);
        if n > 0 {
            let db = box_slice(heap, n + 1, byte_of(0));
            borrow mut db as &!dw in {
                let got = json.string_into(src, tape, tr, contents(dw));
                if got > 0 {
                    b = buffer.append(heap, b, contents(dw)[0..got]);
                }
            }
            unbox_slice(heap, db);
        }
    } else if tr >= 0 {
        b = add_json(heap, b, src, tape, tr);
    }
    var ends = false;
    borrow b as &bq in {
        let t = buffer.bytes(bq);
        ends = len(t) > 0 && int_of(t[len(t) - 1]) == 10;
    }
    if !ends {
        b = buffer.push(heap, b, byte_of(10));
    }
    return b;
}

// The function names the brief states, and whether the plan declares each (used by `build` for a plan it did not just ask for and by the plan agent in each round):
// a bullet `- name(...) : what it does` (or `... ) -> Type : ...`) names a public function, and the
// plan must declare it as `fn name`. Answers "\nname\nname2\n" for the ones no unit declares (empty: none). A brief with no such bullet
// requires nothing.
fn is_name_byte(c: int) -> [] bool {
    return (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
}

pub fn brief_gaps[&h, &b, &s](heap: &!h Heap, brief: &b [byte], plan: &s [byte]) -> [heap] buffer.Buffer {
    var gaps = buffer.append(heap, buffer.empty(heap, 16), "\n");
    var pos = 0;
    while pos < len(brief) {
        var e = pos;
        while e < len(brief) && int_of(brief[e]) != 10 {
            e = e + 1;
        }
        let line = brief[pos..e];
        if len(line) > 3 && int_of(line[0]) == 45 && int_of(line[1]) == 32 && int_of(line[2]) >= 97 && int_of(line[2]) <= 122 {
            var j = 2;
            while j < len(line) && is_name_byte(int_of(line[j])) {
                j = j + 1;
            }
            if j < len(line) && int_of(line[j]) == 40 && (bytes.find(line, ") :") >= 0 || bytes.find(line, ") ->") >= 0) {
                let name = line[2..j];
                // `fn name` must end at the name: the next byte is `(` or `[`.
                var exact = false;
                var rest = plan;
                var look = true;
                while look {
                    let k = bytes.find(rest, "fn ");
                    if k < 0 {
                        look = false;
                    } else {
                        let from = k + 3;
                        if from + len(name) < len(rest) && bytes.equal(rest[from..from + len(name)], name) && (int_of(rest[from + len(name)]) == 40 || int_of(rest[from + len(name)]) == 91) {
                            exact = true;
                            look = false;
                        } else {
                            rest = rest[from..len(rest)];
                        }
                    }
                }
                if !exact {
                    var seen = false;
                    borrow gaps as &gb in {
                        var probe = buffer.append(heap, buffer.empty(heap, 32), "\n");
                        probe = buffer.append(heap, probe, name);
                        probe = buffer.append(heap, probe, "\n");
                        borrow probe as &pb in {
                            seen = bytes.find(buffer.bytes(gb), buffer.bytes(pb)) >= 0;
                        }
                        buffer.drop(heap, probe);
                    }
                    if !seen {
                        gaps = buffer.append(heap, gaps, name);
                        gaps = buffer.append(heap, gaps, "\n");
                    }
                }
            }
        }
        pos = e + 1;
    }
    return gaps;
}

// The report for the names the plan lacks: one `[PLAN_ERROR]<TAB>brief-name<TAB><name><TAB><the action>` line per missing name (ALL of them, so the model fixes
// them in one round), then `[PLAN]<TAB>invalid`; and how many were missing (0: the report is empty).
pub fn brief_report[&h, &b, &s](heap: &!h Heap, brief: &b [byte], plan: &s [byte]) -> [heap] (buffer.Buffer, int) {
    var out = buffer.empty(heap, 16);
    var count = 0;
    let gaps = brief_gaps(heap, brief, plan);
    borrow gaps as &gb in {
        let g = buffer.bytes(gb);
        var at = 1;
        while at < len(g) {
            var e = at;
            while int_of(g[e]) != 10 {
                e = e + 1;
            }
            out = buffer.append(heap, out, "[PLAN_ERROR]\tbrief-name\t");
            out = buffer.append(heap, out, g[at..e]);
            out = buffer.append(heap, out, "\tthe brief names this function and no unit declares it: declare `fn ");
            out = buffer.append(heap, out, g[at..e]);
            out = buffer.append(heap, out, "` with exactly this name (the brief states it; do not rename it)\n");
            count = count + 1;
            at = e + 1;
        }
    }
    buffer.drop(heap, gaps);
    if count > 0 {
        out = buffer.append(heap, out, "[PLAN]\tinvalid\n");
    }
    return (out, count);
}

// Check the plan in `src`: the output text and the exit code (0 valid, 1 invalid).
pub fn check[&h, &s](heap: &!h Heap, src: &s [byte]) -> [heap] (buffer.Buffer, int) {
    return check_as(heap, src, false);
}

// `check` for a plan whose units are functions (`components` false: the default, cancho's) or components (a build profile's `units:
// "components"`, docs/profile.md): a unit is then `component` and `trace` instead of `signature` and `examples` (`collect_components`).
pub fn check_as[&h, &s](heap: &!h Heap, src: &s [byte], components: bool) -> [heap] (buffer.Buffer, int) {
    var out = buffer.empty(heap, 512);
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        let nodes = json.parse(src, tape);
        if nodes < 0 {
            out = emit(heap, out, "plan-json", "-", json.error_message(json.error_code(nodes)));
        } else {
            let name = json.get(src, tape, 0, "name");
            let units = json.get(src, tape, 0, "units");
            if !json.is_object(tape, 0) || name < 0 || !json.is_string(tape, name) || units < 0 || !json.is_array(tape, units) {
                out = emit(heap, out, "plan-json", "-", "the root must be an object with a string `name` and an array `units`");
            } else {
                out = check_units(heap, out, src, tape, units, components);
            }
        }
    }
    unbox_slice(heap, tb);
    var code = 0;
    var bad = false;
    borrow out as &o in {
        bad = buffer.size(o) > 0;
    }
    if bad {
        code = 1;
        out = buffer.append(heap, out, "[PLAN]\tinvalid\n");
    } else {
        out = buffer.append(heap, out, "[PLAN]\tvalid\n");
    }
    return (out, code);
}

// The byte range of the function name in a signature text, or (-1, -1) (for the project driver).
pub fn name_range[&t](t: &t [byte]) -> [] (int, int) {
    return sig_name(t);
}
