edition 7;

module plan;

// The plan check (docs/plan.md): a JSON plan is parsed onto a tape and every
// rule is reported, one `[PLAN_ERROR]` line each, then the verdict. No model.
//
// `info` holds 11 ints per unit (see the field names below); it is filled in
// one pass, the cycles are marked in a second, and the third reports.

import std.buffer;
import std.bytes;
import std.json;

fn f_node() -> [] int { return 0; }
fn f_id() -> [] int { return 1; }
fn f_sig() -> [] int { return 2; }
fn f_ns() -> [] int { return 3; }
fn f_ne() -> [] int { return 4; }
fn f_ex() -> [] int { return 5; }
fn f_dep() -> [] int { return 6; }
fn f_ok() -> [] int { return 7; }
fn f_cur() -> [] int { return 8; }
fn f_col() -> [] int { return 9; }
fn f_cyc() -> [] int { return 10; }
fn stride() -> [] int { return 11; }

fn byte_at[&t](t: &t [byte], i: int) -> [] int {
    if i < 0 || i >= len(t) {
        return 0 - 1;
    }
    return int_of(t[i]);
}

fn is_start(c: int) -> [] bool {
    return bytes.is_alpha(c) || c == 95;
}

fn is_part(c: int) -> [] bool {
    return bytes.is_alpha(c) || bytes.is_digit(c) || c == 95;
}

fn skip_sp[&t](t: &t [byte], p: int) -> [] int {
    var i = p;
    while byte_at(t, i) == 32 {
        i = i + 1;
    }
    return i;
}

// The end of the identifier that starts at `p`, or `p` when there is none.
fn ident_end[&t](t: &t [byte], p: int) -> [] int {
    if !is_start(byte_at(t, p)) {
        return p;
    }
    var i = p + 1;
    while is_part(byte_at(t, i)) {
        i = i + 1;
    }
    return i;
}

// `fn NAME(...) -> [row] TYPE`: the name's byte range, or (-1, -1).
fn sig_name[&t](t: &t [byte]) -> [] (int, int) {
    if !bytes.starts_with(t, "fn ") {
        return (0 - 1, 0 - 1);
    }
    let a = skip_sp(t, 3);
    let b = ident_end(t, a);
    if b == a {
        return (0 - 1, 0 - 1);
    }
    let c = skip_sp(t, b);
    if byte_at(t, c) != 40 {
        return (0 - 1, 0 - 1);
    }
    let arrow = bytes.find(t, "->");
    if arrow < c {
        return (0 - 1, 0 - 1);
    }
    var k = arrow - 1;
    while k > c && byte_at(t, k) == 32 {
        k = k - 1;
    }
    if byte_at(t, k) != 41 {
        return (0 - 1, 0 - 1);
    }
    let d = skip_sp(t, arrow + 2);
    if byte_at(t, d) != 91 {
        return (0 - 1, 0 - 1);
    }
    var e = d + 1;
    while e < len(t) && byte_at(t, e) != 93 {
        e = e + 1;
    }
    if e >= len(t) {
        return (0 - 1, 0 - 1);
    }
    let f = skip_sp(t, e + 1);
    if f >= len(t) {
        return (0 - 1, 0 - 1);
    }
    return (a, b);
}

fn node_text[&s, &t](src: &s [byte], tape: &t [int], i: int) -> [] &s [byte] {
    return src[tape[3 * i + 1]..tape[3 * i + 2]];
}

fn all_strings[&t](tape: &t [int], arr: int) -> [] bool {
    if !json.is_array(tape, arr) {
        return false;
    }
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        if !json.is_string(tape, j) {
            return false;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return true;
}

fn emit[&h, &r, &u, &m](heap: &!h Heap, out: buffer.Buffer, rule: &r [byte], unit: &u [byte], msg: &m [byte]) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "[PLAN_ERROR]\t");
    b = buffer.append(heap, b, rule);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, unit);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, msg);
    b = buffer.append(heap, b, "\n");
    return b;
}

fn get_f[&i](info: &!i [int], u: int, f: int) -> [] int {
    return info[u * stride() + f];
}

fn set_f[&i](info: &!i [int], u: int, f: int, v: int) -> [] int {
    info[u * stride() + f] = v;
    return 0;
}

// The id text of unit `u`, or "-" when it has none.
fn label[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], u: int) -> [] &s [byte] {
    let n = get_f(info, u, f_id());
    if n < 0 {
        return "-";
    }
    return node_text(src, tape, n);
}

fn fn_name[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], u: int) -> [] &s [byte] {
    let sig = node_text(src, tape, get_f(info, u, f_sig()));
    return sig[get_f(info, u, f_ns())..get_f(info, u, f_ne())];
}

fn has_name[&i](info: &!i [int], u: int) -> [] bool {
    return get_f(info, u, f_ok()) == 1 && get_f(info, u, f_ns()) >= 0;
}

// The first unit with this id, or -1.
fn find_id[&s, &t, &i, &x](src: &s [byte], tape: &t [int], info: &!i [int], n: int, text: &x [byte]) -> [] int {
    var u = 0;
    while u < n {
        if get_f(info, u, f_ok()) == 1 && bytes.equal(node_text(src, tape, get_f(info, u, f_id())), text) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// The first unit declaring a function of this name, or -1.
fn find_fn[&s, &t, &i, &x](src: &s [byte], tape: &t [int], info: &!i [int], n: int, text: &x [byte]) -> [] int {
    var u = 0;
    while u < n {
        if has_name(info, u) && bytes.equal(fn_name(src, tape, info, u), text) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

fn collect[&s, &t, &i](src: &s [byte], tape: &t [int], info: &!i [int], units: int, n: int) -> [] int {
    var u = 0;
    var j = units + 1;
    while u < n {
        set_f(info, u, f_node(), j);
        let isobj = json.is_object(tape, j);
        var idn = 0 - 1;
        var sg = 0 - 1;
        var ex = 0 - 1;
        var dp = 0 - 1;
        var ds = 0 - 1;
        if isobj {
            idn = json.get(src, tape, j, "id");
            sg = json.get(src, tape, j, "signature");
            ex = json.get(src, tape, j, "examples");
            dp = json.get(src, tape, j, "deps");
            ds = json.get(src, tape, j, "description");
        }
        if idn >= 0 && json.is_string(tape, idn) {
            set_f(info, u, f_id(), idn);
        }
        var ok = 0;
        if isobj && get_f(info, u, f_id()) >= 0 && sg >= 0 && json.is_string(tape, sg) && all_strings(tape, ex) && all_strings(tape, dp) && (ds < 0 || json.is_string(tape, ds)) {
            ok = 1;
        }
        set_f(info, u, f_ok(), ok);
        if ok == 1 {
            set_f(info, u, f_sig(), sg);
            set_f(info, u, f_ex(), ex);
            set_f(info, u, f_dep(), dp);
            let (a, b) = sig_name(node_text(src, tape, sg));
            set_f(info, u, f_ns(), a);
            set_f(info, u, f_ne(), b);
        }
        j = json.skip(tape, j);
        u = u + 1;
    }
    return 0;
}

// Depth-first search over the dependencies, with an explicit stack. A back
// edge to a node still on the stack closes a cycle; it is reported on the
// first unit of it in the file.
fn cycles[&s, &t, &i, &k](src: &s [byte], tape: &t [int], info: &!i [int], stack: &!k [int], n: int) -> [] int {
    var root = 0;
    while root < n {
        if get_f(info, root, f_ok()) == 1 && get_f(info, root, f_col()) == 0 {
            var sp = 0;
            stack[0] = root;
            sp = 1;
            set_f(info, root, f_col(), 1);
            while sp > 0 {
                let u = stack[sp - 1];
                let deps = get_f(info, u, f_dep());
                let cur = get_f(info, u, f_cur());
                if cur >= json.count(tape, deps) {
                    set_f(info, u, f_col(), 2);
                    sp = sp - 1;
                } else {
                    set_f(info, u, f_cur(), cur + 1);
                    let v = find_id(src, tape, info, n, node_text(src, tape, json.at(tape, deps, cur)));
                    if v >= 0 {
                        let color = get_f(info, v, f_col());
                        if color == 0 {
                            set_f(info, v, f_col(), 1);
                            stack[sp] = v;
                            sp = sp + 1;
                        } else if color == 1 {
                            var low = v;
                            var q = sp - 1;
                            while q >= 0 && stack[q] != v {
                                if stack[q] < low {
                                    low = stack[q];
                                }
                                q = q - 1;
                            }
                            set_f(info, low, f_cyc(), 1);
                        }
                    }
                }
            }
        }
        root = root + 1;
    }
    return 0;
}

// Where " == " splits an example, or -1.
fn split_at[&x](text: &x [byte]) -> [] int {
    return bytes.find(text, " == ");
}

// The length of the called identifier on the left side, or -1 when the left
// side is not `ident(`.
fn call_len[&x](left: &x [byte]) -> [] int {
    let e = ident_end(left, 0);
    if e == 0 || byte_at(left, e) != 40 {
        return 0 - 1;
    }
    return e;
}

fn report_unit[&h, &s, &t, &i](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], info: &!i [int], n: int, u: int) -> [heap] buffer.Buffer {
    var b = out;
    let who = label(src, tape, info, u);
    if get_f(info, u, f_ok()) != 1 {
        return emit(heap, b, "unit-field", who, "a unit must be an object with a string id, a string signature, an array of strings examples and an array of strings deps (and a description, if any, that is a string)");
    }
    if find_id(src, tape, info, n, who) != u {
        b = emit(heap, b, "duplicate-id", who, "another unit already has this id");
    }
    let ns = get_f(info, u, f_ns());
    if ns < 0 {
        b = emit(heap, b, "bad-signature", who, "the signature must be `fn NAME(...) -> [effect row] TYPE`; a function's effect row is required, write `-> [] int` for the pure form");
    } else if find_fn(src, tape, info, n, fn_name(src, tape, info, u)) != u {
        b = emit(heap, b, "duplicate-function", who, "this function is already declared by an earlier unit; a function is declared by exactly one unit");
    }
    let ex = get_f(info, u, f_ex());
    let m = json.count(tape, ex);
    if m == 0 {
        b = emit(heap, b, "no-example", who, "the unit has no example; give at least one `CALL == EXPECTED`");
    } else if ns >= 0 {
        var own = false;
        var shaped = 0;
        var q = 0;
        while q < m {
            let text = node_text(src, tape, json.at(tape, ex, q));
            let at = split_at(text);
            if at >= 0 {
                let left = bytes.trim(text[0..at]);
                let cl = call_len(left);
                if cl > 0 {
                    shaped = shaped + 1;
                }
                if cl > 0 && bytes.equal(left[0..cl], fn_name(src, tape, info, u)) {
                    own = true;
                }
            }
            q = q + 1;
        }
        if !own && shaped > 0 {
            b = emit(heap, b, "example-own", who, "none of the examples calls this unit's own function");
        }
    }
    var q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var cl = 0 - 1;
        var left = text[0..0];
        if at >= 0 {
            left = bytes.trim(text[0..at]);
            cl = call_len(left);
        }
        if ns >= 0 && cl > 0 && find_fn(src, tape, info, n, left[0..cl]) < 0 {
            b = emit(heap, b, "example-callee", who, "an example calls a function that no unit declares");
        }
        q = q + 1;
    }
    q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var cl = 0 - 1;
        if at >= 0 {
            cl = call_len(bytes.trim(text[0..at]));
        }
        if cl < 0 {
            b = emit(heap, b, "example-shape", who, "an example must look like `CALL == EXPECTED`, with a call such as `f(1)` first");
        }
        q = q + 1;
    }
    q = 0;
    while q < m {
        let text = node_text(src, tape, json.at(tape, ex, q));
        let at = split_at(text);
        var same = false;
        if at >= 0 {
            same = bytes.equal(bytes.trim(text[0..at]), bytes.trim(text[at + 4..len(text)]));
        }
        if same || bytes.find(text, "|| true") >= 0 || bytes.find(text, "or true") >= 0 {
            b = emit(heap, b, "tautology", who, "an example whose two sides are the same, or that contains `|| true`, checks nothing");
        }
        q = q + 1;
    }
    let deps = get_f(info, u, f_dep());
    q = 0;
    while q < json.count(tape, deps) {
        let d = node_text(src, tape, json.at(tape, deps, q));
        if find_id(src, tape, info, n, d) < 0 {
            b = emit(heap, b, "unknown-dep", who, "a dependency names no unit in this plan");
        }
        q = q + 1;
    }
    if get_f(info, u, f_cyc()) == 1 {
        b = emit(heap, b, "cycle", who, "the dependencies of this unit lead back to it");
    }
    return b;
}

fn check_units[&h, &s, &t](heap: &!h Heap, out: buffer.Buffer, src: &s [byte], tape: &t [int], units: int) -> [heap] buffer.Buffer {
    var b = out;
    let n = json.count(tape, units);
    let ib = box_slice(heap, stride() * (n + 1), 0 - 1);
    let sb = box_slice(heap, n + 1, 0);
    borrow mut ib as &!iw in {
        borrow mut sb as &!sw in {
            let info = contents(iw);
            let stack = contents(sw);
            var u = 0;
            while u < n {
                set_f(info, u, f_cur(), 0);
                set_f(info, u, f_col(), 0);
                set_f(info, u, f_cyc(), 0);
                u = u + 1;
            }
            collect(src, tape, info, units, n);
            cycles(src, tape, info, stack, n);
            u = 0;
            while u < n {
                b = report_unit(heap, b, src, tape, info, n, u);
                u = u + 1;
            }
        }
    }
    unbox_slice(heap, sb);
    unbox_slice(heap, ib);
    return b;
}

// Check the plan in `src`: the output text and the exit code (0 valid, 1 invalid).
pub fn check[&h, &s](heap: &!h Heap, src: &s [byte]) -> [heap] (buffer.Buffer, int) {
    var out = buffer.empty(heap, 512);
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        let nodes = json.parse(src, tape);
        if nodes < 0 {
            out = emit(heap, out, "plan-json", "-", json.error_message(json.error_code(nodes)));
        } else {
            let name = json.get(src, tape, 0, "name");
            let units = json.get(src, tape, 0, "units");
            if !json.is_object(tape, 0) || name < 0 || !json.is_string(tape, name) || units < 0 || !json.is_array(tape, units) {
                out = emit(heap, out, "plan-json", "-", "the root must be an object with a string `name` and an array `units`");
            } else {
                out = check_units(heap, out, src, tape, units);
            }
        }
    }
    unbox_slice(heap, tb);
    var code = 0;
    var bad = false;
    borrow out as &o in {
        bad = buffer.size(o) > 0;
    }
    if bad {
        code = 1;
        out = buffer.append(heap, out, "[PLAN]\tinvalid\n");
    } else {
        out = buffer.append(heap, out, "[PLAN]\tvalid\n");
    }
    return (out, code);
}

// The byte range of the function name in a signature text, or (-1, -1) (for the project driver).
pub fn name_range[&t](t: &t [byte]) -> [] (int, int) {
    return sig_name(t);
}
