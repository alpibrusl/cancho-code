edition 7;

module project;

// `project` -- the project driver (docs/project.md, docs/parity.md P5): a plan built unit by unit. The next unit whose
// dependencies are verified is handed to `driver.run_issue` (the `fix` loop, reused unchanged); everything verified is
// re-checked after every unit; `state.txt` lets a killed run resume.
//
// The plan is parsed once onto a tape. Per unit `u`, `meta[3u]` is its state (0 open, 1 verified, 2 failed this run),
// `meta[3u+1]` how often it was built, `meta[3u+2]` the length of its NOTE, kept in `notes` (note() bytes per unit).

import acceptance;
import driver;
import parallel;
import plan;
import pool;
import trail;
import snapshot;
import splice;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

fn note_cap() -> [] int {
    return 640;
}

// ---- the language profile (docs/profile.md) ---------------------------------
//
// The driver's `checker` value is the build's toolchain: the checker's absolute path, then, for a profile other than the default, one
// `key<TAB>value` line per field that differs from the default (`src/build.cho` `profile_tool`). For the default it is the path alone, so every
// command below is the bytes it was before profiles. Each place that names a file or a flag reads it with `tool_get`, the default beside it.

// The checker's path: the first line of the toolchain.
pub fn tool_program[&k](tool: &k [byte]) -> [] &k [byte] {
    var i = 0;
    while i < len(tool) && int_of(tool[i]) != 10 {
        i = i + 1;
    }
    return tool[0..i];
}

// The toolchain's value for `key`, or `dflt` when it has none (the default profile's).
pub fn tool_get[&k](tool: &k [byte], key: &static [byte], dflt: &static [byte]) -> [] &k [byte] {
    var i = 0;
    while i < len(tool) && int_of(tool[i]) != 10 {
        i = i + 1;
    }
    while i < len(tool) {
        i = i + 1;
        var e = i;
        while e < len(tool) && int_of(tool[e]) != 10 {
            e = e + 1;
        }
        let line = tool[i..e];
        if len(line) > len(key) && bytes.starts_with(line, key) && int_of(line[len(key)]) == 9 {
            return line[len(key) + 1..len(line)];
        }
        i = e;
    }
    return dflt;
}

// Is the toolchain a profile other than the default?
pub fn tool_profiled[&k](tool: &k [byte]) -> [] bool {
    return len(tool_program(tool)) < len(tool);
}

// The file the units of the default file are written into (`project.cho` by default).
pub fn tool_entry[&k](tool: &k [byte]) -> [] &k [byte] {
    return tool_get(tool, "entry", "project.cho");
}

// `<checker> <words> ` for one of the profile's commands: `check`, `compile` or `test`.
fn add_command[&h, &k](heap: &!h Heap, b: buffer.Buffer, tool: &k [byte], which: &static [byte]) -> [heap] buffer.Buffer {
    var r = buffer.append(heap, b, tool_program(tool));
    r = buffer.append(heap, r, " ");
    if bytes.equal(which, "check") {
        r = buffer.append(heap, r, tool_get(tool, "check", "check --std --output json --backend cranelift"));
    } else if bytes.equal(which, "compile") {
        r = buffer.append(heap, r, tool_get(tool, "compile", "check --std --backend cranelift"));
    } else {
        r = buffer.append(heap, r, tool_get(tool, "test", "test --std --backend cranelift"));
    }
    return buffer.append(heap, r, " ");
}

// `<wd>/<entry> `.
fn add_entry[&h, &k, &w](heap: &!h Heap, b: buffer.Buffer, tool: &k [byte], wd: &w [byte]) -> [heap] buffer.Buffer {
    var r = buffer.append(heap, b, wd);
    r = buffer.append(heap, r, "/");
    r = buffer.append(heap, r, tool_entry(tool));
    return buffer.append(heap, r, " ");
}

// `<wd>/<main> `.
fn add_main[&h, &k, &w](heap: &!h Heap, b: buffer.Buffer, tool: &k [byte], wd: &w [byte]) -> [heap] buffer.Buffer {
    var r = buffer.append(heap, b, wd);
    r = buffer.append(heap, r, "/");
    r = buffer.append(heap, r, tool_get(tool, "main", "main.cho"));
    return buffer.append(heap, r, " ");
}

// `<wd>/<tests file of unit id> ` (`tests-<id>.cho` by default).
fn add_tests_file[&h, &k, &w, &d](heap: &!h Heap, b: buffer.Buffer, tool: &k [byte], wd: &w [byte], id: &d [byte]) -> [heap] buffer.Buffer {
    var r = buffer.append(heap, b, wd);
    r = buffer.append(heap, r, "/");
    r = buffer.append(heap, r, tool_get(tool, "tests_pre", "tests-"));
    r = buffer.append(heap, r, id);
    r = buffer.append(heap, r, tool_get(tool, "tests_suf", ".cho"));
    return buffer.append(heap, r, " ");
}

// The file unit `node` is written into, as a name in the work directory: the plan's `file`, or the profile's entry for the default file.
fn unit_file_in[&h, &k, &s, &t](heap: &!h Heap, tool: &k [byte], src: &s [byte], tape: &t [int], node: int) -> [heap] buffer.Buffer {
    let uf = plan.unit_file(src, tape, node);
    if bytes.equal(uf, "project.cho") {
        return buffer.append(heap, buffer.empty(heap, 32), tool_entry(tool));
    }
    return buffer.append(heap, buffer.empty(heap, 32), uf);
}

// ---- small helpers --------------------------------------------------------

// `<wd>/<pre><id><suf>`.
pub fn in_wd[&h, &w, &a, &b, &c](heap: &!h Heap, wd: &w [byte], pre: &a [byte], id: &b [byte], suf: &c [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 128), wd);
    b = buffer.append(heap, b, "/");
    b = buffer.append(heap, b, pre);
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, suf);
    return b;
}

// Write `b` whole to `path` and end it; 0, or -1 when the write failed.
pub fn put[&h, &z, &p](heap: &!h Heap, fs: &z Fs(""), path: &p [byte], b: buffer.Buffer) -> [heap, fs_write("")] int {
    var r = -1;
    borrow b as &bb in {
        let want = buffer.size(bb);
        if fs_write(fs, path, buffer.bytes(bb)) == want {
            r = 0;
        }
    }
    buffer.drop(heap, b);
    return r;
}

// Append the string at node `i`, decoded.
fn add_str[&h, &s, &t](heap: &!h Heap, b: buffer.Buffer, src: &s [byte], tape: &t [int], i: int) -> [heap] buffer.Buffer {
    var out = b;
    if json.string_plain(tape, i) {
        out = buffer.append(heap, out, json.string_view(src, tape, i));
    } else {
        let n = json.string_length(src, tape, i);
        if n > 0 {
            region r {
                let tmp = alloc_slice[r](n, byte_of(0));
                json.string_into(src, tape, i, tmp);
                out = buffer.append(heap, out, tmp[0..n]);
            }
        }
    }
    return out;
}

// Append `text` to the file `path` (read whole, written whole: a log is small, and the file capability has no append): 0, or -1.
pub fn append_file[&h, &z, &p, &t](heap: &!h Heap, fs: &z Fs(""), path: &p [byte], text: &t [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let room = 4194304;
    let store = box_slice(heap, room, byte_of(0));
    var b = buffer.empty(heap, 256);
    var full = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= room {
            full = true;
        } else if n > 0 {
            b = buffer.append(heap, b, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    b = buffer.append(heap, b, text);
    var r = -1;
    if full == false {
        r = put(heap, fs, path, b);
    } else {
        buffer.drop(heap, b);
    }
    return r;
}

// Say `text` on the console and, when `log` names a file, append it there too (the run's `run.log`, docs/build.md).
pub fn tell[&h, &i, &z, &l, &t](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], text: &t [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    io.write_all(io, text);
    if len(log) > 0 {
        append_file(heap, fs, log, text);
    }
    return 0;
}

fn say[&h, &i, &z, &l, &d](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], id: &d [byte], word: &static [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    var b = buffer.append(heap, buffer.empty(heap, 64), "[UNIT]\t");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, word);
    b = buffer.append(heap, b, "\n");
    borrow b as &bb in {
        tell(heap, io, fs, log, buffer.bytes(bb));
    }
    buffer.drop(heap, b);
    return 0;
}

// ---- files (docs/multi-file.md) ---------------------------------------------------------------------------------------------------------

// `dir/a.cho dir/b.cho ` for the names (separated by a space) of the plan's extra files, each followed by a space: what goes on a compile command
// between `project.cho` and the rest. Nothing for a single-file plan.
fn add_files[&h, &d, &f](heap: &!h Heap, b: buffer.Buffer, dir: &d [byte], names: &f [byte]) -> [heap] buffer.Buffer {
    var out = b;
    var at = 0;
    while at < len(names) {
        var e = at;
        while e < len(names) && int_of(names[e]) != 32 {
            e = e + 1;
        }
        if e > at {
            out = buffer.append(heap, out, dir);
            out = buffer.append(heap, out, "/");
            out = buffer.append(heap, out, names[at..e]);
            out = buffer.append(heap, out, " ");
        }
        at = e + 1;
    }
    return out;
}

// The text of the file `name` in `dir`, at most `cap` bytes; empty when it cannot be read.
fn file_text[&h, &z, &d, &n](heap: &!h Heap, fs: &z Fs(""), dir: &d [byte], name: &n [byte]) -> [heap, fs_read("")] buffer.Buffer {
    let path = in_wd(heap, dir, name, "", "");
    var text = buffer.empty(heap, 16);
    borrow path as &pq in {
        let (t, ok) = slurp_all(heap, fs, buffer.bytes(pq), 1048576);
        buffer.drop(heap, text);
        text = t;
    }
    buffer.drop(heap, path);
    return text;
}

// What the task says about files, for a plan that has them (nothing otherwise): the file the unit is built in, its module, the imports its file already
// has, and the public items of every file it imports (read from `dir`, where the unit works, as they are now), then the files it does not import.
fn file_block[&h, &z, &s, &t, &d](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], node: int, dir: &d [byte]) -> [heap, fs_read("")] buffer.Buffer {
    var b = buffer.empty(heap, 64);
    let uf = plan.unit_file(src, tape, node);
    let fc = plan.files_declared(src, tape);
    if fc == 0 && bytes.equal(uf, "project.cho") {
        return b;
    }
    let um = plan.unit_module(src, tape, node);
    b = buffer.append(heap, b, "\nFILE: ");
    b = buffer.append(heap, b, uf);
    if len(um) > 0 {
        b = buffer.append(heap, b, "\nMODULE: ");
        b = buffer.append(heap, b, um);
    }
    let k = plan.declared_index(src, tape, uf);
    var q = 0;
    var shown = 0;
    if k >= 0 {
        let ni = plan.import_count(src, tape, k);
        if ni > 0 {
            b = buffer.append(heap, b, "\nIMPORTS ALREADY AT THE TOP OF ");
            b = buffer.append(heap, b, uf);
            b = buffer.append(heap, b, ": ");
            while q < ni {
                if q > 0 {
                    b = buffer.append(heap, b, ", ");
                }
                b = buffer.append(heap, b, plan.import_at(src, tape, k, q));
                q = q + 1;
            }
        }
        q = 0;
        while q < ni {
            let im = plan.import_at(src, tape, k, q);
            let nf = plan.file_of_module(src, tape, im);
            if len(nf) > 0 {
                b = buffer.append(heap, b, "\nOTHER FILE ");
                b = buffer.append(heap, b, nf);
                b = buffer.append(heap, b, " (module ");
                b = buffer.append(heap, b, im);
                b = buffer.append(heap, b, "; read only, you do not write it; call its public items with the module name in front, as ");
                b = buffer.append(heap, b, im);
                b = buffer.append(heap, b, ".NAME(...)); its public items now:\n");
                let ft = file_text(heap, fs, dir, nf);
                borrow ft as &ftq in {
                    let items = splice.public_items(heap, buffer.bytes(ftq));
                    borrow items as &itq in {
                        if len(buffer.bytes(itq)) == 0 {
                            b = buffer.append(heap, b, "(nothing yet)\n");
                        } else {
                            b = buffer.append(heap, b, buffer.bytes(itq));
                        }
                    }
                    buffer.drop(heap, items);
                }
                buffer.drop(heap, ft);
                shown = shown + 1;
            }
            q = q + 1;
        }
    }
    var other = 0;
    var m = 0;
    while m < fc {
        let nm = plan.declared_file(src, tape, m);
        if len(nm) > 0 && bytes.equal(nm, uf) == false && bytes.equal(nm, "project.cho") == false {
            var imported = false;
            if k >= 0 {
                var r = 0;
                while r < plan.import_count(src, tape, k) {
                    if bytes.equal(plan.import_at(src, tape, k, r), plan.declared_module(src, tape, m)) {
                        imported = true;
                    }
                    r = r + 1;
                }
            }
            if imported == false {
                if other == 0 {
                    b = buffer.append(heap, b, "\nNOT IMPORTED BY ");
                    b = buffer.append(heap, b, uf);
                    b = buffer.append(heap, b, " (do not use): ");
                } else {
                    b = buffer.append(heap, b, ", ");
                }
                b = buffer.append(heap, b, nm);
                other = other + 1;
            }
        }
        m = m + 1;
    }
    return b;
}

// Does the signature of a unit in the file `name` mention `word` (`result.`, `buffer.`, `option.`)?
fn file_names[&s, &t, &n, &x](src: &s [byte], tape: &t [int], name: &n [byte], word: &x [byte]) -> [] bool {
    let units = json.get(src, tape, 0, "units");
    var j = units + 1;
    var left = json.count(tape, units);
    while left > 0 {
        if bytes.equal(plan.unit_file(src, tape, j), name) {
            let sg = json.get(src, tape, j, "signature");
            if sg >= 0 && json.is_string(tape, sg) && bytes.find(json.string_view(src, tape, sg), word) >= 0 {
                return true;
            }
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return false;
}

// The scaffold of a declared file: `edition 7;`, its `module` line when it has one, its imports (docs/multi-file.md). Written when the file is absent, so a
// resumed run keeps what is there.
fn write_files[&h, &z, &s, &t, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], wd: &w [byte]) -> [heap, fs_read(""), fs_write("")] int {
    var r = 0;
    let fc = plan.files_declared(src, tape);
    var k = 0;
    while k < fc {
        let nm = plan.declared_file(src, tape, k);
        if len(nm) > 0 {
            let pp = in_wd(heap, wd, nm, "", "");
            borrow pp as &pq in {
                region g {
                    let probe = alloc_slice[g](16, byte_of(0));
                    let had = fs_read(fs, buffer.bytes(pq), probe);
                    // project.cho is made by `write_fixed` as just `edition 7;`: that is a file nobody has written to yet, and gets its imports
                    var fresh = had < 0;
                    if had == 11 && bytes.equal(probe[0..11], "edition 7;\n") {
                        fresh = true;
                    }
                    if fresh {
                        var b = buffer.append(heap, buffer.empty(heap, 128), "edition 7;\n");
                        let md = plan.declared_module(src, tape, k);
                        if len(md) > 0 {
                            b = buffer.append(heap, b, "\nmodule ");
                            b = buffer.append(heap, b, md);
                            b = buffer.append(heap, b, ";\n");
                        }
                        let ni = plan.import_count(src, tape, k);
                        // the standard modules the signatures of the file's own units name (`build`'s scaffold rule), unless the plan declares them
                        var want_result = file_names(src, tape, nm, "result.");
                        var want_buffer = file_names(src, tape, nm, "buffer.");
                        var want_option = file_names(src, tape, nm, "option.");
                        var q = 0;
                        while q < ni {
                            if bytes.equal(plan.import_at(src, tape, k, q), "std.result") {
                                want_result = false;
                            }
                            if bytes.equal(plan.import_at(src, tape, k, q), "std.buffer") {
                                want_buffer = false;
                            }
                            if bytes.equal(plan.import_at(src, tape, k, q), "std.option") {
                                want_option = false;
                            }
                            q = q + 1;
                        }
                        if ni > 0 || want_result || want_buffer || want_option {
                            b = buffer.append(heap, b, "\n");
                        }
                        q = 0;
                        while q < ni {
                            b = buffer.append(heap, b, "import ");
                            b = buffer.append(heap, b, plan.import_at(src, tape, k, q));
                            b = buffer.append(heap, b, ";\n");
                            q = q + 1;
                        }
                        if want_result {
                            b = buffer.append(heap, b, "import std.result;\n");
                        }
                        if want_buffer {
                            b = buffer.append(heap, b, "import std.buffer;\n");
                        }
                        if want_option {
                            b = buffer.append(heap, b, "import std.option;\n");
                        }
                        if put(heap, fs, buffer.bytes(pq), b) < 0 {
                            r = -1;
                        }
                    }
                }
            }
            buffer.drop(heap, pp);
        }
        k = k + 1;
    }
    return r;
}

// ---- the plan -------------------------------------------------------------

fn uid[&s, &t, &n](src: &s [byte], tape: &t [int], nodes: &n [int], u: int) -> [] &s [byte] {
    return json.string_view(src, tape, json.get(src, tape, nodes[u], "id"));
}

fn find_unit[&s, &t, &n, &x](src: &s [byte], tape: &t [int], nodes: &n [int], count: int, id: &x [byte]) -> [] int {
    var u = 0;
    while u < count {
        if bytes.equal(uid(src, tape, nodes, u), id) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// Are all of `u`'s dependencies verified?
fn deps_done[&s, &t, &n, &m](src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int, u: int) -> [] bool {
    let arr = json.get(src, tape, nodes[u], "deps");
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        let d = find_unit(src, tape, nodes, count, json.string_view(src, tape, j));
        if d < 0 || meta[3 * d] != 1 {
            return false;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return true;
}

// The first unit in file order that is open and ready, or -1.
fn next_unit[&s, &t, &n, &m](src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int) -> [] int {
    var u = 0;
    while u < count {
        if meta[3 * u] == 0 && deps_done(src, tape, nodes, meta, count, u) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// ---- notes ----------------------------------------------------------------

fn fill[&o, &x](notes: &!o [byte], base: int, pos: int, text: &x [byte]) -> [] int {
    var p = pos;
    var k = 0;
    while k < len(text) && p < note_cap() {
        notes[base + p] = text[k];
        p = p + 1;
        k = k + 1;
    }
    return p;
}

// The NOTE of unit `u`: which unit broke it, and the failing output (cut to fit).
fn set_note[&o, &m, &b, &x](notes: &!o [byte], meta: &!m [int], u: int, broke: &b [byte], said: &x [byte]) -> [] int {
    let base = u * note_cap();
    var p = fill(notes, base, 0, "The unit ");
    p = fill(notes, base, p, broke);
    p = fill(notes, base, p, " broke this one. Failing test output:\n");
    p = fill(notes, base, p, said);
    meta[3 * u + 2] = p;
    return 0;
}

// ---- files ----------------------------------------------------------------

// `edition 7;` and the unit's examples as tests, and the legend.
// The JSON string at node `i`, decoded (it may hold quotes and newlines), appended to `b`.
fn add_decoded[&h, &s, &t](heap: &!h Heap, b: buffer.Buffer, src: &s [byte], tape: &t [int], i: int) -> [heap] buffer.Buffer {
    var r = b;
    let n = json.string_length(src, tape, i);
    if n > 0 {
        region dr {
            let out = alloc_slice[dr](n + 1, byte_of(0));
            let w = json.string_into(src, tape, i, out);
            if w > 0 {
                r = buffer.append(heap, r, out[0..w]);
            }
        }
    }
    return r;
}

// The body of one example's test: `() -> [] int { ...; return 0; }`. `CALL == EXPECTED` is `test.assert(CALL == EXPECTED)`, except when
// EXPECTED is an Option (`option.Option::Some(X)` or `option.Option::None`): the compiler has no `==` on enums, so the call is matched
// and X compared as a scalar. That is the one enum the examples can name. The tests file does NOT import std.option: files compiled together
// share their imports, and the project file has to import it for the unit's signature to exist.
fn example_body[&h, &e](heap: &!h Heap, out: buffer.Buffer, ex: &e [byte]) -> [heap] buffer.Buffer {
    var b = out;
    let at = bytes.find(ex, " == ");
    if at >= 0 {
        let call = ex[0..at];
        let want = ex[at + 4..len(ex)];
        if bytes.find(want, "option.Option::None") == 0 {
            b = buffer.append(heap, b, "() -> [] int { match ");
            b = buffer.append(heap, b, call);
            b = buffer.append(heap, b, " { option.Option::Some(v) => { test.assert(false); } option.Option::None => { test.assert(true); } } return 0; }\n");
            return b;
        }
        if bytes.find(want, "option.Option::Some(") == 0 && len(want) > 20 && int_of(want[len(want) - 1]) == 41 {
            b = buffer.append(heap, b, "() -> [] int { match ");
            b = buffer.append(heap, b, call);
            b = buffer.append(heap, b, " { option.Option::Some(v) => { test.assert(v == ");
            b = buffer.append(heap, b, want[20..len(want) - 1]);
            b = buffer.append(heap, b, "); } option.Option::None => { test.assert(false); } } return 0; }\n");
            return b;
        }
    }
    b = buffer.append(heap, b, "() -> [] int { test.assert(");
    b = buffer.append(heap, b, ex);
    b = buffer.append(heap, b, "); return 0; }\n");
    return b;
}

fn write_tests[&h, &z, &s, &t, &w, &k](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], node: int, wd: &w [byte], tool: &k [byte]) -> [heap, fs_write("")] int {
    let id = json.string_view(src, tape, json.get(src, tape, node, "id"));
    var sid = buffer.empty(heap, 32);
    var q = 0;
    while q < len(id) {
        let c = int_of(id[q]);
        if bytes.is_alpha(c) || bytes.is_digit(c) || c == 95 {
            sid = buffer.push(heap, sid, id[q]);
        } else {
            sid = buffer.push(heap, sid, byte_of(95));
        }
        q = q + 1;
    }
    // A unit of a module file has its tests in that module (docs/multi-file.md): they call the unit's function as the file does, see what the file
    // imports, and the unit's own file imports `std.test` for them.
    var tests = buffer.append(heap, buffer.empty(heap, 512), "edition 7;\n");
    let tmod = plan.unit_module(src, tape, node);
    if len(tmod) > 0 {
        tests = buffer.append(heap, tests, "module ");
        tests = buffer.append(heap, tests, tmod);
        tests = buffer.append(heap, tests, ";\n");
    }
    tests = buffer.append(heap, tests, "import std.test;\n");
    var legend = buffer.empty(heap, 256);
    // A unit's own `tests` (docs/plan.md) are the executable form when it has any: the examples stay documentation, for a function
    // an example cannot call (a result that is text, or a Result).
    let rt = json.get(src, tape, node, "tests");
    var raw = 0;
    if rt >= 0 {
        raw = json.count(tape, rt);
    }
    let arr = json.get(src, tape, node, "examples");
    var j = arr + 1;
    var left = json.count(tape, arr);
    if raw > 0 {
        left = 0;
    }
    var k = 1;
    while left > 0 {
        var ex = add_str(heap, buffer.empty(heap, 64), src, tape, j);
        var name = buffer.append(heap, buffer.empty(heap, 32), "test_");
        borrow sid as &sb in {
            name = buffer.append(heap, name, buffer.bytes(sb));
        }
        name = buffer.append(heap, name, "_");
        name = buffer.push_nat(heap, name, k);
        borrow name as &nb in {
            borrow ex as &eb in {
                tests = buffer.append(heap, tests, "pub fn ");
                tests = buffer.append(heap, tests, buffer.bytes(nb));
                tests = example_body(heap, tests, buffer.bytes(eb));
                legend = buffer.append(heap, legend, buffer.bytes(nb));
                legend = buffer.append(heap, legend, " ");
                legend = buffer.append(heap, legend, buffer.bytes(eb));
                legend = buffer.append(heap, legend, "\n");
            }
        }
        buffer.drop(heap, name);
        buffer.drop(heap, ex);
        j = json.skip(tape, j);
        left = left - 1;
        k = k + 1;
    }
    buffer.drop(heap, sid);
    if raw > 0 {
        var rj = rt + 1;
        var rleft = raw;
        while rleft > 0 {
            tests = plan.add_unit_test(heap, tests, src, tape, plan.unit_file(src, tape, node), rj);
            tests = buffer.append(heap, tests, "\n");
            legend = buffer.append(heap, legend, "(the unit's own test, named in the output above)\n");
            rj = json.skip(tape, rj);
            rleft = rleft - 1;
        }
    }
    let tp = in_wd(heap, wd, tool_get(tool, "tests_pre", "tests-"), id, tool_get(tool, "tests_suf", ".cho"));
    let lp = in_wd(heap, wd, "legend-", id, ".txt");
    var r = 0;
    borrow tp as &tq in {
        if put(heap, fs, buffer.bytes(tq), tests) < 0 {
            r = -1;
        }
    }
    borrow lp as &lq in {
        if put(heap, fs, buffer.bytes(lq), legend) < 0 {
            r = -1;
        }
    }
    buffer.drop(heap, tp);
    buffer.drop(heap, lp);
    return r;
}

// `<file>.task` for unit `node` (`project.cho.task` for a unit of the default file).
fn write_task[&h, &z, &s, &t, &w, &x, &y, &k](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], node: int, wd: &w [byte], note: &x [byte], hint: &y [byte], integ: bool, tool: &k [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let id = json.string_view(src, tape, json.get(src, tape, node, "id"));
    let sg = json.get(src, tape, node, "signature");
    var sig = add_str(heap, buffer.empty(heap, 96), src, tape, sg);
    var b = buffer.append(heap, buffer.empty(heap, 512), "UNIT: ");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, "\nFUNCTION: ");
    borrow sig as &sb in {
        let (a, e) = plan.name_range(buffer.bytes(sb));
        if a >= 0 {
            b = buffer.append(heap, b, buffer.bytes(sb)[a..e]);
        }
        b = buffer.append(heap, b, "\nSIGNATURE: ");
        b = buffer.append(heap, b, buffer.bytes(sb));
    }
    buffer.drop(heap, sig);
    // The description, decoded (it holds quotes and newlines): what the signature and the examples cannot say.
    let dn = json.get(src, tape, node, "description");
    if dn >= 0 && json.is_string(tape, dn) {
        b = buffer.append(heap, b, "\nDESCRIPTION: ");
        b = add_decoded(heap, b, src, tape, dn);
    }
    // How hard the model should think about this unit (docs/plan.md `effort`): the agent reads it and sends it as the request's effort.
    let en = json.get(src, tape, node, "effort");
    if en >= 0 && json.is_string(tape, en) {
        b = buffer.append(heap, b, "\nEFFORT: ");
        b = add_decoded(heap, b, src, tape, en);
    }
    // The files of a multi-file plan (docs/multi-file.md): which file this unit writes and what the other files offer.
    let fb = file_block(heap, fs, src, tape, node, wd);
    borrow fb as &fbq in {
        b = buffer.append(heap, b, buffer.bytes(fbq));
    }
    buffer.drop(heap, fb);
    let uf = plan.unit_file(src, tape, node);
    let um = plan.unit_module(src, tape, node);
    if integ {
        // The integration unit (docs/plan.md `integration`): the application, wired from the functions already in project.cho, judged by
        // the service's acceptance scenarios, whose output is the feedback. It has no examples.
        b = buffer.append(heap, b, "\nINSTRUCTIONS: Add the application to project.cho: the definitions the description names, wired from the functions that are already in the file (call them; do not write them again). The service's acceptance scenarios are run for you on the whole service (the file plus the fixed server loop that holds `main`); when one fails, its output is the feedback. Do not write a main, tests or examples of your own. If a scenario shows that an earlier function is wrong, fix that function too, keeping every other function as it is.\n");
    } else {
        b = buffer.append(heap, b, "\nEXAMPLES:\n");
        let arr = json.get(src, tape, node, "examples");
        var j = arr + 1;
        var left = json.count(tape, arr);
        while left > 0 {
            b = add_str(heap, b, src, tape, j);
            b = buffer.append(heap, b, "\n");
            j = json.skip(tape, j);
            left = left - 1;
        }
        if len(um) > 0 {
            b = buffer.append(heap, b, "INSTRUCTIONS: Add this function to ");
            b = buffer.append(heap, b, uf);
            b = buffer.append(heap, b, ", keeping every other function as it is. The file is the module `");
            b = buffer.append(heap, b, um);
            b = buffer.append(heap, b, "`: its `module` line and its imports are already there, and you write only this one file. Declare the function `pub fn`: another module can call a function only when it is `pub`, and the unit is refused otherwise. Call another module's function with the module name in front (`module_name.function_name(...)`), only for a module this file imports. The file has no main. Do not write tests or examples of your own: the examples above are run for you.\n");
        } else if plan.files_declared(src, tape) > 0 {
            b = buffer.append(heap, b, "INSTRUCTIONS: Add this function to project.cho, keeping every other function as it is. project.cho is the root file: call a function of another file with its module name in front (`module_name.function_name(...)`), for a module the file imports. The file has no main. Do not write tests or examples of your own: the examples above are run for you.\n");
        } else {
            b = buffer.append(heap, b, "INSTRUCTIONS: Add this function to project.cho, keeping every other function as it is. The file has no main. Do not write tests or examples of your own: the examples above are run for you.\n");
        }
    }
    if len(note) > 0 {
        b = buffer.append(heap, b, "NOTE: ");
        b = buffer.append(heap, b, note);
        b = buffer.append(heap, b, "\n");
    }
    // What a person said about this unit when they re-opened it (`--retry <unit> --hint "..."`): one `HINT:` line per line of their text. The agent
    // puts it in the prompt under its own heading (src/prompt.cho); the checks decide as before.
    var at = 0;
    while at < len(hint) {
        var e = at;
        while e < len(hint) && int_of(hint[e]) != 10 {
            e = e + 1;
        }
        let said = bytes.trim(hint[at..e]);
        if len(said) > 0 {
            b = buffer.append(heap, b, "HINT: ");
            b = buffer.append(heap, b, said);
            b = buffer.append(heap, b, "\n");
        }
        at = e + 1;
    }
    let tf = unit_file_in(heap, tool, src, tape, node);
    var path = buffer.empty(heap, 8);
    borrow tf as &tfq in {
        buffer.drop(heap, path);
        path = in_wd(heap, wd, buffer.bytes(tfq), ".task", "");
    }
    buffer.drop(heap, tf);
    var r = 0;
    borrow path as &pq in {
        r = put(heap, fs, buffer.bytes(pq), b);
    }
    buffer.drop(heap, path);
    return r;
}

// `state.txt`, rewritten whole: one `verified <id>` per verified unit.
fn state_write[&h, &z, &s, &t, &n, &m, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int, wd: &w [byte]) -> [heap, fs_write("")] int {
    var b = buffer.empty(heap, 128);
    var u = 0;
    while u < count {
        if meta[3 * u] == 1 {
            b = buffer.append(heap, b, "verified ");
            b = buffer.append(heap, b, uid(src, tape, nodes, u));
            b = buffer.append(heap, b, "\n");
        }
        u = u + 1;
    }
    let path = in_wd(heap, wd, "state.txt", "", "");
    var r = 0;
    borrow path as &pq in {
        r = put(heap, fs, buffer.bytes(pq), b);
    }
    buffer.drop(heap, path);
    return r;
}

// Mark the units `state.txt` names as verified (a missing file is empty).
fn state_read[&h, &z, &s, &t, &n, &m, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], count: int, wd: &w [byte]) -> [heap, fs_read("")] int {
    let path = in_wd(heap, wd, "state.txt", "", "");
    borrow path as &pq in {
        region r {
            let text = alloc_slice[r](65536, byte_of(0));
            let got = fs_read(fs, buffer.bytes(pq), text);
            var p = 0;
            while p < got {
                var e = p;
                while e < got && int_of(text[e]) != 10 {
                    e = e + 1;
                }
                let line = text[p..e];
                if bytes.starts_with(line, "verified ") {
                    let u = find_unit(src, tape, nodes, count, bytes.trim(line[9..len(line)]));
                    if u >= 0 {
                        meta[3 * u] = 1;
                    }
                }
                p = e + 1;
            }
        }
    }
    buffer.drop(heap, path);
    return 0;
}

// `main.cho` (a fixed main that releases every capability) and `project.cho` when absent: 0, or -1 when the work directory
// cannot be written.
fn write_fixed[&h, &z, &w, &k](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], tool: &k [byte]) -> [heap, fs_read(""), fs_write("")] int {
    var m = buffer.append(heap, buffer.empty(heap, 512), "edition 7;\n\nfn main(world: World) -> [] int {\n");
    m = buffer.append(heap, m, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    m = buffer.append(heap, m, "    release(io);\n    release(ffi);\n    release(fs);\n    release(heap);\n    release(args);\n");
    m = buffer.append(heap, m, "    release(net);\n    release(clock);\n    release(signals);\n    release(exec);\n    return 0;\n}\n");
    let mp = in_wd(heap, wd, tool_get(tool, "main", "main.cho"), "", "");
    var r = 0;
    borrow mp as &mq in {
        r = put(heap, fs, buffer.bytes(mq), m);
    }
    buffer.drop(heap, mp);
    let pp = in_wd(heap, wd, tool_entry(tool), "", "");
    borrow pp as &pq in {
        region g {
            let probe = alloc_slice[g](16, byte_of(0));
            if fs_read(fs, buffer.bytes(pq), probe) < 0 {
                if fs_write(fs, buffer.bytes(pq), "edition 7;\n") < 0 {
                    r = -1;
                }
            }
        }
    }
    buffer.drop(heap, pp);
    return r;
}

// ---- commands -------------------------------------------------------------

// The unit's acceptance command (the file is appended by the runner, the `#` ends the command).
//
// `libs` are source files every compile gets beside the project (a service's http-server package). The integration unit's acceptance
// is the service's own command (`accept`): it builds and runs the whole service, and the runner appends the project file to it.
fn unit_accept[&h, &k, &w, &s, &t, &n, &ac, &lb](heap: &!h Heap, checker: &k [byte], wd: &w [byte], src: &s [byte], tape: &t [int], nodes: &n [int], u: int, integ: bool, accept: &ac [byte], libs: &lb [byte]) -> [heap] buffer.Buffer {
    if integ {
        return buffer.append(heap, buffer.empty(heap, 512), accept);
    }
    let id = uid(src, tape, nodes, u);
    var b = buffer.empty(heap, 512);
    // A unit of a module file declares its function `pub` (docs/multi-file.md): its tests are in the module and would pass on a private function,
    // but the next unit, in another module, could not call it. Checked first, with the refusal as the first line of the output.
    let um = plan.unit_module(src, tape, nodes[u]);
    if len(um) > 0 {
        let uf = plan.unit_file(src, tape, nodes[u]);
        let (fa, fe) = plan.name_range(json.string_view(src, tape, json.get(src, tape, nodes[u], "signature")));
        if fa >= 0 {
            let fname = json.string_view(src, tape, json.get(src, tape, nodes[u], "signature"))[fa..fe];
            b = buffer.append(heap, b, "{ grep -Eq '^pub fn ");
            b = buffer.append(heap, b, fname);
            b = buffer.append(heap, b, "[[(]' ");
            b = buffer.append(heap, b, wd);
            b = buffer.append(heap, b, "/");
            b = buffer.append(heap, b, uf);
            b = buffer.append(heap, b, " || { echo 'error: ");
            b = buffer.append(heap, b, fname);
            b = buffer.append(heap, b, " is not declared pub fn in ");
            b = buffer.append(heap, b, uf);
            b = buffer.append(heap, b, " (module ");
            b = buffer.append(heap, b, um);
            b = buffer.append(heap, b, "): another module can call only a pub function'; exit 1; }; } && ");
        }
    }
    b = add_command(heap, b, checker, "test");
    // The tests of a unit of a module file are in that module and run on the module files without project.cho (docs/multi-file.md): `cancho test`
    // makes a root runner that imports the module under test, and a project.cho that imports it too is refused (`is already bound to another import`).
    // No module imports project.cho, so nothing of the module's depends on it.
    if len(um) == 0 {
        b = add_entry(heap, b, checker, wd);
    }
    let fl = plan.extra_files(heap, src, tape);
    borrow fl as &flq in {
        b = add_files(heap, b, wd, buffer.bytes(flq));
    }
    buffer.drop(heap, fl);
    b = add_tests_file(heap, b, checker, wd, id);
    b = buffer.append(heap, b, libs);
    b = buffer.append(heap, b, " || { cat ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/legend-");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, ".txt; exit 1; } #");
    return b;
}

// How long one acceptance run may take: a unit's tests, or the integration unit's whole service (a build, a server, its scenarios).
fn accept_ms(integ: bool) -> [] int {
    if integ {
        return 300000;
    }
    return 60000;
}

// Run unit `id`'s acceptance command on project.cho.
fn verify[&h, &x, &c, &k, &w, &s, &t, &n, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, checker: &k [byte], wd: &w [byte], src: &s [byte], tape: &t [int], nodes: &n [int], u: int, integ: bool, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] acceptance.Result {
    let text = unit_accept(heap, checker, wd, src, tape, nodes, u, integ, accept, libs);
    let file = in_wd(heap, wd, tool_entry(checker), "", "");
    var ans = acceptance.Result { held: 2, why: buffer.empty(heap, 8), said: buffer.empty(heap, 8) };
    borrow text as &tb in {
        borrow file as &fb in {
            acceptance.drop(heap, ans);
            ans = acceptance.run(heap, exec, clock, buffer.bytes(tb), buffer.bytes(fb), 4096, accept_ms(integ));
        }
    }
    buffer.drop(heap, text);
    buffer.drop(heap, file);
    return ans;
}

// `ids` and `id` after it, comma-separated (the journal's sweep event).
fn note_id[&h, &d](heap: &!h Heap, ids: buffer.Buffer, id: &d [byte]) -> [heap] buffer.Buffer {
    var b = ids;
    var some = false;
    borrow b as &bq in {
        some = buffer.size(bq) > 0;
    }
    if some {
        b = buffer.push(heap, b, byte_of(44));
    }
    return buffer.append(heap, b, id);
}

// The sweep event of a `recheck` (docs/journal.md), when it checked anything; ends the two lists.
fn sweep_event[&h, &c, &z, &w, &b](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], skip: int, broke: &b [byte], held_ids: buffer.Buffer, bad_ids: buffer.Buffer) -> [heap, clock, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        borrow held_ids as &hq in {
            borrow bad_ids as &bq in {
                if len(buffer.bytes(hq)) + len(buffer.bytes(bq)) > 0 {
                    if skip >= 0 {
                        trail.journal_sweep(heap, clock, fs, buffer.bytes(jq), broke, buffer.bytes(hq), buffer.bytes(bq));
                    } else {
                        trail.journal_sweep(heap, clock, fs, buffer.bytes(jq), "", buffer.bytes(hq), buffer.bytes(bq));
                    }
                }
            }
        }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, held_ids);
    buffer.drop(heap, bad_ids);
    return 0;
}

// Re-verify every verified unit but `skip` (-1: none): the ones that fail go back on the board, with a NOTE naming `broke`.
fn recheck[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &b, &l, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &!o [byte], count: int, skip: int, broke: &b [byte], keep: bool, checker: &k [byte], wd: &w [byte], log: &l [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll, io_write, fs_read(""), fs_write("")] int {
    var u = 0;
    var dropped = 0;
    var held_ids = buffer.empty(heap, 64);
    var bad_ids = buffer.empty(heap, 64);
    while u < count {
        if u != skip && meta[3 * u] == 1 {
            let r = verify(heap, exec, clock, checker, wd, src, tape, nodes, u, u == integ, accept, libs);
            let acceptance.Result { held, why, said } = r;
            buffer.drop(heap, why);
            if held == 0 {
                held_ids = note_id(heap, held_ids, uid(src, tape, nodes, u));
                if keep {
                    say(heap, io, fs, log, uid(src, tape, nodes, u), "kept");
                }
            } else {
                meta[3 * u] = 0;
                dropped = dropped + 1;
                bad_ids = note_id(heap, bad_ids, uid(src, tape, nodes, u));
                say(heap, io, fs, log, uid(src, tape, nodes, u), "regressed");
                borrow said as &sd in {
                    set_note(notes, meta, u, broke, buffer.bytes(sd));
                }
            }
            buffer.drop(heap, said);
        }
        u = u + 1;
    }
    if dropped > 0 {
        state_write(heap, fs, src, tape, nodes, meta, count, wd);
    }
    sweep_event(heap, clock, fs, wd, skip, broke, held_ids, bad_ids);
    return dropped;
}

// Build unit `u` with the fix loop: 0 verified, 1 failed, 2 unavailable.
fn build[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &ht](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &o [byte], u: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], integ: int, accept_cmd: &ac [byte], libs: &lb [byte], base: int, hint: &ht [byte], human: bool) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let id = uid(src, tape, nodes, u);
    let nbase = u * note_cap();
    if human == false {
        write_task(heap, fs, src, tape, nodes[u], wd, notes[nbase..nbase + meta[3 * u + 2]], hint, u == integ, checker);
        meta[3 * u + 2] = 0;
        meta[3 * u + 1] = meta[3 * u + 1] + 1;
        say(heap, io, fs, log, id, "building");
    }
    let ufb = unit_file_in(heap, checker, src, tape, nodes[u]);
    var file = buffer.empty(heap, 8);
    var cmd = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    cmd = add_command(heap, cmd, checker, "check");
    cmd = add_entry(heap, cmd, checker, wd);
    let fl = plan.extra_files(heap, src, tape);
    borrow fl as &flq in {
        cmd = add_files(heap, cmd, wd, buffer.bytes(flq));
    }
    buffer.drop(heap, fl);
    cmd = add_main(heap, cmd, checker, wd);
    cmd = buffer.append(heap, cmd, libs);
    cmd = buffer.append(heap, cmd, "\0");
    var act = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    var prefix = buffer.append(heap, buffer.empty(heap, 128), wd);
    borrow ufb as &ufq in {
    let uf = buffer.bytes(ufq);
    buffer.drop(heap, file);
    file = in_wd(heap, wd, uf, "", "");
    act = buffer.append(heap, act, agent);
    act = buffer.append(heap, act, " ");
    act = buffer.append(heap, act, wd);
    // the agent's standard error goes to a file the driver reads after every turn (src/driver.cho `agent_note`)
    act = buffer.append(heap, act, "/");
    act = buffer.append(heap, act, uf);
    act = buffer.append(heap, act, " 2>");
    act = buffer.append(heap, act, wd);
    act = buffer.append(heap, act, "/");
    act = buffer.append(heap, act, uf);
    act = buffer.append(heap, act, ".agent.err\0");
    prefix = buffer.append(heap, prefix, "/");
    prefix = buffer.append(heap, prefix, uf);
    prefix = buffer.append(heap, prefix, ".snap");
    }
    buffer.drop(heap, ufb);
    let accept = unit_accept(heap, checker, wd, src, tape, nodes, u, u == integ, accept_cmd, libs);
    let jd = trail.journal_dir(heap, wd);
    var status = 1;
    borrow jd as &jq in {
    borrow file as &fb in {
        borrow cmd as &ce in {
            borrow act as &ae in {
                borrow prefix as &pe in {
                    borrow accept as &qe in {
                        match driver.run_issue_journal_as(heap, exec, clock, io, fs, buffer.bytes(fb), buffer.bytes(ae), buffer.bytes(ce), buffer.bytes(pe), attempts, 2, agent_ms, buffer.bytes(qe), accept_ms(u == integ), buffer.bytes(jq), id, base, hint, human, tool_get(checker, "key", "rule"), tool_get(checker, "clean", "\"refused\": []")) {
                            driver.Ended::Verified => {
                                status = 0;
                            }
                            driver.Ended::FailedSignaure => {
                                status = 1;
                            }
                            driver.Ended::FailedCeiling => {
                                status = 1;
                            }
                            driver.Ended::PlanDefect => {
                                status = 1;
                            }
                            driver.Ended::Unavailable => {
                                status = 2;
                            }
                        }
                    }
                }
            }
        }
    }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, file);
    buffer.drop(heap, cmd);
    buffer.drop(heap, act);
    buffer.drop(heap, prefix);
    buffer.drop(heap, accept);
    return status;
}

// `unit_start`: the unit, the function it adds (from its signature) and the units it depends on. `node` is the unit's object in the plan's tape.
fn unit_start_event[&h, &c, &z, &d, &s, &t](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), dir: &d [byte], src: &s [byte], tape: &t [int], node: int, how: &static [byte], lane: int) -> [heap, clock, fs_read(""), fs_write("")] int {
    var w = trail.begin_event(heap, clock_unix_ms(clock), "unit_start");
    var id = trail.add_string(heap, buffer.empty(heap, 32), src, tape, json.get(src, tape, node, "id"));
    borrow id as &iq in {
        w = trail.put_str(heap, w, "unit", buffer.bytes(iq));
    }
    buffer.drop(heap, id);
    var sig = trail.add_string(heap, buffer.empty(heap, 96), src, tape, json.get(src, tape, node, "signature"));
    borrow sig as &sq in {
        let (a, e) = plan.name_range(buffer.bytes(sq));
        if a >= 0 {
            w = trail.put_str(heap, w, "function", buffer.bytes(sq)[a..e]);
        }
    }
    buffer.drop(heap, sig);
    // the module file the unit is built in, for a plan that has files or a unit that names one (docs/multi-file.md)
    if plan.files_declared(src, tape) > 0 || json.get(src, tape, node, "file") >= 0 {
        w = trail.put_str(heap, w, "file", plan.unit_file(src, tape, node));
    }
    // a unit re-opened by the person (`how` is `retry` or `patch`): the story says so
    if len(how) > 0 {
        w = trail.put_flag(heap, w, how, true);
    }
    // the lane of a unit built beside others (docs/parallel.md); none when it was built alone
    if lane >= 0 {
        w = trail.put_num(heap, w, "lane", lane);
    }
    w = json.put_key(heap, w, "deps");
    w = json.begin_array(heap, w);
    let ds = json.get(src, tape, node, "deps");
    if ds >= 0 && json.is_array(tape, ds) {
        var j = ds + 1;
        var left = json.count(tape, ds);
        while left > 0 {
            var dep = trail.add_string(heap, buffer.empty(heap, 32), src, tape, j);
            borrow dep as &dq in {
                w = json.put_string(heap, w, buffer.bytes(dq));
            }
            buffer.drop(heap, dep);
            j = json.skip(tape, j);
            left = left - 1;
        }
    }
    w = json.end_array(heap, w);
    return trail.end_event(heap, fs, dir, w);
}

// The unit's journal event (docs/journal.md): its start (`ended` false), or its end in `state` (the attempts are those of its trail).
fn unit_event[&h, &c, &z, &s, &t, &n, &w, &d, &k](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], tool: &k [byte], src: &s [byte], tape: &t [int], node: int, id: &d [byte], state: &static [byte], ended: bool, how: &static [byte]) -> [heap, clock, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    let ef = unit_file_in(heap, tool, src, tape, node);
    var tp = buffer.empty(heap, 8);
    borrow ef as &efq in {
        buffer.drop(heap, tp);
        tp = in_wd(heap, wd, buffer.bytes(efq), ".trail.jsonl", "");
    }
    buffer.drop(heap, ef);
    borrow jd as &jq in {
        borrow tp as &tq in {
            if ended {
                trail.unit_end(heap, clock, fs, buffer.bytes(jq), id, state, buffer.bytes(tq));
            } else {
                unit_start_event(heap, clock, fs, buffer.bytes(jq), src, tape, node, how, 0 - 1);
            }
        }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, tp);
    return 0;
}

// Copy the unit's file `uf` (project.cho for a unit of the default file) to `<uf>.before` in the work directory, or `<uf>.before` back over it (`back`): 0, or -1.
fn keep_copy[&h, &z, &w, &d](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], uf: &d [byte], back: bool) -> [heap, fs_read(""), fs_write("")] int {
    let file = in_wd(heap, wd, uf, "", "");
    let other = in_wd(heap, wd, uf, ".before", "");
    var r = -1;
    borrow file as &fb in {
        borrow other as &ob in {
            if back {
                r = snapshot.copy(fs, buffer.bytes(ob), buffer.bytes(fb), 65536);
            } else {
                r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ob), 65536);
            }
        }
    }
    buffer.drop(heap, file);
    buffer.drop(heap, other);
    return r;
}

// Keep the unit's trail, whatever its outcome: `trail-<id>.jsonl`.
fn keep_trail[&h, &z, &d, &w, &u](heap: &!h Heap, fs: &z Fs(""), id: &d [byte], wd: &w [byte], uf: &u [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, uf, ".trail.jsonl", "");
    let into = in_wd(heap, wd, "trail-", id, ".jsonl");
    var r = -1;
    borrow from as &fb in {
        borrow into as &ib in {
            r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536);
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return r;
}

// Keep the unit's agent log (the standard error of every turn, src/driver.cho), whatever its outcome: `agent-<id>.log`.
fn keep_agent_log[&h, &z, &d, &w, &u](heap: &!h Heap, fs: &z Fs(""), id: &d [byte], wd: &w [byte], uf: &u [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, uf, ".agent.log", "");
    let into = in_wd(heap, wd, "agent-", id, ".log");
    var r = -1;
    borrow from as &fb in {
        borrow into as &ib in {
            r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536);
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return r;
}

// The final gate: project.cho and main.cho check, and every unit's tests run (one `cancho test` per tests file: each starts with `import std.test;`, and two such files in one run are refused).
fn final_gate[&h, &x, &c, &s, &t, &n, &k, &w, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, src: &s [byte], tape: &t [int], nodes: &n [int], count: int, checker: &k [byte], wd: &w [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] bool {
    var b = add_command(heap, buffer.empty(heap, 1024), checker, "check");
    b = add_entry(heap, b, checker, wd);
    let fl = plan.extra_files(heap, src, tape);
    borrow fl as &flq in {
        b = add_files(heap, b, wd, buffer.bytes(flq));
    }
    b = add_main(heap, b, checker, wd);
    b = buffer.append(heap, b, libs);
    b = buffer.append(heap, b, " > /dev/null");
    var u = 0;
    while u < count {
        if u != integ {
            b = buffer.append(heap, b, " && ");
            b = add_command(heap, b, checker, "test");
            if len(plan.unit_module(src, tape, nodes[u])) == 0 {
                b = add_entry(heap, b, checker, wd);
            }
            borrow fl as &flq2 in {
                b = add_files(heap, b, wd, buffer.bytes(flq2));
            }
            b = add_tests_file(heap, b, checker, wd, uid(src, tape, nodes, u));
            b = buffer.append(heap, b, libs);
        }
        u = u + 1;
    }
    if integ >= 0 {
        // the service itself, once more: it builds and runs the whole service against its scenarios
        b = buffer.append(heap, b, " && ");
        b = buffer.append(heap, b, accept);
        b = buffer.append(heap, b, " ");
        b = buffer.append(heap, b, wd);
        b = buffer.append(heap, b, "/");
        b = buffer.append(heap, b, tool_entry(checker));
    }
    b = buffer.append(heap, b, " #");
    buffer.drop(heap, fl);
    let file = in_wd(heap, wd, tool_entry(checker), "", "");
    var ok = false;
    borrow b as &bb in {
        borrow file as &fb in {
            let r = acceptance.run(heap, exec, clock, buffer.bytes(bb), buffer.bytes(fb), 65536, 120000 + accept_ms(integ >= 0));
            let acceptance.Result { held, why, said } = r;
            ok = held == 0;
            buffer.drop(heap, why);
            buffer.drop(heap, said);
        }
    }
    buffer.drop(heap, b);
    buffer.drop(heap, file);
    return ok;
}

// ---- re-opening a unit: --retry and --patch (docs/build.md) ---------------------------

// The most a hint holds, in bytes.
pub fn hint_cap() -> [] int {
    return 4000;
}

// The arguments' own rules, checked before anything is read or written: true when they hold, else the reason on the error stream. `retry` and
// `patch` are unit ids (empty: not given), `hint_given` says `--hint` was on the command line (an empty hint is an error, not no hint).
pub fn redo_args_ok[&i, &r, &h, &p, &f](io: &!i Io, retry: &r [byte], hint_given: bool, hint: &h [byte], patch: &p [byte], pfile: &f [byte]) -> [err_write] bool {
    if len(retry) > 0 && len(patch) > 0 {
        io.error_all(io, "project: --retry and --patch cannot be used together\n");
        return false;
    }
    if hint_given && len(hint) == 0 {
        io.error_all(io, "project: the --hint is empty\n");
        return false;
    }
    if hint_given && len(retry) == 0 {
        io.error_all(io, "project: --hint goes with --retry\n");
        return false;
    }
    if len(hint) > hint_cap() {
        io.error_all(io, "project: the --hint is longer than 4000 bytes\n");
        return false;
    }
    if len(patch) > 0 && len(pfile) == 0 {
        io.error_all(io, "project: --patch needs a unit and a file\n");
        return false;
    }
    if bytes.find(pfile, "..") >= 0 {
        io.error_all(io, "project: a path may not contain '..'\n");
        return false;
    }
    return true;
}

// The file `path` read whole (at most `cap` bytes), and whether it could be read.
fn slurp_all[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read("")] (buffer.Buffer, bool) {
    let store = box_slice(heap, cap, byte_of(0));
    var out = buffer.empty(heap, 16);
    var ok = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= 0 && n < cap {
            ok = true;
            out = buffer.append(heap, out, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    return (out, ok);
}

// The index of the unit named `id` in the plan `src`, or -1.
fn unit_index[&h, &s, &x](heap: &!h Heap, src: &s [byte], id: &x [byte]) -> [heap] int {
    var found = 0 - 1;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        let units = json.get(src, tape, 0, "units");
        var j = units + 1;
        var left = json.count(tape, units);
        var k = 0;
        while left > 0 {
            if bytes.equal(json.string_view(src, tape, json.get(src, tape, j, "id")), id) {
                found = k;
            }
            j = json.skip(tape, j);
            left = left - 1;
            k = k + 1;
        }
    }
    unbox_slice(heap, tb);
    return found;
}

// Whether the re-opening asked for (`retry` or `patch`, a unit id; `pfile` the patch's file) fits the plan `src`: the unit is in it, and the patch file
// can be read and holds something. 0 yes; 2 (a usage error: the reason is on the error stream, nothing has been changed) no.
pub fn redo_check[&h, &i, &z, &s, &r, &p, &f](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), src: &s [byte], retry: &r [byte], patch: &p [byte], pfile: &f [byte]) -> [heap, err_write, fs_read("")] int {
    if len(retry) > 0 {
        if unit_index(heap, src, retry) < 0 {
            io.error_all(io, "project: --retry names a unit the plan does not have: ");
            io.error_all(io, retry);
            io.error_all(io, "\n");
            return 2;
        }
    }
    if len(patch) > 0 {
        if unit_index(heap, src, patch) < 0 {
            io.error_all(io, "project: --patch names a unit the plan does not have: ");
            io.error_all(io, patch);
            io.error_all(io, "\n");
            return 2;
        }
        let (text, ok) = slurp_all(heap, fs, pfile, 1048576);
        var empty = true;
        borrow text as &tq in {
            empty = len(bytes.trim(buffer.bytes(tq))) == 0;
        }
        buffer.drop(heap, text);
        if ok == false || empty {
            io.error_all(io, "project: the --patch file cannot be read, or is empty: ");
            io.error_all(io, pfile);
            io.error_all(io, "\n");
            return 2;
        }
    }
    return 0;
}

// Does unit `v` depend, directly, on a unit marked in `reach`?
fn dep_reached[&s, &t, &n, &r](src: &s [byte], tape: &t [int], nodes: &n [int], reach: &r [int], count: int, v: int) -> [] bool {
    let arr = json.get(src, tape, nodes[v], "deps");
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        let d = find_unit(src, tape, nodes, count, json.string_view(src, tape, j));
        if d >= 0 && reach[d] == 1 {
            return true;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return false;
}

// The unit's trail is continued, not restarted, when the person re-opens it: its earlier records are put back as the loop's trail file (the loop adds
// to it) and their number is the offset of the new attempts' numbers (the journal's blobs are named by them, and the earlier attempts' stay).
// Answers the number of earlier records; 0 when the unit has no trail yet (the loop starts a fresh one).
fn seed_trail[&h, &z, &d, &w, &u](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], id: &d [byte], uf: &u [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, "trail-", id, ".jsonl");
    let into = in_wd(heap, wd, uf, ".trail.jsonl", "");
    var n = 0;
    borrow from as &fb in {
        borrow into as &ib in {
            n = trail.attempts_so_far(fs, buffer.bytes(fb));
            if n > 0 {
                if snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536) < 0 {
                    n = 0;
                }
            }
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return n;
}

// What the person's patch was refused for, from the attempt's journal blobs (the acceptance output when the examples ran, else the checker's whole
// answer), at most 4096 bytes, on the console and in the log.
fn show_refusal[&h, &i, &z, &l, &w, &d](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], wd: &w [byte], id: &d [byte], n: int) -> [heap, io_write, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    var shown = false;
    var what = 0;
    while what < 2 && shown == false {
        var tail = "acceptance.txt";
        if what == 1 {
            tail = "checker.json";
        }
        let nm = trail.attempt_name(heap, id, n, tail);
        var bp = buffer.empty(heap, 16);
        borrow jd as &jq in {
            borrow nm as &nq in {
                buffer.drop(heap, bp);
                bp = trail.blob_path(heap, buffer.bytes(jq), buffer.bytes(nq));
            }
        }
        borrow bp as &bq in {
            let (text, ok) = slurp_all(heap, fs, buffer.bytes(bq), 262145);
            borrow text as &tq in {
                let all = buffer.bytes(tq);
                if ok && len(all) > 0 {
                    var cut = len(all);
                    if cut > 4096 {
                        cut = 4096;
                    }
                    tell(heap, io, fs, log, all[0..cut]);
                    if int_of(all[cut - 1]) != 10 {
                        tell(heap, io, fs, log, "\n");
                    }
                    shown = true;
                }
            }
            buffer.drop(heap, text);
        }
        buffer.drop(heap, bp);
        buffer.drop(heap, nm);
        what = what + 1;
    }
    buffer.drop(heap, jd);
    return 0;
}

// A patch that could not even be put into the file (it holds no item, or the splice refused it) is still an attempt: the trail's record and the
// journal's `attempt` event (outcome `human_patch`, decision `ceiling`: the person's one try), with the patch as the code and the splice's report.
fn splice_refused[&h, &c, &z, &w, &d, &p, &r, &u](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], id: &d [byte], base: int, patch: &p [byte], report: &r [byte], uf: &u [byte]) -> [heap, clock, fs_read(""), fs_write("")] int {
    let tp = in_wd(heap, wd, uf, ".trail.jsonl", "");
    borrow tp as &tq in {
        if base == 0 {
            trail.begin(fs, buffer.bytes(tq));
        }
        trail.record(heap, fs, buffer.bytes(tq), base, 0, "refused", "splice", "ceiling", 65536);
    }
    buffer.drop(heap, tp);
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        var w = trail.begin_event(heap, clock_unix_ms(clock), "attempt");
        w = trail.put_str(heap, w, "unit", id);
        w = trail.put_num(heap, w, "n", base);
        w = trail.put_str(heap, w, "outcome", "human_patch");
        w = trail.put_str(heap, w, "decision", "ceiling");
        w = trail.put_str(heap, w, "signature", "splice");
        w = trail.put_num(heap, w, "ms", 0);
        let cn = trail.attempt_name(heap, id, base, "code.cho");
        borrow cn as &cq in {
            if trail.blob_put(heap, fs, buffer.bytes(jq), buffer.bytes(cq), patch) == 0 {
                w = trail.put_str(heap, w, "code", buffer.bytes(cq));
            }
        }
        buffer.drop(heap, cn);
        let fnm = trail.attempt_name(heap, id, base, "feedback.txt");
        borrow fnm as &fq in {
            if trail.blob_put(heap, fs, buffer.bytes(jq), buffer.bytes(fq), report) == 0 {
                w = trail.put_str(heap, w, "feedback", buffer.bytes(fq));
            }
        }
        buffer.drop(heap, fnm);
        trail.end_event(heap, fs, buffer.bytes(jq), w);
    }
    buffer.drop(heap, jd);
    return 0;
}

// Apply the person's patch to unit `u` (the `--patch` of docs/build.md): the code in `pfile` is spliced into project.cho exactly as a model's patch
// reply would be (src/splice.cho), then the loop verifies it with the same checker and the unit's own tests or acceptance, ONE attempt, and with
// no model: its "agent" is `cp` of the spliced file over project.cho. The attempt is recorded like any other (trail, journal outcome
// `human_patch`). A patch that does not verify leaves project.cho as it was. 0 verified, 1 refused, 2 the checker is away.
fn apply_patch[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &l, &ac, &lb, &pf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &o [byte], u: int, checker: &k [byte], wd: &w [byte], agent_ms: int, log: &l [byte], integ: int, accept: &ac [byte], libs: &lb [byte], pfile: &pf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let id = uid(src, tape, nodes, u);
    var line = buffer.append(heap, buffer.empty(heap, 64), "[PATCH]\t");
    line = buffer.append(heap, line, id);
    line = buffer.append(heap, line, "\tapplying\n");
    borrow line as &lnb in {
        tell(heap, io, fs, log, buffer.bytes(lnb));
    }
    buffer.drop(heap, line);
    let uf = plan.unit_file(src, tape, nodes[u]);
    keep_copy(heap, fs, wd, uf, false);
    unit_event(heap, clock, fs, wd, checker, src, tape, nodes[u], id, "", false, "patch");
    let base = seed_trail(heap, fs, wd, id, uf);
    // splice: the patch as a model's reply would be read (fences and all), then put into the file
    let pp = in_wd(heap, wd, uf, "", "");
    var cur = buffer.empty(heap, 16);
    var cur_ok = false;
    borrow pp as &ppq in {
        let (c2, ok2) = slurp_all(heap, fs, buffer.bytes(ppq), 1048576);
        buffer.drop(heap, cur);
        cur = c2;
        cur_ok = ok2;
    }
    buffer.drop(heap, pp);
    let (pat, pat_ok) = slurp_all(heap, fs, pfile, 1048576);
    var code = 1;
    var report = buffer.empty(heap, 16);
    var newfile = buffer.empty(heap, 16);
    var shown = buffer.empty(heap, 16);
    borrow cur as &cq in {
        borrow pat as &pq in {
            shown = buffer.append(heap, shown, buffer.bytes(pq));
            let (pa, pz) = splice.patch_span(buffer.bytes(pq));
            if pa >= 0 && cur_ok && pat_ok {
                let (nf, sr, sc) = splice.splice(heap, buffer.bytes(cq), buffer.bytes(pq)[pa..pz]);
                buffer.drop(heap, newfile);
                buffer.drop(heap, report);
                newfile = nf;
                report = sr;
                code = sc;
            } else {
                buffer.drop(heap, report);
                report = buffer.append(heap, buffer.empty(heap, 96), "[SPLICE_ERROR]\t-\t0:the patch file holds no cancho item\n");
            }
        }
    }
    buffer.drop(heap, cur);
    buffer.drop(heap, pat);
    var result = 1;
    if code == 0 {
        let pf2 = in_wd(heap, wd, uf, ".patched", "");
        borrow pf2 as &pfq in {
            put(heap, fs, buffer.bytes(pfq), newfile);
        }
        buffer.drop(heap, pf2);
        // the agent of this attempt is a copy, not a model
        var cp = buffer.append(heap, buffer.empty(heap, 256), "cp ");
        cp = buffer.append(heap, cp, wd);
        cp = buffer.append(heap, cp, "/");
        cp = buffer.append(heap, cp, uf);
        cp = buffer.append(heap, cp, ".patched");
        borrow cp as &cpq in {
            result = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, u, checker, wd, buffer.bytes(cpq), 1, agent_ms, log, integ, accept, libs, base, "", true);
        }
        buffer.drop(heap, cp);
        keep_trail(heap, fs, id, wd, uf);
    } else {
        buffer.drop(heap, newfile);
        borrow report as &rq in {
            tell(heap, io, fs, log, buffer.bytes(rq));
        }
        borrow report as &rq2 in {
            borrow shown as &shq in {
                splice_refused(heap, clock, fs, wd, id, base, buffer.bytes(shq), buffer.bytes(rq2), uf);
            }
        }
        keep_trail(heap, fs, id, wd, uf);
    }
    buffer.drop(heap, report);
    buffer.drop(heap, shown);
    var word = "refused";
    if result == 0 {
        word = "verified";
    } else if result == 2 {
        word = "unavailable";
    }
    if result != 0 {
        // the unit stays as it was: the project file goes back
        keep_copy(heap, fs, wd, uf, true);
        if code == 0 {
            show_refusal(heap, io, fs, log, wd, id, base);
        }
    }
    var end = buffer.append(heap, buffer.empty(heap, 64), "[PATCH]\t");
    end = buffer.append(heap, end, id);
    end = buffer.append(heap, end, "\t");
    end = buffer.append(heap, end, word);
    end = buffer.append(heap, end, "\n");
    borrow end as &enb in {
        tell(heap, io, fs, log, buffer.bytes(enb));
    }
    buffer.drop(heap, end);
    if result == 0 {
        unit_event(heap, clock, fs, wd, checker, src, tape, nodes[u], id, "verified", true, "");
    } else if meta[3 * u] == 1 {
        unit_event(heap, clock, fs, wd, checker, src, tape, nodes[u], id, "verified", true, "");
    } else if result == 1 {
        unit_event(heap, clock, fs, wd, checker, src, tape, nodes[u], id, "stuck", true, "");
    } else {
        unit_event(heap, clock, fs, wd, checker, src, tape, nodes[u], id, "unavailable", true, "");
    }
    return result;
}

// ---- the loop -------------------------------------------------------------

// ---- units built side by side (docs/parallel.md) ---------------------------------------------------------------------------------------
//
// With `--jobs N` (N > 1) the driver stays one loop and the only writer of project.cho, state.txt, the trail, run.log and the journal. A unit is built
// by a worker, this same program started again as `<self> --unit-worker ...` in a workspace of its own, `<workdir>/units/<id>/`: a copy of project.cho as
// it was when the unit was dispatched (every dependency verified), the unit's tests, task and sidecars, its own journal. The worker runs the `fix` loop
// (`driver.run_issue_journal`) on that copy and says what the loop says on its standard output; the driver waits for any worker on one poller
// (src/pool.cho). When a unit verifies in its workspace, the driver puts its items into project.cho (src/splice.cho `merge3`), checks the combined file
// and everything that had verified, and when that fails restores project.cho and builds the unit again on the file as it is now.

// Options of the parallel driver: how many units at once, how long (ms) to collect units that end together before integrating them in plan order, and
// whether a model call has already been made in this run (the primer is cached then: no need to start one unit first).
pub val struct Par {
    jobs: int,
    settle: int,
    warm: bool,
}

// A worker's command-line value: the argument without the `=` every one starts with (so that an empty one is still an argument).
fn wval[&g](g: &g Args, i: int) -> [args] &static [byte] {
    let a = arg(g, i);
    if len(a) == 0 {
        return a;
    }
    return a[1..len(a)];
}

fn number[&a](text: &a [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + c - 48;
        i = i + 1;
    }
    return n;
}

// The worker (`<self> --unit-worker =<checker> =<workspace> =<unit> =<agent> =<attempts> =<agent-ms> =<accept-ms> =<base> =<hint> =<libs> =<accept> =<file> =<files>`):
// the `fix` loop on the workspace's copy of the unit's file (`<file>`, project.cho for a single-file plan; `<files>` are the plan's other files, which the
// compile commands name), with the unit's journal in `<workspace>/journal`. It says what the loop says. Exit 0 verified,
// 1 failed, 2 unavailable (the agent or the checker is away), 3 usage.
pub fn unit_worker[&h, &x, &c, &i, &z, &g](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), g: &g Args) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, args] int {
    if arg_count(g) < 15 {
        return 3;
    }
    let checker = wval(g, 2);
    let ws = wval(g, 3);
    let id = wval(g, 4);
    let agent = wval(g, 5);
    let attempts = number(wval(g, 6));
    let agent_ms = number(wval(g, 7));
    let accept_ms = number(wval(g, 8));
    let base = number(wval(g, 9));
    let hint = wval(g, 10);
    let libs = wval(g, 11);
    let accept = wval(g, 12);
    let uf = wval(g, 13);
    let names = wval(g, 14);
    if attempts < 0 || agent_ms < 0 || accept_ms < 0 || base < 0 || len(uf) == 0 {
        return 3;
    }
    let file = in_wd(heap, ws, uf, "", "");
    var cmd = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    cmd = buffer.append(heap, cmd, tool_program(checker));
    cmd = buffer.append(heap, cmd, " check --std --output json --backend cranelift ");
    cmd = buffer.append(heap, cmd, ws);
    cmd = buffer.append(heap, cmd, "/project.cho ");
    cmd = add_files(heap, cmd, ws, names);
    cmd = buffer.append(heap, cmd, ws);
    cmd = buffer.append(heap, cmd, "/main.cho ");
    cmd = buffer.append(heap, cmd, libs);
    cmd = buffer.append(heap, cmd, "\0");
    var act = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    act = buffer.append(heap, act, agent);
    act = buffer.append(heap, act, " ");
    act = buffer.append(heap, act, ws);
    act = buffer.append(heap, act, "/");
    act = buffer.append(heap, act, uf);
    act = buffer.append(heap, act, " 2>");
    act = buffer.append(heap, act, ws);
    act = buffer.append(heap, act, "/");
    act = buffer.append(heap, act, uf);
    act = buffer.append(heap, act, ".agent.err\0");
    var prefix = buffer.append(heap, buffer.empty(heap, 128), ws);
    prefix = buffer.append(heap, prefix, "/");
    prefix = buffer.append(heap, prefix, uf);
    prefix = buffer.append(heap, prefix, ".snap");
    let jd = trail.journal_dir(heap, ws);
    var status = 1;
    borrow jd as &jq in {
    borrow file as &fb in {
        borrow cmd as &ce in {
            borrow act as &ae in {
                borrow prefix as &pe in {
                    match driver.run_issue_journal(heap, exec, clock, io, fs, buffer.bytes(fb), buffer.bytes(ae), buffer.bytes(ce), buffer.bytes(pe), attempts, 2, agent_ms, accept, accept_ms, buffer.bytes(jq), id, base, hint, false) {
                        driver.Ended::Verified => {
                            status = 0;
                        }
                        driver.Ended::FailedSignaure => {
                            status = 1;
                        }
                        driver.Ended::FailedCeiling => {
                            status = 1;
                        }
                        driver.Ended::PlanDefect => {
                            status = 1;
                        }
                        driver.Ended::Unavailable => {
                            status = 2;
                        }
                    }
                }
            }
        }
    }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, file);
    buffer.drop(heap, cmd);
    buffer.drop(heap, act);
    buffer.drop(heap, prefix);
    return status;
}

// One worker argument: `=` and the value, ended by the separator.
fn put_arg[&h, &v](heap: &!h Heap, list: buffer.Buffer, value: &v [byte]) -> [heap] buffer.Buffer {
    var b = buffer.push(heap, list, byte_of(61));
    b = buffer.append(heap, b, value);
    return buffer.push(heap, b, byte_of(0));
}

fn put_num_arg[&h](heap: &!h Heap, list: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    var b = buffer.push(heap, list, byte_of(61));
    b = buffer.push_nat(heap, b, n);
    return buffer.push(heap, b, byte_of(0));
}

// Write `text` to `path`: 0, or -1.
fn write_text[&z, &p, &t](fs: &z Fs(""), path: &p [byte], text: &t [byte]) -> [fs_write("")] int {
    if fs_write(fs, path, text) == len(text) {
        return 0;
    }
    return 0 - 1;
}

// Run a shell command made of `parts` (ended by ` #`): its exit status as `held` of acceptance.run (0 held).
fn sh_ok[&h, &x, &c, &m](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, cmd: &m [byte]) -> [heap, exec(""), clock, poll] bool {
    return trail.journal_sh(heap, exec, clock, cmd) == 0;
}

// Unit `u` into a workspace and onto a worker: 0, or the errno / -1 when it could not be started. The workspace is made fresh from project.cho as it is.
fn par_start[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &ht, &sf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &o [byte], u: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], integ: int, accept_cmd: &ac [byte], libs: &lb [byte], base: int, hint: &ht [byte], how: &static [byte], lane: int, selfx: &sf [byte], pl: pool.Pool) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] (pool.Pool, int) {
    let id = uid(src, tape, nodes, u);
    let uf = plan.unit_file(src, tape, nodes[u]);
    let fl = plan.extra_files(heap, src, tape);
    let wsbuf = in_wd(heap, wd, "units/", id, "");
    var started = pl;
    var answer = 0 - 1;
    borrow wsbuf as &wsr in {
    let ws = buffer.bytes(wsr);
    var prep = buffer.append(heap, buffer.empty(heap, 512), "rm -rf ");
    prep = buffer.append(heap, prep, ws);
    prep = buffer.append(heap, prep, " && mkdir -p ");
    prep = buffer.append(heap, prep, ws);
    prep = buffer.append(heap, prep, "/journal/blobs && cp ");
    prep = buffer.append(heap, prep, wd);
    prep = buffer.append(heap, prep, "/project.cho ");
    prep = buffer.append(heap, prep, ws);
    prep = buffer.append(heap, prep, "/project.cho");
    // every file of the project, as it is now (docs/multi-file.md): the unit's tests and checks compile them all
    var fa = 0;
    borrow fl as &flq0 in {
        while fa < len(buffer.bytes(flq0)) {
            var fe = fa;
            while fe < len(buffer.bytes(flq0)) && int_of(buffer.bytes(flq0)[fe]) != 32 {
                fe = fe + 1;
            }
            if fe > fa {
                prep = buffer.append(heap, prep, " && cp ");
                prep = buffer.append(heap, prep, wd);
                prep = buffer.append(heap, prep, "/");
                prep = buffer.append(heap, prep, buffer.bytes(flq0)[fa..fe]);
                prep = buffer.append(heap, prep, " ");
                prep = buffer.append(heap, prep, ws);
                prep = buffer.append(heap, prep, "/");
                prep = buffer.append(heap, prep, buffer.bytes(flq0)[fa..fe]);
            }
            fa = fe + 1;
        }
    }
    prep = buffer.append(heap, prep, " && cp ");
    prep = buffer.append(heap, prep, wd);
    prep = buffer.append(heap, prep, "/");
    prep = buffer.append(heap, prep, uf);
    prep = buffer.append(heap, prep, " ");
    prep = buffer.append(heap, prep, ws);
    prep = buffer.append(heap, prep, "/");
    prep = buffer.append(heap, prep, uf);
    prep = buffer.append(heap, prep, ".base && cp ");
    prep = buffer.append(heap, prep, wd);
    prep = buffer.append(heap, prep, "/");
    prep = buffer.append(heap, prep, uf);
    prep = buffer.append(heap, prep, " ");
    prep = buffer.append(heap, prep, ws);
    // what the journal's diff of the unit's first attempt is made against (src/trail.cho `diff_field`): the file as it stood before the unit
    prep = buffer.append(heap, prep, "/");
    prep = buffer.append(heap, prep, uf);
    prep = buffer.append(heap, prep, ".before");
    if base > 0 {
        // ... and, for an attempt that goes on after earlier ones, the code of the attempt before it
        prep = buffer.append(heap, prep, " && { cp ");
        prep = buffer.append(heap, prep, wd);
        prep = buffer.append(heap, prep, "/journal/blobs/");
        prep = buffer.append(heap, prep, id);
        prep = buffer.append(heap, prep, "-a");
        prep = buffer.push_nat(heap, prep, base - 1);
        prep = buffer.append(heap, prep, "-code.cho ");
        prep = buffer.append(heap, prep, ws);
        prep = buffer.append(heap, prep, "/journal/blobs/ 2>/dev/null || true; }");
    }
    if base > 0 {
        // the unit's earlier records go on in the workspace's trail
        prep = buffer.append(heap, prep, " && cp ");
        prep = buffer.append(heap, prep, wd);
        prep = buffer.append(heap, prep, "/trail-");
        prep = buffer.append(heap, prep, id);
        prep = buffer.append(heap, prep, ".jsonl ");
        prep = buffer.append(heap, prep, ws);
        prep = buffer.append(heap, prep, "/");
        prep = buffer.append(heap, prep, uf);
        prep = buffer.append(heap, prep, ".trail.jsonl");
    }
    prep = buffer.append(heap, prep, " #");
    var ready = false;
    borrow prep as &pq in {
        ready = sh_ok(heap, exec, clock, buffer.bytes(pq));
    }
    buffer.drop(heap, prep);
    if ready {
        write_fixed(heap, fs, ws, checker);
        if u != integ {
            write_tests(heap, fs, src, tape, nodes[u], ws, checker);
        }
        write_task(heap, fs, src, tape, nodes[u], ws, notes[u * note_cap()..u * note_cap() + meta[3 * u + 2]], hint, u == integ, checker);
        meta[3 * u + 2] = 0;
        meta[3 * u + 1] = meta[3 * u + 1] + 1;
        meta[3 * u] = 4;
        say(heap, io, fs, log, id, "building");
        let jd = trail.journal_dir(heap, wd);
        borrow jd as &jq in {
            unit_start_event(heap, clock, fs, buffer.bytes(jq), src, tape, nodes[u], how, lane);
        }
        buffer.drop(heap, jd);
        let accept = unit_accept(heap, checker, ws, src, tape, nodes, u, u == integ, accept_cmd, libs);
        var args = buffer.append(heap, buffer.empty(heap, 1024), "--unit-worker");
        args = buffer.push(heap, args, byte_of(0));
        args = put_arg(heap, args, checker);
        args = put_arg(heap, args, ws);
        args = put_arg(heap, args, id);
        args = put_arg(heap, args, agent);
        args = put_num_arg(heap, args, attempts);
        args = put_num_arg(heap, args, agent_ms);
        args = put_num_arg(heap, args, accept_ms(u == integ));
        args = put_num_arg(heap, args, base);
        args = put_arg(heap, args, hint);
        args = put_arg(heap, args, libs);
        borrow accept as &qb in {
            args = put_arg(heap, args, buffer.bytes(qb));
        }
        args = put_arg(heap, args, uf);
        borrow fl as &flq1 in {
            args = put_arg(heap, args, buffer.bytes(flq1));
        }
        borrow args as &ab in {
            let (next, e) = pool.start(heap, exec, clock, started, u, selfx, buffer.bytes(ab), "PATH=/usr/local/bin:/usr/bin:/bin\0");
            started = next;
            answer = e;
        }
        buffer.drop(heap, args);
        buffer.drop(heap, accept);
    }
    }
    buffer.drop(heap, wsbuf);
    buffer.drop(heap, fl);
    return (started, answer);
}

// The first line of `text`, at most 160 bytes, for the console and the signature.
fn first_line[&t](text: &t [byte]) -> [] &t [byte] {
    var e = 0;
    while e < len(text) && int_of(text[e]) != 10 && e < 160 {
        e = e + 1;
    }
    return text[0..e];
}

fn hash_of[&t](text: &t [byte]) -> [] int {
    var h = 7;
    var i = 0;
    while i < len(text) {
        h = (h * 31 + int_of(text[i])) % 1000000007;
        i = i + 1;
    }
    return h;
}

// The NOTE of a unit whose work could not be put into the project file as it is now (what it says, cut to fit).
fn set_integration_note[&o, &m, &x](notes: &!o [byte], meta: &!m [int], u: int, said: &x [byte]) -> [] int {
    let base = u * note_cap();
    var p = fill(notes, base, 0, "Your version passed on its own, but it could not be put into the project file as it is now (another unit's work was added while you were working). The project file now holds that work. What went wrong:\n");
    p = fill(notes, base, p, said);
    meta[3 * u + 2] = p;
    return 0;
}

// Does unit `which` hold on the project file as it is? Empty when it does, else what it said (the unit named first).
fn unit_says[&h, &x, &c, &s, &t, &n, &k, &w, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, src: &s [byte], tape: &t [int], nodes: &n [int], which: int, checker: &k [byte], wd: &w [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] buffer.Buffer {
    var bad = buffer.empty(heap, 64);
    let r = verify(heap, exec, clock, checker, wd, src, tape, nodes, which, which == integ, accept, libs);
    let acceptance.Result { held, why, said } = r;
    buffer.drop(heap, why);
    if held != 0 {
        bad = buffer.append(heap, bad, "The unit ");
        bad = buffer.append(heap, bad, uid(src, tape, nodes, which));
        bad = buffer.append(heap, bad, " fails on the combined project file. Its output:\n");
        borrow said as &sd in {
            bad = buffer.append(heap, bad, buffer.bytes(sd));
        }
    }
    buffer.drop(heap, said);
    return bad;
}

// What is wrong with the project file after unit `u`'s work was put into it, or nothing (empty): the combined file must compile, the unit's own examples
// must hold on it, and so must every unit that had verified (`others`; a unit that only added to the file cannot have changed what they do, see `splice.rewrites`).
fn combined_holds[&h, &x, &c, &s, &t, &n, &m, &k, &w, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int, u: int, others: bool, checker: &k [byte], wd: &w [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] buffer.Buffer {
    var bad = buffer.empty(heap, 64);
    var cmd = buffer.append(heap, buffer.empty(heap, 512), tool_program(checker));
    cmd = buffer.append(heap, cmd, " check --std --backend cranelift ");
    cmd = buffer.append(heap, cmd, wd);
    cmd = buffer.append(heap, cmd, "/project.cho ");
    let fl = plan.extra_files(heap, src, tape);
    borrow fl as &flq in {
        cmd = add_files(heap, cmd, wd, buffer.bytes(flq));
    }
    buffer.drop(heap, fl);
    cmd = buffer.append(heap, cmd, wd);
    cmd = buffer.append(heap, cmd, "/main.cho ");
    cmd = buffer.append(heap, cmd, libs);
    cmd = buffer.append(heap, cmd, " #");
    borrow cmd as &cb in {
        let r = acceptance.run(heap, exec, clock, buffer.bytes(cb), "", 4096, 60000);
        let acceptance.Result { held, why, said } = r;
        buffer.drop(heap, why);
        if held != 0 {
            bad = buffer.append(heap, bad, "The combined project file does not compile: ");
            borrow said as &sb in {
                bad = buffer.append(heap, bad, buffer.bytes(sb));
            }
        }
        buffer.drop(heap, said);
    }
    buffer.drop(heap, cmd);
    var clean = true;
    borrow bad as &wq in {
        clean = buffer.size(wq) == 0;
    }
    if clean {
        buffer.drop(heap, bad);
        bad = unit_says(heap, exec, clock, src, tape, nodes, u, checker, wd, integ, accept, libs);
    }
    var v = 0;
    while v < count {
        borrow bad as &wq2 in {
            clean = buffer.size(wq2) == 0;
        }
        if clean && others && v != u && meta[3 * v] == 1 {
            buffer.drop(heap, bad);
            bad = unit_says(heap, exec, clock, src, tape, nodes, v, checker, wd, integ, accept, libs);
        }
        v = v + 1;
    }
    return bad;
}

// Say `[INTEGRATE]<TAB><id><TAB><word>[<TAB><why>]`.
fn say_integrate[&h, &i, &z, &l, &d, &w](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], id: &d [byte], word: &static [byte], why: &w [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    var b = buffer.append(heap, buffer.empty(heap, 96), "[INTEGRATE]\t");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, word);
    if len(why) > 0 {
        b = buffer.append(heap, b, "\t");
        b = buffer.append(heap, b, why);
    }
    b = buffer.append(heap, b, "\n");
    borrow b as &bb in {
        tell(heap, io, fs, log, buffer.bytes(bb));
    }
    buffer.drop(heap, b);
    return 0;
}

// A unit's worker has ended: take its results into the run, in the driver's own files. The unit's story (journal events and blobs), trail and agent log
// are kept whatever came of it; a unit that verified in its workspace is then integrated (put into project.cho, with the checks of the combined file), and
// is requeued when that fails. 0, or 1 when the agent or the checker was away (unavailable).
fn par_finish[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &l, &ac, &lb, &sa](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &!o [byte], count: int, u: int, checker: &k [byte], wd: &w [byte], log: &l [byte], integ: int, accept: &ac [byte], libs: &lb [byte], st: &!sa [int], attempts: int) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let id = uid(src, tape, nodes, u);
    let uf = plan.unit_file(src, tape, nodes[u]);
    let lane = st[8 * u];
    let code = st[8 * u + 6];
    let wall = st[8 * u + 7];
    let jd = trail.journal_dir(heap, wd);
    let wsbuf = in_wd(heap, wd, "units/", id, "");
    var provider = 0;
    borrow wsbuf as &wsr in {
    let ws = buffer.bytes(wsr);
    let wsj = trail.journal_dir(heap, ws);
    let wstrail = in_wd(heap, ws, uf, ".trail.jsonl", "");
    borrow jd as &jq in {
        borrow wsj as &wq in {
            parallel.merge_events(heap, fs, buffer.bytes(jq), buffer.bytes(wq), lane);
            parallel.copy_blobs(heap, exec, clock, buffer.bytes(jq), buffer.bytes(wq));
        }
    }
    // the trail and the agent's words, kept whatever the outcome
    let keep_t = in_wd(heap, wd, "trail-", id, ".jsonl");
    let from_l = in_wd(heap, ws, uf, ".agent.log", "");
    let keep_l = in_wd(heap, wd, "agent-", id, ".log");
    borrow wstrail as &wtq in {
        borrow keep_t as &ktq in {
            snapshot.copy(fs, buffer.bytes(wtq), buffer.bytes(ktq), 65536);
        }
        st[8 * u + 2] = trail.attempts_so_far(fs, buffer.bytes(wtq));
    }
    borrow from_l as &flq in {
        borrow keep_l as &klq in {
            snapshot.copy(fs, buffer.bytes(flq), buffer.bytes(klq), 65536);
        }
    }
    buffer.drop(heap, keep_t);
    buffer.drop(heap, from_l);
    buffer.drop(heap, keep_l);
    // what the loop said in the workspace, whole, now that the unit is over
    let outp = in_wd(heap, ws, "worker.out", "", "");
    borrow outp as &opq in {
        let (said, readable) = slurp_all(heap, fs, buffer.bytes(opq), 70000);
        if readable {
            borrow said as &sq in {
                io.write_all(io, buffer.bytes(sq));
            }
        }
        buffer.drop(heap, said);
    }
    buffer.drop(heap, outp);
    var r = 2;
    if code == 0 {
        r = 0;
    } else if code == 1 {
        r = 1;
    }
    if r != 0 {
        report_not_verified(heap, io, fs, log, wd, id);
    }
    if r == 1 {
        borrow jd as &jq1 in {
            borrow wstrail as &wt1 in {
                parallel.unit_end_event(heap, clock, fs, buffer.bytes(jq1), id, "stuck", buffer.bytes(wt1), lane, wall);
            }
        }
        meta[3 * u] = 2;
        say(heap, io, fs, log, id, "failed");
    } else if r == 2 {
        borrow jd as &jq2 in {
            borrow wstrail as &wt2 in {
                parallel.unit_end_event(heap, clock, fs, buffer.bytes(jq2), id, "unavailable", buffer.bytes(wt2), lane, wall);
            }
        }
        meta[3 * u] = 0;
        say(heap, io, fs, log, id, "unavailable");
        provider = 1;
    } else {
        // verified in its workspace: into the project file
        let basep = in_wd(heap, ws, uf, ".base", "");
        let mainp = in_wd(heap, wd, uf, "", "");
        let wsp = in_wd(heap, ws, uf, "", "");
        var same = false;
        var cmp = buffer.append(heap, buffer.empty(heap, 256), "cmp -s ");
        cmp = buffer.append(heap, cmp, wd);
        cmp = buffer.append(heap, cmp, "/");
        cmp = buffer.append(heap, cmp, uf);
        cmp = buffer.append(heap, cmp, " ");
        cmp = buffer.append(heap, cmp, ws);
        cmp = buffer.append(heap, cmp, "/");
        cmp = buffer.append(heap, cmp, uf);
        cmp = buffer.append(heap, cmp, ".base #");
        borrow cmp as &cq in {
            same = sh_ok(heap, exec, clock, buffer.bytes(cq));
        }
        buffer.drop(heap, cmp);
        // Did the unit change anything that was there when it started? If it only added, the units that had verified need not be run again.
        var rew = true;
        borrow basep as &bpr in {
            borrow wsp as &wpr in {
                let (bt0, bok0) = slurp_all(heap, fs, buffer.bytes(bpr), 1048576);
                let (tt0, tok0) = slurp_all(heap, fs, buffer.bytes(wpr), 1048576);
                if bok0 && tok0 {
                    borrow bt0 as &bq0 in {
                        borrow tt0 as &tq0 in {
                            rew = splice.rewrites(heap, buffer.bytes(bq0), buffer.bytes(tq0)) != 0;
                        }
                    }
                }
                buffer.drop(heap, bt0);
                buffer.drop(heap, tt0);
            }
        }
        keep_copy(heap, fs, wd, uf, false);
        var bad = buffer.empty(heap, 64);
        if same {
            var cp = buffer.append(heap, buffer.empty(heap, 256), "cp ");
            cp = buffer.append(heap, cp, ws);
            cp = buffer.append(heap, cp, "/");
            cp = buffer.append(heap, cp, uf);
            cp = buffer.append(heap, cp, " ");
            cp = buffer.append(heap, cp, wd);
            cp = buffer.append(heap, cp, "/");
            cp = buffer.append(heap, cp, uf);
            cp = buffer.append(heap, cp, " #");
            borrow cp as &cpq in {
                if sh_ok(heap, exec, clock, buffer.bytes(cpq)) == false {
                    bad = buffer.append(heap, bad, "the unit's file could not be copied into the project file");
                }
            }
            buffer.drop(heap, cp);
        } else {
            borrow basep as &bpq in {
            borrow mainp as &mpq in {
            borrow wsp as &wpq in {
            let (b_text, b_ok) = slurp_all(heap, fs, buffer.bytes(bpq), 1048576);
            let (o_text, o_ok) = slurp_all(heap, fs, buffer.bytes(mpq), 1048576);
            let (t_text, t_ok) = slurp_all(heap, fs, buffer.bytes(wpq), 1048576);
            if b_ok && o_ok && t_ok {
                borrow b_text as &bb in {
                    borrow o_text as &ob in {
                        borrow t_text as &tb in {
                            let (merged, report, mcode) = splice.merge3(heap, buffer.bytes(bb), buffer.bytes(ob), buffer.bytes(tb));
                            if mcode != 0 {
                                borrow report as &rq in {
                                    bad = buffer.append(heap, bad, buffer.bytes(rq));
                                }
                            } else {
                                borrow merged as &mq in {
                                    if write_text(fs, buffer.bytes(mpq), buffer.bytes(mq)) < 0 {
                                        bad = buffer.append(heap, bad, "the merged project file could not be written");
                                    }
                                }
                            }
                            buffer.drop(heap, merged);
                            buffer.drop(heap, report);
                        }
                    }
                }
            } else {
                bad = buffer.append(heap, bad, "a project file could not be read (or is 1 MiB or more)");
            }
            buffer.drop(heap, b_text);
            buffer.drop(heap, o_text);
            buffer.drop(heap, t_text);
            }
            }
            }
            var clean = true;
            borrow bad as &bq in {
                clean = buffer.size(bq) == 0;
            }
            if clean {
                buffer.drop(heap, bad);
                bad = combined_holds(heap, exec, clock, src, tape, nodes, meta, count, u, rew, checker, wd, integ, accept, libs);
            }
        }
        buffer.drop(heap, basep);
        buffer.drop(heap, mainp);
        buffer.drop(heap, wsp);
        st[8 * count] = st[8 * count] + 1;
        let order = st[8 * count];
        var mode = "merge";
        if same {
            mode = "fast";
        }
        var ok = true;
        borrow bad as &bq2 in {
            ok = buffer.size(bq2) == 0;
        }
        if ok {
            borrow jd as &jq3 in {
                parallel.integrate_event(heap, clock, fs, buffer.bytes(jq3), id, mode, true, order, "");
                borrow wstrail as &wt3 in {
                    parallel.unit_end_event(heap, clock, fs, buffer.bytes(jq3), id, "verified", buffer.bytes(wt3), lane, wall);
                }
            }
            meta[3 * u] = 1;
            state_write(heap, fs, src, tape, nodes, meta, count, wd);
            say_integrate(heap, io, fs, log, id, mode, "");
            say(heap, io, fs, log, id, "verified");
            if same && rew {
                // the units that had verified are checked again, as when units are built one at a time: one the new work broke is rebuilt
                recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, u, id, false, checker, wd, log, integ, accept, libs);
            }
        } else {
            keep_copy(heap, fs, wd, uf, true);
            st[8 * u + 3] = st[8 * u + 3] + 1;
            var sigh = 0;
            var line = buffer.empty(heap, 16);
            borrow bad as &bq3 in {
                sigh = hash_of(first_line(buffer.bytes(bq3)));
                line = buffer.append(heap, line, first_line(buffer.bytes(bq3)));
            }
            let repeated = sigh == st[8 * u + 4];
            st[8 * u + 4] = sigh;
            var word = "requeued";
            var giving_up = false;
            if st[8 * u + 3] > attempts || repeated {
                giving_up = true;
                word = "failed";
            }
            borrow jd as &jq4 in {
                borrow line as &lq in {
                    parallel.integrate_event(heap, clock, fs, buffer.bytes(jq4), id, mode, false, order, buffer.bytes(lq));
                }
                borrow wstrail as &wt4 in {
                    if giving_up {
                        parallel.unit_end_event(heap, clock, fs, buffer.bytes(jq4), id, "stuck", buffer.bytes(wt4), lane, wall);
                    } else {
                        parallel.unit_end_event(heap, clock, fs, buffer.bytes(jq4), id, "requeued", buffer.bytes(wt4), lane, wall);
                    }
                }
            }
            borrow line as &lq2 in {
                say_integrate(heap, io, fs, log, id, word, buffer.bytes(lq2));
            }
            buffer.drop(heap, line);
            if giving_up {
                meta[3 * u] = 2;
                say(heap, io, fs, log, id, "failed");
            } else {
                meta[3 * u] = 0;
                borrow bad as &bq4 in {
                    set_integration_note(notes, meta, u, buffer.bytes(bq4));
                }
            }
        }
        buffer.drop(heap, bad);
    }
    // the scratch workspace is done with
    var rm = buffer.append(heap, buffer.empty(heap, 128), "rm -rf ");
    rm = buffer.append(heap, rm, ws);
    rm = buffer.append(heap, rm, " #");
    borrow rm as &rq2 in {
        sh_ok(heap, exec, clock, buffer.bytes(rq2));
    }
    buffer.drop(heap, rm);
    buffer.drop(heap, jd);
    buffer.drop(heap, wsj);
    buffer.drop(heap, wstrail);
    }
    buffer.drop(heap, wsbuf);
    return provider;
}

// The lowest lane (0..jobs-1) no unit is using.
fn free_lane[&sa](st: &sa [int], gb: int, jobs: int) -> [] int {
    var l = 0;
    while l < jobs {
        if st[gb + 1 + l] == 0 {
            return l;
        }
        l = l + 1;
    }
    return 0;
}

// The units are built side by side until none is ready and none is running (0), or until an agent or the checker is away (1).
//
// A unit is dispatched when it is open and every dependency is verified, while fewer than `par.jobs` are running; the application unit of a service
// (`integ`) runs alone, since its acceptance starts a server. Before any model call has been made in the run (`par.warm` false) ONE unit is dispatched
// and the others wait until its first call has returned (it leaves `project.cho.call/meta.json`) or it has ended: the primer is cached by then, and two
// cold first calls would pay for writing the cache twice. When a unit ends, units that end within `par.settle` ms of it are collected too, and all of
// them are integrated in plan order. After the first unit whose agent or checker was away, nothing new is started; the running ones are finished and kept.
fn par_loop[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &ht, &sf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &!o [byte], count: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], accept: &ac [byte], libs: &lb [byte], integ: int, redo: int, patching: bool, hint: &ht [byte], par: Par, argv0: &sf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, pipe_read, child_signal] int {
    // what a killed run left: its scratch workspaces, and the processes still working in them
    var clean = buffer.append(heap, buffer.empty(heap, 256), "if [ -d ");
    clean = buffer.append(heap, clean, wd);
    clean = buffer.append(heap, clean, "/units ]; then pkill -9 -f '");
    clean = buffer.append(heap, clean, wd);
    clean = buffer.append(heap, clean, "/[u]nits/' 2>/dev/null; rm -rf ");
    clean = buffer.append(heap, clean, wd);
    clean = buffer.append(heap, clean, "/units; fi; true #");
    borrow clean as &clq in {
        sh_ok(heap, exec, clock, buffer.bytes(clq));
    }
    buffer.drop(heap, clean);
    let selfx = parallel.self_path(heap, exec, clock, argv0);
    var provider = 0;
    var no_worker = false;
    borrow selfx as &sxq in {
        no_worker = len(buffer.bytes(sxq)) == 0;
    }
    if no_worker {
        tell(heap, io, fs, log, "project: --jobs needs to start itself again and cannot tell where it is\n");
        buffer.drop(heap, selfx);
        return 1;
    }
    let gb = 8 * count;
    let stb = box_slice(heap, 8 * count + par.jobs + 16, 0);
    match pool.new() {
        pool.Made::Failed(e) => {
            tell(heap, io, fs, log, "project: the poller for the workers could not be made\n");
            provider = 1;
        }
        pool.Made::Ok(p0) => {
            var pl = p0;
            borrow mut stb as &!sw in {
                let st = contents(sw);
                var cold = par.warm == false;
                var cold_u = 0 - 1;
                var redo_used = false;
                var going = true;
                var waiting = 0;
                while going {
                    // dispatch
                    var more = provider == 0;
                    while more {
                        borrow pl as &plr in {
                            waiting = pool.live(plr);
                        }
                        var cap = par.jobs;
                        if cold && waiting >= 1 {
                            cap = 1;
                        }
                        if waiting >= cap {
                            more = false;
                        } else {
                            let nx = next_unit(src, tape, nodes, meta, count);
                            if nx < 0 {
                                more = false;
                            } else if nx == integ && waiting > 0 {
                                more = false;
                            } else if meta[3 * nx + 1] >= 3 * count {
                                // the guard against two units breaking each other for ever
                                meta[3 * nx] = 2;
                                say(heap, io, fs, log, uid(src, tape, nodes, nx), "failed");
                            } else {
                                let lane = free_lane(st, gb, par.jobs);
                                var how = "";
                                var base = st[8 * nx + 2];
                                var said = hint;
                                if nx == redo && patching == false && redo_used == false {
                                    redo_used = true;
                                    how = "retry";
                                    let tp = in_wd(heap, wd, "trail-", uid(src, tape, nodes, nx), ".jsonl");
                                    borrow tp as &tpq in {
                                        base = trail.attempts_so_far(fs, buffer.bytes(tpq));
                                    }
                                    buffer.drop(heap, tp);
                                } else {
                                    said = "";
                                }
                                st[8 * nx] = lane;
                                st[gb + 1 + lane] = 1;
                                st[8 * nx + 1] = clock_ms(clock);
                                st[8 * nx + 5] = 0;
                                var sx = buffer.empty(heap, 16);
                                borrow selfx as &sxr in {
                                    buffer.drop(heap, sx);
                                    sx = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(sxr)) + 1), buffer.bytes(sxr));
                                }
                                var started = 0 - 1;
                                borrow sx as &sxb in {
                                    let (next, e) = par_start(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, nx, checker, wd, agent, attempts, agent_ms, log, integ, accept, libs, base, said, how, lane, buffer.bytes(sxb), pl);
                                    pl = next;
                                    started = e;
                                }
                                buffer.drop(heap, sx);
                                if started != 0 {
                                    // the worker could not be started: the agent is away as far as this run can tell
                                    st[gb + 1 + lane] = 0;
                                    meta[3 * nx] = 0;
                                    say(heap, io, fs, log, uid(src, tape, nodes, nx), "unavailable");
                                    provider = 1;
                                    more = false;
                                } else if cold && cold_u < 0 {
                                    cold_u = nx;
                                }
                            }
                        }
                    }
                    borrow pl as &plr2 in {
                        waiting = pool.live(plr2);
                    }
                    if waiting == 0 {
                        going = false;
                    } else {
                        // the first unit's first call has returned, or it is done: the others may start
                        if cold && cold_u >= 0 {
                            let mp0 = in_wd(heap, wd, "units/", uid(src, tape, nodes, cold_u), "/");
                            let mp2 = buffer.append(heap, mp0, plan.unit_file(src, tape, nodes[cold_u]));
                            let mp = buffer.append(heap, mp2, ".call/meta.json");
                            var said_so = false;
                            borrow mp as &mpq in {
                                said_so = parallel.exists(fs, buffer.bytes(mpq));
                            }
                            buffer.drop(heap, mp);
                            if said_so || st[8 * cold_u + 5] == 1 || meta[3 * cold_u] != 4 {
                                cold = false;
                            }
                        }
                        var collected = 0;
                        var settle_until = 0 - 1;
                        var again = true;
                        while again {
                            var tick = 100;
                            if settle_until >= 0 {
                                tick = settle_until - clock_ms(clock);
                                if tick > 100 {
                                    tick = 100;
                                }
                                if tick < 1 {
                                    tick = 1;
                                }
                            }
                            match pool.wait(heap, clock, pl, tick) {
                                pool.Taken::Nothing(q) => {
                                    pl = q;
                                }
                                pool.Taken::Ended(q, d) => {
                                    pl = q;
                                    var who = 0;
                                    borrow d as &dr0 in {
                                        who = pool.tag_of(dr0);
                                    }
                                    let wsd = in_wd(heap, wd, "units/", uid(src, tape, nodes, who), "/worker.out");
                                    borrow d as &dr in {
                                        borrow wsd as &wdq in {
                                            write_text(fs, buffer.bytes(wdq), pool.said(dr));
                                        }
                                        st[8 * who + 6] = pool.code_of(dr);
                                        st[8 * who + 7] = pool.ms_of(dr);
                                    }
                                    buffer.drop(heap, wsd);
                                    pool.drop_left(heap, d);
                                    st[8 * who + 5] = 1;
                                    collected = collected + 1;
                                    if settle_until < 0 {
                                        settle_until = clock_ms(clock) + par.settle;
                                    }
                                }
                            }
                            borrow pl as &plr3 in {
                                waiting = pool.live(plr3);
                            }
                            if collected == 0 {
                                again = false;
                            } else if waiting == 0 || clock_ms(clock) >= settle_until {
                                again = false;
                            }
                        }
                        // integrate what ended, in plan order
                        var v = 0;
                        while v < count {
                            if st[8 * v + 5] == 1 {
                                st[8 * v + 5] = 0;
                                let pf = par_finish(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, v, checker, wd, log, integ, accept, libs, st, attempts);
                                st[gb + 1 + st[8 * v]] = 0;
                                if pf == 1 {
                                    provider = 1;
                                }
                            }
                            v = v + 1;
                        }
                    }
                }
            }
            pool.close(heap, pl);
        }
    }
    unbox_slice(heap, stb);
    buffer.drop(heap, selfx);
    var gone = buffer.append(heap, buffer.empty(heap, 128), "rm -rf ");
    gone = buffer.append(heap, gone, wd);
    gone = buffer.append(heap, gone, "/units #");
    borrow gone as &gq in {
        sh_ok(heap, exec, clock, buffer.bytes(gq));
    }
    buffer.drop(heap, gone);
    return provider;
}


// What the run says about a unit that did not verify, after its trail is kept as `trail-<id>.jsonl`: where the agent's own words are (a provider error has its
// cause there) and, when the agent reached the model but gave up (a named failure signature in the trail), why.
fn report_not_verified[&h, &i, &z, &l, &w, &d](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], wd: &w [byte], id: &d [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    var al = buffer.append(heap, buffer.empty(heap, 64), "[AGENT_LOG]\t");
    al = buffer.append(heap, al, id);
    al = buffer.append(heap, al, "\tagent-");
    al = buffer.append(heap, al, id);
    al = buffer.append(heap, al, ".log\n");
    borrow al as &alb in {
        tell(heap, io, fs, log, buffer.bytes(alb));
    }
    buffer.drop(heap, al);
    let whyp = in_wd(heap, wd, "trail-", id, ".jsonl");
    borrow whyp as &wpq in {
        let gw = trail.gave_up_why(heap, fs, buffer.bytes(wpq));
        borrow gw as &gwq in {
            if len(buffer.bytes(gwq)) > 0 {
                var wl = buffer.append(heap, buffer.empty(heap, 96), "[UNIT_WHY]\t");
                wl = buffer.append(heap, wl, id);
                wl = buffer.append(heap, wl, "\t");
                wl = buffer.append(heap, wl, buffer.bytes(gwq));
                wl = buffer.append(heap, wl, "\n");
                borrow wl as &wlb in {
                    tell(heap, io, fs, log, buffer.bytes(wlb));
                }
                buffer.drop(heap, wl);
            }
        }
        buffer.drop(heap, gw);
    }
    buffer.drop(heap, whyp);
    return 0;
}

fn drive[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &rc, &rt, &ht, &pt, &pf, &av](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &!n [int], meta: &!m [int], notes: &!o [byte], reach: &!rc [int], count: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte], par: Par, argv0: &av [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, pipe_read, child_signal] int {
    let units = json.get(src, tape, 0, "units");
    var j = units + 1;
    var u = 0;
    while u < count {
        nodes[u] = j;
        j = json.skip(tape, j);
        u = u + 1;
    }
    // The integration unit (docs/plan.md): the application of a service, judged by the service's acceptance command instead of tests.
    var integ = 0 - 1;
    let inode = json.get(src, tape, 0, "integration");
    if inode >= 0 && json.is_string(tape, inode) {
        integ = find_unit(src, tape, nodes, count, json.string_view(src, tape, inode));
    }
    if integ >= 0 && len(accept) == 0 {
        tell(heap, io, fs, log, "project: the plan names an integration unit and no acceptance command was given\n");
        return 2;
    }
    // The scaffolds of the plan's declared files (docs/multi-file.md), when they are not there yet.
    write_files(heap, fs, src, tape, wd);
    u = 0;
    while u < count {
        if u != integ {
            write_tests(heap, fs, src, tape, nodes[u], wd, checker);
        }
        u = u + 1;
    }
    state_read(heap, fs, src, tape, nodes, meta, count, wd);
    // A unit the person re-opens (docs/build.md): `--retry` puts it back to not verified, `--patch` leaves it as it is until the patch has verified.
    // Only it, and the units that depend on it (directly or not), are worked on in this run; every other unit that is not verified stays untouched
    // (state 3: it is neither built nor said to have failed).
    var redo = 0 - 1;
    var patching = false;
    if len(patch) > 0 {
        redo = find_unit(src, tape, nodes, count, patch);
        patching = true;
    } else if len(retry) > 0 {
        redo = find_unit(src, tape, nodes, count, retry);
    }
    if redo >= 0 {
        if patching == false {
            if meta[3 * redo] == 1 {
                meta[3 * redo] = 0;
                state_write(heap, fs, src, tape, nodes, meta, count, wd);
            }
            var rl = buffer.append(heap, buffer.empty(heap, 64), "[RETRY]\t");
            rl = buffer.append(heap, rl, uid(src, tape, nodes, redo));
            if len(hint) > 0 {
                rl = buffer.append(heap, rl, "\thint");
            }
            rl = buffer.append(heap, rl, "\n");
            borrow rl as &rlb in {
                tell(heap, io, fs, log, buffer.bytes(rlb));
            }
            buffer.drop(heap, rl);
        }
        reach[redo] = 1;
        var grew = true;
        while grew {
            grew = false;
            var v = 0;
            while v < count {
                if reach[v] == 0 && dep_reached(src, tape, nodes, reach, count, v) {
                    reach[v] = 1;
                    grew = true;
                }
                v = v + 1;
            }
        }
        var mv = 0;
        while mv < count {
            if reach[mv] == 0 && meta[3 * mv] != 1 {
                meta[3 * mv] = 3;
            }
            mv = mv + 1;
        }
    }
    // Re-verify what the state says is verified.
    recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, -1, "an earlier edit", true, checker, wd, log, integ, accept, libs);
    var provider = false;
    var going = true;
    var refused_patch = false;
    if patching {
        let pr = apply_patch(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, redo, checker, wd, agent_ms, log, integ, accept, libs, pfile);
        if pr == 0 {
            meta[3 * redo] = 1;
            state_write(heap, fs, src, tape, nodes, meta, count, wd);
            say(heap, io, fs, log, uid(src, tape, nodes, redo), "verified");
            recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, redo, uid(src, tape, nodes, redo), false, checker, wd, log, integ, accept, libs);
        } else if pr == 1 {
            // refused: nothing else is built; the run ends stuck
            refused_patch = true;
            going = false;
            meta[3 * redo] = 2;
        } else {
            provider = true;
            going = false;
        }
    }
    // Units built side by side (docs/parallel.md): the same loop, many at a time, then the verdict below as ever.
    if par.jobs > 1 && going {
        if par_loop(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, checker, wd, agent, attempts, agent_ms, log, accept, libs, integ, redo, patching, hint, par, argv0) == 1 {
            provider = true;
        }
        going = false;
    }
    while going {
        let next = next_unit(src, tape, nodes, meta, count);
        if next < 0 {
            going = false;
        } else {
            let id = uid(src, tape, nodes, next);
            if meta[3 * next + 1] >= 3 * count {
                // The guard against two units breaking each other for ever.
                meta[3 * next] = 2;
                say(heap, io, fs, log, id, "failed");
            } else {
                // A unit that fails leaves its attempts in project.cho; the file goes back to what it was, so the units
                // that do not depend on it still build.
                let nufb = unit_file_in(heap, checker, src, tape, nodes[next]);
                borrow nufb as &nufq in {
                let nuf = buffer.bytes(nufq);
                keep_copy(heap, fs, wd, nuf, false);
                var how = "";
                var base = 0;
                if next == redo && patching == false {
                    how = "retry";
                    base = seed_trail(heap, fs, wd, id, nuf);
                }
                unit_event(heap, clock, fs, wd, checker, src, tape, nodes[next], id, "", false, how);
                var r = 1;
                if next == redo && patching == false {
                    r = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, next, checker, wd, agent, attempts, agent_ms, log, integ, accept, libs, base, hint, false);
                } else {
                    r = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, next, checker, wd, agent, attempts, agent_ms, log, integ, accept, libs, 0, "", false);
                }
                // The unit's trail is kept whatever the outcome: a unit that failed is the one whose trail is wanted.
                keep_trail(heap, fs, id, wd, nuf);
                keep_agent_log(heap, fs, id, wd, nuf);
                if r != 0 {
                    report_not_verified(heap, io, fs, log, wd, id);
                }
                if r == 0 {
                    unit_event(heap, clock, fs, wd, checker, src, tape, nodes[next], id, "verified", true, "");
                } else if r == 1 {
                    unit_event(heap, clock, fs, wd, checker, src, tape, nodes[next], id, "stuck", true, "");
                } else {
                    unit_event(heap, clock, fs, wd, checker, src, tape, nodes[next], id, "unavailable", true, "");
                }
                if r == 0 {
                    meta[3 * next] = 1;
                    state_write(heap, fs, src, tape, nodes, meta, count, wd);
                    say(heap, io, fs, log, id, "verified");
                    recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, next, id, false, checker, wd, log, integ, accept, libs);
                } else if r == 1 {
                    keep_copy(heap, fs, wd, nuf, true);
                    meta[3 * next] = 2;
                    say(heap, io, fs, log, id, "failed");
                } else {
                    say(heap, io, fs, log, id, "unavailable");
                    provider = true;
                    going = false;
                }
                }
                buffer.drop(heap, nufb);
            }
        }
    }
    if provider {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tprovider_error\n");
        return 4;
    }
    var stuck = refused_patch;
    u = 0;
    while u < count {
        if meta[3 * u] == 2 || meta[3 * u] == 3 {
            stuck = true;
        } else if meta[3 * u] == 0 {
            stuck = true;
            if refused_patch == false {
                say(heap, io, fs, log, uid(src, tape, nodes, u), "skipped");
            }
        }
        u = u + 1;
    }
    if stuck {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tstuck\n");
        return 1;
    }
    if final_gate(heap, exec, clock, src, tape, nodes, count, checker, wd, integ, accept, libs) {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tdone\n");
        return 0;
    }
    tell(heap, io, fs, log, "[PROJECT_VERDICT]\tgate_failed\n");
    return 5;
}

// Build the plan in `src` in `wd`, saying every line on the console and, when `log` names a file, appending it there too (the build
// command's run.log). The exit code of docs/project.md, except that a final gate that fails is 5 (it is 1 in `run`, the same exit as stuck):
// 0 done, 1 stuck, 2 the work directory cannot be written (or the re-opening asked for does not fit the plan: nothing changed), 3 no plan,
// 4 the agent or the checker is away, 5 gate_failed.
//
// `retry` (a unit id; empty: none) re-opens that unit, with `hint` (the person's words; empty: none) in its task; `patch` (a unit id) applies
// the code in the file `pfile` to that unit instead of asking the agent (docs/build.md). Both empty is a plain run.
pub fn run_logged[&h, &x, &c, &i, &z, &s, &k, &w, &a, &l, &ac, &lb, &rt, &ht, &pt, &pf, &av](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte], par: Par, argv0: &av [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, err_write, pipe_read, child_signal] int {
    let (out, code) = plan.check(heap, src);
    borrow out as &o in {
        tell(heap, io, fs, log, buffer.bytes(o));
    }
    buffer.drop(heap, out);
    if code != 0 {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tno_plan\n");
        return 3;
    }
    if redo_check(heap, io, fs, src, retry, patch, pfile) != 0 {
        return 2;
    }
    if write_fixed(heap, fs, wd, checker) < 0 {
        io.error_all(io, "project: the work directory cannot be written\n");
        return 2;
    }
    let jd0 = trail.journal_dir(heap, wd);
    borrow jd0 as &jq0 in {
        trail.journal_dirs(heap, exec, clock, buffer.bytes(jq0));
    }
    buffer.drop(heap, jd0);
    var status = 1;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        let count = json.count(tape, json.get(src, tape, 0, "units"));
        let nb = box_slice(heap, count + 1, 0);
        let mb = box_slice(heap, 3 * count + 3, 0);
        let rb = box_slice(heap, count + 1, 0);
        let sb = box_slice(heap, (count + 1) * note_cap(), byte_of(0));
        borrow mut nb as &!nw in {
            borrow mut mb as &!mw in {
                borrow mut rb as &!rw in {
                    borrow mut sb as &!sw in {
                        status = drive(heap, exec, clock, io, fs, src, tape, contents(nw), contents(mw), contents(sw), contents(rw), count, checker, wd, agent, attempts, agent_ms, log, accept, libs, retry, hint, patch, pfile, par, argv0);
                    }
                }
            }
        }
        unbox_slice(heap, sb);
        unbox_slice(heap, rb);
        unbox_slice(heap, mb);
        unbox_slice(heap, nb);
    }
    unbox_slice(heap, tb);
    return status;
}

// Build the plan in `src` in `wd` (the exit code of docs/project.md: 0 done, 1 stuck or gate failed, 2 the work directory cannot be
// written, 3 no plan, 4 the agent or the checker is away). `retry`, `hint`, `patch`, `pfile`: as in `run_logged`.
pub fn run[&h, &x, &c, &i, &z, &s, &k, &w, &a, &ac, &lb, &rt, &ht, &pt, &pf, &av](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte], par: Par, argv0: &av [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, err_write, pipe_read, child_signal] int {
    let started = clock_unix_ms(clock);
    // A re-opening that does not fit the plan is a usage error before anything is written, the journal included.
    if len(retry) > 0 || len(patch) > 0 {
        let (pout, pcode) = plan.check(heap, src);
        buffer.drop(heap, pout);
        if pcode == 0 && redo_check(heap, io, fs, src, retry, patch, pfile) != 0 {
            return 2;
        }
    }
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        trail.journal_dirs(heap, exec, clock, buffer.bytes(jq));
        trail.run_start(heap, clock, fs, buffer.bytes(jq), "", "", "", false, 0, attempts, agent_ms, 0);
    }
    let status = run_logged(heap, exec, clock, io, fs, src, checker, wd, agent, attempts, agent_ms, "", accept, libs, retry, hint, patch, pfile, par, argv0);
    var code = status;
    if status == 5 {
        code = 1;
    }
    var word = "stuck";
    if status == 0 {
        word = "done";
    } else if status == 2 {
        word = "usage";
    } else if status == 3 {
        word = "no_plan";
    } else if status == 4 {
        word = "provider_error";
    } else if status == 5 {
        word = "gate_failed";
    }
    borrow jd as &jq2 in {
        let now = clock_unix_ms(clock);
        trail.run_end(heap, now, fs, buffer.bytes(jq2), word, code, (now - started) / 1000);
    }
    buffer.drop(heap, jd);
    return code;
}
