edition 7;

module project;

// `project` -- the project driver (docs/project.md, docs/parity.md P5): a plan built unit by unit. The next unit whose
// dependencies are verified is handed to `driver.run_issue` (the `fix` loop, reused unchanged); everything verified is
// re-checked after every unit; `state.txt` lets a killed run resume.
//
// The plan is parsed once onto a tape. Per unit `u`, `meta[3u]` is its state (0 open, 1 verified, 2 failed this run),
// `meta[3u+1]` how often it was built, `meta[3u+2]` the length of its NOTE, kept in `notes` (note() bytes per unit).

import acceptance;
import driver;
import plan;
import trail;
import snapshot;
import splice;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

fn note_cap() -> [] int {
    return 640;
}

// ---- small helpers --------------------------------------------------------

// `<wd>/<pre><id><suf>`.
pub fn in_wd[&h, &w, &a, &b, &c](heap: &!h Heap, wd: &w [byte], pre: &a [byte], id: &b [byte], suf: &c [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 128), wd);
    b = buffer.append(heap, b, "/");
    b = buffer.append(heap, b, pre);
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, suf);
    return b;
}

// Write `b` whole to `path` and end it; 0, or -1 when the write failed.
pub fn put[&h, &z, &p](heap: &!h Heap, fs: &z Fs(""), path: &p [byte], b: buffer.Buffer) -> [heap, fs_write("")] int {
    var r = -1;
    borrow b as &bb in {
        let want = buffer.size(bb);
        if fs_write(fs, path, buffer.bytes(bb)) == want {
            r = 0;
        }
    }
    buffer.drop(heap, b);
    return r;
}

// Append the string at node `i`, decoded.
fn add_str[&h, &s, &t](heap: &!h Heap, b: buffer.Buffer, src: &s [byte], tape: &t [int], i: int) -> [heap] buffer.Buffer {
    var out = b;
    if json.string_plain(tape, i) {
        out = buffer.append(heap, out, json.string_view(src, tape, i));
    } else {
        let n = json.string_length(src, tape, i);
        if n > 0 {
            region r {
                let tmp = alloc_slice[r](n, byte_of(0));
                json.string_into(src, tape, i, tmp);
                out = buffer.append(heap, out, tmp[0..n]);
            }
        }
    }
    return out;
}

// Append `text` to the file `path` (read whole, written whole: a log is small, and the file capability has no append): 0, or -1.
pub fn append_file[&h, &z, &p, &t](heap: &!h Heap, fs: &z Fs(""), path: &p [byte], text: &t [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let room = 4194304;
    let store = box_slice(heap, room, byte_of(0));
    var b = buffer.empty(heap, 256);
    var full = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= room {
            full = true;
        } else if n > 0 {
            b = buffer.append(heap, b, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    b = buffer.append(heap, b, text);
    var r = -1;
    if full == false {
        r = put(heap, fs, path, b);
    } else {
        buffer.drop(heap, b);
    }
    return r;
}

// Say `text` on the console and, when `log` names a file, append it there too (the run's `run.log`, docs/build.md).
pub fn tell[&h, &i, &z, &l, &t](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], text: &t [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    io.write_all(io, text);
    if len(log) > 0 {
        append_file(heap, fs, log, text);
    }
    return 0;
}

fn say[&h, &i, &z, &l, &d](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], id: &d [byte], word: &static [byte]) -> [heap, io_write, fs_read(""), fs_write("")] int {
    var b = buffer.append(heap, buffer.empty(heap, 64), "[UNIT]\t");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, "\t");
    b = buffer.append(heap, b, word);
    b = buffer.append(heap, b, "\n");
    borrow b as &bb in {
        tell(heap, io, fs, log, buffer.bytes(bb));
    }
    buffer.drop(heap, b);
    return 0;
}

// ---- the plan -------------------------------------------------------------

fn uid[&s, &t, &n](src: &s [byte], tape: &t [int], nodes: &n [int], u: int) -> [] &s [byte] {
    return json.string_view(src, tape, json.get(src, tape, nodes[u], "id"));
}

fn find_unit[&s, &t, &n, &x](src: &s [byte], tape: &t [int], nodes: &n [int], count: int, id: &x [byte]) -> [] int {
    var u = 0;
    while u < count {
        if bytes.equal(uid(src, tape, nodes, u), id) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// Are all of `u`'s dependencies verified?
fn deps_done[&s, &t, &n, &m](src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int, u: int) -> [] bool {
    let arr = json.get(src, tape, nodes[u], "deps");
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        let d = find_unit(src, tape, nodes, count, json.string_view(src, tape, j));
        if d < 0 || meta[3 * d] != 1 {
            return false;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return true;
}

// The first unit in file order that is open and ready, or -1.
fn next_unit[&s, &t, &n, &m](src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int) -> [] int {
    var u = 0;
    while u < count {
        if meta[3 * u] == 0 && deps_done(src, tape, nodes, meta, count, u) {
            return u;
        }
        u = u + 1;
    }
    return 0 - 1;
}

// ---- notes ----------------------------------------------------------------

fn fill[&o, &x](notes: &!o [byte], base: int, pos: int, text: &x [byte]) -> [] int {
    var p = pos;
    var k = 0;
    while k < len(text) && p < note_cap() {
        notes[base + p] = text[k];
        p = p + 1;
        k = k + 1;
    }
    return p;
}

// The NOTE of unit `u`: which unit broke it, and the failing output (cut to fit).
fn set_note[&o, &m, &b, &x](notes: &!o [byte], meta: &!m [int], u: int, broke: &b [byte], said: &x [byte]) -> [] int {
    let base = u * note_cap();
    var p = fill(notes, base, 0, "The unit ");
    p = fill(notes, base, p, broke);
    p = fill(notes, base, p, " broke this one. Failing test output:\n");
    p = fill(notes, base, p, said);
    meta[3 * u + 2] = p;
    return 0;
}

// ---- files ----------------------------------------------------------------

// `edition 7;` and the unit's examples as tests, and the legend.
// The JSON string at node `i`, decoded (it may hold quotes and newlines), appended to `b`.
fn add_decoded[&h, &s, &t](heap: &!h Heap, b: buffer.Buffer, src: &s [byte], tape: &t [int], i: int) -> [heap] buffer.Buffer {
    var r = b;
    let n = json.string_length(src, tape, i);
    if n > 0 {
        region dr {
            let out = alloc_slice[dr](n + 1, byte_of(0));
            let w = json.string_into(src, tape, i, out);
            if w > 0 {
                r = buffer.append(heap, r, out[0..w]);
            }
        }
    }
    return r;
}

// The body of one example's test: `() -> [] int { ...; return 0; }`. `CALL == EXPECTED` is `test.assert(CALL == EXPECTED)`, except when
// EXPECTED is an Option (`option.Option::Some(X)` or `option.Option::None`): the compiler has no `==` on enums, so the call is matched
// and X compared as a scalar. That is the one enum the examples can name. The tests file does NOT import std.option: files compiled together
// share their imports, and the project file has to import it for the unit's signature to exist.
fn example_body[&h, &e](heap: &!h Heap, out: buffer.Buffer, ex: &e [byte]) -> [heap] buffer.Buffer {
    var b = out;
    let at = bytes.find(ex, " == ");
    if at >= 0 {
        let call = ex[0..at];
        let want = ex[at + 4..len(ex)];
        if bytes.find(want, "option.Option::None") == 0 {
            b = buffer.append(heap, b, "() -> [] int { match ");
            b = buffer.append(heap, b, call);
            b = buffer.append(heap, b, " { option.Option::Some(v) => { test.assert(false); } option.Option::None => { test.assert(true); } } return 0; }\n");
            return b;
        }
        if bytes.find(want, "option.Option::Some(") == 0 && len(want) > 20 && int_of(want[len(want) - 1]) == 41 {
            b = buffer.append(heap, b, "() -> [] int { match ");
            b = buffer.append(heap, b, call);
            b = buffer.append(heap, b, " { option.Option::Some(v) => { test.assert(v == ");
            b = buffer.append(heap, b, want[20..len(want) - 1]);
            b = buffer.append(heap, b, "); } option.Option::None => { test.assert(false); } } return 0; }\n");
            return b;
        }
    }
    b = buffer.append(heap, b, "() -> [] int { test.assert(");
    b = buffer.append(heap, b, ex);
    b = buffer.append(heap, b, "); return 0; }\n");
    return b;
}

fn write_tests[&h, &z, &s, &t, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], node: int, wd: &w [byte]) -> [heap, fs_write("")] int {
    let id = json.string_view(src, tape, json.get(src, tape, node, "id"));
    var sid = buffer.empty(heap, 32);
    var q = 0;
    while q < len(id) {
        let c = int_of(id[q]);
        if bytes.is_alpha(c) || bytes.is_digit(c) || c == 95 {
            sid = buffer.push(heap, sid, id[q]);
        } else {
            sid = buffer.push(heap, sid, byte_of(95));
        }
        q = q + 1;
    }
    var tests = buffer.append(heap, buffer.empty(heap, 512), "edition 7;\nimport std.test;\n");
    var legend = buffer.empty(heap, 256);
    // A unit's own `tests` (docs/plan.md) are the executable form when it has any: the examples stay documentation, for a function
    // an example cannot call (a result that is text, or a Result).
    let rt = json.get(src, tape, node, "tests");
    var raw = 0;
    if rt >= 0 {
        raw = json.count(tape, rt);
    }
    let arr = json.get(src, tape, node, "examples");
    var j = arr + 1;
    var left = json.count(tape, arr);
    if raw > 0 {
        left = 0;
    }
    var k = 1;
    while left > 0 {
        var ex = add_str(heap, buffer.empty(heap, 64), src, tape, j);
        var name = buffer.append(heap, buffer.empty(heap, 32), "test_");
        borrow sid as &sb in {
            name = buffer.append(heap, name, buffer.bytes(sb));
        }
        name = buffer.append(heap, name, "_");
        name = buffer.push_nat(heap, name, k);
        borrow name as &nb in {
            borrow ex as &eb in {
                tests = buffer.append(heap, tests, "pub fn ");
                tests = buffer.append(heap, tests, buffer.bytes(nb));
                tests = example_body(heap, tests, buffer.bytes(eb));
                legend = buffer.append(heap, legend, buffer.bytes(nb));
                legend = buffer.append(heap, legend, " ");
                legend = buffer.append(heap, legend, buffer.bytes(eb));
                legend = buffer.append(heap, legend, "\n");
            }
        }
        buffer.drop(heap, name);
        buffer.drop(heap, ex);
        j = json.skip(tape, j);
        left = left - 1;
        k = k + 1;
    }
    buffer.drop(heap, sid);
    if raw > 0 {
        var rj = rt + 1;
        var rleft = raw;
        while rleft > 0 {
            tests = add_decoded(heap, tests, src, tape, rj);
            tests = buffer.append(heap, tests, "\n");
            legend = buffer.append(heap, legend, "(the unit's own test, named in the output above)\n");
            rj = json.skip(tape, rj);
            rleft = rleft - 1;
        }
    }
    let tp = in_wd(heap, wd, "tests-", id, ".cho");
    let lp = in_wd(heap, wd, "legend-", id, ".txt");
    var r = 0;
    borrow tp as &tq in {
        if put(heap, fs, buffer.bytes(tq), tests) < 0 {
            r = -1;
        }
    }
    borrow lp as &lq in {
        if put(heap, fs, buffer.bytes(lq), legend) < 0 {
            r = -1;
        }
    }
    buffer.drop(heap, tp);
    buffer.drop(heap, lp);
    return r;
}

// `project.cho.task` for unit `node`.
fn write_task[&h, &z, &s, &t, &w, &x, &y](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], node: int, wd: &w [byte], note: &x [byte], hint: &y [byte], integ: bool) -> [heap, fs_write("")] int {
    let id = json.string_view(src, tape, json.get(src, tape, node, "id"));
    let sg = json.get(src, tape, node, "signature");
    var sig = add_str(heap, buffer.empty(heap, 96), src, tape, sg);
    var b = buffer.append(heap, buffer.empty(heap, 512), "UNIT: ");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, "\nFUNCTION: ");
    borrow sig as &sb in {
        let (a, e) = plan.name_range(buffer.bytes(sb));
        if a >= 0 {
            b = buffer.append(heap, b, buffer.bytes(sb)[a..e]);
        }
        b = buffer.append(heap, b, "\nSIGNATURE: ");
        b = buffer.append(heap, b, buffer.bytes(sb));
    }
    buffer.drop(heap, sig);
    // The description, decoded (it holds quotes and newlines): what the signature and the examples cannot say.
    let dn = json.get(src, tape, node, "description");
    if dn >= 0 && json.is_string(tape, dn) {
        b = buffer.append(heap, b, "\nDESCRIPTION: ");
        b = add_decoded(heap, b, src, tape, dn);
    }
    // How hard the model should think about this unit (docs/plan.md `effort`): the agent reads it and sends it as the request's effort.
    let en = json.get(src, tape, node, "effort");
    if en >= 0 && json.is_string(tape, en) {
        b = buffer.append(heap, b, "\nEFFORT: ");
        b = add_decoded(heap, b, src, tape, en);
    }
    if integ {
        // The integration unit (docs/plan.md `integration`): the application, wired from the functions already in project.cho, judged by
        // the service's acceptance scenarios, whose output is the feedback. It has no examples.
        b = buffer.append(heap, b, "\nINSTRUCTIONS: Add the application to project.cho: the definitions the description names, wired from the functions that are already in the file (call them; do not write them again). The service's acceptance scenarios are run for you on the whole service (the file plus the fixed server loop that holds `main`); when one fails, its output is the feedback. Do not write a main, tests or examples of your own. If a scenario shows that an earlier function is wrong, fix that function too, keeping every other function as it is.\n");
    } else {
        b = buffer.append(heap, b, "\nEXAMPLES:\n");
        let arr = json.get(src, tape, node, "examples");
        var j = arr + 1;
        var left = json.count(tape, arr);
        while left > 0 {
            b = add_str(heap, b, src, tape, j);
            b = buffer.append(heap, b, "\n");
            j = json.skip(tape, j);
            left = left - 1;
        }
        b = buffer.append(heap, b, "INSTRUCTIONS: Add this function to project.cho, keeping every other function as it is. The file has no main. Do not write tests or examples of your own: the examples above are run for you.\n");
    }
    if len(note) > 0 {
        b = buffer.append(heap, b, "NOTE: ");
        b = buffer.append(heap, b, note);
        b = buffer.append(heap, b, "\n");
    }
    // What a person said about this unit when they re-opened it (`--retry <unit> --hint "..."`): one `HINT:` line per line of their text. The agent
    // puts it in the prompt under its own heading (src/prompt.cho); the checks decide as before.
    var at = 0;
    while at < len(hint) {
        var e = at;
        while e < len(hint) && int_of(hint[e]) != 10 {
            e = e + 1;
        }
        let said = bytes.trim(hint[at..e]);
        if len(said) > 0 {
            b = buffer.append(heap, b, "HINT: ");
            b = buffer.append(heap, b, said);
            b = buffer.append(heap, b, "\n");
        }
        at = e + 1;
    }
    let path = in_wd(heap, wd, "project.cho.task", "", "");
    var r = 0;
    borrow path as &pq in {
        r = put(heap, fs, buffer.bytes(pq), b);
    }
    buffer.drop(heap, path);
    return r;
}

// `state.txt`, rewritten whole: one `verified <id>` per verified unit.
fn state_write[&h, &z, &s, &t, &n, &m, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &m [int], count: int, wd: &w [byte]) -> [heap, fs_write("")] int {
    var b = buffer.empty(heap, 128);
    var u = 0;
    while u < count {
        if meta[3 * u] == 1 {
            b = buffer.append(heap, b, "verified ");
            b = buffer.append(heap, b, uid(src, tape, nodes, u));
            b = buffer.append(heap, b, "\n");
        }
        u = u + 1;
    }
    let path = in_wd(heap, wd, "state.txt", "", "");
    var r = 0;
    borrow path as &pq in {
        r = put(heap, fs, buffer.bytes(pq), b);
    }
    buffer.drop(heap, path);
    return r;
}

// Mark the units `state.txt` names as verified (a missing file is empty).
fn state_read[&h, &z, &s, &t, &n, &m, &w](heap: &!h Heap, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], count: int, wd: &w [byte]) -> [heap, fs_read("")] int {
    let path = in_wd(heap, wd, "state.txt", "", "");
    borrow path as &pq in {
        region r {
            let text = alloc_slice[r](65536, byte_of(0));
            let got = fs_read(fs, buffer.bytes(pq), text);
            var p = 0;
            while p < got {
                var e = p;
                while e < got && int_of(text[e]) != 10 {
                    e = e + 1;
                }
                let line = text[p..e];
                if bytes.starts_with(line, "verified ") {
                    let u = find_unit(src, tape, nodes, count, bytes.trim(line[9..len(line)]));
                    if u >= 0 {
                        meta[3 * u] = 1;
                    }
                }
                p = e + 1;
            }
        }
    }
    buffer.drop(heap, path);
    return 0;
}

// `main.cho` (a fixed main that releases every capability) and `project.cho` when absent: 0, or -1 when the work directory
// cannot be written.
fn write_fixed[&h, &z, &w](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte]) -> [heap, fs_read(""), fs_write("")] int {
    var m = buffer.append(heap, buffer.empty(heap, 512), "edition 7;\n\nfn main(world: World) -> [] int {\n");
    m = buffer.append(heap, m, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    m = buffer.append(heap, m, "    release(io);\n    release(ffi);\n    release(fs);\n    release(heap);\n    release(args);\n");
    m = buffer.append(heap, m, "    release(net);\n    release(clock);\n    release(signals);\n    release(exec);\n    return 0;\n}\n");
    let mp = in_wd(heap, wd, "main.cho", "", "");
    var r = 0;
    borrow mp as &mq in {
        r = put(heap, fs, buffer.bytes(mq), m);
    }
    buffer.drop(heap, mp);
    let pp = in_wd(heap, wd, "project.cho", "", "");
    borrow pp as &pq in {
        region g {
            let probe = alloc_slice[g](16, byte_of(0));
            if fs_read(fs, buffer.bytes(pq), probe) < 0 {
                if fs_write(fs, buffer.bytes(pq), "edition 7;\n") < 0 {
                    r = -1;
                }
            }
        }
    }
    buffer.drop(heap, pp);
    return r;
}

// ---- commands -------------------------------------------------------------

// The unit's acceptance command (the file is appended by the runner, the `#` ends the command).
//
// `libs` are source files every compile gets beside the project (a service's http-server package). The integration unit's acceptance
// is the service's own command (`accept`): it builds and runs the whole service, and the runner appends the project file to it.
fn unit_accept[&h, &k, &w, &d, &ac, &lb](heap: &!h Heap, checker: &k [byte], wd: &w [byte], id: &d [byte], integ: bool, accept: &ac [byte], libs: &lb [byte]) -> [heap] buffer.Buffer {
    if integ {
        return buffer.append(heap, buffer.empty(heap, 512), accept);
    }
    var b = buffer.append(heap, buffer.empty(heap, 512), checker);
    b = buffer.append(heap, b, " test --std --backend cranelift ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/project.cho ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/tests-");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, ".cho ");
    b = buffer.append(heap, b, libs);
    b = buffer.append(heap, b, " || { cat ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/legend-");
    b = buffer.append(heap, b, id);
    b = buffer.append(heap, b, ".txt; exit 1; } #");
    return b;
}

// How long one acceptance run may take: a unit's tests, or the integration unit's whole service (a build, a server, its scenarios).
fn accept_ms(integ: bool) -> [] int {
    if integ {
        return 300000;
    }
    return 60000;
}

// Run unit `id`'s acceptance command on project.cho.
fn verify[&h, &x, &c, &k, &w, &d, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, checker: &k [byte], wd: &w [byte], id: &d [byte], integ: bool, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] acceptance.Result {
    let text = unit_accept(heap, checker, wd, id, integ, accept, libs);
    let file = in_wd(heap, wd, "project.cho", "", "");
    var ans = acceptance.Result { held: 2, why: buffer.empty(heap, 8), said: buffer.empty(heap, 8) };
    borrow text as &tb in {
        borrow file as &fb in {
            acceptance.drop(heap, ans);
            ans = acceptance.run(heap, exec, clock, buffer.bytes(tb), buffer.bytes(fb), 4096, accept_ms(integ));
        }
    }
    buffer.drop(heap, text);
    buffer.drop(heap, file);
    return ans;
}

// `ids` and `id` after it, comma-separated (the journal's sweep event).
fn note_id[&h, &d](heap: &!h Heap, ids: buffer.Buffer, id: &d [byte]) -> [heap] buffer.Buffer {
    var b = ids;
    var some = false;
    borrow b as &bq in {
        some = buffer.size(bq) > 0;
    }
    if some {
        b = buffer.push(heap, b, byte_of(44));
    }
    return buffer.append(heap, b, id);
}

// The sweep event of a `recheck` (docs/journal.md), when it checked anything; ends the two lists.
fn sweep_event[&h, &c, &z, &w, &b](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], skip: int, broke: &b [byte], held_ids: buffer.Buffer, bad_ids: buffer.Buffer) -> [heap, clock, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        borrow held_ids as &hq in {
            borrow bad_ids as &bq in {
                if len(buffer.bytes(hq)) + len(buffer.bytes(bq)) > 0 {
                    if skip >= 0 {
                        trail.journal_sweep(heap, clock, fs, buffer.bytes(jq), broke, buffer.bytes(hq), buffer.bytes(bq));
                    } else {
                        trail.journal_sweep(heap, clock, fs, buffer.bytes(jq), "", buffer.bytes(hq), buffer.bytes(bq));
                    }
                }
            }
        }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, held_ids);
    buffer.drop(heap, bad_ids);
    return 0;
}

// Re-verify every verified unit but `skip` (-1: none): the ones that fail go back on the board, with a NOTE naming `broke`.
fn recheck[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &b, &l, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &!o [byte], count: int, skip: int, broke: &b [byte], keep: bool, checker: &k [byte], wd: &w [byte], log: &l [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll, io_write, fs_read(""), fs_write("")] int {
    var u = 0;
    var dropped = 0;
    var held_ids = buffer.empty(heap, 64);
    var bad_ids = buffer.empty(heap, 64);
    while u < count {
        if u != skip && meta[3 * u] == 1 {
            let r = verify(heap, exec, clock, checker, wd, uid(src, tape, nodes, u), u == integ, accept, libs);
            let acceptance.Result { held, why, said } = r;
            buffer.drop(heap, why);
            if held == 0 {
                held_ids = note_id(heap, held_ids, uid(src, tape, nodes, u));
                if keep {
                    say(heap, io, fs, log, uid(src, tape, nodes, u), "kept");
                }
            } else {
                meta[3 * u] = 0;
                dropped = dropped + 1;
                bad_ids = note_id(heap, bad_ids, uid(src, tape, nodes, u));
                say(heap, io, fs, log, uid(src, tape, nodes, u), "regressed");
                borrow said as &sd in {
                    set_note(notes, meta, u, broke, buffer.bytes(sd));
                }
            }
            buffer.drop(heap, said);
        }
        u = u + 1;
    }
    if dropped > 0 {
        state_write(heap, fs, src, tape, nodes, meta, count, wd);
    }
    sweep_event(heap, clock, fs, wd, skip, broke, held_ids, bad_ids);
    return dropped;
}

// Build unit `u` with the fix loop: 0 verified, 1 failed, 2 unavailable.
fn build[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &ht](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &o [byte], u: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], integ: int, accept_cmd: &ac [byte], libs: &lb [byte], base: int, hint: &ht [byte], human: bool) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let id = uid(src, tape, nodes, u);
    let nbase = u * note_cap();
    if human == false {
        write_task(heap, fs, src, tape, nodes[u], wd, notes[nbase..nbase + meta[3 * u + 2]], hint, u == integ);
        meta[3 * u + 2] = 0;
        meta[3 * u + 1] = meta[3 * u + 1] + 1;
        say(heap, io, fs, log, id, "building");
    }
    let file = in_wd(heap, wd, "project.cho", "", "");
    var cmd = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    cmd = buffer.append(heap, cmd, checker);
    cmd = buffer.append(heap, cmd, " check --std --output json --backend cranelift ");
    cmd = buffer.append(heap, cmd, wd);
    cmd = buffer.append(heap, cmd, "/project.cho ");
    cmd = buffer.append(heap, cmd, wd);
    cmd = buffer.append(heap, cmd, "/main.cho ");
    cmd = buffer.append(heap, cmd, libs);
    cmd = buffer.append(heap, cmd, "\0");
    var act = buffer.append(heap, buffer.empty(heap, 512), "-c\0");
    act = buffer.append(heap, act, agent);
    act = buffer.append(heap, act, " ");
    act = buffer.append(heap, act, wd);
    // the agent's standard error goes to a file the driver reads after every turn (src/driver.cho `agent_note`)
    act = buffer.append(heap, act, "/project.cho 2>");
    act = buffer.append(heap, act, wd);
    act = buffer.append(heap, act, "/project.cho.agent.err\0");
    var prefix = buffer.append(heap, buffer.empty(heap, 128), wd);
    prefix = buffer.append(heap, prefix, "/project.cho.snap");
    let accept = unit_accept(heap, checker, wd, id, u == integ, accept_cmd, libs);
    let jd = trail.journal_dir(heap, wd);
    var status = 1;
    borrow jd as &jq in {
    borrow file as &fb in {
        borrow cmd as &ce in {
            borrow act as &ae in {
                borrow prefix as &pe in {
                    borrow accept as &qe in {
                        match driver.run_issue_journal(heap, exec, clock, io, fs, buffer.bytes(fb), buffer.bytes(ae), buffer.bytes(ce), buffer.bytes(pe), attempts, 2, agent_ms, buffer.bytes(qe), accept_ms(u == integ), buffer.bytes(jq), id, base, hint, human) {
                            driver.Ended::Verified => {
                                status = 0;
                            }
                            driver.Ended::FailedSignaure => {
                                status = 1;
                            }
                            driver.Ended::FailedCeiling => {
                                status = 1;
                            }
                            driver.Ended::PlanDefect => {
                                status = 1;
                            }
                            driver.Ended::Unavailable => {
                                status = 2;
                            }
                        }
                    }
                }
            }
        }
    }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, file);
    buffer.drop(heap, cmd);
    buffer.drop(heap, act);
    buffer.drop(heap, prefix);
    buffer.drop(heap, accept);
    return status;
}

// `unit_start`: the unit, the function it adds (from its signature) and the units it depends on. `node` is the unit's object in the plan's tape.
fn unit_start_event[&h, &c, &z, &d, &s, &t](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), dir: &d [byte], src: &s [byte], tape: &t [int], node: int, how: &static [byte]) -> [heap, clock, fs_read(""), fs_write("")] int {
    var w = trail.begin_event(heap, clock_unix_ms(clock), "unit_start");
    var id = trail.add_string(heap, buffer.empty(heap, 32), src, tape, json.get(src, tape, node, "id"));
    borrow id as &iq in {
        w = trail.put_str(heap, w, "unit", buffer.bytes(iq));
    }
    buffer.drop(heap, id);
    var sig = trail.add_string(heap, buffer.empty(heap, 96), src, tape, json.get(src, tape, node, "signature"));
    borrow sig as &sq in {
        let (a, e) = plan.name_range(buffer.bytes(sq));
        if a >= 0 {
            w = trail.put_str(heap, w, "function", buffer.bytes(sq)[a..e]);
        }
    }
    buffer.drop(heap, sig);
    // a unit re-opened by the person (`how` is `retry` or `patch`): the story says so
    if len(how) > 0 {
        w = trail.put_flag(heap, w, how, true);
    }
    w = json.put_key(heap, w, "deps");
    w = json.begin_array(heap, w);
    let ds = json.get(src, tape, node, "deps");
    if ds >= 0 && json.is_array(tape, ds) {
        var j = ds + 1;
        var left = json.count(tape, ds);
        while left > 0 {
            var dep = trail.add_string(heap, buffer.empty(heap, 32), src, tape, j);
            borrow dep as &dq in {
                w = json.put_string(heap, w, buffer.bytes(dq));
            }
            buffer.drop(heap, dep);
            j = json.skip(tape, j);
            left = left - 1;
        }
    }
    w = json.end_array(heap, w);
    return trail.end_event(heap, fs, dir, w);
}

// The unit's journal event (docs/journal.md): its start (`ended` false), or its end in `state` (the attempts are those of its trail).
fn unit_event[&h, &c, &z, &s, &t, &n, &w, &d](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], src: &s [byte], tape: &t [int], node: int, id: &d [byte], state: &static [byte], ended: bool, how: &static [byte]) -> [heap, clock, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    let tp = in_wd(heap, wd, "project.cho.trail.jsonl", "", "");
    borrow jd as &jq in {
        borrow tp as &tq in {
            if ended {
                trail.unit_end(heap, clock, fs, buffer.bytes(jq), id, state, buffer.bytes(tq));
            } else {
                unit_start_event(heap, clock, fs, buffer.bytes(jq), src, tape, node, how);
            }
        }
    }
    buffer.drop(heap, jd);
    buffer.drop(heap, tp);
    return 0;
}

// Copy project.cho to `<name>` in the work directory, or `<name>` back over project.cho (`back`): 0, or -1.
fn keep_copy[&h, &z, &w, &d](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], name: &d [byte], back: bool) -> [heap, fs_read(""), fs_write("")] int {
    let file = in_wd(heap, wd, "project.cho", "", "");
    let other = in_wd(heap, wd, name, "", "");
    var r = -1;
    borrow file as &fb in {
        borrow other as &ob in {
            if back {
                r = snapshot.copy(fs, buffer.bytes(ob), buffer.bytes(fb), 65536);
            } else {
                r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ob), 65536);
            }
        }
    }
    buffer.drop(heap, file);
    buffer.drop(heap, other);
    return r;
}

// Keep the unit's trail, whatever its outcome: `trail-<id>.jsonl`.
fn keep_trail[&h, &z, &d, &w](heap: &!h Heap, fs: &z Fs(""), id: &d [byte], wd: &w [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, "project.cho.trail.jsonl", "", "");
    let into = in_wd(heap, wd, "trail-", id, ".jsonl");
    var r = -1;
    borrow from as &fb in {
        borrow into as &ib in {
            r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536);
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return r;
}

// Keep the unit's agent log (the standard error of every turn, src/driver.cho), whatever its outcome: `agent-<id>.log`.
fn keep_agent_log[&h, &z, &d, &w](heap: &!h Heap, fs: &z Fs(""), id: &d [byte], wd: &w [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, "project.cho.agent.log", "", "");
    let into = in_wd(heap, wd, "agent-", id, ".log");
    var r = -1;
    borrow from as &fb in {
        borrow into as &ib in {
            r = snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536);
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return r;
}

// The final gate: project.cho and main.cho check, and every unit's tests run (one `cancho test` per tests file: each starts with `import std.test;`, and two such files in one run are refused).
fn final_gate[&h, &x, &c, &s, &t, &n, &k, &w, &ac, &lb](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, src: &s [byte], tape: &t [int], nodes: &n [int], count: int, checker: &k [byte], wd: &w [byte], integ: int, accept: &ac [byte], libs: &lb [byte]) -> [heap, exec(""), clock, poll] bool {
    var b = buffer.append(heap, buffer.empty(heap, 1024), checker);
    b = buffer.append(heap, b, " check --std --output json --backend cranelift ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/project.cho ");
    b = buffer.append(heap, b, wd);
    b = buffer.append(heap, b, "/main.cho ");
    b = buffer.append(heap, b, libs);
    b = buffer.append(heap, b, " > /dev/null");
    var u = 0;
    while u < count {
        if u != integ {
            b = buffer.append(heap, b, " && ");
            b = buffer.append(heap, b, checker);
            b = buffer.append(heap, b, " test --std --backend cranelift ");
            b = buffer.append(heap, b, wd);
            b = buffer.append(heap, b, "/project.cho ");
            b = buffer.append(heap, b, wd);
            b = buffer.append(heap, b, "/tests-");
            b = buffer.append(heap, b, uid(src, tape, nodes, u));
            b = buffer.append(heap, b, ".cho ");
            b = buffer.append(heap, b, libs);
        }
        u = u + 1;
    }
    if integ >= 0 {
        // the service itself, once more: it builds and runs the whole service against its scenarios
        b = buffer.append(heap, b, " && ");
        b = buffer.append(heap, b, accept);
        b = buffer.append(heap, b, " ");
        b = buffer.append(heap, b, wd);
        b = buffer.append(heap, b, "/project.cho");
    }
    b = buffer.append(heap, b, " #");
    let file = in_wd(heap, wd, "project.cho", "", "");
    var ok = false;
    borrow b as &bb in {
        borrow file as &fb in {
            let r = acceptance.run(heap, exec, clock, buffer.bytes(bb), buffer.bytes(fb), 65536, 120000 + accept_ms(integ >= 0));
            let acceptance.Result { held, why, said } = r;
            ok = held == 0;
            buffer.drop(heap, why);
            buffer.drop(heap, said);
        }
    }
    buffer.drop(heap, b);
    buffer.drop(heap, file);
    return ok;
}

// ---- re-opening a unit: --retry and --patch (docs/build.md) ---------------------------

// The most a hint holds, in bytes.
pub fn hint_cap() -> [] int {
    return 4000;
}

// The arguments' own rules, checked before anything is read or written: true when they hold, else the reason on the error stream. `retry` and
// `patch` are unit ids (empty: not given), `hint_given` says `--hint` was on the command line (an empty hint is an error, not no hint).
pub fn redo_args_ok[&i, &r, &h, &p, &f](io: &!i Io, retry: &r [byte], hint_given: bool, hint: &h [byte], patch: &p [byte], pfile: &f [byte]) -> [err_write] bool {
    if len(retry) > 0 && len(patch) > 0 {
        io.error_all(io, "project: --retry and --patch cannot be used together\n");
        return false;
    }
    if hint_given && len(hint) == 0 {
        io.error_all(io, "project: the --hint is empty\n");
        return false;
    }
    if hint_given && len(retry) == 0 {
        io.error_all(io, "project: --hint goes with --retry\n");
        return false;
    }
    if len(hint) > hint_cap() {
        io.error_all(io, "project: the --hint is longer than 4000 bytes\n");
        return false;
    }
    if len(patch) > 0 && len(pfile) == 0 {
        io.error_all(io, "project: --patch needs a unit and a file\n");
        return false;
    }
    if bytes.find(pfile, "..") >= 0 {
        io.error_all(io, "project: a path may not contain '..'\n");
        return false;
    }
    return true;
}

// The file `path` read whole (at most `cap` bytes), and whether it could be read.
fn slurp_all[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read("")] (buffer.Buffer, bool) {
    let store = box_slice(heap, cap, byte_of(0));
    var out = buffer.empty(heap, 16);
    var ok = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= 0 && n < cap {
            ok = true;
            out = buffer.append(heap, out, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    return (out, ok);
}

// The index of the unit named `id` in the plan `src`, or -1.
fn unit_index[&h, &s, &x](heap: &!h Heap, src: &s [byte], id: &x [byte]) -> [heap] int {
    var found = 0 - 1;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        let units = json.get(src, tape, 0, "units");
        var j = units + 1;
        var left = json.count(tape, units);
        var k = 0;
        while left > 0 {
            if bytes.equal(json.string_view(src, tape, json.get(src, tape, j, "id")), id) {
                found = k;
            }
            j = json.skip(tape, j);
            left = left - 1;
            k = k + 1;
        }
    }
    unbox_slice(heap, tb);
    return found;
}

// Whether the re-opening asked for (`retry` or `patch`, a unit id; `pfile` the patch's file) fits the plan `src`: the unit is in it, and the patch file
// can be read and holds something. 0 yes; 2 (a usage error: the reason is on the error stream, nothing has been changed) no.
pub fn redo_check[&h, &i, &z, &s, &r, &p, &f](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), src: &s [byte], retry: &r [byte], patch: &p [byte], pfile: &f [byte]) -> [heap, err_write, fs_read("")] int {
    if len(retry) > 0 {
        if unit_index(heap, src, retry) < 0 {
            io.error_all(io, "project: --retry names a unit the plan does not have: ");
            io.error_all(io, retry);
            io.error_all(io, "\n");
            return 2;
        }
    }
    if len(patch) > 0 {
        if unit_index(heap, src, patch) < 0 {
            io.error_all(io, "project: --patch names a unit the plan does not have: ");
            io.error_all(io, patch);
            io.error_all(io, "\n");
            return 2;
        }
        let (text, ok) = slurp_all(heap, fs, pfile, 1048576);
        var empty = true;
        borrow text as &tq in {
            empty = len(bytes.trim(buffer.bytes(tq))) == 0;
        }
        buffer.drop(heap, text);
        if ok == false || empty {
            io.error_all(io, "project: the --patch file cannot be read, or is empty: ");
            io.error_all(io, pfile);
            io.error_all(io, "\n");
            return 2;
        }
    }
    return 0;
}

// Does unit `v` depend, directly, on a unit marked in `reach`?
fn dep_reached[&s, &t, &n, &r](src: &s [byte], tape: &t [int], nodes: &n [int], reach: &r [int], count: int, v: int) -> [] bool {
    let arr = json.get(src, tape, nodes[v], "deps");
    var j = arr + 1;
    var left = json.count(tape, arr);
    while left > 0 {
        let d = find_unit(src, tape, nodes, count, json.string_view(src, tape, j));
        if d >= 0 && reach[d] == 1 {
            return true;
        }
        j = json.skip(tape, j);
        left = left - 1;
    }
    return false;
}

// The unit's trail is continued, not restarted, when the person re-opens it: its earlier records are put back as the loop's trail file (the loop adds
// to it) and their number is the offset of the new attempts' numbers (the journal's blobs are named by them, and the earlier attempts' stay).
// Answers the number of earlier records; 0 when the unit has no trail yet (the loop starts a fresh one).
fn seed_trail[&h, &z, &d, &w](heap: &!h Heap, fs: &z Fs(""), wd: &w [byte], id: &d [byte]) -> [heap, fs_read(""), fs_write("")] int {
    let from = in_wd(heap, wd, "trail-", id, ".jsonl");
    let into = in_wd(heap, wd, "project.cho.trail.jsonl", "", "");
    var n = 0;
    borrow from as &fb in {
        borrow into as &ib in {
            n = trail.attempts_so_far(fs, buffer.bytes(fb));
            if n > 0 {
                if snapshot.copy(fs, buffer.bytes(fb), buffer.bytes(ib), 65536) < 0 {
                    n = 0;
                }
            }
        }
    }
    buffer.drop(heap, from);
    buffer.drop(heap, into);
    return n;
}

// What the person's patch was refused for, from the attempt's journal blobs (the acceptance output when the examples ran, else the checker's whole
// answer), at most 4096 bytes, on the console and in the log.
fn show_refusal[&h, &i, &z, &l, &w, &d](heap: &!h Heap, io: &!i Io, fs: &z Fs(""), log: &l [byte], wd: &w [byte], id: &d [byte], n: int) -> [heap, io_write, fs_read(""), fs_write("")] int {
    let jd = trail.journal_dir(heap, wd);
    var shown = false;
    var what = 0;
    while what < 2 && shown == false {
        var tail = "acceptance.txt";
        if what == 1 {
            tail = "checker.json";
        }
        let nm = trail.attempt_name(heap, id, n, tail);
        var bp = buffer.empty(heap, 16);
        borrow jd as &jq in {
            borrow nm as &nq in {
                buffer.drop(heap, bp);
                bp = trail.blob_path(heap, buffer.bytes(jq), buffer.bytes(nq));
            }
        }
        borrow bp as &bq in {
            let (text, ok) = slurp_all(heap, fs, buffer.bytes(bq), 262145);
            borrow text as &tq in {
                let all = buffer.bytes(tq);
                if ok && len(all) > 0 {
                    var cut = len(all);
                    if cut > 4096 {
                        cut = 4096;
                    }
                    tell(heap, io, fs, log, all[0..cut]);
                    if int_of(all[cut - 1]) != 10 {
                        tell(heap, io, fs, log, "\n");
                    }
                    shown = true;
                }
            }
            buffer.drop(heap, text);
        }
        buffer.drop(heap, bp);
        buffer.drop(heap, nm);
        what = what + 1;
    }
    buffer.drop(heap, jd);
    return 0;
}

// A patch that could not even be put into the file (it holds no item, or the splice refused it) is still an attempt: the trail's record and the
// journal's `attempt` event (outcome `human_patch`, decision `ceiling`: the person's one try), with the patch as the code and the splice's report.
fn splice_refused[&h, &c, &z, &w, &d, &p, &r](heap: &!h Heap, clock: &c Clock, fs: &z Fs(""), wd: &w [byte], id: &d [byte], base: int, patch: &p [byte], report: &r [byte]) -> [heap, clock, fs_read(""), fs_write("")] int {
    let tp = in_wd(heap, wd, "project.cho.trail.jsonl", "", "");
    borrow tp as &tq in {
        if base == 0 {
            trail.begin(fs, buffer.bytes(tq));
        }
        trail.record(heap, fs, buffer.bytes(tq), base, 0, "refused", "splice", "ceiling", 65536);
    }
    buffer.drop(heap, tp);
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        var w = trail.begin_event(heap, clock_unix_ms(clock), "attempt");
        w = trail.put_str(heap, w, "unit", id);
        w = trail.put_num(heap, w, "n", base);
        w = trail.put_str(heap, w, "outcome", "human_patch");
        w = trail.put_str(heap, w, "decision", "ceiling");
        w = trail.put_str(heap, w, "signature", "splice");
        w = trail.put_num(heap, w, "ms", 0);
        let cn = trail.attempt_name(heap, id, base, "code.cho");
        borrow cn as &cq in {
            if trail.blob_put(heap, fs, buffer.bytes(jq), buffer.bytes(cq), patch) == 0 {
                w = trail.put_str(heap, w, "code", buffer.bytes(cq));
            }
        }
        buffer.drop(heap, cn);
        let fnm = trail.attempt_name(heap, id, base, "feedback.txt");
        borrow fnm as &fq in {
            if trail.blob_put(heap, fs, buffer.bytes(jq), buffer.bytes(fq), report) == 0 {
                w = trail.put_str(heap, w, "feedback", buffer.bytes(fq));
            }
        }
        buffer.drop(heap, fnm);
        trail.end_event(heap, fs, buffer.bytes(jq), w);
    }
    buffer.drop(heap, jd);
    return 0;
}

// Apply the person's patch to unit `u` (the `--patch` of docs/build.md): the code in `pfile` is spliced into project.cho exactly as a model's patch
// reply would be (src/splice.cho), then the loop verifies it with the same checker and the unit's own tests or acceptance, ONE attempt, and with
// no model: its "agent" is `cp` of the spliced file over project.cho. The attempt is recorded like any other (trail, journal outcome
// `human_patch`). A patch that does not verify leaves project.cho as it was. 0 verified, 1 refused, 2 the checker is away.
fn apply_patch[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &l, &ac, &lb, &pf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &n [int], meta: &!m [int], notes: &o [byte], u: int, checker: &k [byte], wd: &w [byte], agent_ms: int, log: &l [byte], integ: int, accept: &ac [byte], libs: &lb [byte], pfile: &pf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let id = uid(src, tape, nodes, u);
    var line = buffer.append(heap, buffer.empty(heap, 64), "[PATCH]\t");
    line = buffer.append(heap, line, id);
    line = buffer.append(heap, line, "\tapplying\n");
    borrow line as &lnb in {
        tell(heap, io, fs, log, buffer.bytes(lnb));
    }
    buffer.drop(heap, line);
    keep_copy(heap, fs, wd, "project.cho.before", false);
    unit_event(heap, clock, fs, wd, src, tape, nodes[u], id, "", false, "patch");
    let base = seed_trail(heap, fs, wd, id);
    // splice: the patch as a model's reply would be read (fences and all), then put into the file
    let pp = in_wd(heap, wd, "project.cho", "", "");
    var cur = buffer.empty(heap, 16);
    var cur_ok = false;
    borrow pp as &ppq in {
        let (c2, ok2) = slurp_all(heap, fs, buffer.bytes(ppq), 1048576);
        buffer.drop(heap, cur);
        cur = c2;
        cur_ok = ok2;
    }
    buffer.drop(heap, pp);
    let (pat, pat_ok) = slurp_all(heap, fs, pfile, 1048576);
    var code = 1;
    var report = buffer.empty(heap, 16);
    var newfile = buffer.empty(heap, 16);
    var shown = buffer.empty(heap, 16);
    borrow cur as &cq in {
        borrow pat as &pq in {
            shown = buffer.append(heap, shown, buffer.bytes(pq));
            let (pa, pz) = splice.patch_span(buffer.bytes(pq));
            if pa >= 0 && cur_ok && pat_ok {
                let (nf, sr, sc) = splice.splice(heap, buffer.bytes(cq), buffer.bytes(pq)[pa..pz]);
                buffer.drop(heap, newfile);
                buffer.drop(heap, report);
                newfile = nf;
                report = sr;
                code = sc;
            } else {
                buffer.drop(heap, report);
                report = buffer.append(heap, buffer.empty(heap, 96), "[SPLICE_ERROR]\t-\t0:the patch file holds no cancho item\n");
            }
        }
    }
    buffer.drop(heap, cur);
    buffer.drop(heap, pat);
    var result = 1;
    if code == 0 {
        let pf2 = in_wd(heap, wd, "project.cho.patched", "", "");
        borrow pf2 as &pfq in {
            put(heap, fs, buffer.bytes(pfq), newfile);
        }
        buffer.drop(heap, pf2);
        // the agent of this attempt is a copy, not a model
        var cp = buffer.append(heap, buffer.empty(heap, 256), "cp ");
        cp = buffer.append(heap, cp, wd);
        cp = buffer.append(heap, cp, "/project.cho.patched");
        borrow cp as &cpq in {
            result = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, u, checker, wd, buffer.bytes(cpq), 1, agent_ms, log, integ, accept, libs, base, "", true);
        }
        buffer.drop(heap, cp);
        keep_trail(heap, fs, id, wd);
    } else {
        buffer.drop(heap, newfile);
        borrow report as &rq in {
            tell(heap, io, fs, log, buffer.bytes(rq));
        }
        borrow report as &rq2 in {
            borrow shown as &shq in {
                splice_refused(heap, clock, fs, wd, id, base, buffer.bytes(shq), buffer.bytes(rq2));
            }
        }
        keep_trail(heap, fs, id, wd);
    }
    buffer.drop(heap, report);
    buffer.drop(heap, shown);
    var word = "refused";
    if result == 0 {
        word = "verified";
    } else if result == 2 {
        word = "unavailable";
    }
    if result != 0 {
        // the unit stays as it was: the project file goes back
        keep_copy(heap, fs, wd, "project.cho.before", true);
        if code == 0 {
            show_refusal(heap, io, fs, log, wd, id, base);
        }
    }
    var end = buffer.append(heap, buffer.empty(heap, 64), "[PATCH]\t");
    end = buffer.append(heap, end, id);
    end = buffer.append(heap, end, "\t");
    end = buffer.append(heap, end, word);
    end = buffer.append(heap, end, "\n");
    borrow end as &enb in {
        tell(heap, io, fs, log, buffer.bytes(enb));
    }
    buffer.drop(heap, end);
    if result == 0 {
        unit_event(heap, clock, fs, wd, src, tape, nodes[u], id, "verified", true, "");
    } else if meta[3 * u] == 1 {
        unit_event(heap, clock, fs, wd, src, tape, nodes[u], id, "verified", true, "");
    } else if result == 1 {
        unit_event(heap, clock, fs, wd, src, tape, nodes[u], id, "stuck", true, "");
    } else {
        unit_event(heap, clock, fs, wd, src, tape, nodes[u], id, "unavailable", true, "");
    }
    return result;
}

// ---- the loop -------------------------------------------------------------

fn drive[&h, &x, &c, &i, &z, &s, &t, &n, &m, &o, &k, &w, &a, &l, &ac, &lb, &rc, &rt, &ht, &pt, &pf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], tape: &t [int], nodes: &!n [int], meta: &!m [int], notes: &!o [byte], reach: &!rc [int], count: int, checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write] int {
    let units = json.get(src, tape, 0, "units");
    var j = units + 1;
    var u = 0;
    while u < count {
        nodes[u] = j;
        j = json.skip(tape, j);
        u = u + 1;
    }
    // The integration unit (docs/plan.md): the application of a service, judged by the service's acceptance command instead of tests.
    var integ = 0 - 1;
    let inode = json.get(src, tape, 0, "integration");
    if inode >= 0 && json.is_string(tape, inode) {
        integ = find_unit(src, tape, nodes, count, json.string_view(src, tape, inode));
    }
    if integ >= 0 && len(accept) == 0 {
        tell(heap, io, fs, log, "project: the plan names an integration unit and no acceptance command was given\n");
        return 2;
    }
    u = 0;
    while u < count {
        if u != integ {
            write_tests(heap, fs, src, tape, nodes[u], wd);
        }
        u = u + 1;
    }
    state_read(heap, fs, src, tape, nodes, meta, count, wd);
    // A unit the person re-opens (docs/build.md): `--retry` puts it back to not verified, `--patch` leaves it as it is until the patch has verified.
    // Only it, and the units that depend on it (directly or not), are worked on in this run; every other unit that is not verified stays untouched
    // (state 3: it is neither built nor said to have failed).
    var redo = 0 - 1;
    var patching = false;
    if len(patch) > 0 {
        redo = find_unit(src, tape, nodes, count, patch);
        patching = true;
    } else if len(retry) > 0 {
        redo = find_unit(src, tape, nodes, count, retry);
    }
    if redo >= 0 {
        if patching == false {
            if meta[3 * redo] == 1 {
                meta[3 * redo] = 0;
                state_write(heap, fs, src, tape, nodes, meta, count, wd);
            }
            var rl = buffer.append(heap, buffer.empty(heap, 64), "[RETRY]\t");
            rl = buffer.append(heap, rl, uid(src, tape, nodes, redo));
            if len(hint) > 0 {
                rl = buffer.append(heap, rl, "\thint");
            }
            rl = buffer.append(heap, rl, "\n");
            borrow rl as &rlb in {
                tell(heap, io, fs, log, buffer.bytes(rlb));
            }
            buffer.drop(heap, rl);
        }
        reach[redo] = 1;
        var grew = true;
        while grew {
            grew = false;
            var v = 0;
            while v < count {
                if reach[v] == 0 && dep_reached(src, tape, nodes, reach, count, v) {
                    reach[v] = 1;
                    grew = true;
                }
                v = v + 1;
            }
        }
        var mv = 0;
        while mv < count {
            if reach[mv] == 0 && meta[3 * mv] != 1 {
                meta[3 * mv] = 3;
            }
            mv = mv + 1;
        }
    }
    // Re-verify what the state says is verified.
    recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, -1, "an earlier edit", true, checker, wd, log, integ, accept, libs);
    var provider = false;
    var going = true;
    var refused_patch = false;
    if patching {
        let pr = apply_patch(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, redo, checker, wd, agent_ms, log, integ, accept, libs, pfile);
        if pr == 0 {
            meta[3 * redo] = 1;
            state_write(heap, fs, src, tape, nodes, meta, count, wd);
            say(heap, io, fs, log, uid(src, tape, nodes, redo), "verified");
            recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, redo, uid(src, tape, nodes, redo), false, checker, wd, log, integ, accept, libs);
        } else if pr == 1 {
            // refused: nothing else is built; the run ends stuck
            refused_patch = true;
            going = false;
            meta[3 * redo] = 2;
        } else {
            provider = true;
            going = false;
        }
    }
    while going {
        let next = next_unit(src, tape, nodes, meta, count);
        if next < 0 {
            going = false;
        } else {
            let id = uid(src, tape, nodes, next);
            if meta[3 * next + 1] >= 3 * count {
                // The guard against two units breaking each other for ever.
                meta[3 * next] = 2;
                say(heap, io, fs, log, id, "failed");
            } else {
                // A unit that fails leaves its attempts in project.cho; the file goes back to what it was, so the units
                // that do not depend on it still build.
                keep_copy(heap, fs, wd, "project.cho.before", false);
                var how = "";
                var base = 0;
                if next == redo && patching == false {
                    how = "retry";
                    base = seed_trail(heap, fs, wd, id);
                }
                unit_event(heap, clock, fs, wd, src, tape, nodes[next], id, "", false, how);
                var r = 1;
                if next == redo && patching == false {
                    r = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, next, checker, wd, agent, attempts, agent_ms, log, integ, accept, libs, base, hint, false);
                } else {
                    r = build(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, next, checker, wd, agent, attempts, agent_ms, log, integ, accept, libs, 0, "", false);
                }
                // The unit's trail is kept whatever the outcome: a unit that failed is the one whose trail is wanted.
                keep_trail(heap, fs, id, wd);
                keep_agent_log(heap, fs, id, wd);
                if r != 0 {
                    // where the agent's own words are, for a unit that did not verify (a provider error has its cause there)
                    var al = buffer.append(heap, buffer.empty(heap, 64), "[AGENT_LOG]\t");
                    al = buffer.append(heap, al, id);
                    al = buffer.append(heap, al, "\tagent-");
                    al = buffer.append(heap, al, id);
                    al = buffer.append(heap, al, ".log\n");
                    borrow al as &alb in {
                        tell(heap, io, fs, log, buffer.bytes(alb));
                    }
                    buffer.drop(heap, al);
                }
                if r == 0 {
                    unit_event(heap, clock, fs, wd, src, tape, nodes[next], id, "verified", true, "");
                } else if r == 1 {
                    unit_event(heap, clock, fs, wd, src, tape, nodes[next], id, "stuck", true, "");
                } else {
                    unit_event(heap, clock, fs, wd, src, tape, nodes[next], id, "unavailable", true, "");
                }
                if r == 0 {
                    meta[3 * next] = 1;
                    state_write(heap, fs, src, tape, nodes, meta, count, wd);
                    say(heap, io, fs, log, id, "verified");
                    recheck(heap, exec, clock, io, fs, src, tape, nodes, meta, notes, count, next, id, false, checker, wd, log, integ, accept, libs);
                } else if r == 1 {
                    keep_copy(heap, fs, wd, "project.cho.before", true);
                    meta[3 * next] = 2;
                    say(heap, io, fs, log, id, "failed");
                } else {
                    say(heap, io, fs, log, id, "unavailable");
                    provider = true;
                    going = false;
                }
            }
        }
    }
    if provider {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tprovider_error\n");
        return 4;
    }
    var stuck = refused_patch;
    u = 0;
    while u < count {
        if meta[3 * u] == 2 || meta[3 * u] == 3 {
            stuck = true;
        } else if meta[3 * u] == 0 {
            stuck = true;
            if refused_patch == false {
                say(heap, io, fs, log, uid(src, tape, nodes, u), "skipped");
            }
        }
        u = u + 1;
    }
    if stuck {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tstuck\n");
        return 1;
    }
    if final_gate(heap, exec, clock, src, tape, nodes, count, checker, wd, integ, accept, libs) {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tdone\n");
        return 0;
    }
    tell(heap, io, fs, log, "[PROJECT_VERDICT]\tgate_failed\n");
    return 5;
}

// Build the plan in `src` in `wd`, saying every line on the console and, when `log` names a file, appending it there too (the build
// command's run.log). The exit code of docs/project.md, except that a final gate that fails is 5 (it is 1 in `run`, the same exit as stuck):
// 0 done, 1 stuck, 2 the work directory cannot be written (or the re-opening asked for does not fit the plan: nothing changed), 3 no plan,
// 4 the agent or the checker is away, 5 gate_failed.
//
// `retry` (a unit id; empty: none) re-opens that unit, with `hint` (the person's words; empty: none) in its task; `patch` (a unit id) applies
// the code in the file `pfile` to that unit instead of asking the agent (docs/build.md). Both empty is a plain run.
pub fn run_logged[&h, &x, &c, &i, &z, &s, &k, &w, &a, &l, &ac, &lb, &rt, &ht, &pt, &pf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, log: &l [byte], accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, err_write] int {
    let (out, code) = plan.check(heap, src);
    borrow out as &o in {
        tell(heap, io, fs, log, buffer.bytes(o));
    }
    buffer.drop(heap, out);
    if code != 0 {
        tell(heap, io, fs, log, "[PROJECT_VERDICT]\tno_plan\n");
        return 3;
    }
    if redo_check(heap, io, fs, src, retry, patch, pfile) != 0 {
        return 2;
    }
    if write_fixed(heap, fs, wd) < 0 {
        io.error_all(io, "project: the work directory cannot be written\n");
        return 2;
    }
    let jd0 = trail.journal_dir(heap, wd);
    borrow jd0 as &jq0 in {
        trail.journal_dirs(heap, exec, clock, buffer.bytes(jq0));
    }
    buffer.drop(heap, jd0);
    var status = 1;
    let tb = box_slice(heap, json.tape_len(src), 0);
    borrow mut tb as &!tw in {
        let tape = contents(tw);
        json.parse(src, tape);
        let count = json.count(tape, json.get(src, tape, 0, "units"));
        let nb = box_slice(heap, count + 1, 0);
        let mb = box_slice(heap, 3 * count + 3, 0);
        let rb = box_slice(heap, count + 1, 0);
        let sb = box_slice(heap, (count + 1) * note_cap(), byte_of(0));
        borrow mut nb as &!nw in {
            borrow mut mb as &!mw in {
                borrow mut rb as &!rw in {
                    borrow mut sb as &!sw in {
                        status = drive(heap, exec, clock, io, fs, src, tape, contents(nw), contents(mw), contents(sw), contents(rw), count, checker, wd, agent, attempts, agent_ms, log, accept, libs, retry, hint, patch, pfile);
                    }
                }
            }
        }
        unbox_slice(heap, sb);
        unbox_slice(heap, rb);
        unbox_slice(heap, mb);
        unbox_slice(heap, nb);
    }
    unbox_slice(heap, tb);
    return status;
}

// Build the plan in `src` in `wd` (the exit code of docs/project.md: 0 done, 1 stuck or gate failed, 2 the work directory cannot be
// written, 3 no plan, 4 the agent or the checker is away). `retry`, `hint`, `patch`, `pfile`: as in `run_logged`.
pub fn run[&h, &x, &c, &i, &z, &s, &k, &w, &a, &ac, &lb, &rt, &ht, &pt, &pf](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, io: &!i Io, fs: &z Fs(""), src: &s [byte], checker: &k [byte], wd: &w [byte], agent: &a [byte], attempts: int, agent_ms: int, accept: &ac [byte], libs: &lb [byte], retry: &rt [byte], hint: &ht [byte], patch: &pt [byte], pfile: &pf [byte]) -> [heap, exec(""), clock, poll, fs_read(""), fs_write(""), io_write, err_write] int {
    let started = clock_unix_ms(clock);
    // A re-opening that does not fit the plan is a usage error before anything is written, the journal included.
    if len(retry) > 0 || len(patch) > 0 {
        let (pout, pcode) = plan.check(heap, src);
        buffer.drop(heap, pout);
        if pcode == 0 && redo_check(heap, io, fs, src, retry, patch, pfile) != 0 {
            return 2;
        }
    }
    let jd = trail.journal_dir(heap, wd);
    borrow jd as &jq in {
        trail.journal_dirs(heap, exec, clock, buffer.bytes(jq));
        trail.run_start(heap, clock, fs, buffer.bytes(jq), "", "", "", false, 0, attempts, agent_ms, 0);
    }
    let status = run_logged(heap, exec, clock, io, fs, src, checker, wd, agent, attempts, agent_ms, "", accept, libs, retry, hint, patch, pfile);
    var code = status;
    if status == 5 {
        code = 1;
    }
    var word = "stuck";
    if status == 0 {
        word = "done";
    } else if status == 2 {
        word = "usage";
    } else if status == 3 {
        word = "no_plan";
    } else if status == 4 {
        word = "provider_error";
    } else if status == 5 {
        word = "gate_failed";
    }
    borrow jd as &jq2 in {
        let now = clock_unix_ms(clock);
        trail.run_end(heap, now, fs, buffer.bytes(jq2), word, code, (now - started) / 1000);
    }
    buffer.drop(heap, jd);
    return code;
}
