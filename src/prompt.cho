edition 7;

module prompt;

// `prompt` — what the model is asked, built from three texts the driver left
// beside the project file (docs/project.md): the project itself, its task
// (`<file>.task`, empty when the file is only being fixed) and the checker's
// current refusals (`<file>.feedback`, the JSON the checker prints, or
// whatever text it left). Pure: the caller reads the files.
//
// `scripts/agent_lib.py`'s `build_prompt` is what this replaces, and the
// gate (scripts/test-prompt.sh) holds the two to the same bytes.

import std.buffer;
import std.bytes;
import std.json;

fn is_space(c: int) -> [] bool {
    return c == 32 || (c >= 9 && c <= 13);
}

// `text` without the whitespace at either end.
fn trimmed[&t](text: &t [byte]) -> [] &t [byte] {
    var a = 0;
    var b = len(text);
    while a < b && is_space(int_of(text[a])) {
        a = a + 1;
    }
    while b > a && is_space(int_of(text[b - 1])) {
        b = b - 1;
    }
    return text[a..b];
}

fn append_int[&h](heap: &!h Heap, out: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    var o = out;
    var scale = 1;
    while n / scale >= 10 {
        scale = scale * 10;
    }
    var rest = n;
    while scale >= 1 {
        let d = rest / scale;
        o = buffer.push(heap, o, byte_of(48 + d));
        rest = rest - d * scale;
        scale = scale / 10;
    }
    return o;
}

// The first `most` bytes of `text`, not cutting a UTF-8 character in two.
fn head[&t](text: &t [byte], most: int) -> [] &t [byte] {
    if len(text) <= most {
        return text;
    }
    var n = most;
    while n > 0 && int_of(text[n]) >= 128 && int_of(text[n]) < 192 {
        n = n - 1;
    }
    return text[0..n];
}

fn append_string[&h, &b, &t](heap: &!h Heap, out: buffer.Buffer, body: &b [byte], tape: &t [int], n: int) -> [heap] buffer.Buffer {
    let piece = box_slice(heap, json.string_length(body, tape, n) + 1, byte_of(0));
    var o = out;
    borrow mut piece as &!pw in {
        let got = json.string_into(body, tape, n, contents(pw));
        o = buffer.append(heap, o, contents(pw)[0..got]);
    }
    unbox_slice(heap, piece);
    return o;
}

// The line `line` (1-based) of `source`, as offsets, or (-1, -1).
fn source_line[&s](source: &s [byte], line: int) -> [] (int, int) {
    var start = 0;
    var n = 1;
    var i = 0;
    while n < line && i < len(source) {
        if int_of(source[i]) == 10 {
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if n < line || line < 1 {
        return (0 - 1, 0 - 1);
    }
    var end = start;
    while end < len(source) && int_of(source[end]) != 10 {
        end = end + 1;
    }
    return (start, end);
}

// One line per refusal (at most eight), each with the source line and a caret
// under the column: "line 9, column 39" is hard to find by counting. When the
// feedback is not the checker's JSON, its first 1,500 bytes as they are.
pub fn feedback_text[&h, &s, &f](heap: &!h Heap, source: &s [byte], feedback: &f [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 512);
    var valid = true;
    let tape_box = box_slice(heap, json.tape_len(feedback), 0);
    borrow mut tape_box as &!tw in {
        let tape = contents(tw);
        let nodes = json.parse(feedback, tape);
        if nodes < 0 || json.is_object(tape, 0) == false {
            valid = false;
        } else {
            let refused = json.get(feedback, tape, 0, "refused");
            if refused >= 0 && json.is_array(tape, refused) {
                var n = 0;
                while n < json.count(tape, refused) && n < 8 && valid {
                    let r = json.at(tape, refused, n);
                    let pos = json.get(feedback, tape, r, "position");
                    let line = json.get(feedback, tape, pos, "line");
                    let col = json.get(feedback, tape, pos, "column");
                    let msg = json.get(feedback, tape, r, "message");
                    let rule = json.get(feedback, tape, r, "rule");
                    if pos < 0 || line < 0 || col < 0 || msg < 0 || rule < 0 || json.is_int(tape, line) == false || json.is_int(tape, col) == false || json.is_string(tape, msg) == false || json.is_string(tape, rule) == false {
                        valid = false;
                    } else {
                        let l = json.to_int(feedback, tape, line);
                        let c = json.to_int(feedback, tape, col);
                        out = buffer.append(heap, out, "- line ");
                        out = append_int(heap, out, l);
                        out = buffer.append(heap, out, ", column ");
                        out = append_int(heap, out, c);
                        out = buffer.append(heap, out, ": ");
                        out = append_string(heap, out, feedback, tape, msg);
                        out = buffer.append(heap, out, " (rule ");
                        out = append_string(heap, out, feedback, tape, rule);
                        out = buffer.append(heap, out, ")\n");
                        let (a, b) = source_line(source, l);
                        if a >= 0 {
                            out = buffer.append(heap, out, "    ");
                            out = buffer.append(heap, out, source[a..b]);
                            out = buffer.append(heap, out, "\n    ");
                            var k = 1;
                            while k < c {
                                out = buffer.push(heap, out, byte_of(32));
                                k = k + 1;
                            }
                            out = buffer.append(heap, out, "^\n");
                        }
                    }
                    n = n + 1;
                }
            }
        }
    }
    unbox_slice(heap, tape_box);
    if valid == false {
        buffer.drop(heap, out);
        out = buffer.empty(heap, 512);
        out = buffer.append(heap, out, head(feedback, 1500));
    }
    return out;
}

// The task without its lines that start with `prefix`, and those lines' text after the prefix, one per line. The `HINT: ` lines are a person's words
// about the unit, written by the project driver when a unit is re-opened with `--retry <unit> --hint "..."` (docs/build.md); the `MEMORY: ` and `FACT: `
// lines, each after a NUL byte, are what the agent's memory adds in its own copy of the task (docs/memory.md). A task with no such line comes back as it was, byte for byte.
fn split_prefix[&h, &t, &x](heap: &!h Heap, task: &t [byte], prefix: &x [byte]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var rest = buffer.empty(heap, len(task) + 8);
    var hint = buffer.empty(heap, 64);
    var have = false;
    var i = 0;
    while i < len(task) {
        var e = i;
        while e < len(task) && int_of(task[e]) != 10 {
            e = e + 1;
        }
        let line = task[i..e];
        if len(line) >= len(prefix) && bytes.starts_with(line, prefix) {
            if have {
                hint = buffer.push(heap, hint, byte_of(10));
            }
            have = true;
            hint = buffer.append(heap, hint, line[len(prefix)..len(line)]);
        } else {
            rest = buffer.append(heap, rest, line);
            if e < len(task) {
                rest = buffer.push(heap, rest, byte_of(10));
            }
        }
        i = e + 1;
    }
    return (rest, hint);
}

fn split_hint[&h, &t](heap: &!h Heap, task: &t [byte]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    return split_prefix(heap, task, "HINT: ");
}

// `text`'s lines, each after `lead`.
fn lead_lines[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte], lead: &static [byte]) -> [heap] buffer.Buffer {
    var o = out;
    var i = 0;
    while i < len(text) {
        var e = i;
        while e < len(text) && int_of(text[e]) != 10 {
            e = e + 1;
        }
        o = buffer.append(heap, o, lead);
        o = buffer.append(heap, o, text[i..e]);
        o = buffer.push(heap, o, byte_of(10));
        i = e + 1;
    }
    return o;
}

// The prompt: the task (or the instruction to fix), the checker's current
// output, then the file between rules.
fn compose[&h, &s, &k, &f](heap: &!h Heap, source: &s [byte], task: &k [byte], feedback: &f [byte], mode: int) -> [heap] buffer.Buffer {
    let patch = mode == 1;
    let change = mode == 2;
    var p = buffer.empty(heap, 4096);
    let (rest0, memo) = split_prefix(heap, task, "\0MEMORY: ");
    var rest1 = buffer.empty(heap, 8);
    var facts = buffer.empty(heap, 8);
    borrow rest0 as &r0 in {
        buffer.drop(heap, rest1);
        buffer.drop(heap, facts);
        let (a, b) = split_prefix(heap, buffer.bytes(r0), "\0FACT: ");
        rest1 = a;
        facts = b;
    }
    buffer.drop(heap, rest0);
    var rest = buffer.empty(heap, 8);
    var hint = buffer.empty(heap, 8);
    borrow rest1 as &r1 in {
        buffer.drop(heap, rest);
        buffer.drop(heap, hint);
        let (a, b) = split_hint(heap, buffer.bytes(r1));
        rest = a;
        hint = b;
    }
    buffer.drop(heap, rest1);
    borrow rest as &rq in {
    borrow hint as &hq in {
        let job = trimmed(buffer.bytes(rq));
        let said = trimmed(buffer.bytes(hq));
        if len(job) > 0 {
            p = buffer.append(heap, p, "Your task, for the cancho program below:\n");
            p = buffer.append(heap, p, job);
            if len(said) > 0 {
                p = buffer.append(heap, p, "\n\nWhat the person who runs this build says about this unit (they have read the earlier attempts; take it into account, but the compiler and the tests still decide whether the code is right):\n");
                p = buffer.append(heap, p, said);
            }
            if change {
                p = buffer.append(heap, p, "\n\nThe files of the repository are below, each after a line `=== FILE <path>`. Reply with ONLY the change, in this form, for each file you change or add (only files under src/ or tests/ whose names end in .cho): a line `=== FILE <path>`, then for an existing file the complete new definition of each top-level item (function, struct, enum) to ADD or CHANGE (an item with the same name is replaced in place; do not repeat the items that stay), and one line `remove fn NAME` or `remove struct NAME` or `remove enum NAME` for each item to DELETE. To rename an item, remove the old name, add the new one and change every use of it in every file. A path that is not below is a new file: give it whole, starting with its `edition` line. A bug fix or a new feature must add or change a test function (`fn test_...`) in a file under tests/. No explanation and no markdown fences.\n");
            } else if patch {
                p = buffer.append(heap, p, "\n\nThe file below is kept as it is. Reply with ONLY the code to ADD or CHANGE: the function(s) this task asks for, and any helper functions or types it needs, as complete top-level items. Do not repeat the other items of the file; if you must change one, give its complete new definition. No `edition` line, no imports the file already has, no tests, no markdown fences, no explanation.\n");
            } else {
                p = buffer.append(heap, p, "\n\nReply with the complete file, with the task done, and nothing else: no markdown fences, no explanation.\n");
            }
        } else {
            if change {
                p = buffer.append(heap, p, "The change to the repository below is refused. Reply with the complete corrected change (`=== FILE <path>` sections as before) and nothing else.\n");
            } else if patch {
                p = buffer.append(heap, p, "The cancho program below is refused by its compiler. Reply with ONLY the complete corrected definition of each item that must change, as top-level items, and nothing else: not the items that are fine, no `edition` line, no markdown fences, no explanation.\n");
            } else {
                p = buffer.append(heap, p, "The cancho program below is refused by its compiler. Reply with the complete corrected file and nothing else: no markdown fences, no explanation.\n");
            }
        }
    }
    }
    buffer.drop(heap, rest);
    buffer.drop(heap, hint);
    let fb = feedback_text(heap, source, feedback);
    borrow fb as &fr in {
        if len(buffer.bytes(fr)) > 0 {
            p = buffer.append(heap, p, "The current output of the compiler and of the checks on the file:\n");
            p = buffer.append(heap, p, buffer.bytes(fr));
        }
    }
    buffer.drop(heap, fb);
    borrow memo as &mq in {
        if len(buffer.bytes(mq)) > 0 {
            p = buffer.append(heap, p, "Known pitfalls, found in the journals of earlier runs (they came back more than once; none is certain to apply to this unit, and the compiler and the tests still decide):\n");
            p = buffer.append(heap, p, buffer.bytes(mq));
            p = buffer.push(heap, p, byte_of(10));
        }
    }
    borrow facts as &fq in {
        if len(buffer.bytes(fq)) > 0 {
            p = buffer.append(heap, p, "What the person who runs this build says holds for every unit:\n");
            p = lead_lines(heap, p, buffer.bytes(fq), "- ");
        }
    }
    buffer.drop(heap, memo);
    buffer.drop(heap, facts);
    p = buffer.append(heap, p, "---\n");
    p = buffer.append(heap, p, source);
    p = buffer.append(heap, p, "---\n");
    return p;
}

// The prompt that asks for the complete file.
pub fn build[&h, &s, &k, &f](heap: &!h Heap, source: &s [byte], task: &k [byte], feedback: &f [byte]) -> [heap] buffer.Buffer {
    return compose(heap, source, task, feedback, 0);
}

// The prompt that asks for only the code to add or change: what the model re-emits is the unit, not the whole file (`splice` puts it in).
pub fn build_patch[&h, &s, &k, &f](heap: &!h Heap, source: &s [byte], task: &k [byte], feedback: &f [byte]) -> [heap] buffer.Buffer {
    return compose(heap, source, task, feedback, 1);
}

// The prompt of a change request for a repository: `source` is the bundle of its files (`=== FILE <path>` and the text), the answer an envelope.
pub fn build_change[&h, &s, &k, &f](heap: &!h Heap, source: &s [byte], task: &k [byte], feedback: &f [byte]) -> [heap] buffer.Buffer {
    return compose(heap, source, task, feedback, 2);
}
