edition 7;

module splice;

// The edit mode (docs/plan.md, "edit mode"). The measured waste of a project build is that for every unit the model re-emits the WHOLE
// project file. Here it returns only what the unit adds (a PATCH: the function and the helpers, types and imports it needs) and this module
// puts it into the file:
//
//   patch_span(reply)          where the patch is in a model's reply, or (-1, -1)
//   splice(existing, patch)    the new file, a report, and a code (0, or 1 with the file unchanged and `[SPLICE_ERROR]` lines)
//
// Both are pure. The rules (what an item is, its identity, where things go, the errors) are written once, in tests/reference/splice_ref.py,
// which scripts/test-splice.sh holds this module to, byte for byte; the gate also rebuilds every eval reference by splicing its items in.

import std.buffer;
import std.bytes;

// ---- bytes (reply.cho's) ----------------------------------------------------------

fn match_at[&s, &l](s: &s [byte], i: int, lit: &l [byte]) -> [] bool {
    if i < 0 || i + len(lit) > len(s) {
        return false;
    }
    var k = 0;
    var ok = true;
    while k < len(lit) {
        if int_of(s[i + k]) != int_of(lit[k]) {
            ok = false;
        }
        k = k + 1;
    }
    return ok;
}

// The first place in [from, to) where `lit` starts and ends inside it, or -1.
fn find_in[&s, &l](s: &s [byte], from: int, to: int, lit: &l [byte]) -> [] int {
    var i = from;
    var found = 0 - 1;
    while found < 0 && i + len(lit) <= to {
        if match_at(s, i, lit) {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

// The last such place in [from, to), or -1.
fn rfind_in[&s, &l](s: &s [byte], from: int, to: int, lit: &l [byte]) -> [] int {
    var i = to - len(lit);
    var found = 0 - 1;
    while found < 0 && i >= from {
        if match_at(s, i, lit) {
            found = i;
        }
        i = i - 1;
    }
    return found;
}

// Python's `str.isspace` on ASCII: space, \t \n \v \f \r.
fn is_space(c: int) -> [] bool {
    return c == 32 || c >= 9 && c <= 13;
}

fn blank[&s](s: &s [byte], lo: int, hi: int) -> [] bool {
    var i = lo;
    var all = true;
    while i < hi {
        if is_space(int_of(s[i])) == false {
            all = false;
        }
        i = i + 1;
    }
    return all;
}

// [A-Za-z0-9_+-]: what a fence's language tag is made of.
fn is_info(c: int) -> [] bool {
    return c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95 || c == 43 || c == 45;
}

// A fenced block that starts at or after `from`: (where its text starts, where
// it ends, where to look for the next one), or (-1, 0, 0). An opener is three
// backticks, a language tag, spaces or tabs, and a newline; the block ends at
// the next three backticks, wherever they are.
fn next_block[&s](s: &s [byte], lo: int, hi: int, from: int) -> [] (int, int, int) {
    var p = from;
    var result = (0 - 1, 0, 0);
    var searching = true;
    while searching {
        let i = find_in(s, p, hi, "```");
        if i < 0 {
            searching = false;
        } else {
            var j = i + 3;
            while j < hi && is_info(int_of(s[j])) {
                j = j + 1;
            }
            while j < hi && (int_of(s[j]) == 32 || int_of(s[j]) == 9) {
                j = j + 1;
            }
            if j < hi && int_of(s[j]) == 10 {
                let close = find_in(s, j + 1, hi, "```");
                if close >= 0 {
                    result = (j + 1, close, close + 3);
                    searching = false;
                } else {
                    p = i + 1;
                }
            } else {
                p = i + 1;
            }
        }
    }
    return result;
}

fn byte_at[&t](t: &t [byte], i: int) -> [] int {
    if i < 0 || i >= len(t) {
        return 0 - 1;
    }
    return int_of(t[i]);
}

fn is_ws(c: int) -> [] bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn is_ident(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
}

// ---- items ---------------------------------------------------------------------------

// An item keyword at `i`: (kind, length) with kind 0 edition, 1 import, 2 fn, 3 struct, 4 enum; -1 when there is none.
fn kw_info[&t](t: &t [byte], i: int) -> [] (int, int) {
    if match_at(t, i, "pub res struct ") {
        return (3, 15);
    }
    if match_at(t, i, "res struct ") {
        return (3, 11);
    }
    if match_at(t, i, "pub struct ") {
        return (3, 11);
    }
    if match_at(t, i, "struct ") {
        return (3, 7);
    }
    if match_at(t, i, "pub enum ") {
        return (4, 9);
    }
    if match_at(t, i, "enum ") {
        return (4, 5);
    }
    if match_at(t, i, "pub fn ") {
        return (2, 7);
    }
    if match_at(t, i, "fn ") {
        return (2, 3);
    }
    if match_at(t, i, "import ") {
        return (1, 7);
    }
    if match_at(t, i, "edition ") {
        return (0, 8);
    }
    if match_at(t, i, "module ") {
        return (0, 7);
    }
    return (0 - 1, 0);
}

// The end (exclusive) of the item whose header scan starts at `start`, or -1 when it never closes. The matcher skips string literals,
// char literals and `//` comments.
fn scan_body[&t](t: &t [byte], start: int, semi_ends: bool) -> [] int {
    let n = len(t);
    var i = start;
    var depth = 0;
    var opened = false;
    var result = 0 - 2;
    while i < n && result == 0 - 2 {
        let c = int_of(t[i]);
        if c == 47 && i + 1 < n && int_of(t[i + 1]) == 47 {
            while i < n && int_of(t[i]) != 10 {
                i = i + 1;
            }
        } else if c == 34 {
            i = i + 1;
            while i < n && int_of(t[i]) != 34 {
                if int_of(t[i]) == 92 {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
            if i >= n {
                result = 0 - 1;
            } else {
                i = i + 1;
            }
        } else if c == 39 {
            if i + 3 < n && int_of(t[i + 1]) == 92 && int_of(t[i + 3]) == 39 {
                i = i + 4;
            } else if i + 2 < n && int_of(t[i + 1]) != 92 && int_of(t[i + 1]) != 10 && int_of(t[i + 2]) == 39 {
                i = i + 3;
            } else {
                i = i + 1;
            }
        } else if c == 123 {
            depth = depth + 1;
            opened = true;
            i = i + 1;
        } else if c == 125 {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
            if opened && depth == 0 {
                result = i;
            }
        } else if c == 59 && !opened && depth == 0 {
            if semi_ends {
                result = i + 1;
            } else {
                result = 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    if result == 0 - 2 {
        return 0 - 1;
    }
    return result;
}

fn line_end[&t](t: &t [byte], from: int) -> [] int {
    var e = from;
    while e < len(t) && int_of(t[e]) != 10 {
        e = e + 1;
    }
    return e;
}

// Parse `t` into items. `tab` holds six ints per item (kind, start, end, name start, name end, keyword position) while there is room. The
// answer: (how many items, status, position, end of the last item): status 0 ok, 1 stray text at the position, 2 the item whose keyword is
// at the position never closes.
fn parse_items[&t, &x](t: &t [byte], tab: &!x [int]) -> [] (int, int, int, int) {
    let n = len(t);
    let cap = len(tab) / 6;
    var cnt = 0;
    var last = 0;
    var i = 0;
    var st = 0;
    var epos = 0;
    var done = false;
    while !done {
        while i < n && is_ws(int_of(t[i])) {
            i = i + 1;
        }
        if i >= n {
            done = true;
        } else {
            let start = i;
            var kwpos = i;
            var free = false;
            if match_at(t, i, "//") {
                var j = i;
                var scanning = true;
                while scanning {
                    let eol = line_end(t, j);
                    var k = j;
                    while k < eol && (int_of(t[k]) == 32 || int_of(t[k]) == 9) {
                        k = k + 1;
                    }
                    if k + 2 <= eol && match_at(t, k, "//") {
                        j = eol + 1;
                        if j >= n {
                            j = n;
                            scanning = false;
                        }
                    } else {
                        scanning = false;
                    }
                }
                var k = j;
                while k < n && (int_of(t[k]) == 32 || int_of(t[k]) == 9) {
                    k = k + 1;
                }
                let (kk, kl) = kw_info(t, k);
                if kk < 0 {
                    i = j;
                    free = true;
                } else {
                    kwpos = k;
                }
            }
            if !free {
                let (kind, klen) = kw_info(t, kwpos);
                if kind < 0 {
                    st = 1;
                    epos = i;
                    done = true;
                } else {
                    var q = kwpos + klen;
                    var end = 0 - 1;
                    var ns = q;
                    var ne = q;
                    var stray = false;
                    if kind <= 1 {
                        let semi = find_in(t, q, n, ";");
                        if semi >= 0 {
                            end = semi + 1;
                            if kind == 1 {
                                ns = q;
                                ne = semi;
                                while ns < ne && is_ws(int_of(t[ns])) {
                                    ns = ns + 1;
                                }
                                while ne > ns && is_ws(int_of(t[ne - 1])) {
                                    ne = ne - 1;
                                }
                            }
                        }
                    } else {
                        while q < n && int_of(t[q]) == 32 {
                            q = q + 1;
                        }
                        ns = q;
                        ne = q;
                        while ne < n && is_ident(int_of(t[ne])) {
                            ne = ne + 1;
                        }
                        var k = ne;
                        while k < n && (int_of(t[k]) == 32 || int_of(t[k]) == 9) {
                            k = k + 1;
                        }
                        let c = byte_at(t, k);
                        var fine = false;
                        if kind == 2 {
                            fine = c == 40 || c == 91;
                        } else {
                            fine = c == 123 || c == 59 || c == 91;
                        }
                        if ne == ns || !fine {
                            stray = true;
                        } else {
                            end = scan_body(t, ne, kind != 2);
                        }
                    }
                    if stray {
                        st = 1;
                        epos = i;
                        done = true;
                    } else if end < 0 {
                        st = 2;
                        epos = kwpos;
                        done = true;
                    } else {
                        if cnt < cap {
                            tab[6 * cnt] = kind;
                            tab[6 * cnt + 1] = start;
                            tab[6 * cnt + 2] = end;
                            tab[6 * cnt + 3] = ns;
                            tab[6 * cnt + 4] = ne;
                            tab[6 * cnt + 5] = kwpos;
                        }
                        cnt = cnt + 1;
                        last = end;
                        i = end;
                    }
                }
            }
        }
    }
    return (cnt, st, epos, last);
}

// ---- the patch in a reply -------------------------------------------------------------

fn starts_item_line[&s](s: &s [byte], i: int) -> [] bool {
    return match_at(s, i, "fn ") || match_at(s, i, "pub fn ") || match_at(s, i, "struct ") || match_at(s, i, "pub struct ") || match_at(s, i, "res struct ") || match_at(s, i, "pub res struct ") || match_at(s, i, "enum ") || match_at(s, i, "pub enum ") || match_at(s, i, "import ") || match_at(s, i, "//") || match_at(s, i, "edition ") || match_at(s, i, "module ");
}

fn segment_patch[&s](s: &s [byte], lo: int, hi: int) -> [] (int, int) {
    var a = lo;
    var b = hi;
    // the longest fenced block (the first of equal length)
    var best = 0 - 1;
    var best_a = 0;
    var best_b = 0;
    var from = lo;
    var scanning = true;
    while scanning {
        let (cs, ce, resume) = next_block(s, lo, hi, from);
        if cs < 0 {
            scanning = false;
        } else {
            if best < 0 || ce - cs > best {
                best = ce - cs;
                best_a = cs;
                best_b = ce;
            }
            from = resume;
        }
    }
    if best >= 0 {
        a = best_a;
        b = best_b;
    }
    // an unopened or unclosed fence left at either end
    var k = a;
    while k < b && is_space(int_of(s[k])) {
        k = k + 1;
    }
    if match_at(s, k, "```") && k + 3 <= b {
        var j = k + 3;
        while j < b && is_info(int_of(s[j])) {
            j = j + 1;
        }
        while j < b && (int_of(s[j]) == 32 || int_of(s[j]) == 9) {
            j = j + 1;
        }
        if j < b && int_of(s[j]) == 10 {
            a = j + 1;
        }
    }
    var e = b;
    while e > a && is_space(int_of(s[e - 1])) {
        e = e - 1;
    }
    if e - 3 >= a && match_at(s, e - 3, "```") {
        var q = e - 3;
        while q > a && (int_of(s[q - 1]) == 32 || int_of(s[q - 1]) == 9) {
            q = q - 1;
        }
        if q > a && int_of(s[q - 1]) == 10 {
            b = q - 1;
        }
    }
    // the first line that begins an item and from which an item parses
    var found = false;
    var rs = 0 - 1;
    var re = 0 - 1;
    region r {
        let tab = alloc_slice[r](60, 0);
        var i = a;
        while i < b && !found {
            var at_line = i == a || int_of(s[i - 1]) == 10;
            if at_line == false && i - 7 >= a && match_at(s, i - 7, "<think>") && (i - 7 == a || int_of(s[i - 8]) == 10) {
                at_line = true;
            }
            if at_line && starts_item_line(s, i) {
                let (cnt, st, epos, last) = parse_items(s[i..b], tab);
                if cnt > 0 || st == 2 {
                    found = true;
                    rs = i;
                    if st == 2 {
                        var end = b;
                        while end > i && int_of(s[end - 1]) == 10 {
                            end = end - 1;
                        }
                        re = end;
                    } else {
                        re = i + last;
                    }
                }
            }
            i = i + 1;
        }
    }
    return (rs, re);
}

// The patch in a model's answer: where it starts and ends in `answer`, or (-1, -1). Fences and `</think>` as `reply.program_span`; then from
// the first line that begins an item (or a `//` comment) to the end of the last item that closes (an item that never closes runs to the end).
pub fn patch_span[&s](answer: &s [byte]) -> [] (int, int) {
    var hi = len(answer);
    var result = (0 - 1, 0 - 1);
    var searching = true;
    while searching {
        let t = rfind_in(answer, 0, hi, "</think>");
        if t < 0 {
            result = segment_patch(answer, 0, hi);
            searching = false;
        } else {
            if blank(answer, t + 8, hi) == false {
                let (a, b) = segment_patch(answer, t + 8, hi);
                if a >= 0 {
                    result = (a, b);
                    searching = false;
                }
            }
            hi = t;
        }
    }
    return result;
}

// ---- splicing -------------------------------------------------------------------------

fn tag_of(kind: int) -> [] int {
    if kind >= 3 {
        return 3;
    }
    return kind;
}

fn line_of[&t](t: &t [byte], pos: int) -> [] int {
    var n = 1;
    var i = 0;
    while i < pos {
        if int_of(t[i]) == 10 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// Do item `a` of `ta` (in `x`) and item `b` of `tb` (in `y`) have one identity?
fn same_ident[&x, &y, &p, &q](x: &x [byte], ta: &p [int], a: int, y: &y [byte], tb: &q [int], b: int) -> [] bool {
    if tag_of(ta[6 * a]) != tag_of(tb[6 * b]) {
        return false;
    }
    return bytes.equal(x[ta[6 * a + 3]..ta[6 * a + 4]], y[tb[6 * b + 3]..tb[6 * b + 4]]);
}

fn put_line[&h, &w](heap: &!h Heap, rep: buffer.Buffer, tag: &static [byte], who: &w [byte], line: int, msg: &static [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, rep, tag);
    b = buffer.push_nat(heap, b, line);
    b = buffer.append(heap, b, ":");
    b = buffer.append(heap, b, who);
    return buffer.append(heap, b, msg);
}

// The error of a parse that stopped (status 1 or 2) on `t`, with the first 40 bytes of its line.
fn put_parse_error[&h, &t](heap: &!h Heap, rep: buffer.Buffer, who: &static [byte], t: &t [byte], st: int, pos: int) -> [heap] buffer.Buffer {
    var b = rep;
    if st == 1 {
        b = put_line(heap, b, "[SPLICE_ERROR]\t-\t", who, line_of(t, pos), ": text outside any item: ");
    } else {
        b = put_line(heap, b, "[SPLICE_ERROR]\t-\t", who, line_of(t, pos), ": item never closes (unbalanced braces): ");
    }
    var e = line_end(t, pos);
    while e > pos && int_of(t[e - 1]) == 13 {
        e = e - 1;
    }
    if e > pos + 40 {
        e = pos + 40;
    }
    b = buffer.append(heap, b, t[pos..e]);
    return buffer.push(heap, b, byte_of(10));
}

fn put_ident[&h, &t, &p](heap: &!h Heap, out: buffer.Buffer, t: &t [byte], tab: &p [int], k: int) -> [heap] buffer.Buffer {
    var b = out;
    let tg = tag_of(tab[6 * k]);
    if tg == 1 {
        b = buffer.append(heap, b, "import ");
    } else if tg == 2 {
        b = buffer.append(heap, b, "fn ");
    } else {
        b = buffer.append(heap, b, "type ");
    }
    return buffer.append(heap, b, t[tab[6 * k + 3]..tab[6 * k + 4]]);
}

fn put_note[&h, &t, &p](heap: &!h Heap, rep: buffer.Buffer, verb: &static [byte], t: &t [byte], tab: &p [int], k: int, with_word: bool) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, rep, "[SPLICE_NOTE]\t");
    b = buffer.append(heap, b, verb);
    if with_word {
        let kind = tab[6 * k];
        if kind == 2 {
            b = buffer.append(heap, b, "fn ");
        } else if kind == 3 {
            b = buffer.append(heap, b, "struct ");
        } else {
            b = buffer.append(heap, b, "enum ");
        }
    }
    b = buffer.append(heap, b, t[tab[6 * k + 3]..tab[6 * k + 4]]);
    return buffer.push(heap, b, byte_of(10));
}

// Put the patch into the file. The answer: the new file, the report, 0 (done; `[SPLICE_NOTE]` lines say what changed) or 1 (nothing
// changed; `[SPLICE_ERROR]<TAB>-<TAB>LINE:MESSAGE` lines say why).
pub fn splice[&h, &s, &p](heap: &!h Heap, existing: &s [byte], patch: &p [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 256);
    var out = buffer.empty(heap, len(existing) + len(patch) + 64);
    var code = 0;
    let teb = box_slice(heap, 6 * (len(existing) / 4 + 16), 0);
    let tpb = box_slice(heap, 6 * (len(patch) / 4 + 16), 0);
    borrow mut teb as &!ew in {
        borrow mut tpb as &!pw in {
            let te = contents(ew);
            let tp = contents(pw);
            let (ne, se, pe, le) = parse_items(existing, te);
            let (np, sp, pp, lp) = parse_items(patch, tp);
            var bad = false;
            if se != 0 {
                rep = put_parse_error(heap, rep, "existing", existing, se, pe);
                bad = true;
            }
            if sp != 0 {
                rep = put_parse_error(heap, rep, "patch", patch, sp, pp);
                bad = true;
            }
            if sp == 0 && np == 0 {
                rep = put_line(heap, rep, "[SPLICE_ERROR]\t-\t", "patch", 1, ": no item (a fn, struct, enum, import or edition line)\n");
                bad = true;
            }
            if sp == 0 {
                var k = 0;
                while k < np {
                    if tp[6 * k] != 0 {
                        var j = 0;
                        var first = 0 - 1;
                        while j < k && first < 0 {
                            if tp[6 * j] != 0 && same_ident(patch, tp, j, patch, tp, k) {
                                first = j;
                            }
                            j = j + 1;
                        }
                        if first >= 0 {
                            rep = put_line(heap, rep, "[SPLICE_ERROR]\t-\t", "patch", line_of(patch, tp[6 * k + 5]), ": defines ");
                            rep = put_ident(heap, rep, patch, tp, k);
                            rep = buffer.append(heap, rep, " twice (first at line ");
                            rep = buffer.push_nat(heap, rep, line_of(patch, tp[6 * first + 5]));
                            rep = buffer.append(heap, rep, ")\n");
                            bad = true;
                        }
                    }
                    k = k + 1;
                }
            }
            if bad {
                out = buffer.append(heap, out, existing);
                code = 1;
            } else {
                // what each patch item does: replace the first item of the file with its identity, be added, or (an import) be inserted
                let rb = box_slice(heap, ne + 1, 0 - 1);
                let ab = box_slice(heap, np + 1, 0);
                borrow mut rb as &!rw in {
                    borrow mut ab as &!aw in {
                        let repl = contents(rw);
                        let act = contents(aw);
                        var k = 0;
                        while k < np {
                            let kind = tp[6 * k];
                            if kind == 0 {
                                rep = buffer.append(heap, rep, "[SPLICE_NOTE]\tdropped edition\n");
                            } else if kind == 1 {
                                var have = false;
                                var e = 0;
                                while e < ne {
                                    if te[6 * e] == 1 && same_ident(existing, te, e, patch, tp, k) {
                                        have = true;
                                    }
                                    e = e + 1;
                                }
                                if have {
                                    rep = put_note(heap, rep, "kept import ", patch, tp, k, false);
                                } else {
                                    rep = put_note(heap, rep, "added import ", patch, tp, k, false);
                                    act[k] = 1;
                                }
                            } else {
                                var idx = 0 - 1;
                                var e = 0;
                                while e < ne && idx < 0 {
                                    if same_ident(existing, te, e, patch, tp, k) {
                                        idx = e;
                                    }
                                    e = e + 1;
                                }
                                if idx >= 0 {
                                    rep = put_note(heap, rep, "replaced ", patch, tp, k, true);
                                    repl[idx] = k;
                                } else {
                                    rep = put_note(heap, rep, "added ", patch, tp, k, true);
                                    act[k] = 2;
                                }
                            }
                            k = k + 1;
                        }
                        // the anchor of new imports: the last import, else the last header line (`edition N;`, then `module NAME;` in a module file)
                        var anchor = 0 - 1;
                        var e = 0;
                        while e < ne {
                            if te[6 * e] == 1 {
                                anchor = e;
                            }
                            e = e + 1;
                        }
                        if anchor < 0 {
                            e = 0;
                            while e < ne {
                                if te[6 * e] == 0 {
                                    anchor = e;
                                }
                                e = e + 1;
                            }
                        }
                        var inserts = buffer.empty(heap, 64);
                        k = 0;
                        while k < np {
                            if act[k] == 1 {
                                inserts = buffer.push(heap, inserts, byte_of(10));
                                inserts = buffer.append(heap, inserts, patch[tp[6 * k + 1]..tp[6 * k + 2]]);
                            }
                            k = k + 1;
                        }
                        var first_out = buffer.empty(heap, len(existing) + 64);
                        if anchor < 0 {
                            k = 0;
                            var any = false;
                            while k < np {
                                if act[k] == 1 {
                                    first_out = buffer.append(heap, first_out, patch[tp[6 * k + 1]..tp[6 * k + 2]]);
                                    first_out = buffer.push(heap, first_out, byte_of(10));
                                    any = true;
                                }
                                k = k + 1;
                            }
                            if any {
                                first_out = buffer.push(heap, first_out, byte_of(10));
                            }
                        }
                        var pos = 0;
                        e = 0;
                        while e < ne {
                            if repl[e] >= 0 {
                                let pk = repl[e];
                                first_out = buffer.append(heap, first_out, existing[pos..te[6 * e + 1]]);
                                first_out = buffer.append(heap, first_out, patch[tp[6 * pk + 1]..tp[6 * pk + 2]]);
                            } else {
                                first_out = buffer.append(heap, first_out, existing[pos..te[6 * e + 2]]);
                            }
                            pos = te[6 * e + 2];
                            if e == anchor {
                                borrow inserts as &ir in {
                                    first_out = buffer.append(heap, first_out, buffer.bytes(ir));
                                }
                            }
                            e = e + 1;
                        }
                        buffer.drop(heap, inserts);
                        first_out = buffer.append(heap, first_out, existing[pos..len(existing)]);
                        // trailing whitespace off, the appended items after one blank line each, one newline at the end
                        var tl = 0;
                        borrow first_out as &fr in {
                            tl = buffer.size(fr);
                            while tl > 0 && is_ws(int_of(buffer.bytes(fr)[tl - 1])) {
                                tl = tl - 1;
                            }
                            buffer.drop(heap, out);
                            out = buffer.append(heap, buffer.empty(heap, len(existing) + len(patch) + 64), buffer.bytes(fr)[0..tl]);
                        }
                        buffer.drop(heap, first_out);
                        k = 0;
                        while k < np {
                            if act[k] == 2 {
                                if tl > 0 {
                                    out = buffer.append(heap, out, "\n\n");
                                }
                                tl = tl + 1;
                                out = buffer.append(heap, out, patch[tp[6 * k + 1]..tp[6 * k + 2]]);
                            }
                            k = k + 1;
                        }
                        out = buffer.push(heap, out, byte_of(10));
                    }
                }
                unbox_slice(heap, ab);
                unbox_slice(heap, rb);
            }
        }
    }
    unbox_slice(heap, tpb);
    unbox_slice(heap, teb);
    return (out, rep, code);
}

// ---- merging what a unit built beside the file ---------------------------------------------------------------------------------
//
// The parallel project driver (docs/parallel.md) builds a unit in a private copy of the project file, `base` as it was when the unit started. When it
// verifies, `theirs` is that copy as the unit left it and `ours` is the project file now, which other units may have changed since. `merge3` puts what the
// unit changed (its new items, and the items of `base` it rewrote, by identity as `splice` has it) into `ours`:
//
//   - an item `theirs` has that `base` has with the same text is not the unit's: left alone;
//   - an item the unit added or rewrote goes in, with `splice`'s rules (a replaced item keeps its place, a new one is appended, new imports go with
//     the imports), when `ours` does not have it, or has it exactly as `base` had it (nobody else touched it), or already has the unit's own text;
//   - otherwise it is a CLASH: the same name defined twice with different bodies, or one item changed by two units. Nothing is merged; the report has one
//     `[INTEGRATE_CLASH]<TAB><identity><TAB><why>` line per clash.
//
// The answer is the merged file, the report, and 0 or 1 (1: `ours` is returned unchanged; the report says why). Like `splice`, pure.
pub fn merge3[&h, &b, &o, &t](heap: &!h Heap, base: &b [byte], ours: &o [byte], theirs: &t [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 128);
    var out = buffer.empty(heap, len(ours) + 64);
    var code = 0;
    let bb = box_slice(heap, 6 * (len(base) / 4 + 16), 0);
    let ob = box_slice(heap, 6 * (len(ours) / 4 + 16), 0);
    let tb = box_slice(heap, 6 * (len(theirs) / 4 + 16), 0);
    borrow mut bb as &!bw in {
        borrow mut ob as &!ow in {
            borrow mut tb as &!tw in {
                let tab_b = bw;
                let tab_o = ow;
                let tab_t = tw;
                let (nb, sb, pb, lb) = parse_items(base, contents(tab_b));
                let (no, so, po, lo) = parse_items(ours, contents(tab_o));
                let (nt, st, pt, lt) = parse_items(theirs, contents(tab_t));
                let eb = contents(tab_b);
                let eo = contents(tab_o);
                let et = contents(tab_t);
                var bad = false;
                if sb != 0 {
                    rep = put_parse_error(heap, rep, "base", base, sb, pb);
                    bad = true;
                }
                if so != 0 {
                    rep = put_parse_error(heap, rep, "ours", ours, so, po);
                    bad = true;
                }
                if st != 0 {
                    rep = put_parse_error(heap, rep, "theirs", theirs, st, pt);
                    bad = true;
                }
                var patch = buffer.empty(heap, 256);
                var included = 0;
                if bad == false {
                    var k = 0;
                    while k < nt {
                        let kind = et[6 * k];
                        if kind != 0 {
                            var ib = 0 - 1;
                            var ix = 0 - 1;
                            var e = 0;
                            while e < nb {
                                if ib < 0 && same_ident(theirs, et, k, base, eb, e) {
                                    ib = e;
                                }
                                e = e + 1;
                            }
                            e = 0;
                            while e < no {
                                if ix < 0 && same_ident(theirs, et, k, ours, eo, e) {
                                    ix = e;
                                }
                                e = e + 1;
                            }
                            let text = theirs[et[6 * k + 1]..et[6 * k + 2]];
                            if kind == 1 {
                                if ix < 0 {
                                    patch = buffer.append(heap, patch, text);
                                    patch = buffer.append(heap, patch, "\n\n");
                                    included = included + 1;
                                }
                            } else {
                                var theirs_changed = true;
                                if ib >= 0 {
                                    theirs_changed = bytes.equal(base[eb[6 * ib + 1]..eb[6 * ib + 2]], text) == false;
                                }
                                if theirs_changed {
                                    if ix < 0 {
                                        patch = buffer.append(heap, patch, text);
                                        patch = buffer.append(heap, patch, "\n\n");
                                        included = included + 1;
                                    } else if bytes.equal(ours[eo[6 * ix + 1]..eo[6 * ix + 2]], text) {
                                        // the same text is there already
                                    } else if ib >= 0 && bytes.equal(ours[eo[6 * ix + 1]..eo[6 * ix + 2]], base[eb[6 * ib + 1]..eb[6 * ib + 2]]) {
                                        patch = buffer.append(heap, patch, text);
                                        patch = buffer.append(heap, patch, "\n\n");
                                        included = included + 1;
                                    } else {
                                        rep = buffer.append(heap, rep, "[INTEGRATE_CLASH]\t");
                                        rep = put_ident(heap, rep, theirs, et, k);
                                        if ib >= 0 {
                                            rep = buffer.append(heap, rep, "\tchanged by this unit and by another unit that was integrated first\n");
                                        } else {
                                            rep = buffer.append(heap, rep, "\tdefined by this unit and, differently, by another unit that was integrated first\n");
                                        }
                                        bad = true;
                                    }
                                }
                            }
                        }
                        k = k + 1;
                    }
                }
                if bad {
                    out = buffer.append(heap, out, ours);
                    code = 1;
                } else if included == 0 {
                    out = buffer.append(heap, out, ours);
                } else {
                    borrow patch as &pq in {
                        let (merged, report, scode) = splice(heap, ours, buffer.bytes(pq));
                        buffer.drop(heap, out);
                        out = merged;
                        if scode != 0 {
                            code = 1;
                            borrow report as &rr in {
                                rep = buffer.append(heap, rep, buffer.bytes(rr));
                            }
                        }
                        buffer.drop(heap, report);
                    }
                }
                buffer.drop(heap, patch);
            }
        }
    }
    unbox_slice(heap, tb);
    unbox_slice(heap, ob);
    unbox_slice(heap, bb);
    return (out, rep, code);
}

// How many items of `base` the unit that started from it has changed or dropped in `theirs` (by identity, as `merge3` finds them; an import counts when it
// is gone): 0 means the unit only ADDED to the file, so no unit that had verified can behave differently (a name it would shadow is a clash, and a file that
// does not compile is the combined check's to find). -1 when either file cannot be parsed: the caller then assumes the worst.
pub fn rewrites[&h, &b, &t](heap: &!h Heap, base: &b [byte], theirs: &t [byte]) -> [heap] int {
    var count = 0;
    let bb = box_slice(heap, 6 * (len(base) / 4 + 16), 0);
    let tb = box_slice(heap, 6 * (len(theirs) / 4 + 16), 0);
    borrow mut bb as &!bw in {
        borrow mut tb as &!tw in {
            let eb = bw;
            let et = tw;
            let (nb, sb, pb, lb) = parse_items(base, contents(eb));
            let (nt, st, pt, lt) = parse_items(theirs, contents(et));
            if sb != 0 || st != 0 {
                count = 0 - 1;
            } else {
                let tab_b = contents(eb);
                let tab_t = contents(et);
                var k = 0;
                while k < nb {
                    if tab_b[6 * k] != 0 {
                        var found = false;
                        var same = false;
                        var e = 0;
                        while e < nt {
                            if found == false && same_ident(base, tab_b, k, theirs, tab_t, e) {
                                found = true;
                                same = bytes.equal(base[tab_b[6 * k + 1]..tab_b[6 * k + 2]], theirs[tab_t[6 * e + 1]..tab_t[6 * e + 2]]);
                            }
                            e = e + 1;
                        }
                        if same == false {
                            count = count + 1;
                        }
                    }
                    k = k + 1;
                }
            }
        }
    }
    unbox_slice(heap, tb);
    unbox_slice(heap, bb);
    return count;
}

// ---- the public surface of a module file ----------------------------------------------------------------------------------------------------
//
// The multi-file task (docs/multi-file.md) tells the agent what the other files of the project offer: for every `pub` item of a file, a `pub fn` as its
// signature line (up to the body) and a `pub` struct or enum whole, one after the other, each ended by a newline. A file that does not parse gives an
// empty answer (the agent then sees the file's name and nothing else).
pub fn public_items[&h, &s](heap: &!h Heap, text: &s [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 256);
    let tb = box_slice(heap, 6 * (len(text) / 4 + 16), 0);
    borrow mut tb as &!tw in {
        let tab = contents(tw);
        let (n, st, pos, last) = parse_items(text, tab);
        if st == 0 {
            var k = 0;
            while k < n && 6 * k + 5 < len(tab) {
                let kind = tab[6 * k];
                let kw = tab[6 * k + 5];
                let end = tab[6 * k + 2];
                if kind >= 2 && match_at(text, kw, "pub ") {
                    var stop = end;
                    if kind == 2 {
                        let brace = find_in(text, kw, end, "{");
                        if brace >= 0 {
                            stop = brace;
                        }
                    }
                    while stop > kw && is_ws(int_of(text[stop - 1])) {
                        stop = stop - 1;
                    }
                    out = buffer.append(heap, out, text[kw..stop]);
                    out = buffer.push(heap, out, byte_of(10));
                }
                k = k + 1;
            }
        }
    }
    unbox_slice(heap, tb);
    return out;
}

// ---- removing items (docs/repo-patch.md) -------------------------------------------------------------------------------------------------
//
// Patch mode can add or replace an item by name, never delete one; a rename is a removal and an addition. `remove_items` takes the file and a
// list of lines `fn NAME` or `type NAME` (a struct or an enum is a `type`: the two share a namespace, as `splice`'s identity has it), and drops
// each such item, its leading comment with it and the blank space after it. It does not look for uses of the item: a use that is left is the
// compiler's to find. An item the file does not have is an error, in the same `[SPLICE_ERROR]` form as the others (and the file is returned
// unchanged). Pure, like `splice`.
pub fn remove_items[&h, &s, &r](heap: &!h Heap, existing: &s [byte], removes: &r [byte]) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var rep = buffer.empty(heap, 128);
    var out = buffer.empty(heap, len(existing) + 16);
    var code = 0;
    let teb = box_slice(heap, 6 * (len(existing) / 4 + 16), 0);
    let gone = box_slice(heap, len(existing) / 4 + 17, 0);
    borrow mut teb as &!ew in {
        borrow mut gone as &!gw in {
            let te = contents(ew);
            let dropped = contents(gw);
            let (ne, se, pe, le) = parse_items(existing, te);
            if se != 0 {
                rep = put_parse_error(heap, rep, "existing", existing, se, pe);
                code = 1;
            } else {
                var p = 0;
                var lineno = 0;
                while p < len(removes) {
                    let e = line_end(removes, p);
                    lineno = lineno + 1;
                    let ln = bytes.trim(removes[p..e]);
                    if len(ln) > 0 {
                        var tag = 0;
                        var name = ln;
                        if bytes.starts_with(ln, "fn ") {
                            tag = 2;
                            name = bytes.trim(ln[3..len(ln)]);
                        } else if bytes.starts_with(ln, "type ") {
                            tag = 3;
                            name = bytes.trim(ln[5..len(ln)]);
                        }
                        var idx = 0 - 1;
                        var k = 0;
                        while k < ne && idx < 0 {
                            if tag_of(te[6 * k]) == tag && tag >= 2 && bytes.equal(existing[te[6 * k + 3]..te[6 * k + 4]], name) {
                                idx = k;
                            }
                            k = k + 1;
                        }
                        if idx < 0 {
                            rep = put_line(heap, rep, "[SPLICE_ERROR]\t-\t", "patch", lineno, ": remove ");
                            rep = buffer.append(heap, rep, ln);
                            rep = buffer.append(heap, rep, ": the file has no such item\n");
                            code = 1;
                        } else {
                            dropped[idx] = 1;
                        }
                    }
                    p = e + 1;
                }
                if code == 0 {
                    var whole = buffer.empty(heap, len(existing) + 16);
                    var pos = 0;
                    var k = 0;
                    while k < ne {
                        if dropped[k] == 1 {
                            whole = buffer.append(heap, whole, existing[pos..te[6 * k + 1]]);
                            pos = te[6 * k + 2];
                            while pos < len(existing) && is_ws(int_of(existing[pos])) {
                                pos = pos + 1;
                            }
                        }
                        k = k + 1;
                    }
                    whole = buffer.append(heap, whole, existing[pos..len(existing)]);
                    borrow whole as &wr in {
                        var tl = buffer.size(wr);
                        while tl > 0 && is_ws(int_of(buffer.bytes(wr)[tl - 1])) {
                            tl = tl - 1;
                        }
                        buffer.drop(heap, out);
                        out = buffer.append(heap, buffer.empty(heap, tl + 2), buffer.bytes(wr)[0..tl]);
                        out = buffer.push(heap, out, byte_of(10));
                    }
                    buffer.drop(heap, whole);
                }
            }
        }
    }
    unbox_slice(heap, gone);
    unbox_slice(heap, teb);
    if code != 0 {
        buffer.drop(heap, out);
        out = buffer.append(heap, buffer.empty(heap, len(existing) + 16), existing);
    }
    return (out, rep, code);
}

// ---- a change of several files (docs/repo-patch.md) --------------------------------------------------------------------------------------
//
// The reply to a change request is an ENVELOPE: for each file it touches, a header line `=== FILE <path>` and under it the body for that file (the
// items to add or replace, the `remove` lines, or a whole new file). These two functions are the parts of it that need the item parser.

// Does a header line `=== FILE ` begin at `i`, at the start of a line?
pub fn is_header[&s](s: &s [byte], i: int) -> [] bool {
    return (i == 0 || int_of(s[i - 1]) == 10) && match_at(s, i, "=== FILE ");
}

// The first line at or after `from` (before `hi`) that begins with `=== FILE `, as its offset, or -1.
fn header_from[&s](s: &s [byte], from: int, hi: int) -> [] int {
    var i = from;
    var found = 0 - 1;
    while found < 0 && i < hi {
        if (i == 0 || int_of(s[i - 1]) == 10) && match_at(s, i, "=== FILE ") {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

// The envelope in a model's answer: from its first header line to its end (trailing space off, and a closing fence that closes no fence of the
// envelope), or (-1, -1) when there is no header. Text before the first header (a preamble, reasoning) is not part of it; of a `</think>`, only
// what follows the last one counts when a header follows it.
pub fn envelope_span[&s](answer: &s [byte]) -> [] (int, int) {
    let n = len(answer);
    var lo = 0;
    let t = rfind_in(answer, 0, n, "</think>");
    if t >= 0 && header_from(answer, t + 8, n) >= 0 {
        lo = t + 8;
    }
    let a = header_from(answer, lo, n);
    if a < 0 {
        return (0 - 1, 0 - 1);
    }
    var e = n;
    while e > a && is_space(int_of(answer[e - 1])) {
        e = e - 1;
    }
    var fences = 0;
    var i = a;
    while i < e {
        if (i == a || int_of(answer[i - 1]) == 10) && match_at(answer, i, "```") {
            fences = fences + 1;
        }
        i = i + 1;
    }
    if fences % 2 == 1 && e - 3 >= a && match_at(answer, e - 3, "```") && int_of(answer[e - 4]) == 10 {
        e = e - 3;
        while e > a && is_space(int_of(answer[e - 1])) {
            e = e - 1;
        }
    }
    return (a, e);
}

// How many test functions `new` adds or changes against `base`: the `fn test_...` items of `new` that `base` does not have, or has with other text.
// `base` empty is a new file. A file that does not parse counts none (the compiler is the one to say why).
pub fn changed_tests[&h, &b, &n](heap: &!h Heap, base: &b [byte], new: &n [byte]) -> [heap] int {
    var count = 0;
    let bb = box_slice(heap, 6 * (len(base) / 4 + 16), 0);
    let nb = box_slice(heap, 6 * (len(new) / 4 + 16), 0);
    borrow mut bb as &!bw in {
        borrow mut nb as &!nw in {
            let tb = contents(bw);
            let tn = contents(nw);
            let (cb, sb, pb, lb) = parse_items(base, tb);
            let (cn, sn, pn, ln) = parse_items(new, tn);
            if sb == 0 && sn == 0 {
                var k = 0;
                while k < cn {
                    if tn[6 * k] == 2 && match_at(new, tn[6 * k + 3], "test_") && tn[6 * k + 3] + 5 <= tn[6 * k + 4] {
                        var same = false;
                        var e = 0;
                        while e < cb {
                            if same_ident(base, tb, e, new, tn, k) && bytes.equal(base[tb[6 * e + 1]..tb[6 * e + 2]], new[tn[6 * k + 1]..tn[6 * k + 2]]) {
                                same = true;
                            }
                            e = e + 1;
                        }
                        if same == false {
                            count = count + 1;
                        }
                    }
                    k = k + 1;
                }
            }
        }
    }
    unbox_slice(heap, nb);
    unbox_slice(heap, bb);
    return count;
}

// The test functions `new` adds or changes against `base` (the ones `changed_tests` counts), one per line: their names, or (`text` true) their text
// from the keyword to the end of the item, a newline after each. The gate reads the names to run them against the base, and the text to see what they call.
pub fn changed_test_items[&h, &b, &n](heap: &!h Heap, base: &b [byte], new: &n [byte], text: bool) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    let bb = box_slice(heap, 6 * (len(base) / 4 + 16), 0);
    let nb = box_slice(heap, 6 * (len(new) / 4 + 16), 0);
    borrow mut bb as &!bw in {
        borrow mut nb as &!nw in {
            let tb = contents(bw);
            let tn = contents(nw);
            let (cb, sb, pb, lb) = parse_items(base, tb);
            let (cn, sn, pn, ln) = parse_items(new, tn);
            if sb == 0 && sn == 0 {
                var k = 0;
                while k < cn {
                    if tn[6 * k] == 2 && match_at(new, tn[6 * k + 3], "test_") && tn[6 * k + 3] + 5 <= tn[6 * k + 4] {
                        var same = false;
                        var e = 0;
                        while e < cb {
                            if same_ident(base, tb, e, new, tn, k) && bytes.equal(base[tb[6 * e + 1]..tb[6 * e + 2]], new[tn[6 * k + 1]..tn[6 * k + 2]]) {
                                same = true;
                            }
                            e = e + 1;
                        }
                        if same == false {
                            if text {
                                out = buffer.append(heap, out, new[tn[6 * k + 5]..tn[6 * k + 2]]);
                            } else {
                                out = buffer.append(heap, out, new[tn[6 * k + 3]..tn[6 * k + 4]]);
                            }
                            out = buffer.push(heap, out, byte_of(10));
                        }
                    }
                    k = k + 1;
                }
            }
        }
    }
    unbox_slice(heap, nb);
    unbox_slice(heap, bb);
    return out;
}

fn delta_line[&h, &p, &t, &x](heap: &!h Heap, out: buffer.Buffer, path: &p [byte], status: &static [byte], text: &t [byte], tab: &x [int], k: int) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, out, path);
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, status);
    b = buffer.push(heap, b, byte_of(9));
    if tab[6 * k] == 2 {
        b = buffer.append(heap, b, "fn");
    } else {
        b = buffer.append(heap, b, "type");
    }
    b = buffer.push(heap, b, byte_of(9));
    b = buffer.append(heap, b, text[tab[6 * k + 3]..tab[6 * k + 4]]);
    b = buffer.push(heap, b, byte_of(9));
    if match_at(text, tab[6 * k + 5], "pub ") {
        b = buffer.append(heap, b, "1");
    } else {
        b = buffer.append(heap, b, "0");
    }
    b = buffer.push(heap, b, byte_of(9));
    var lines = 1;
    var i = tab[6 * k + 5];
    while i < tab[6 * k + 2] {
        if int_of(text[i]) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    b = buffer.push_nat(heap, b, lines);
    return buffer.push(heap, b, byte_of(10));
}

// What `new` did to the items (fns, structs, enums) of `base`, one line per item: `PATH<TAB>STATUS<TAB>KIND<TAB>NAME<TAB>PUB<TAB>LINES`, with STATUS
// `A` (added), `C` (an item of that name with other text: replaced) or `R` (removed), KIND `fn` or `type` (the two share a namespace as `splice`
// has it), PUB 1 or 0, LINES the lines of the new item (of the removed one for `R`). `base` empty is a new file. A file that does not parse gives
// nothing (the compiler says why). The `--constraints` of docs/repo-patch.md are decided on these lines.
pub fn item_delta[&h, &p, &b, &n](heap: &!h Heap, path: &p [byte], base: &b [byte], new: &n [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    let bb = box_slice(heap, 6 * (len(base) / 4 + 16), 0);
    let nb = box_slice(heap, 6 * (len(new) / 4 + 16), 0);
    borrow mut bb as &!bw in {
        borrow mut nb as &!nw in {
            let tb = contents(bw);
            let tn = contents(nw);
            let (cb, sb, pb, lb) = parse_items(base, tb);
            let (cn, sn, pn, ln) = parse_items(new, tn);
            if sb == 0 && sn == 0 {
                var k = 0;
                while k < cn {
                    if tn[6 * k] >= 2 {
                        var found = false;
                        var same = false;
                        var e = 0;
                        while e < cb {
                            if same_ident(base, tb, e, new, tn, k) {
                                found = true;
                                if bytes.equal(base[tb[6 * e + 1]..tb[6 * e + 2]], new[tn[6 * k + 1]..tn[6 * k + 2]]) {
                                    same = true;
                                }
                            }
                            e = e + 1;
                        }
                        if found == false {
                            out = delta_line(heap, out, path, "A", new, tn, k);
                        } else if same == false {
                            out = delta_line(heap, out, path, "C", new, tn, k);
                        }
                    }
                    k = k + 1;
                }
                var e2 = 0;
                while e2 < cb {
                    if tb[6 * e2] >= 2 {
                        var kept = false;
                        var j = 0;
                        while j < cn {
                            if same_ident(base, tb, e2, new, tn, j) {
                                kept = true;
                            }
                            j = j + 1;
                        }
                        if kept == false {
                            out = delta_line(heap, out, path, "R", base, tb, e2);
                        }
                    }
                    e2 = e2 + 1;
                }
            }
        }
    }
    unbox_slice(heap, nb);
    unbox_slice(heap, bb);
    return out;
}
