edition 7;

// `cancho-build` -- one command from a brief to a verified build (docs/build.md):
//
//     build <checker> <brief.txt> <workdir> <agent-command> --provider <p> --model <m> [options]
//
// `--jobs N` (default 4) builds up to N units at once (docs/parallel.md; 1 is one at a time). Started again as `build --unit-worker ...` it is one such
// unit's worker, which the driver itself starts (not for people).
//
// Exit codes: 0 done, 1 stuck or the final gate failed, 2 usage, 3 plan_failed, 4 provider_error.

import build;
import project;
import std.buffer;
import std.bytes;
import std.io;

fn digits_of[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + c - 48;
        i = i + 1;
    }
    return n;
}

// How many words an option takes with its name: `--patch <unit> <file>` takes two, every other option one.
fn width[&a](name: &a [byte]) -> [] int {
    if bytes.equal(name, "--patch") {
        return 3;
    }
    return 2;
}

// The value after `--name`, or "" when the option is absent (the last one wins). `nth` 1 is its first value, 2 the second (`--patch`'s file).
fn opt_at[&g](g: &g Args, name: &static [byte], nth: int) -> [args] &static [byte] {
    var found = "";
    var i = 5;
    while i + nth < arg_count(g) {
        if bytes.equal(arg(g, i), name) {
            found = arg(g, i + nth);
        }
        i = i + width(arg(g, i));
    }
    return found;
}

fn opt[&g](g: &g Args, name: &static [byte]) -> [args] &static [byte] {
    return opt_at(g, name, 1);
}

// Was `--name` given at all (even with an empty value)?
fn given_opt[&g](g: &g Args, name: &static [byte]) -> [args] bool {
    var i = 5;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), name) {
            return true;
        }
        i = i + width(arg(g, i));
    }
    return false;
}

fn known[&a](name: &a [byte]) -> [] bool {
    return bytes.equal(name, "--provider") || bytes.equal(name, "--model") || bytes.equal(name, "--guide") || bytes.equal(name, "--review-guide")
        || bytes.equal(name, "--review") || bytes.equal(name, "--contract") || bytes.equal(name, "--rounds") || bytes.equal(name, "--attempts")
        || bytes.equal(name, "--agent-seconds") || bytes.equal(name, "--plan-seconds")
        || bytes.equal(name, "--retry") || bytes.equal(name, "--hint") || bytes.equal(name, "--patch") || bytes.equal(name, "--jobs")
        || bytes.equal(name, "--memory") || bytes.equal(name, "--remember");
}

// A word that goes into a shell command line: letters, digits and . _ / + : = @ % , - only.
fn plain[&a](text: &a [byte]) -> [] bool {
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        let ok = (c >= 48 && c <= 58) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 46 || c == 95 || c == 47 || c == 43 || c == 61 || c == 64 || c == 37 || c == 44 || c == 45;
        if ok == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `--remember "<text>"` (docs/memory.md): one line of the person's own, appended to <memory dir>/facts.txt, which every prompt of a run given
// `--memory <dir>` carries. 0 done; 1 the line cannot be added (ten facts are the most a prompt carries, or the file cannot be written).
fn remember[&h, &z, &d, &t, &i](heap: &!h Heap, fs: &z Fs(""), io: &!i Io, dir: &d [byte], text: &t [byte]) -> [heap, fs_read(""), fs_write(""), err_write] int {
    var path = buffer.append(heap, buffer.empty(heap, len(dir) + 16), dir);
    path = buffer.append(heap, path, "/facts.txt");
    var all = buffer.empty(heap, 256);
    var facts = 0;
    let room = box_slice(heap, 16384, byte_of(0));
    borrow mut room as &!rw in {
        borrow path as &pq0 in {
            let n = fs_read(fs, buffer.bytes(pq0), contents(rw));
            if n > 0 {
                let old = contents(rw)[0..n];
                all = buffer.append(heap, all, old);
                if int_of(old[n - 1]) != 10 {
                    all = buffer.push(heap, all, byte_of(10));
                }
                var p = 0;
                while p < n {
                    var e = p;
                    while e < n && int_of(old[e]) != 10 {
                        e = e + 1;
                    }
                    let l = bytes.trim(old[p..e]);
                    if len(l) > 0 && int_of(l[0]) != 35 {
                        facts = facts + 1;
                    }
                    p = e + 1;
                }
            }
        }
    }
    unbox_slice(heap, room);
    var status = 1;
    if facts >= 10 {
        io.error_all(io, "build: facts.txt already holds ten facts, the most a prompt carries; remove one first\n");
    } else {
        all = buffer.append(heap, all, text);
        all = buffer.push(heap, all, byte_of(10));
        borrow all as &aq in {
            borrow path as &pq in {
                if fs_write(fs, buffer.bytes(pq), buffer.bytes(aq)) == len(buffer.bytes(aq)) {
                    status = 0;
                } else {
                    io.error_all(io, "build: facts.txt cannot be written in the --memory directory\n");
                }
            }
        }
    }
    buffer.drop(heap, all);
    buffer.drop(heap, path);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var console = io;
    var h = heap;
    var checker = "";
    var brief = "";
    var wd = "";
    var agent = "";
    var provider = "";
    var model = "";
    var guide = "";
    var review_guide = "";
    var contract = "";
    var review = false;
    var rounds = 3;
    var attempts = 4;
    var agent_seconds = 30;
    var plan_seconds = 900;
    var retry = "";
    var hint = "";
    var patch = "";
    var pfile = "";
    var jobs = 4;
    var argv0 = "";
    var worker = false;
    var memory = "";
    var fact = "";
    var given = false;
    borrow args as &g0 in {
        if arg_count(g0) >= 2 && bytes.equal(arg(g0, 1), "--unit-worker") {
            worker = true;
        }
    }
    borrow mut console as &!ci in {
        borrow args as &g in {
            if worker {
                given = false;
            } else if arg_count(g) < 5 {
                io.error_all(ci, "usage: build <checker> <brief.txt> <workdir> <agent-command> --provider <p> --model <m> [--guide <file>] [--review on --review-guide <file>] [--contract <file>] [--rounds N] [--attempts N] [--agent-seconds N] [--plan-seconds N] [--retry <unit> [--hint <text>]] [--patch <unit> <file>] [--memory <dir> [--remember <text>]] [--jobs N]\n");
            } else {
                given = true;
                argv0 = arg(g, 0);
                checker = arg(g, 1);
                brief = arg(g, 2);
                wd = arg(g, 3);
                agent = arg(g, 4);
                provider = opt(g, "--provider");
                model = opt(g, "--model");
                guide = opt(g, "--guide");
                review_guide = opt(g, "--review-guide");
                contract = opt(g, "--contract");
                if len(checker) == 0 || int_of(checker[0]) != 47 {
                    io.error_all(ci, "build: the checker path must be absolute\n");
                    given = false;
                }
                // `..` in a path traps the file capability (exit 132), so it is refused here, as `project` does.
                if bytes.find(brief, "..") >= 0 || bytes.find(wd, "..") >= 0 || bytes.find(guide, "..") >= 0 || bytes.find(review_guide, "..") >= 0 || bytes.find(contract, "..") >= 0 {
                    io.error_all(ci, "build: a path may not contain '..'\n");
                    given = false;
                }
                // The paths, provider and model are put into shell command lines: no space, quote or metacharacter in them.
                if plain(checker) == false || plain(brief) == false || plain(wd) == false || plain(guide) == false || plain(review_guide) == false || plain(contract) == false || plain(provider) == false || plain(model) == false {
                    io.error_all(ci, "build: a path, the provider and the model may hold only letters, digits and . _ / + : = @ % , -\n");
                    given = false;
                }
                if len(provider) == 0 || len(model) == 0 {
                    io.error_all(ci, "build: --provider and --model are required (there is no default for either)\n");
                    given = false;
                }
                var i = 5;
                while i < arg_count(g) {
                    if known(arg(g, i)) == false || i + width(arg(g, i)) > arg_count(g) {
                        io.error_all(ci, "build: an option it does not know, or without its value: ");
                        io.error_all(ci, arg(g, i));
                        io.error_all(ci, "\n");
                        given = false;
                    }
                    i = i + width(arg(g, i));
                }
                // --retry <unit> [--hint <text>] and --patch <unit> <file> re-open a unit of the plan the earlier run left (docs/build.md). The hint
                // is free text and never goes through a shell: it reaches the agent in the task file.
                retry = opt(g, "--retry");
                hint = opt(g, "--hint");
                patch = opt(g, "--patch");
                pfile = opt_at(g, "--patch", 2);
                if given_opt(g, "--retry") && len(retry) == 0 {
                    io.error_all(ci, "build: --retry needs a unit\n");
                    given = false;
                }
                if given_opt(g, "--patch") && len(patch) == 0 {
                    io.error_all(ci, "build: --patch needs a unit\n");
                    given = false;
                }
                if (len(retry) > 0 && plain(retry) == false) || (len(patch) > 0 && plain(patch) == false) || (len(pfile) > 0 && plain(pfile) == false) {
                    io.error_all(ci, "build: a unit and a patch file may hold only letters, digits and . _ / + : = @ % , -\n");
                    given = false;
                }
                if project.redo_args_ok(ci, retry, given_opt(g, "--hint"), hint, patch, pfile) == false {
                    given = false;
                }
                // --memory <dir> goes to the unit agent (docs/memory.md); --remember <text> adds one line of the person's own to <dir>/facts.txt first.
                // The text never goes through a shell, it is one line of at most 160 bytes.
                memory = opt(g, "--memory");
                fact = opt(g, "--remember");
                if given_opt(g, "--memory") && (len(memory) == 0 || int_of(memory[0]) != 47 || bytes.find(memory, "..") >= 0 || plain(memory) == false) {
                    io.error_all(ci, "build: --memory needs an absolute directory (letters, digits and . _ / + : = @ % , - only, no ..)\n");
                    given = false;
                }
                if given_opt(g, "--remember") && (len(fact) == 0 || len(bytes.trim(fact)) == 0 || bytes.find(fact, "\n") >= 0 || bytes.find(fact, "\r") >= 0 || len(fact) > 160) {
                    io.error_all(ci, "build: --remember needs one non-empty line of at most 160 bytes\n");
                    given = false;
                }
                if given_opt(g, "--remember") && len(memory) == 0 {
                    io.error_all(ci, "build: --remember needs --memory <dir>\n");
                    given = false;
                }
                let r = opt(g, "--review");
                if bytes.equal(r, "on") {
                    review = true;
                    if len(review_guide) == 0 {
                        io.error_all(ci, "build: --review on needs --review-guide\n");
                        given = false;
                    }
                } else if len(r) > 0 && bytes.equal(r, "off") == false {
                    io.error_all(ci, "build: --review is on or off\n");
                    given = false;
                }
                let n_rounds = opt(g, "--rounds");
                if len(n_rounds) > 0 {
                    rounds = digits_of(n_rounds);
                }
                let n_attempts = opt(g, "--attempts");
                if len(n_attempts) > 0 {
                    attempts = digits_of(n_attempts);
                }
                let n_agent = opt(g, "--agent-seconds");
                if len(n_agent) > 0 {
                    agent_seconds = digits_of(n_agent);
                }
                let n_jobs = opt(g, "--jobs");
                if given_opt(g, "--jobs") {
                    jobs = digits_of(n_jobs);
                    if jobs < 1 || jobs > 64 {
                        io.error_all(ci, "build: --jobs needs a number from 1 to 64\n");
                        given = false;
                    }
                }
                let n_plan = opt(g, "--plan-seconds");
                if len(n_plan) > 0 {
                    plan_seconds = digits_of(n_plan);
                }
                if rounds < 1 || attempts < 1 || agent_seconds < 1 || plan_seconds < 1 {
                    io.error_all(ci, "build: --rounds, --attempts, --agent-seconds and --plan-seconds are positive numbers\n");
                    given = false;
                }
            }
        }
    }
    var status = 2;
    var remembered = true;
    if given {
        borrow fs as &fz in {
            // The brief must be there (the agent reads it; here it is only checked).
            region probe {
                let room = alloc_slice[probe](4, byte_of(0));
                if fs_read(fz, brief, room) < 0 {
                    given = false;
                }
            }
            borrow exec as &x in {
                borrow clock as &c in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            if given && len(fact) > 0 && remember(hh, fz, i, memory, bytes.trim(fact)) != 0 {
                                given = false;
                                remembered = false;
                            }
                            if given {
                                var agent2 = buffer.append(hh, buffer.empty(hh, len(agent) + len(memory) + 16), agent);
                                if len(memory) > 0 {
                                    agent2 = buffer.append(hh, agent2, " --memory ");
                                    agent2 = buffer.append(hh, agent2, memory);
                                }
                                borrow agent2 as &a2 in {
                                status = build.run(hh, x, c, i, fz, checker, brief, wd, buffer.bytes(a2), provider, model, guide, review_guide, contract, review, rounds, attempts, agent_seconds * 1000, plan_seconds * 1000, retry, hint, patch, pfile, jobs, argv0);
                                }
                                buffer.drop(hh, agent2);
                            } else if remembered {
                                io.error_all(i, "build: the brief cannot be read\n");
                            }
                        }
                    }
                }
            }
        }
    }
    if worker {
        borrow fs as &fz in {
            borrow exec as &x in {
                borrow clock as &c in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            borrow args as &g in {
                                status = project.unit_worker(hh, x, c, i, fz, g);
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(console);
    release(h);
    release(args);
    return status;
}
