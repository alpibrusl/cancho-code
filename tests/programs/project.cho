edition 7;

// `project` -- build a plan (docs/plan.md) unit by unit (docs/project.md):
//
//     project <checker> <plan.json> <workdir> <agent-command> [attempts [agent-seconds [acceptance-command [lib-files]]]] [--retry <unit> [--hint <text>]] [--patch <unit> <file>] [--jobs N] [--settle MS]
//
// `--jobs N` builds up to N units at once (docs/parallel.md; default 1: one at a time). Started again as `project --unit-worker ...` it is one such unit's
// worker, which the driver itself starts (not for people).
//
// Exit codes: 0 done, 1 stuck or the final gate failed, 2 usage, 3 the plan is invalid, 4 the agent or the checker is away.

import project;
import std.bytes;
import std.io;

fn digits_of[&a](text: &a [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0;
        }
        n = n * 10 + c - 48;
        i = i + 1;
    }
    return n;
}

// Is `text` a non-empty run of digits?
fn all_digits[&a](text: &a [byte]) -> [] bool {
    if len(text) == 0 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var console = io;
    var h = heap;
    var checker = "";
    var plan_path = "";
    var wd = "";
    var agent = "";
    var attempts = 4;
    var seconds = 30;
    var accept = "";
    var libs = "";
    var retry = "";
    var hint = "";
    var hint_given = false;
    var patch = "";
    var pfile = "";
    var jobs = 1;
    var settle = 300;
    var argv0 = "";
    var worker = false;
    var given = false;
    borrow args as &g0 in {
        if arg_count(g0) >= 2 && bytes.equal(arg(g0, 1), "--unit-worker") {
            worker = true;
        }
    }
    borrow mut console as &!ci in {
        borrow args as &g in {
            if worker {
                given = false;
            } else if arg_count(g) < 5 {
                io.error_all(ci, "usage: project <checker> <plan.json> <workdir> <agent-cmd> [attempts [agent-seconds [acceptance-cmd [lib-files]]]] [--retry <unit> [--hint <text>]] [--patch <unit> <file>] [--jobs N] [--settle MS]\n");
            } else {
                given = true;
                argv0 = arg(g, 0);
                checker = arg(g, 1);
                plan_path = arg(g, 2);
                wd = arg(g, 3);
                agent = arg(g, 4);
                // The checker and the agent are spawned from another directory: a relative path is a usage error, not a crash
                // (found by the first implementation, which died with SIGILL on one).
                if len(checker) == 0 || int_of(checker[0]) != 47 {
                    io.error_all(ci, "project: the checker path must be absolute\n");
                    given = false;
                }
                // Nor may the plan or the work directory hold `..`: the file capability refuses traversal by trapping (SIGILL, exit 132),
                // so a path named `/a/../b` killed the program instead of being refused. (The checker is spawned by the shell and
                // does not go through that capability.)
                if bytes.find(plan_path, "..") >= 0 || bytes.find(wd, "..") >= 0 {
                    io.error_all(ci, "project: a path may not contain '..'\n");
                    given = false;
                }
                // the positional arguments, then the options that re-open a unit (docs/build.md): --retry <unit>, --hint <text>, --patch <unit> <file>
                var pos = 0;
                var i = 5;
                while i < arg_count(g) {
                    let a = arg(g, i);
                    if bytes.equal(a, "--retry") && i + 1 < arg_count(g) {
                        retry = arg(g, i + 1);
                        if len(retry) == 0 {
                            io.error_all(ci, "project: --retry needs a unit\n");
                            given = false;
                        }
                        i = i + 2;
                    } else if bytes.equal(a, "--hint") && i + 1 < arg_count(g) {
                        hint = arg(g, i + 1);
                        hint_given = true;
                        i = i + 2;
                    } else if bytes.equal(a, "--patch") && i + 2 < arg_count(g) {
                        patch = arg(g, i + 1);
                        pfile = arg(g, i + 2);
                        if len(patch) == 0 {
                            io.error_all(ci, "project: --patch needs a unit\n");
                            given = false;
                        }
                        i = i + 3;
                    } else if bytes.equal(a, "--jobs") && i + 1 < arg_count(g) {
                        jobs = digits_of(arg(g, i + 1));
                        if all_digits(arg(g, i + 1)) == false || jobs < 1 || jobs > 64 {
                            io.error_all(ci, "project: --jobs needs a number from 1 to 64\n");
                            given = false;
                        }
                        i = i + 2;
                    } else if bytes.equal(a, "--settle") && i + 1 < arg_count(g) {
                        settle = digits_of(arg(g, i + 1));
                        if all_digits(arg(g, i + 1)) == false || settle > 60000 {
                            io.error_all(ci, "project: --settle needs a number of milliseconds, at most 60000\n");
                            given = false;
                        }
                        i = i + 2;
                    } else if len(a) >= 2 && int_of(a[0]) == 45 && int_of(a[1]) == 45 {
                        io.error_all(ci, "project: an option it does not know, or without its value: ");
                        io.error_all(ci, a);
                        io.error_all(ci, "\n");
                        given = false;
                        i = i + 1;
                    } else {
                        if pos == 0 {
                            attempts = digits_of(a);
                        } else if pos == 1 {
                            seconds = digits_of(a);
                        } else if pos == 2 {
                            accept = a;
                        } else if pos == 3 {
                            libs = a;
                        }
                        pos = pos + 1;
                        i = i + 1;
                    }
                }
                if project.redo_args_ok(ci, retry, hint_given, hint, patch, pfile) == false {
                    given = false;
                }
            }
        }
    }
    var status = 2;
    if given {
        borrow fs as &fz in {
            borrow exec as &x in {
                borrow clock as &c in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            let room = box_slice(hh, 1048576, byte_of(0));
                            borrow mut room as &!rw in {
                                let text = contents(rw);
                                let n = fs_read(fz, plan_path, text);
                                if n >= 1048576 {
                                    io.error_all(i, "project: the plan is too large (1 MiB or more)\n");
                                } else if n >= 0 {
                                    status = project.run(hh, x, c, i, fz, text[0..n], checker, wd, agent, attempts, seconds * 1000, accept, libs, retry, hint, patch, pfile, project.Par { jobs: jobs, settle: settle, warm: false }, argv0);
                                } else {
                                    io.error_all(i, "project: the plan cannot be read\n");
                                }
                            }
                            unbox_slice(hh, room);
                        }
                    }
                }
            }
        }
    }
    if worker {
        borrow fs as &fz in {
            borrow exec as &x in {
                borrow clock as &c in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            borrow args as &g in {
                                status = project.unit_worker(hh, x, c, i, fz, g);
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(console);
    release(h);
    release(args);
    return status;
}
