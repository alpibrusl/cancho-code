edition 7;

// review_gate blind PLAN | review_gate apply PLAN ANSWERS: the blind pass of src/review.cho (docs/plan.md, "review"). `blind` prints the
// reviewer's questions; `apply` prints the plan with the cases the reviewer did not confirm removed on stdout, the report on stderr, and
// exits 0 (usable), 1 (not). Exit 2: usage, a file that cannot be read, or one of 1 MiB or more.

import std.buffer;
import std.bytes;
import std.io;
import review;

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var console = io;
    var h = heap;
    var mode = "";
    var path1 = "";
    var path2 = "";
    var given = 0;
    var status = 2;
    borrow args as &g in {
        given = arg_count(g);
        if given >= 3 {
            mode = arg(g, 1);
            path1 = arg(g, 2);
        }
        if given >= 4 {
            path2 = arg(g, 3);
        }
    }
    let wants = bytes.equal(mode, "blind") && given == 3 || bytes.equal(mode, "apply") && given == 4;
    if wants {
        borrow fs as &f in {
            borrow mut console as &!i in {
                borrow mut h as &!hh in {
                    let room1 = box_slice(hh, 1048576, byte_of(0));
                    let room2 = box_slice(hh, 1048576, byte_of(0));
                    borrow mut room1 as &!r1 in {
                        borrow mut room2 as &!r2 in {
                            let t1 = contents(r1);
                            let t2 = contents(r2);
                            let n1 = fs_read(f, path1, t1);
                            var n2 = 0;
                            if given == 4 {
                                n2 = fs_read(f, path2, t2);
                            }
                            if n1 < 0 || n2 < 0 || n1 >= 1048576 || n2 >= 1048576 {
                                io.error_all(i, "review_gate: a file cannot be read, or is 1 MiB or more\n");
                            } else if given == 3 {
                                let q = review.blind(hh, t1[0..n1]);
                                borrow q as &qr in {
                                    buffer.write(i, qr);
                                }
                                buffer.drop(hh, q);
                                status = 0;
                            } else {
                                let (plan, report, code) = review.apply(hh, t1[0..n1], t2[0..n2]);
                                borrow plan as &p in {
                                    buffer.write(i, p);
                                }
                                buffer.drop(hh, plan);
                                borrow report as &r in {
                                    io.error_all(i, buffer.bytes(r));
                                }
                                buffer.drop(hh, report);
                                status = code;
                            }
                        }
                    }
                    unbox_slice(hh, room2);
                    unbox_slice(hh, room1);
                }
            }
        }
    }
    release(fs);
    release(console);
    release(h);
    release(args);
    return status;
}
